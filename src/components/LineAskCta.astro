---
/**
 * CTA รอง "ทักไลน์มาถามก่อน" — สีเขียว LINE เพื่อไม่ให้แย่งสายตากับ CTA หลักสีคอรัล
 *
 * ใช้คู่กับปุ่มรับของฟรีทุกจุด: คนที่ยังไม่พร้อมกรอกฟอร์ม จะได้มีประตูที่สองแทนที่จะปิดหน้าไปเฉยๆ
 *
 * variant="inline" — ปุ่มเดี่ยว วางใต้ CTA หลัก
 * variant="card"   — กล่องเต็มพร้อม QR สำหรับคนที่เปิดจากคอม (สแกนด้วยมือถือ)
 *
 * QR ถอดรหัสยืนยันแล้วว่าชี้ไป SITE.social.line (lin.ee/ioSnSUG) — ต้นฉบับ claude-code repo
 * → output/images/nissan-summit/line-qr.png
 */
import { SITE } from '../data/site';

interface Props {
  variant?: 'inline' | 'card';
  label?: string;
  note?: string;
  class?: string;
}

const {
  variant = 'inline',
  label = 'ทักไลน์ถามผมว่าช่วยธุรกิจคุณได้ไหม',
  note = 'เล่าสถานการณ์ทีมคุณสั้นๆ ผมตอบเอง ไม่มีค่าใช้จ่าย',
  class: className = '',
} = Astro.props;

const GREEN = 'bg-[#06C755] text-white hover:bg-[#05b04a]';
---

{
  variant === 'inline' ? (
    <div class={`flex flex-col items-start gap-2 ${className}`}>
      <a
        href={SITE.social.line}
        target="_blank"
        rel="noopener"
        class={`btn border-none ${GREEN} focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#06C755]`}
      >
        <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
          <path d="M12 2C6.5 2 2 5.7 2 10.2c0 4 3.6 7.4 8.4 8.1.3.07.8.2.9.5.1.3.07.7.03 1l-.14.9c-.04.26-.2 1.03.9.56s6-3.5 8.2-6C21.7 13.6 22 12 22 10.2 22 5.7 17.5 2 12 2M8 13H6.4c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.5c.2 0 .4.2.4.4v3.3H8c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4m2 0h-.5c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.5c.2 0 .4.2.4.4v4.2c0 .2-.2.4-.4.4m5 0h-.5c-.13 0-.25-.06-.32-.16l-1.9-2.56v2.32c0 .2-.18.4-.4.4h-.5c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.55c.12 0 .24.06.31.16l1.9 2.57V8.4c0-.2.18-.4.4-.4h.46c.22 0 .4.2.4.4v4.2c0 .2-.18.4-.4.4m3.6 0H17c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h1.6c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4h-.7v.6h.7c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4h-.7v.6h.7c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4" />
        </svg>
        {label}
      </a>
      <p class="text-sm text-base-content/60">{note}</p>
    </div>
  ) : (
    <div
      class={`rounded-2xl border-2 border-[#06C755]/30 bg-base-100 p-6 md:p-8 ${className}`}
    >
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <div class="flex-1">
          <p class="text-xs font-bold uppercase tracking-widest text-[#06C755]">คุยกับผมโดยตรง</p>
          <h3 class="mt-2 font-display text-2xl font-black leading-tight">
            ไม่แน่ใจว่าผมช่วยธุรกิจคุณได้ไหม ทักมาถามได้เลย
          </h3>
          <p class="mt-3 leading-relaxed text-base-content/75">
            เล่าให้ฟังสั้นๆ ว่าทีมขายคุณตอนนี้เป็นยังไง ติดตรงไหน
            ผมจะบอกตรงๆ ว่าควรเริ่มจากอะไรก่อน และเรื่องไหนที่ยังไม่ต้องจ้างใครทำก็ได้
          </p>
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            class={`btn btn-lg mt-6 border-none ${GREEN} focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#06C755]`}
          >
            <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
              <path d="M12 2C6.5 2 2 5.7 2 10.2c0 4 3.6 7.4 8.4 8.1.3.07.8.2.9.5.1.3.07.7.03 1l-.14.9c-.04.26-.2 1.03.9.56s6-3.5 8.2-6C21.7 13.6 22 12 22 10.2 22 5.7 17.5 2 12 2M8 13H6.4c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.5c.2 0 .4.2.4.4v3.3H8c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4m2 0h-.5c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.5c.2 0 .4.2.4.4v4.2c0 .2-.2.4-.4.4m5 0h-.5c-.13 0-.25-.06-.32-.16l-1.9-2.56v2.32c0 .2-.18.4-.4.4h-.5c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h.55c.12 0 .24.06.31.16l1.9 2.57V8.4c0-.2.18-.4.4-.4h.46c.22 0 .4.2.4.4v4.2c0 .2-.18.4-.4.4m3.6 0H17c-.2 0-.4-.2-.4-.4V8.4c0-.2.2-.4.4-.4h1.6c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4h-.7v.6h.7c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4h-.7v.6h.7c.2 0 .4.2.4.4v.5c0 .2-.2.4-.4.4" />
            </svg>
            เปิด LINE แล้วทักเลย
          </a>
        </div>

        {/* QR สำหรับคนที่เปิดหน้านี้จากคอม — บนมือถือปุ่มด้านบนทำงานแทนอยู่แล้ว */}
        <figure class="hidden shrink-0 text-center sm:block">
          <img
            src="/images/line-qr.png"
            alt="QR code เพิ่มเพื่อน LINE ของปัน ณัฐพัชร์"
            width="132"
            height="132"
            loading="lazy"
            class="size-32 rounded-lg ring-1 ring-base-content/10"
          />
          <figcaption class="mt-2 text-xs text-base-content/55">สแกนด้วยมือถือ</figcaption>
        </figure>
      </div>
    </div>
  )
}
