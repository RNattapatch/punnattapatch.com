---
/**
 * ส่วน 2 — แนะนำตัว · โทน "จดหมายเจ้าของถึงเจ้าของ"
 *
 * 2026-08-12 (ปันสั่ง): เลิกใช้ placeholder รูปเดียว → ใช้รูปหน้างานจริงหลายใบ + โลโก้ลูกค้า
 * เพื่อสร้าง trust ตั้งแต่ต้นหน้า ไม่ต้องรอถึงส่วนเคส
 *
 * + รูป portrait สตูดิโอมาคู่กับหัวข้อ "สวัสดีครับ ผมปันครับ" —
 *   คนที่มาจาก Ads LP ยังไม่เคยเห็นหน้าคนที่ตัวเองเพิ่งให้เบอร์ไป เห็นหน้าก่อนค่อยอ่านว่าทำอะไร
 *   นี่คือ**ข้อยกเว้นที่ตั้งใจ**ของกฎ "ห้ามรูปสตูดิโอ" เดิม: รูปสตูดิโอทำหน้าที่ "นี่คือใคร"
 *   ส่วนรูปหน้างาน 4 ใบด้านล่างทำหน้าที่ "เขาทำงานยังไง" — คนละงานกัน ไม่ทดแทนกัน
 *
 * รูปทั้งหมดเป็นรูปงานจริงที่มีอยู่ในรีโปแล้ว (ตรวจเนื้อภาพทีละใบก่อนใช้):
 *   - about/pun-working-with-team — ปันยืนชี้จอ ทีมลูกค้านั่งล้อมโต๊ะ (ภาพนำ "จับมือทำ" ชัดสุด)
 *   - gallery4 — รูปหมู่กับทีมลูกค้าหลังจบงาน
 *   - gallery1 — ห้องอบรมจริง มีสไลด์ Advance AI & Business Automation ขึ้นจอ
 *   - gallery3 — หน้างานนอกออฟฟิศ (โรงพยาบาล) แสดงว่าไม่ได้ทำแต่ห้องประชุม
 *
 * ⚠️ โลโก้ลูกค้าย้ายมาอยู่ตรงนี้แล้ว และถูก **ถอดออกจาก CaseLogos** —
 *    โลโก้ชุดเดียวกันโผล่ 2 ที่ในหน้าเดียวคือความซ้ำ ไม่ใช่หลักฐานเพิ่ม
 * ⚠️ โลโก้ขึ้นสีเต็มเสมอ ห้าม grayscale (กฎถาวร · design-system.md)
 */
const shots = [
  {
    src: '/about/pun-working-with-team.jpg',
    alt: 'ปันยืนอธิบายหน้าจอให้ทีมลูกค้าที่นั่งล้อมโต๊ะทำงานพร้อมโน้ตบุ๊กของตัวเอง',
    lead: true,
  },
  {
    src: '/gallery/gallery4.jpg',
    alt: 'รูปหมู่กับทีมลูกค้าหลังจบงานอบรมในห้องประชุม',
  },
  {
    src: '/gallery/gallery1.jpg',
    alt: 'ห้องอบรมจริง ทีมงานนั่งทำงานกับโน้ตบุ๊ก มีสไลด์หัวข้อ Advance AI ขึ้นจอ',
  },
  {
    src: '/gallery/gallery3.jpg',
    alt: 'ปันลงหน้างานจริงนอกออฟฟิศ คุยกับทีมพยาบาลหน้าเคาน์เตอร์',
  },
];

const clientLogos = [
  { src: '/logos/clients/futureskill.png', alt: 'FutureSkill' },
  { src: '/logos/clients/hfc-healthfoods.png', alt: 'HFC HealthFoods Corporation' },
  { src: '/logos/clients/home-plus.png', alt: 'ฮ.โฮมพลัส' },
  { src: '/logos/clients/ving.png', alt: 'V!NG' },
  { src: '/logos/clients/farevefarm.jpg', alt: 'Farevefarm' },
  { src: '/logos/clients/farmsuk.jpg', alt: 'ฟาร์มสุข farmsuk' },
  { src: '/logos/clients/business-boy.jpg', alt: 'เด็กประกอบการ The Business Boy' },
  { src: '/logos/clients/gpx.jpg', alt: 'GPX' },
  { src: '/logos/clients/aes.jpg', alt: 'AES' },
  { src: '/logos/clients/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/logos/clients/zontes.png', alt: 'Zontes' },
  { src: '/logos/clients/nissan.png', alt: 'Nissan' },
  { src: '/logos/clients/lambretta.png', alt: 'Lambretta' },
  { src: '/logos/clients/nsscrap.avif', alt: 'NSSCRAP' },
  { src: '/logos/clients/scenery-farm.jpeg', alt: 'Scenery' },
  { src: '/logos/clients/ud-clinic.jpg', alt: 'UD Clinic' },
];

const [lead, ...rest] = shots;
---

<section id="start-intro" class="px-margin-page py-14 md:py-20">
  <div class="mx-auto max-w-2xl">
    {/* เจอหน้าก่อน แล้วค่อยรู้ว่าทำอะไร — รูปกับชื่อต้องมาพร้อมกัน ไม่ใช่รูปลอยอยู่คนละที่กับหัวข้อ
        รูปใช้ mx-auto เฉพาะตอนซ้อนแนวตั้ง (มือถือ): flex-col ทำให้แกนขวางเป็นแนวนอน รูปกว้างคงที่
        เลยไปกองชิดซ้าย · พอขึ้น sm: เป็น flex-row ต้อง reset เป็น sm:mx-0 ไม่งั้น margin auto
        จะไปดันบนแกนหลักแล้วเบียดบล็อกข้อความข้างๆ */}
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-7">
      <img
        src="/about/pun-ceo-portrait.jpg"
        alt="ปัน ณัฐพัชร์ ใส่สูทสีเทา นั่งยิ้มมองกล้อง"
        width="800"
        height="1200"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="mx-auto aspect-[3/4] w-40 shrink-0 rounded-2xl border border-[#c9c2b2] object-cover object-top sm:mx-0 sm:w-48"
      />

      <div>
        <h2 class="font-display text-2xl font-bold leading-tight text-navy md:text-3xl">
          สวัสดีครับ ผมปันครับ
        </h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-warm-ink/70">
          ที่ปรึกษาด้านการปั้นทีมขาย และ AI Agent
        </p>
      </div>
    </div>

    <div class="mt-8">
      <div class="space-y-5 text-[1.05rem] leading-[1.85] text-warm-ink/85">
        <p>ก่อนจะบอกว่าผมทำอะไร ขอเล่าสิ่งที่ผมเคยทำมาก่อน</p>

        <p>
          ผมคลุกอยู่กับฝ่ายขาย B2B และ AI Agent มาตลอดครับ เคยปั้นทีมขายจาก 0 จนถึง 100 ล้าน<br />
          สัมภาษณ์เซลล์มามากกว่า 1,000 คน เจอครบ ทั้งเซลล์เก่งที่ลาออกแล้วยอดหายไปด้วย
          ทั้งข้อมูลลูกค้าที่อยู่ในไลน์ส่วนตัวของพนักงานที่ไม่อยู่แล้ว
        </p>

        <p>
          ทุกวันนี้ผมใช้ AI ทำงานแทนตัวเองทุกวัน ไม่ใช่ในฐานะคนสอน
          แต่ในฐานะเจ้าของที่ต้องการเวลาคืน<br />
          แล้วเอาสิ่งที่ใช้จริงกับธุรกิจตัวเอง ไปใช้จริงแบบจับมือทำกับเจ้าของธุรกิจทีละราย
        </p>
      </div>
    </div>

    {/* รูปหน้างานจริง — วางหลังข้อความ ไม่ใช่ก่อน เพราะมันคือ "หลักฐานของสิ่งที่เพิ่งเล่า"
        ไม่ใช่ภาพประกอบลอยๆ · ภาพนำ 1 + thumbnail 3 */}
    <figure class="m-0 mt-9">
      <img
        src={lead.src}
        alt={lead.alt}
        width="1100"
        height="825"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full rounded-2xl border border-[#c9c2b2] object-cover"
      />

      <ul class="mt-2.5 grid grid-cols-3 gap-2.5" aria-label="ภาพหน้างานจริงเพิ่มเติม">
        {
          rest.map((s) => (
            <li>
              <img
                src={s.src}
                alt={s.alt}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
                class="aspect-square w-full rounded-xl border border-[#c9c2b2] object-cover"
              />
            </li>
          ))
        }
      </ul>

      <figcaption class="mt-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-warm-ink/60">
        หน้างานจริง · ไม่ใช่ภาพสตูดิโอ
      </figcaption>
    </figure>

    <div class="mt-10 border-t border-[#c9c2b2] pt-7">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-warm-ink/65">องค์กรที่ผมดูแล</p>

      <!-- flex-wrap ไม่ใช่ grid — 16 โลโก้หาร 3/4/5 ไม่ลงตัว แถวสุดท้ายจะได้จัดกลาง
           ไม่ค้างชิดซ้ายเป็นเศษ · พื้นกล่องขาวเพื่อให้โลโก้ที่มีพื้นขาวติดมาในไฟล์
           กลืนไปกับกล่อง ไม่เห็นเป็นสี่เหลี่ยมซ้อนสี่เหลี่ยม -->
      <ul
        class="mt-4 flex flex-wrap justify-center gap-2.5 sm:gap-3"
        aria-label="องค์กรที่ไว้ใจให้ปันดูแล"
      >
        {
          clientLogos.map((logo) => (
            <li class="flex h-20 w-[calc(33.333%-0.7rem)] items-center justify-center rounded-xl border border-[#c9c2b2] bg-white p-2.5 sm:h-24 sm:w-[calc(25%-0.75rem)] md:w-[calc(20%-0.8rem)] md:p-3">
              <img
                src={logo.src}
                alt={logo.alt}
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
                class="max-h-full max-w-full object-contain"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
