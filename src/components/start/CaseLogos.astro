---
/**
 * ส่วน 6 — เคสจริง (การ์ดล้วน)
 *
 * ปันเคาะ 2026-08-09: ไม่เอ่ยชื่อบริษัทในเคส — เล่าเป็นประเภทธุรกิจ
 *
 * 2026-08-12: **logo strip ย้ายขึ้นไปอยู่ใน IntroLetter (ส่วน 2) แล้ว** ตามที่ปันสั่ง
 * ให้สร้าง trust ตั้งแต่ต้นหน้า — ที่นี่จึงเหลือแค่การ์ดเคสล้วน
 * ห้ามเอาโลโก้กลับมาใส่ซ้ำที่นี่ (ชุดเดียวกันโผล่ 2 ที่ = ความซ้ำ ไม่ใช่หลักฐานเพิ่ม)
 *
 * การ์ดละไม่เกิน 4 บรรทัด · ไม่เคลมยอด เน้นเวลา/ความหลุด
 */
const cases = [
  {
    kind: 'ตัวแทนจำหน่ายรถโฟล์คลิฟท์',
    before: 'ระบบงานงอกขึ้นมาหลายตัว กระจัดกระจายคนละที่',
    after: 'รวมเหลือระบบเดียวที่ทีมใช้จริง และมี LINE bot รับลูกค้า',
  },
  {
    kind: 'ค้าวัสดุก่อสร้าง 2 สาขา',
    before: 'งานเอกสารและการตามงานวิ่งข้ามสองสาขา',
    after: 'ระบบกลางที่เจ้าของเห็นทุกอย่างจากที่เดียว',
  },
  {
    kind: 'ธุรกิจของผมเอง',
    before: 'ใบเสนอราคาและใบแจ้งหนี้ ทำมือทุกใบ',
    after: 'สั่งงานผ่านแชท แล้วเอกสารวิ่งเข้า LINE เอง',
  },
];

import InlineLineCta from './InlineLineCta.astro';
---

<section class="border-y border-[#c9c2b2] bg-sand px-margin-page py-14 md:py-20">
  <div class="mx-auto max-w-2xl">
    <h2 class="font-display text-2xl font-bold leading-tight text-navy md:text-3xl">
      ของที่ทำไปแล้ว หน้าตาประมาณนี้
    </h2>

    <div class="mt-7 space-y-4">
      {
        cases.map((c) => (
          <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-6">
            <p class="font-display text-lg font-bold text-navy">{c.kind}</p>
            <dl class="mt-3 space-y-2 text-[0.95rem] leading-relaxed">
              <div class="flex gap-2">
                <dt class="shrink-0 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-warm-ink/65 pt-1">
                  ก่อน
                </dt>
                <dd class="text-warm-ink/65">{c.before}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="shrink-0 font-mono text-[0.7rem] uppercase tracking-[0.15em] text-coral pt-1">
                  หลัง
                </dt>
                <dd class="text-warm-ink">{c.after}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-[1.02rem] italic leading-[1.8] text-warm-ink/85">
      อยากเห็นของจริงมากกว่านี้ ในคอลผมเปิดหน้าจอให้ดูระบบที่ผมใช้เองได้เลยครับ
    </p>

    <div class="mt-6">
      <InlineLineCta text="ทักมาใน LINE แล้วนัดเวลากันได้เลยครับ" label="นัดเวลาใน LINE →" />
    </div>
  </div>
</section>
