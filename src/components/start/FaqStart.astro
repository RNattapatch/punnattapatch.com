---
/**
 * ส่วน 9 — คำถามที่เจอบ่อย (6 ข้อ เรียงตามความถี่ที่เจอจริงในคอล)
 * เฟส 2 แทนที่ด้วยวิดีโอตอบทีละข้อ
 *
 * ใช้ <details>/<summary> ตาม pattern เดียวกับ FaqWork.astro ของเว็บ
 * (accordion ที่ keyboard + screen reader ใช้ได้เองโดยไม่ต้องพึ่ง JS)
 */
const faqs = [
  {
    q: 'ทีมผมไม่มีใครเก่งคอมเลย เริ่มได้ไหม?',
    a: 'ได้ครับ ลูกค้าผมส่วนใหญ่เริ่มจากศูนย์ ผมออกแบบให้คนที่ใช้แค่ไลน์กับ Excel ใช้เป็น ถ้าทีมคุณส่งไลน์เป็น ก็เริ่มได้',
  },
  {
    q: 'ต้องซื้อโปรแกรมแพงๆ เพิ่มไหม?',
    a: 'เกือบทั้งหมดเริ่มจากของที่คุณใช้อยู่แล้ว ค่าใช้จ่ายเครื่องมือส่วนใหญ่อยู่แค่หลักร้อยถึงหลักพันต่อเดือน ผมจะบอกตัวเลขจริงก่อนเริ่มเสมอ',
  },
  {
    q: 'ทำแล้วทีมจะใช้ต่อจริงไหม หรือเห่อสองเดือนแล้วเลิก?',
    a: 'นี่คือเหตุผลที่ผมจับมือทำ ไม่ใช่สอนแล้วหาย ระบบที่ทีมไม่ใช้ = ผมยังทำงานไม่จบ',
  },
  {
    q: 'ข้อมูลบริษัทผมปลอดภัยแค่ไหน?',
    a: 'ผมออกแบบให้ข้อมูลทั้งหมดอยู่ในบัญชีของบริษัทคุณเองตั้งแต่วันแรก วันที่จบงาน ทุกอย่างเป็นของคุณ 100%',
  },
  {
    q: 'ต่างจากคอร์สสอน AI ทั่วไปยังไง?',
    a: 'คอร์สทั่วไปสอนใช้เครื่องมือ ส่วนผมทำระบบของธุรกิจคุณ ถึงต้องไปหน้างานจริง ไม่มีสอนออนไลน์',
  },
  {
    q: 'ถ้ายังไม่พร้อมลงทุน คุยก่อนได้ไหม?',
    a: 'ได้ครับ คอลแรกไม่มีค่าใช้จ่ายและผมไม่ขาย อย่างน้อยคุณจะได้ภาพว่าธุรกิจคุณติดตรงไหน เอาไปทำต่อเองก็ยังได้',
  },
];
---

<section class="border-y border-[#c9c2b2] bg-sand px-margin-page py-14 md:py-20">
  <div class="mx-auto max-w-2xl">
    <h2 class="font-display text-2xl font-bold leading-tight text-navy md:text-3xl">
      คำถามที่เจอบ่อย
    </h2>

    <div id="start-faq" class="mt-7 space-y-3">
      {
        faqs.map((f, i) => (
          <details class="group overflow-hidden rounded-xl border border-[#c9c2b2] bg-surface open:border-coral/40">
            <summary class="flex cursor-pointer list-none items-start gap-3 px-5 py-4 font-display text-base font-bold text-navy md:text-lg">
              <span class="mt-0.5 shrink-0 font-mono text-sm font-bold text-coral tabular-nums">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex-1">{f.q}</span>
              <span
                class="mt-0.5 shrink-0 text-xl leading-none text-coral transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="px-5 pb-5 pl-[3.25rem] text-[0.95rem] leading-relaxed text-warm-ink/80">
              {f.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
