 * ต่างกันแค่ ClosingCard ที่โชว์ Reference เฉพาะตอนมาจากฟอร์ม
 */
import IntroLetter from './IntroLetter.astro';
import WhySection from './WhySection.astro';
import ServiceShelves from './ServiceShelves.astro';
import HowTimeline from './HowTimeline.astro';
import CaseLogos from './CaseLogos.astro';
import NotForYou from './NotForYou.astro';
