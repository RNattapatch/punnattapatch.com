---
/**
 * ส่วน 8 — งบประมาณ · "ราคาเดียว 2 ประตู"
 *
 * ปันล็อก 2026-08-09: consult 1 วัน = อบรม 1 วัน = เท่ากัน โดยตั้งใจ เพื่อ**ลด paradox of
 * choice** และให้ลูกค้าเลือกจาก *ปัญหา* ไม่ใช่จากราคา
 *
 * เวอร์ชันแรกทำเป็นตาราง 2 แถวที่เลขขวาเหมือนกันเป๊ะ ซึ่งทำงานย้อนศรกับเจตนานั้น —
 * ตาไปจับ "เลขซ้ำ" ก่อน แล้วเกิดคำถามว่า "งั้นต่างกันตรงไหน" ซึ่งคือคำถามที่ตั้งใจกำจัด
 * (ตารางเปรียบเทียบ = เครื่องมือสำหรับของที่ *ต่างกัน*)
 *
 * เวอร์ชันนี้: ประกาศเลข **ครั้งเดียว เหนือ** ตัวเลือก แล้วให้ 2 ตัวเลือกอยู่ใต้ในฐานะ "ประตู"
 * ที่แยกกันด้วยปัญหาล้วน → ราคาเท่ากันกลายเป็นจุดขาย ไม่ใช่จุดสงสัย
 *
 * ตัวเลขมาจาก pricing.mjs (SSOT) เท่านั้น — ห้าม hardcode
 *   อบรม     → key `inhouse-a`
 *   ที่ปรึกษา → key `consult-daily` (เรตรายวัน ไม่ใช่สินค้าตัวใดตัวหนึ่ง)
 *
 * ⚠️ ถ้าวันหนึ่งสองเรตนี้ไม่เท่ากันแล้ว หน้าจะสลับกลับไปโชว์ราคาแยกต่อประตูเอง
 *    (เช็คที่ `samePrice` ข้างล่าง) — ไม่ต้องมาแก้ layout ตามทีหลัง
 */
import { fmtPrice, PRICES } from '../../data/pricing.mjs';
import InlineLineCta from './InlineLineCta.astro';

const TRAINING = 'inhouse-a';
const CONSULT = 'consult-daily';

const samePrice = PRICES[TRAINING]?.amount === PRICES[CONSULT]?.amount;

const doors = [
  {
    label: 'อบรมทั้งทีม',
    detail: 'คอร์สสดที่บริษัทคุณ',
    fit: 'ทีมมีคนพอแล้ว แต่ยังทำงานแบบเดิมกันทั้งทีม',
    price: fmtPrice(TRAINING),
  },
  {
    label: 'ที่ปรึกษาตัวต่อตัว',
    detail: 'นั่งวางระบบกับผมโดยตรง',
    fit: 'รู้แล้วว่าติดตรงไหน อยากได้คนมานั่งวางระบบให้จริง',
    price: fmtPrice(CONSULT),
  },
];
---

<section id="start-pricing" class="px-margin-page py-10 md:py-14">
  <div class="mx-auto max-w-2xl">
    <p class="font-mono text-[0.7rem] font-bold uppercase tracking-[0.22em] text-warm-ink/55">
      งบประมาณ
    </p>

    <h2 class="mt-3 font-display text-2xl font-bold leading-tight text-navy md:text-3xl">
      งานของผมมี 2 แบบครับ
    </h2>

    <div class="mt-6">
      <InlineLineCta text="ถ้าไม่แน่ใจว่าควรเริ่มแบบไหนก่อน ทักมาคุยกับผมก่อนได้ครับ" />
    </div>

    {
      samePrice && (
        <div class="mt-7 rounded-2xl border border-warm-ink bg-surface px-6 py-6 text-center md:px-8">
          <p class="text-sm font-semibold text-warm-ink/70">ราคาเดียวกันทั้งสองแบบ</p>
          <p class="mt-1 font-display text-[2.4rem] font-bold leading-none text-navy tabular-nums md:text-[3rem]">
            {fmtPrice(TRAINING)}
          </p>
          <p class="mt-1.5 text-sm font-semibold text-warm-ink/70">ต่อ 1 วัน</p>
          <p class="mt-4 border-t border-[#c9c2b2] pt-4 text-[1.02rem] font-medium leading-[1.7] text-navy">
            ไม่ต้องเลือกจากราคา เลือกจากปัญหาที่คุณมีตอนนี้
          </p>
        </div>
      )
    }

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        doors.map((d) => (
          <div class="rounded-2xl border border-[#c9c2b2] bg-surface p-5 md:p-6">
            <p class="font-display text-lg font-bold text-navy">{d.label}</p>
            <p class="mt-0.5 text-sm text-warm-ink/70">{d.detail}</p>

            {!samePrice && (
              <p class="mt-3 font-display text-xl font-bold text-navy tabular-nums">
                <span class="mr-1 text-sm font-semibold text-warm-ink/70">เริ่มต้น</span>
                {d.price}
              </p>
            )}

            <p class="mt-4 border-t border-[#c9c2b2] pt-4 text-[0.98rem] leading-[1.7] text-warm-ink/85">
              <span class="font-bold text-navy">เหมาะถ้า:</span> {d.fit}
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-7 text-[1.02rem] leading-[1.8] text-warm-ink/85">
      ตัวเลขที่เหมาะกับคุณ ขึ้นกับหน้างานจริง ผมถึงต้องคุยก่อนเสนอราคา ไม่ใช่เสนอราคาก่อนคุย
    </p>
    <p class="mt-4 text-[1.02rem] leading-[1.8] text-warm-ink/85">
      ทุกงานชำระเต็มก่อนเริ่ม เพราะผมรับงานจำกัดต่อเดือน คิวที่จองคือคิวที่ผมกันเวลาไว้ให้คุณจริงๆ
    </p>
  </div>
</section>
