---
/**
 * แถบปุ่ม LINE ติดขอบล่าง — โผล่หลังเลื่อนผ่าน fold แรก ซ่อนตอนการ์ดสถานะยังเห็นอยู่
 * (ปุ่มในการ์ดทำหน้าที่แทนอยู่แล้ว แถบซ้ำตอนนั้น = รบกวนเปล่าๆ)
 *
 * แถบนี้ **คือขั้นที่ 4 ของ tracker ที่ยังค้าง** ไม่ใช่ปุ่มลอยที่ไม่เกี่ยวกัน —
 * ใช้วงกลมประดวงเดียวกับ `.tracker-mark-open` ใน StatusCard เพื่อให้ตาโยงกลับไปที่การ์ดข้างบน
 * ทั้งหน้าจึงเป็น "งานหนึ่งชิ้นที่ยังไม่จบ" ตั้งแต่ต้นจนท้าย (Zeigarnik) ไม่ใช่แค่ตกแต่ง fold
 */
import { SITE } from '../../data/site';
---

<div id="sticky-line-bar" class="sticky-line-bar" data-visible="false">
  <p class="sticky-step">
    <span class="sticky-mark" aria-hidden="true"></span>
    ขั้นที่ 4 · รอคุณทักใน LINE
  </p>
  <a
    href={SITE.social.line}
    rel="noopener"
    target="_blank"
    class="press-btn btn w-full gap-2 border-none font-bold text-white shadow-none hover:opacity-90"
    style="background: #06C755;"
  >
    <img src="/line-logo.png" alt="" class="h-5 w-5 shrink-0" aria-hidden="true" />
    ทักใน LINE →
  </a>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('sticky-line-bar');
    var fold = document.getElementById('page0-fold');
    if (!bar || !fold) return;

    if (!('IntersectionObserver' in window)) {
      bar.setAttribute('data-visible', 'true');
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          bar.setAttribute('data-visible', entry.isIntersecting ? 'false' : 'true');
        });
      },
      { threshold: 0 }
    );
    io.observe(fold);
  })();
</script>

<style>
  .sticky-line-bar {
    position: fixed;
    z-index: 30;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.6rem max(1rem, env(safe-area-inset-left)) calc(0.6rem + env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-right));
    background: rgba(244, 241, 234, 0.97);
    border-top: 1px solid #c9c2b2;
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 220ms ease-out,
      opacity 180ms ease-out;
  }
  .sticky-line-bar[data-visible='true'] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  /* ป้ายขั้นที่ 4 — เล็กและเงียบ ไม่แย่งปุ่ม แต่พอให้ตาโยงกลับไปที่ tracker ข้างบน */
  .sticky-step {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0 0 0.45rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #6c6963;
  }
  /* วงกลมประดวงเดียวกับ .tracker-mark-open ใน StatusCard — ตั้งใจให้เป็นภาษาเดียวกัน */
  .sticky-mark {
    width: 0.7rem;
    height: 0.7rem;
    flex: 0 0 auto;
    border-radius: 9999px;
    border: 2px dashed #77746e;
  }

  @media (min-width: 768px) {
    .sticky-line-bar > a {
      max-width: 28rem;
      margin-inline: auto;
    }
  }
  /* prefers-reduced-motion: global.css บีบ transition-duration เหลือ ~0
     แถบจึงโผล่/หายทันทีโดยไม่มีการเดินทาง — ไม่ต้อง override เพิ่ม */
</style>
