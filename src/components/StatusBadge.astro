---
interface Props {
  label: string;
  status: 'active' | 'running' | 'ready' | 'synced';
  pulse?: boolean;
}
const { label, status, pulse = false } = Astro.props;
---

<span class:list={['status-badge', `s-${status}`]}>
  {pulse && <span class="pulse-dot" aria-hidden="true" />}
  {label}
</span>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 10px;
    border-radius: var(--pun-radius-badge);
    font-family: 'Sarabun', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .s-active, .s-running {
    background: rgba(34,211,238,0.10);
    border: 1px solid rgba(34,211,238,0.25);
    color: #22d3ee;
  }
  .s-ready {
    background: rgba(251,191,36,0.10);
    border: 1px solid rgba(251,191,36,0.25);
    color: #fbbf24;
  }
  .s-synced {
    background: rgba(74,222,128,0.10);
    border: 1px solid rgba(74,222,128,0.25);
    color: #4ade80;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
    animation: badge-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes badge-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.25; }
  }
</style>
