---
// เมนูย่อยของ CRM บนจอเล็ก — เปิดจาก hamburger ใน AppNav (คุณปันขอคงไว้ 2026-09-02)
// รายการเดียวกับแถบย่อยแถว 2 บนจอใหญ่ (TabBar) · ลิงก์ข้ามแอป + ออกจากระบบ ย้ายไป AppNav แล้ว
---
<div class="drawer-side z-40 lg:hidden">
  <label for="dash-sidebar-toggle" aria-label="ปิดเมนู" class="drawer-overlay"></label>
  <aside class="flex min-h-full w-72 flex-col border-r border-base-300 bg-base-100 p-4">
    <p class="mb-3 px-2 font-display text-sm font-semibold opacity-60">CRM</p>
    <ul class="menu flex-1 gap-1 text-base">
      <li><a class="rounded-2xl" href="#" data-goto="top">ภาพรวม</a></li>
      <li><a class="rounded-2xl" href="#" data-goto="leads-view">Leads</a></li>
      <li><a class="rounded-2xl" href="#" data-goto="kanban-section">Sales Pipeline</a></li>
      <li><a class="rounded-2xl" href="#" data-tab="war-room">🎯 Client War Room</a></li>
      <li><a class="rounded-2xl" href="#" data-tab="expenses">💸 ค่าใช้จ่าย</a></li>
    </ul>
  </aside>
</div>

<script>
  import { switchTab } from '../../scripts/dashboard/store';

  const close = () => (document.getElementById('dash-sidebar-toggle') as HTMLInputElement | null)?.click();

  document.querySelectorAll<HTMLAnchorElement>('.drawer-side [data-goto]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab('leads'); // เป้าหมายเลื่อนอยู่ในมุมมอง Leads
      close();
      requestAnimationFrame(() => {
        if (a.dataset.goto === 'top') return window.scrollTo({ top: 0, behavior: 'smooth' });
        document.getElementById(a.dataset.goto || '')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.drawer-side [data-tab]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab(a.dataset.tab as 'leads' | 'expenses' | 'war-room');
      close();
    });
  });
</script>
