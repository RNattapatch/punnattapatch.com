---
// ปุ่มเฉพาะหน้า CRM ที่เสียบเข้า slot ของ AppNav (เดิมอยู่ใน DashboardHeader ที่ถูกถอดออก
// ตอนย้ายทุกแอปมาใช้แถบบนร่วม 2026-09-02) — ธีม/ออกจากระบบไปอยู่ใน AppNav แล้ว
---
<p id="dash-meta" class="hidden text-xs opacity-40 tabular-nums md:block">—</p>
<button id="dash-refresh" class="btn btn-ghost btn-sm tap-44" aria-label="รีเฟรช">↻</button>
<button id="dash-add-lead-header" class="btn btn-sm rounded-2xl text-white tap-44" style="background-color:var(--color-brand-navy);">
  <span class="sm:hidden" aria-hidden="true">+</span><span class="hidden sm:inline">+ Add Lead</span>
</button>

<script>
  import { refresh, subscribe, getState, emit } from '../../scripts/dashboard/store';

  function relTime(iso: string | null): string {
    if (!iso) return '—';
    const ms = Date.now() - new Date(iso).getTime();
    if (!Number.isFinite(ms)) return '—';
    const s = Math.floor(ms / 1000);
    if (s < 60) return `อัปเดต ${s} วิที่แล้ว`;
    const m = Math.floor(s / 60);
    if (m < 60) return `อัปเดต ${m} นาทีที่แล้ว`;
    const h = Math.floor(m / 60);
    if (h < 24) return `อัปเดต ${h} ชม.ที่แล้ว`;
    return `อัปเดต ${new Date(iso).toLocaleString('th-TH')}`;
  }

  function render() {
    const meta = document.getElementById('dash-meta');
    if (meta) meta.textContent = relTime(getState().generatedAt);
  }
  render();
  subscribe(render);
  setInterval(render, 30000);

  document.getElementById('dash-refresh')?.addEventListener('click', () => void refresh());
  document.getElementById('dash-add-lead-header')?.addEventListener('click', () => emit('modal:add-lead'));
</script>
