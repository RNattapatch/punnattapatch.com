---
import LeadCard from './LeadCard.astro';
---
<section class="mb-20">
  <div class="flex items-center justify-between mb-3 gap-2">
    <h2 class="font-display text-base">Leads</h2>
    <span id="lead-total" class="text-xs opacity-60"></span>
  </div>

  <div class="flex gap-2 mb-3">
    <input
      id="lead-search"
      type="search"
      placeholder="ค้นชื่อ บริษัท เบอร์..."
      class="input input-bordered input-sm flex-1 tap-44"
      autocomplete="off"
    />
    <select id="lead-sort" class="select select-bordered select-sm tap-44">
      <option value="submitted_desc">ล่าสุด</option>
      <option value="next_due_asc">ครบกำหนดก่อน</option>
      <option value="amount_desc">ยอดสูงก่อน</option>
    </select>
  </div>

  <!-- ช่วงเวลา — อิงวันที่ lead เข้ามา (submitted_at) · ถามฐานข้อมูลทั้งช่วง ไม่ใช่กรองจาก 30 แถวที่โหลดมา -->
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <select id="lead-range" class="select select-bordered select-sm tap-44" aria-label="ช่วงเวลาที่ดู">
      <option value="all">📅 ทุกช่วงเวลา</option>
      <option value="today">วันนี้</option>
      <option value="week">สัปดาห์นี้</option>
      <option value="month">เดือนนี้</option>
      <option value="quarter">ไตรมาสนี้</option>
      <option value="year">ปีนี้</option>
      <option value="custom">กำหนดเอง…</option>
    </select>
    <div id="lead-range-custom" class="hidden flex-wrap items-center gap-1">
      <input id="lead-range-from" type="date" class="input input-bordered input-sm tap-44" aria-label="ตั้งแต่วันที่" />
      <span class="text-xs opacity-60">ถึง</span>
      <input id="lead-range-to" type="date" class="input input-bordered input-sm tap-44" aria-label="ถึงวันที่" />
      <button id="lead-range-apply" class="btn btn-sm tap-44" style="background-color:var(--color-brand-navy);color:white;">ดู</button>
    </div>
  </div>

  <!-- สรุปของช่วงที่เลือก — มีรายการอย่างเดียวไม่พอ ต้องบอกได้ว่าช่วงนี้ได้อะไรบ้าง -->
  <div id="lead-range-summary" class="hidden mb-3 rounded-2xl border border-base-300 bg-base-200 px-4 py-3" role="status" aria-live="polite">
    <p id="lead-range-label" class="text-xs opacity-60"></p>
    <div id="lead-range-stats" class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm"></div>
  </div>

  <div id="lead-filters" class="flex flex-wrap gap-2 mb-3 text-xs">
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="all">All</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="today">Today</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="hot">🔥 Hot</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="warm">🌤 Warm</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="cold">❄️ Cold</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="after_hours">🌒 โทรนอกเวลาได้</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="in_progress">In Progress</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="proposal_sent">Proposal Sent</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="walkthrough_done">Walkthrough Done</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="won">Won</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="repeat">🔁 ซื้อซ้ำ</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="retainer">🗓️ รายเดือน</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="lost">Lost</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="unqualified">🚫 Unqualified</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="sponsor">🤝 Sponsor</button>
    <button class="filter-chip btn btn-xs btn-outline tap-44" data-chip="manual">Manual</button>
  </div>

  <div id="lead-list" class="grid gap-2"></div>
  <div id="lead-empty" class="hidden text-sm opacity-70 px-2 py-6 text-center">ไม่พบ lead</div>

  <div class="flex justify-center mt-4">
    <button id="lead-load-more" class="btn btn-sm btn-ghost tap-44 hidden">โหลดเพิ่ม</button>
  </div>
</section>

<LeadCard variant="list" />

<script>
  import { subscribe, getState, openLead, setFilter, setSort, setSearch, setRange, rangeSummary, visibleLeads, loadMore, on } from '../../scripts/dashboard/store';
  import type { RangeKey } from '../../scripts/dashboard/store';
  import type { LeadUi } from '../../scripts/dashboard/adapter';
  import { markName } from '../../scripts/after-hours';

  function ageDays(iso?: string): string {
    if (!iso) return '';
    const ms = Date.now() - new Date(iso).getTime();
    if (!Number.isFinite(ms)) return '';
    const d = Math.max(0, Math.floor(ms / 86400000));
    return d === 0 ? 'วันนี้' : `${d} วัน`;
  }
  function fmtTHB(n: unknown): string {
    const v = Number(n) || 0;
    if (!v) return '—';
    return new Intl.NumberFormat('th-TH', { maximumFractionDigits: 0 }).format(v) + ' ฿';
  }
  function badgeFor(l: LeadUi): { text: string; cls: string } {
    if (l.deal_outcome === 'repeat') return { text: '🔁 repeat', cls: 'badge-secondary' };
    if (l.deal_outcome === 'retainer') return { text: '🗓️ retainer', cls: 'badge-info' };
    if (l.deal_outcome === 'won') return { text: 'won', cls: 'badge-success' };
    if (l.deal_outcome === 'lost') return { text: 'lost', cls: 'badge-error' };
    if (l.deal_outcome === 'unqualified') return { text: 'unqualified', cls: 'badge-neutral' };
    if (l.walkthrough_at) return { text: 'walk', cls: 'badge-info' };
    if (l.proposal_sent_at) return { text: 'prop', cls: 'badge-warning' };
    return { text: 'in progress', cls: 'badge-ghost' };
  }
  function tempEmoji(t: unknown): string {
    if (t === 'hot') return '🔥';
    if (t === 'warm') return '🌤';
    if (t === 'cold') return '❄️';
    return '';
  }
  function relAgo(iso?: string): string {
    if (!iso) return '';
    const ms = Date.now() - new Date(iso).getTime();
    if (!Number.isFinite(ms) || ms < 0) return '';
    const d = Math.floor(ms / 86400000);
    if (d === 0) return 'วันนี้';
    if (d === 1) return 'เมื่อวาน';
    if (d < 30) return `${d}d ago`;
    const mo = Math.floor(d / 30);
    return `${mo}mo ago`;
  }
  function setField(node: HTMLElement, sel: string, v: string) {
    const el = node.querySelector(`[data-field="${sel}"]`);
    if (el) el.textContent = v;
  }
  function clearChildren(el: HTMLElement) {
    while (el.firstChild) el.removeChild(el.firstChild);
  }

  function fillCard(node: HTMLElement, lead: LeadUi) {
    node.setAttribute('data-lead-id', String(lead.lead_id || ''));
    setField(node, 'temp', tempEmoji(lead.temperature));
    setField(node, 'name', markName((lead.nickname || lead.full_name || '—').toString(), lead.after_hours_ok));
    setField(node, 'company', (lead.company_name || '').toString());
    const due = lead.next_action_due ? `ครบ ${new Date(lead.next_action_due).toLocaleDateString('th-TH')}` : '';
    const next = (lead.next_action || '').toString();
    setField(node, 'meta', [next, due].filter(Boolean).join(' · '));
    const touch = lead.last_touch_at ? `📞 last ${relAgo(lead.last_touch_at as string)}` : '';
    const reason = lead.deal_outcome === 'unqualified' || lead.deal_outcome === 'lost'
      ? (lead.close_reason ? `· ${lead.close_reason}` : '')
      : '';
    const pc = Number(lead.purchase_count) || 0;
    const ltv = pc > 0 ? `🔁 ซื้อ ${pc} ครั้ง · ฿${new Intl.NumberFormat('th-TH', { maximumFractionDigits: 0 }).format(Number(lead.lifetime_value_thb) || 0)}` : '';
    const sponsor = (lead.source || '').toString().toLowerCase().includes('sponsor') ? '🤝 sponsor' : '';
    setField(node, 'log', [sponsor, ltv, touch, reason].filter(Boolean).join('  '));
    setField(node, 'amount', fmtTHB(lead.package_price));
    setField(node, 'age', ageDays(lead.submitted_at));
    const badge = node.querySelector('[data-field="badge"]') as HTMLElement | null;
    const b = badgeFor(lead);
    if (badge) {
      badge.className = `badge badge-sm ${b.cls}`;
      badge.textContent = b.text;
    }
  }

  function renderRangeSummary() {
    const box = document.getElementById('lead-range-summary');
    const label = document.getElementById('lead-range-label');
    const stats = document.getElementById('lead-range-stats');
    if (!box || !label || !stats) return;
    const sum = rangeSummary();
    if (!sum) { box.classList.add('hidden'); return; }
    box.classList.remove('hidden');
    label.textContent = sum.label;
    clearChildren(stats);
    const cells: Array<[string, string]> = [
      ['lead เข้ามา', String(sum.count)],
      ['ปิดได้', String(sum.won)],
      ['ไม่ได้', String(sum.lost)],
      ['ยอดที่ปิดได้', fmtTHB(sum.valueThb)],
    ];
    for (const [k, v] of cells) {
      const wrap = document.createElement('span');
      wrap.className = 'flex items-baseline gap-1.5';
      const key = document.createElement('span');
      key.className = 'text-xs opacity-60';
      key.textContent = k;
      const val = document.createElement('span');
      val.className = 'font-display font-bold tabular-nums';
      val.textContent = v;
      wrap.append(key, val);
      stats.appendChild(wrap);
    }
  }

  function render() {
    const s = getState();
    const list = document.getElementById('lead-list');
    const empty = document.getElementById('lead-empty');
    const total = document.getElementById('lead-total');
    const tpl = document.getElementById('lead-card-tpl-list') as HTMLTemplateElement | null;
    const more = document.getElementById('lead-load-more');
    if (!list || !empty || !total || !tpl || !more) return;

    const rows = visibleLeads();
    // เลือกช่วงเวลาแล้ว ตัวหารต้องเป็น "จำนวนในช่วงนั้น" ไม่ใช่ยอด lead ทั้งฐาน
    // ไม่งั้นจะอ่านว่า "3 / 156" ทั้งที่เดือนนี้มีแค่ 3
    const denom = s.rangeLeads ? s.rangeLeads.length : s.total;
    total.textContent = s.rangeLoading ? 'กำลังโหลด…' : `${rows.length} / ${denom}`;
    renderRangeSummary();
    clearChildren(list as HTMLElement);

    if (!rows.length) {
      empty.classList.remove('hidden');
    } else {
      empty.classList.add('hidden');
      for (const lead of rows) {
        const frag = tpl.content.cloneNode(true) as DocumentFragment;
        const btn = frag.querySelector('button') as HTMLElement | null;
        if (!btn) continue;
        fillCard(btn, lead);
        btn.addEventListener('click', () => void openLead(String(lead.lead_id || '')));
        list.appendChild(frag);
      }
    }
    // ช่วงเวลาโหลดมาทั้งช่วงในทีเดียวอยู่แล้ว — ปุ่ม "โหลดเพิ่ม" ไม่มีความหมายและจะทำให้เข้าใจผิดว่ายังมีอีก
    more.classList.toggle('hidden', !!s.rangeLeads || s.leads.length >= s.total);

    document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((b) => {
      const active = b.getAttribute('data-chip') === s.filter;
      b.classList.toggle('btn-primary', active);
      b.classList.toggle('btn-outline', !active);
    });
  }

  render();
  subscribe(render);

  // Save scroll position when drawer opens; restore when it closes
  let savedScrollY = 0;
  on('drawer:open', () => { savedScrollY = window.scrollY; });
  on('drawer:close', () => { requestAnimationFrame(() => window.scrollTo({ top: savedScrollY, behavior: 'instant' })); });

  document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((b) => {
    b.addEventListener('click', () => setFilter(b.getAttribute('data-chip') as never));
  });
  document.getElementById('lead-search')?.addEventListener('input', (e) => {
    setSearch((e.target as HTMLInputElement).value);
  });
  document.getElementById('lead-sort')?.addEventListener('change', (e) => {
    setSort((e.target as HTMLSelectElement).value as never);
  });
  document.getElementById('lead-load-more')?.addEventListener('click', () => void loadMore());

  // ---- ช่วงเวลา ----
  const rangeSel = document.getElementById('lead-range') as HTMLSelectElement | null;
  const customBox = document.getElementById('lead-range-custom');
  const fromEl = document.getElementById('lead-range-from') as HTMLInputElement | null;
  const toEl = document.getElementById('lead-range-to') as HTMLInputElement | null;

  rangeSel?.addEventListener('change', () => {
    const key = rangeSel.value as RangeKey;
    customBox?.classList.toggle('hidden', key !== 'custom');
    customBox?.classList.toggle('flex', key === 'custom');
    if (key === 'custom') {
      // ตั้งค่าเริ่มต้นให้เป็นเดือนนี้ จะได้ไม่ต้องพิมพ์เองทั้งสองช่อง
      const now = new Date();
      const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      if (fromEl && !fromEl.value) fromEl.value = iso(new Date(now.getFullYear(), now.getMonth(), 1));
      if (toEl && !toEl.value) toEl.value = iso(now);
      return;   // รอกดปุ่ม "ดู" — ไม่ยิง query ระหว่างที่ยังเลือกวันไม่เสร็จ
    }
    void setRange(key);
  });

  document.getElementById('lead-range-apply')?.addEventListener('click', () => {
    if (!fromEl?.value || !toEl?.value) return;
    void setRange('custom', fromEl.value, toEl.value);
  });
</script>
