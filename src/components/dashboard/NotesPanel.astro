---
<section class="mb-3">
  <h3 class="text-xs uppercase tracking-wider opacity-70 mb-1">Notes</h3>
  <textarea id="notes-textarea" rows="4" class="textarea textarea-bordered w-full tap-44" placeholder="memo อิสระ..." autocomplete="off"></textarea>
  <div class="text-xs opacity-60 mt-1">กดปุ่ม "บันทึก" ด้านล่าง drawer เพื่อ save</div>
</section>

<script>
  import { subscribe, getState } from '../../scripts/dashboard/store';

  // Unsaved-edit guard: a focus check alone isn't enough — on mobile, tapping
  // anywhere to dismiss the keyboard blurs the textarea, and the next store
  // notify (e.g. background refresh after a save) would clobber the typed note
  // with the stale server value. Track dirty state per lead instead.
  let dirty = false;
  let currentLeadId = '';

  function apply() {
    const lead = getState().selectedLead;
    const ta = document.getElementById('notes-textarea') as HTMLTextAreaElement | null;
    if (!ta || !lead) return;
    const leadId = String(lead.lead_id || '');
    const serverVal = (lead.crm_notes as string) || '';
    if (leadId !== currentLeadId) {
      // Switched to another lead — show its saved notes fresh.
      currentLeadId = leadId;
      dirty = false;
      ta.value = serverVal;
      return;
    }
    if (ta.value === serverVal) { dirty = false; return; } // save round-trip confirmed
    if (document.activeElement === ta) return; // don't clobber while typing
    if (dirty) return; // never clobber unsaved edits
    ta.value = serverVal;
  }

  document.getElementById('notes-textarea')?.addEventListener('input', () => { dirty = true; });

  apply();
  subscribe(apply);
  // Save is triggered by the drawer's bottom "บันทึก" button — see LeadDetailDrawer.astro.
</script>
