---
---
<section id="kanban-section" class="mb-6">
  <div class="mb-3 flex items-center justify-between">
    <h2 class="font-display text-base font-semibold">Sales Pipeline</h2>
    <span class="text-xs opacity-50">scroll → เพื่อดูทุก stage</span>
  </div>

  <div class="overflow-x-auto pb-2 -mx-3 px-3">
    <div id="kanban-board" class="flex gap-3 min-w-max 3xl:min-w-0">
    </div>
  </div>
</section>

<script>
  import { subscribe, dashboardLeads, openLead, setLeadStatus, toast } from '../../scripts/dashboard/store';
  import type { LeadUi } from '../../scripts/dashboard/adapter';
  import { markName } from '../../scripts/after-hours';
  import { classifySource } from '../../scripts/dashboard/lead-source';

  // status = ค่าที่ส่งเข้า setLeadStatus (ตัวเดียวกับ dropdown "Pipeline Stage" ใน drawer)
  const STAGES: { key: string; label: string; color: string; status: string }[] = [
    { key: 'new',         label: 'New Lead',      color: 'var(--color-pun-cyan)',   status: 'New' },
    { key: 'discovery',   label: 'Discovery',     color: 'var(--color-warning)',    status: 'Discovery Call' },
    { key: 'site_visit',  label: 'Site Visit',    color: 'var(--color-info)',       status: 'Site Visit' },
    { key: 'proposal',    label: 'Proposal Sent', color: 'var(--color-pun-violet)', status: 'Proposal Sent' },
    { key: 'won',         label: 'Won ✓',         color: 'var(--color-success)',    status: 'won' },
    { key: 'lost',        label: 'Lost / Out',    color: 'var(--color-error)',      status: 'lost' },
  ];

  function stageOf(l: LeadUi): string {
    if (l.deal_outcome === 'won' || l.deal_outcome === 'repeat') return 'won';
    if (l.deal_outcome === 'lost' || l.deal_outcome === 'unqualified') return 'lost';
    const ps = (l.pipeline_status || '').toLowerCase().trim();
    // Sheet canonical (strategy/inbound_crm_setup.gs STATUS_OPTIONS) — Title Case stored,
    // lowercased here for case-insensitive matching.
    if (ps === 'proposal — won') return 'won';
    if (ps === 'proposal — lost' || ps === 'discovery — lost') return 'lost';
    if (ps === 'proposal sent' || ps === 'proposal — follow-up') return 'proposal';
    if (ps === 'site visit') return 'site_visit';
    if (ps === 'discovery call') return 'discovery';
    if (ps === 'new') return 'new';
    // Timestamp-based fallbacks for leads with no explicit stage set
    if (l.walkthrough_at) return 'site_visit';
    if (l.proposal_sent_at) return 'proposal';
    return 'new';
  }

  function fmtTHB(n: unknown): string {
    const v = Number(n) || 0;
    if (!v) return '';
    if (v >= 1000) return `฿${(v / 1000).toFixed(0)}K`;
    return `฿${v}`;
  }

  function tempDot(l: LeadUi): string {
    if (l.temperature === 'hot') return '🔥';
    if (l.temperature === 'warm') return '🌤';
    return '';
  }

  // <article> ไม่ใช่ <button> — Firefox ไม่ยิง dragstart บนปุ่ม
  function makeCard(lead: LeadUi, stageColor: string): HTMLElement {
    const id = String(lead.lead_id || '');
    const card = document.createElement('article');
    card.className = 'text-left w-full bg-base-100 border border-base-300 rounded-2xl p-3 hover:border-base-content/30 transition-colors cursor-grab active:cursor-grabbing select-none';
    card.draggable = true;
    card.dataset.lead = id;
    card.tabIndex = 0;
    card.setAttribute('role', 'button');
    card.title = 'กดเพื่อเปิด · ลากไปช่องอื่นเพื่อเปลี่ยน stage';

    const topRow = document.createElement('div');
    topRow.className = 'flex justify-between items-start mb-1 gap-1';
    const name = document.createElement('span');
    name.className = 'text-sm font-semibold leading-tight line-clamp-1';
    name.textContent = markName((lead.nickname || lead.full_name || '—').toString(), lead.after_hours_ok);
    const temp = document.createElement('span');
    temp.className = 'shrink-0 text-sm';
    temp.textContent = tempDot(lead);
    topRow.append(name, temp);

    const company = document.createElement('div');
    company.className = 'text-xs opacity-50 line-clamp-1 mb-2';
    company.textContent = (lead.company_name || '').toString();

    const bottomRow = document.createElement('div');
    bottomRow.className = 'flex items-center justify-between border-t border-base-300 pt-2 gap-1';
    // การ์ด kanban แคบ — ที่มาใส่เป็นไอคอนอย่างเดียว ชื่อเต็มอยู่ใน tooltip
    const left = document.createElement('span');
    left.className = 'flex items-center gap-1 min-w-0';
    const src = classifySource(lead);
    const srcIcon = document.createElement('span');
    srcIcon.className = 'text-xs shrink-0';
    srcIcon.textContent = src.icon;
    srcIcon.title = `ที่มา: ${src.label}${src.detail ? ` (${src.detail})` : ''}`;
    const industry = document.createElement('span');
    industry.className = 'text-xs opacity-50 line-clamp-1';
    industry.textContent = (lead.business_type || '').toString();
    left.append(srcIcon, industry);
    const amount = document.createElement('span');
    amount.className = 'text-xs font-semibold';
    amount.style.color = stageColor;
    amount.textContent = fmtTHB(lead.package_price);
    bottomRow.append(left, amount);

    card.append(topRow, company, bottomRow);
    card.addEventListener('click', () => void openLead(id));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); void openLead(id); }
    });
    return card;
  }

  function render() {
    const board = document.getElementById('kanban-board');
    if (!board) return;
    const leads = dashboardLeads();

    const groups: Record<string, LeadUi[]> = {};
    const totals: Record<string, number> = {};
    STAGES.forEach((s) => { groups[s.key] = []; totals[s.key] = 0; });
    for (const l of leads) {
      const s = stageOf(l);
      totals[s]++;
      if (groups[s].length < 4) groups[s].push(l);
    }

    board.replaceChildren();
    STAGES.forEach((stage) => {
      const col = document.createElement('div');
      col.className = 'kb-col w-56 3xl:w-0 3xl:min-w-56 3xl:grow bg-base-200 rounded-2xl p-3 flex flex-col gap-2 border border-base-300 transition-shadow';
      col.dataset.stage = stage.key;

      const header = document.createElement('div');
      header.className = 'flex items-center justify-between px-1 mb-1';
      const titleEl = document.createElement('span');
      titleEl.className = 'text-xs font-bold uppercase tracking-wide';
      titleEl.style.color = stage.color;
      titleEl.textContent = stage.label;
      const countEl = document.createElement('span');
      countEl.className = 'badge badge-xs border-0 bg-base-300 opacity-70';
      countEl.textContent = String(totals[stage.key]);
      header.append(titleEl, countEl);
      col.appendChild(header);

      if (!groups[stage.key].length) {
        const empty = document.createElement('p');
        empty.className = 'text-center text-xs opacity-30 py-4';
        empty.textContent = '—';
        col.appendChild(empty);
      } else {
        groups[stage.key].forEach((lead) => col.appendChild(makeCard(lead, stage.color)));
        if (totals[stage.key] > groups[stage.key].length) {
          const more = document.createElement('p');
          more.className = 'text-center text-xs opacity-40 pt-1';
          more.textContent = `+${totals[stage.key] - groups[stage.key].length} more`;
          col.appendChild(more);
        }
      }
      board.appendChild(col);
    });
  }

  // ── Drag-drop: การ์ด → คอลัมน์ ────────────────────────────────────────────
  // ทำแบบเดียวกับบอร์ด Content Center (fix 8ae5617): id เดินทางกับ dataTransfer +
  // ล้าง state ที่ dragend เสมอ + ไม่รับ drag ที่ไม่ได้เริ่มจากการ์ด + กันปล่อยรัว
  const DRAG_MIME = 'application/x-crm-lead';
  let dragId: string | null = null;
  let moving = false;
  const board = document.getElementById('kanban-board');
  const clearHint = () => board?.querySelectorAll('.kb-col')
    .forEach((c) => c.classList.remove('ring-2', 'ring-base-content/40'));

  board?.addEventListener('dragstart', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-lead]');
    dragId = card?.dataset.lead || null;
    if (!card || !dragId || !e.dataTransfer) return;
    card.classList.add('opacity-40');
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData(DRAG_MIME, dragId);
    e.dataTransfer.setData('text/plain', dragId);
  });
  board?.addEventListener('dragend', () => {
    dragId = null;
    board.querySelectorAll('[data-lead]').forEach((c) => c.classList.remove('opacity-40'));
    clearHint();
  });
  board?.addEventListener('dragover', (e) => {
    const col = (e.target as HTMLElement).closest<HTMLElement>('.kb-col');
    const mine = dragId || e.dataTransfer?.types.includes(DRAG_MIME);
    if (!col || !mine) return;
    e.preventDefault();
    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
    board.querySelectorAll('.kb-col').forEach((c) => {
      c.classList.toggle('ring-2', c === col);
      c.classList.toggle('ring-base-content/40', c === col);
    });
  });
  board?.addEventListener('drop', (e) => {
    const col = (e.target as HTMLElement).closest<HTMLElement>('.kb-col');
    const id = e.dataTransfer?.getData(DRAG_MIME) || dragId;
    clearHint();
    dragId = null;
    if (!col || !id) return;
    e.preventDefault();
    if (moving) return;
    const stage = STAGES.find((s) => s.key === col.dataset.stage);
    const lead = dashboardLeads().find((l) => String(l.lead_id || '') === id);
    if (!stage || !lead || stageOf(lead) === stage.key) return;

    moving = true;
    const card = board.querySelector<HTMLElement>(`[data-lead="${CSS.escape(id)}"]`);
    card?.classList.add('opacity-40', 'pointer-events-none');
    void (async () => {
      try {
        await setLeadStatus(id, stage.status);
        // Lost ต้องใส่เหตุผลใน drawer — เปิดให้เลยจะได้ไม่ลืม
        const saved = dashboardLeads().find((l) => String(l.lead_id || '') === id);
        if (stage.key === 'lost' && saved && stageOf(saved) === 'lost') {
          toast('ย้ายไป Lost แล้ว — เลือกเหตุผลใน drawer ได้เลย', 'info');
          void openLead(id);
        }
      } finally {
        moving = false;
        render();   // ถ้าบันทึกไม่ผ่าน การ์ดกลับที่เดิม ไม่ค้างจาง
      }
    })();
  });

  render();
  subscribe(render);
</script>
