---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  external?: boolean;
}
const { href, label, variant = 'primary', size = 'md', external = false } = Astro.props;
---

<a
  href={href}
  class:list={['cta-btn', `v-${variant}`, `s-${size}`]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  {label}
</a>

<style>
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Sarabun', sans-serif;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--pun-radius-btn);
    cursor: pointer;
    transition: opacity 0.15s ease, background 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }
  .cta-btn:hover { transform: translateY(-1px); }
  .cta-btn:active { transform: translateY(0); }

  .s-md { padding: 0.625rem 1.5rem;  font-size: 0.95rem; }
  .s-lg { padding: 0.875rem 2.25rem; font-size: 1.05rem; }

  /* Coral CTA — no glow */
  .v-primary {
    background: var(--pun-coral);
    color: #ffffff;
    border: none;
  }
  .v-primary:hover { opacity: 0.9; }

  /* Ghost — ink outline on paper */
  .v-ghost {
    background: transparent;
    color: var(--pun-navy);
    border: 1px solid var(--pun-ink);
  }
  .v-ghost:hover { background: var(--pun-surface-2); }
</style>
