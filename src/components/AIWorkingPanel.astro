---
// Paper "notebook" checklist — the human-touch reinterpretation of the
// AI status panel (editorial decision: ink checkmarks, not glowing badges).
---

<div class="notebook">
  <p class="notebook-title">สิ่งที่ AI ทำให้คุณวันนี้</p>
  <ul class="notebook-rows">
    <li><span class="ink-check">✓</span> คัดกรอง Lead เข้าใหม่</li>
    <li><span class="ink-check">✓</span> ส่ง Follow-up อัตโนมัติ</li>
    <li><span class="ink-check">✓</span> ร่าง Proposal ให้</li>
    <li><span class="ink-check">✓</span> สรุปยอดขายทุกเช้า</li>
  </ul>
</div>

<style>
  .notebook {
    width: 280px;
    max-width: 100%;
    background: #FCF9F2;
    border: 1px solid #C9C2B2;
    border-radius: 0.75rem;
    padding: 1.1rem 1.35rem;
    box-shadow: 2px 4px 0 rgba(30, 27, 22, 0.08);
    transform: rotate(1.3deg);
  }
  .notebook-title {
    font-family: 'Trirong', serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--pun-navy);
    margin: 0 0 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed #D8D1C0;
  }
  .notebook-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .notebook-rows li {
    display: flex;
    gap: 0.5rem;
    font-family: 'Sarabun', sans-serif;
    font-size: 0.82rem;
    color: rgba(30, 27, 22, 0.8);
  }
  .ink-check { color: var(--pun-coral); font-weight: 700; }
  @media (hover: none) { .notebook { transform: rotate(1deg); } }
</style>
