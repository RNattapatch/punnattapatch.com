---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../../data/site';
import type { ServiceOffer } from '../../data/service-offers';

interface Props {
  offer: ServiceOffer;
  image: ImageMetadata;
  featured?: boolean;
  priceLabel?: string;
  eagerImage?: boolean;
}

const { offer, image, featured = false, priceLabel, eagerImage = false } = Astro.props;
const isFeatured = featured && offer.code === 'T2';
const code = offer.code.toLowerCase();
const cardLocation = `${offer.kind}_card_${code}`;
const primaryIsLine = offer.primaryCtaKind === 'line';
---

<article
  id={`offer-${code}`}
  data-offer-code={offer.code}
  data-offer-kind={offer.kind}
  class:list={[
    'group flex min-w-0 flex-col overflow-hidden rounded-[1.5rem] border bg-surface shadow-[0_18px_40px_-28px_rgba(7,43,78,.35)]',
    isFeatured ? 'border-coral/50 ring-1 ring-coral/20 lg:col-span-2 lg:grid lg:grid-cols-[1.05fr_.95fr]' : 'border-sand-deep',
  ]}
>
  <figure class:list={['relative aspect-video overflow-hidden bg-navy', isFeatured && 'lg:aspect-auto lg:min-h-full']}>
    <Image
      src={image}
      alt={offer.imageAlt}
      width={1600}
      height={900}
      loading={eagerImage ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover"
    />
  </figure>

  <div class="flex min-w-0 flex-1 flex-col p-5 sm:p-7">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-navy px-3 py-1.5 text-xs font-bold text-white">{offer.formatLabel}</span>
      {isFeatured && <span class="rounded-full bg-coral px-3 py-1.5 text-xs font-bold text-white">แนะนำสำหรับทีมที่อยากเปลี่ยน Lead เป็นยอดขาย</span>}
    </div>
    <p class="mt-5 text-xs font-bold uppercase tracking-[0.16em] text-coral">{offer.outcomeLabel}</p>
    <h3 class="mt-2 font-display text-2xl font-bold leading-snug tracking-[-0.02em] text-navy">{offer.publicName}</h3>
    <p class="mt-2 font-semibold leading-6 text-navy/85">{offer.customerJob}</p>
    <p class="mt-3 leading-7 text-[#625C53]">{offer.description}</p>

    <ul class="mt-5 space-y-3 text-sm leading-6 text-[#4F4A43]">
      {offer.bullets.map((bullet) => (
        <li class="flex gap-3"><span aria-hidden="true" class="font-bold text-coral">✓</span><span>{bullet}</span></li>
      ))}
    </ul>

    <div class="mt-auto pt-6">
      {priceLabel && (
        <div class="border-t border-sand-deep pt-5">
          <p class="text-xs font-semibold text-muted">ราคาเริ่มต้นตามขอบเขตที่ระบุ</p>
          <p class="mt-1 font-display text-2xl font-bold tabular-nums text-coral">{priceLabel}</p>
        </div>
      )}

      <div class="mt-5 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        {primaryIsLine ? (
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            data-contact-cta
            data-cta-location={cardLocation}
            data-product-code={offer.code}
            data-cta-label={offer.primaryCtaLabel}
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#06C755] bg-[#06C755] px-5 font-bold text-white transition-colors hover:border-[#05A548] hover:bg-[#05A548] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#06C755]"
          >
            {offer.primaryCtaLabel}<span aria-hidden="true" class="ml-2">→</span>
          </a>
        ) : (
          <a
            href={offer.detailHref!}
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-navy bg-navy px-5 font-bold text-white transition-colors hover:border-coral hover:bg-coral focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy"
          >
            ดูรายละเอียดหลักสูตร<span aria-hidden="true" class="ml-2">→</span>
          </a>
        )}
        {!primaryIsLine && (
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            data-contact-cta
            data-cta-location={cardLocation}
            data-product-code={offer.code}
            data-cta-label="ให้ผมช่วยเลือกทาง LINE"
            class="inline-flex min-h-12 items-center justify-center rounded-full px-2 font-semibold text-navy underline decoration-coral/60 underline-offset-4 hover:text-coral focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral"
          >
            ให้ผมช่วยเลือกทาง LINE
          </a>
        )}
      </div>
    </div>
  </div>
</article>
