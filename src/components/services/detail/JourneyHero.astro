---
import type { ProductDetailPageData, ProductJourneyPresentation, PublicProofImage } from '../../../data/product-details/types';
import JourneyCTA from './JourneyCTA.astro';
import { FORM_CTA_LABEL, isFormFirst } from '../../../data/product-details/cta-policy';

interface Props { data: ProductDetailPageData; journey: ProductJourneyPresentation; name: string; price: string; duration: string; primaryLabel?: string; primaryIntent?: string; }
// T1–T4 book a service slot; a public ticket books a seat. Default keeps the in-house wording untouched.
const { data, journey, name, price, primaryLabel = isFormFirst(data.code) ? FORM_CTA_LABEL : 'จองคิวรับบริการ', primaryIntent = 'book_training' } = Astro.props;
const visual = data.hero.visual;
const visualImage = visual?.image;
const src = visualImage && 'publicSrc' in visualImage ? visualImage.publicSrc : visualImage?.src;
const width = visualImage && 'publicSrc' in visualImage ? (visualImage as PublicProofImage).width : visualImage?.width;
const height = visualImage && 'publicSrc' in visualImage ? (visualImage as PublicProofImage).height : visualImage?.height;
const sectionId = `${data.code.toLowerCase()}-hero-heading`;
// hero แบบ focus (2026-10-14 · creative-director + neuro gate): ใช้เมื่อหน้ามี headline ภาษาบ้านๆ
// ปัญหาเดิมที่ 216px: ตัวหนังสือขาว 6–7 ก้อนบนกรมท่า ไม่มีภาพคน ราคากับปุ่มสีเดียวกันแย่งกัน
// โครงใหม่: ภาพทีมจริงบนสุด → พาดหัว + ปากกาเน้น 1 วลี → ✗ ปัญหาตอนนี้ / ✓ ผลหลังเรียน → การ์ดขาว (ราคา + ปุ่มเดียว)
const focus = Boolean(data.hero.headline);
const hl = data.hero.headline ?? '';
const mark = data.hero.highlight && hl.includes(data.hero.highlight) ? data.hero.highlight : '';
const [hlBefore, hlAfter] = mark ? [hl.slice(0, hl.indexOf(mark)), hl.slice(hl.indexOf(mark) + mark.length)] : [hl, ''];
---

{focus ? (
<section data-t4-section={data.code === 'T4' ? 'hero' : undefined} data-journey-section="hero" data-detail-block="hero" data-hero-focus aria-labelledby={sectionId} class="relative isolate overflow-hidden bg-[#072b4e] text-white">
  <div class="mx-auto grid max-w-7xl lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-12 lg:px-5 lg:py-16">
    {visual && src && (
      <figure data-hero-activity class="relative lg:order-2 lg:overflow-hidden lg:rounded-[2rem] lg:border lg:border-white/15 lg:shadow-[0_24px_80px_rgba(0,0,0,.28)]">
        <img src={src} alt={visual.alt} width={width} height={height} loading="eager" fetchpriority="high" decoding="async" class="aspect-[2/1] w-full object-cover object-[center_62%] lg:aspect-[4/3]" />
        {/* ม่านไล่สีเฉพาะขอบล่าง ให้ภาพต่อกับพื้นกรมท่า · ห้ามเบลอภาพ (neuro gate · photo cover rule) */}
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#072b4e] to-transparent lg:hidden"></div>
        <p class="absolute left-4 top-4 rounded-full bg-white px-3 py-1 text-xs font-bold text-[#072b4e] shadow-sm">{data.hero.eyebrow}</p>
        <figcaption class="absolute bottom-3 right-4 rounded-full bg-black/45 px-2.5 py-0.5 text-[11px] font-semibold text-white/90">{visual.label}</figcaption>
      </figure>
    )}

    <div class="min-w-0 px-5 pb-8 pt-3 lg:order-1 lg:px-0 lg:pb-0 lg:pt-0">
      <h1 id={sectionId} class:list={['text-balance font-display font-bold leading-[1.25]', hl.length > 40 ? 'text-[1.85rem] sm:text-5xl' : 'text-[2.1rem] sm:text-5xl', 'lg:text-[3.6rem]']}>
        {hlBefore}{mark && <span data-hero-highlight class="text-[#ff7d8d]">{mark}</span>}{hlAfter}
        {data.hero.headlineTail && <span data-hero-headline-tail class="mt-2 block text-lg font-semibold leading-7 text-white/80 sm:text-2xl">{data.hero.headlineTail}</span>}
      </h1>

      {data.hero.pains && data.hero.pains.length > 0 && (
        <div data-hero-pains class="mt-4">
          {data.hero.painLabel && <p class="text-sm font-semibold text-white/70">{data.hero.painLabel}</p>}
          <ul class="mt-2 flex flex-wrap gap-2">
            {data.hero.pains.map((pain) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-sm font-semibold text-white"><span aria-hidden="true" class="font-bold text-[#ff677a]">✗</span>{pain}</li>
            ))}
          </ul>
        </div>
      )}

      {data.hero.outcome && (
        <p data-hero-outcome class="mt-3 flex items-start gap-2 text-[15px] font-semibold leading-6 text-white/90 sm:text-base">
          <span aria-hidden="true" class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-[#3ddc84] text-xs font-bold text-[#072b4e]">✓</span>
          <span>{data.hero.outcome}</span>
        </p>
      )}

      {/* การ์ดตัดสินใจ: พื้นขาวคือก้อนที่ต่างที่สุดบนจอ — ตาไปจบที่ราคา + ปุ่มเดียว · ราคาเป็นสีกรมท่า เก็บสี coral ไว้ให้ปุ่มกับปากกาเน้น */}
      <div data-hero-decision class="mt-5 rounded-2xl bg-white p-4 text-[#072b4e] shadow-[0_18px_50px_rgba(0,0,0,.28)] sm:p-6">
        <p data-hero-product-name class="text-sm font-semibold text-[#072b4e]/65">{name}</p>
        <div data-hero-price class="mt-1 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="font-display text-[2.1rem] font-bold leading-none tabular-nums sm:text-5xl">{price}</span>
          <span class="text-sm font-semibold text-[#072b4e]/70">{journey.heroMeta}</span>
        </div>
        <div class="mt-4">
          <JourneyCTA
            code={data.code}
            location="hero"
            keyword={data.cta.keyword}
            primary={primaryLabel}
            primaryIntent={primaryIntent}
            secondary={data.cta.heroSecondary ?? data.cta.secondary}
            secondaryIntent={data.cta.heroSecondaryIntent ?? data.cta.secondaryIntent}
          />
        </div>
        <p data-hero-next-step class="mt-3 text-xs leading-5 text-[#072b4e]/70 sm:text-sm sm:leading-6">{journey.capacityNote}</p>
      </div>
    </div>

    <div class="hidden gap-3 px-5 pb-12 sm:grid lg:col-span-2 lg:order-3 lg:grid-cols-3 lg:px-0 lg:pb-0">
      {data.hero.steps?.map((step) => (
        <article data-hero-step class="rounded-2xl border border-white/15 bg-white/[0.07] p-5 backdrop-blur-sm">
          <p class="text-xs font-bold uppercase tracking-[.16em] text-[#ff677a]">{step.label}</p>
          <h2 class="mt-2 font-bold text-white">{step.title}</h2>
          <p class="mt-2 text-sm leading-6 text-white/65">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
) : (
<section data-t4-section={data.code === 'T4' ? 'hero' : undefined} data-journey-section="hero" data-detail-block="hero" aria-labelledby={sectionId} class="relative isolate overflow-hidden bg-[#072b4e] text-white">
  <div aria-hidden="true" class="absolute inset-0 -z-10 opacity-25 [background-image:linear-gradient(rgba(255,255,255,.08)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.08)_1px,transparent_1px)] [background-size:48px_48px]"></div>
  <div aria-hidden="true" class="absolute -right-24 -top-32 -z-10 size-96 rounded-full bg-coral/20 blur-3xl"></div>
  <div class="mx-auto grid max-w-7xl gap-7 px-5 py-7 sm:py-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-12 lg:py-20">
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-[.23em] text-coral sm:text-xs">{data.hero.eyebrow}</p>
      <h1 id={sectionId} class="mt-3 text-balance font-display text-[2.35rem] font-bold leading-[1.1] sm:mt-5 sm:text-5xl lg:text-[4.25rem]">{data.hero.headline ?? name}</h1>
      <p class="mt-4 max-w-3xl text-balance text-xl font-bold leading-8 text-white sm:mt-6 sm:text-2xl sm:leading-9">{data.hero.customerJob}</p>
      <p class="mt-2 text-[15px] font-semibold leading-6 text-white/75 sm:mt-3 sm:text-base">{data.hero.supportingCopy[0]}</p>
      {data.hero.headline && <p data-hero-product-name class="mt-4 text-sm font-semibold text-white/70 sm:mt-6">{name}</p>}
      <div data-hero-price class:list={['flex flex-wrap items-baseline gap-x-3 gap-y-1', data.hero.headline ? 'mt-1' : 'mt-4 sm:mt-6']}>
        <span class="font-display text-4xl font-bold text-[#ff677a] sm:text-5xl">{price}</span>
        <span class="text-sm font-semibold text-white/75">{journey.heroMeta}</span>
      </div>
      <div class="mt-5 sm:mt-7">
        <JourneyCTA
          code={data.code}
          location="hero"
          keyword={data.cta.keyword}
          primary={primaryLabel}
          primaryIntent={primaryIntent}
          secondary={data.cta.heroSecondary ?? data.cta.secondary}
          secondaryIntent={data.cta.heroSecondaryIntent ?? data.cta.secondaryIntent}
          inverse
        />
      </div>
      <p class="mt-3 max-w-2xl text-xs leading-5 text-white/65 sm:text-sm sm:leading-6">{journey.capacityNote}</p>
      <div class="mt-6 hidden flex-wrap gap-2 sm:flex">
        {data.hero.badges.map((badge) => <span class="rounded-full border border-white/25 px-3 py-1.5 text-sm font-semibold text-white/80">{badge}</span>)}
      </div>
    </div>

    {visual && src && (
      <figure data-hero-activity class="overflow-hidden rounded-[1.5rem] border border-white/15 bg-white/10 shadow-[0_24px_80px_rgba(0,0,0,.28)] sm:rounded-[2rem]">
        <img src={src} alt={visual.alt} width={width} height={height} loading="eager" fetchpriority="high" decoding="async" class="aspect-[16/7] w-full object-cover object-[center_48%] sm:aspect-[4/3]" />
        <figcaption class="flex items-center justify-between gap-3 bg-white px-4 py-3 text-xs leading-5 text-navy sm:px-5 sm:text-sm">
          <span class="font-bold">{visual.label}</span>
          <span class="hidden text-right text-navy/65 sm:block">{visual.caption}</span>
        </figcaption>
      </figure>
    )}

    <div class="hidden gap-3 sm:grid lg:col-span-2 lg:grid-cols-3">
      {data.hero.steps?.map((step) => (
        <article data-hero-step class="rounded-2xl border border-white/15 bg-white/[0.07] p-5 backdrop-blur-sm">
          <p class="text-xs font-bold uppercase tracking-[.16em] text-[#ff677a]">{step.label}</p>
          <h2 class="mt-2 font-bold text-white">{step.title}</h2>
          <p class="mt-2 text-sm leading-6 text-white/65">{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
)}
