---
// S5 · วันติดตั้ง 45 นาที + 6 ด่านส่งมอบ + เงื่อนไขก่อนซื้อ
// spec: docs/superpowers/specs/2026-09-05-t2-system-section-design.md
import type { SystemHandoff } from '../../../data/product-details/types';

interface Props { data: SystemHandoff; }
const { data } = Astro.props;
// ภาพต้องมีป้ายกำกับ (label) เสมอ — ตาราง delta ถูกตัดตามคำสั่งคุณปัน 2026-09-05
const shot = data.shot?.label ? data.shot : undefined;
const shotSrc = shot ? ('publicSrc' in shot.image ? shot.image.publicSrc : shot.image.src) : '';
---

<section data-system-block="handoff" aria-labelledby="t2-system-handoff-heading" class="bg-[#ece6da] py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-5">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{data.eyebrow}</p>
    <h3 id="t2-system-handoff-heading" class="mt-3 max-w-3xl text-balance font-display text-2xl font-bold text-navy sm:text-4xl">{data.heading}</h3>
    <p class="mt-4 max-w-3xl leading-7 text-navy/70">{data.intro}</p>

    <div class="mt-9 grid gap-5 lg:grid-cols-[.85fr_1.15fr]">
      <div class="rounded-[1.75rem] bg-white p-6 sm:p-8">
        <h4 class="font-display text-xl font-bold text-navy">45 นาทีแรกในห้อง</h4>
        <ol class="mt-5 space-y-3">
          {data.install.map((row) => (
            <li data-install-row class="grid grid-cols-[5.5rem_1fr] items-start gap-3 border-b border-navy/10 pb-3 last:border-0 last:pb-0">
              <span class="font-display font-bold text-coral">{row.span}</span>
              <span class="text-sm leading-6 text-navy/80">{row.step}</span>
            </li>
          ))}
        </ol>
        <p class="mt-5 border-t border-navy/10 pt-4 text-sm leading-6 text-navy/70">{data.installNote}</p>
      </div>

      <div class="rounded-[1.75rem] bg-navy p-6 text-white sm:p-8">
        <h4 class="font-display text-xl font-bold">ระบบเดินทางถึงบริษัทเป็น 6 ด่าน</h4>
        <ol class="relative mt-6 space-y-5 before:absolute before:bottom-2 before:left-[.6rem] before:top-2 before:w-px before:bg-white/20">
          {data.stages.map((stage) => (
            <li data-handoff-stage class="relative grid gap-1 pl-8">
              <span aria-hidden="true" class="absolute left-0 top-1.5 size-[.85rem] rounded-full border-2 border-[#65d7f2] bg-navy"></span>
              <p class="flex flex-wrap items-baseline gap-x-3"><span class="font-display font-bold text-[#65d7f2]">{stage.code}</span><span class="text-xs font-semibold text-white/60">{stage.when}</span></p>
              <p class="text-sm leading-6 text-white/85">{stage.what}</p>
              <p class="text-xs leading-5 text-white/55">ผ่านเมื่อ: {stage.evidence}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    {shot && (
      <figure data-system-shot class="mt-6 overflow-hidden rounded-[1.5rem] border border-navy/10 bg-white">
        <div class="relative">
          <img src={shotSrc} alt={shot.alt} width={shot.image.width} height={shot.image.height} loading="lazy" decoding="async" class="aspect-[22/10] w-full object-cover" />
          <p data-shot-label class="absolute left-4 top-4 rounded-lg bg-navy/90 px-3 py-1.5 text-xs font-bold text-white">{shot.label}</p>
        </div>
        <figcaption class="p-5 sm:p-6">
          <p class="leading-7 text-navy/75">{shot.caption}</p>
        </figcaption>
      </figure>
    )}

    <aside data-system-prerequisites class="mt-6 rounded-[1.75rem] border-2 border-coral/40 bg-white p-6 sm:p-8">
      <h4 class="font-display text-xl font-bold text-navy">{data.prerequisites.heading}</h4>
      <ul class="mt-5 grid gap-3 md:grid-cols-2">
        {data.prerequisites.items.map((item) => (
          <li class="flex gap-3 rounded-xl bg-[#f4f1ea] p-4 text-sm leading-6 text-navy/85"><span aria-hidden="true" class="mt-0.5 font-bold text-coral">✓</span><span>{item}</span></li>
        ))}
      </ul>
    </aside>
  </div>
</section>
