---
import { resolveProductDetailCatalog } from '../../../data/product-details/catalog';
import { Image } from 'astro:assets';
import { LINE_QR_IMAGE } from '../../../data/service-offer-assets';
import type { ProductDetailPageData } from '../../../data/product-details/types';
import ProductHero from './ProductHero.astro';
import AuthoritySnapshot from './AuthoritySnapshot.astro';
import ProofWall from './ProofWall.astro';
import PainChecklist from './PainChecklist.astro';
import OfferBoundary from './OfferBoundary.astro';
import ReasonBlock from './ReasonBlock.astro';
import ScopeTimeline from './ScopeTimeline.astro';
import TakeHomeStack from './TakeHomeStack.astro';
import BonusCardStack from './BonusCardStack.astro';
import FitBlock from './FitBlock.astro';
import InstructorBio from './InstructorBio.astro';
import InvestmentBlock from './InvestmentBlock.astro';
import ProductFAQ from './ProductFAQ.astro';
import DetailLineCTA from './DetailLineCTA.astro';
import ClientLogoWall from './ClientLogoWall.astro';
import { CLIENT_LOGOS } from '../../../data/product-details/client-logos';
import DecisionCTA from './DecisionCTA.astro';
import ProofSystems from '../../proof/ProofSystems.astro';
import ProductChapterMap from './ProductChapterMap.astro';
import ProductChapterGate from './ProductChapterGate.astro';
import JourneyHero from './JourneyHero.astro';
import OfferStack from './OfferStack.astro';
import ProofGallery from './ProofGallery.astro';
import WhyNowBlock from './WhyNowBlock.astro';
import JourneyCurriculum from './JourneyCurriculum.astro';
import InstructorCard from './InstructorCard.astro';
import JourneyCTA from './JourneyCTA.astro';
import SpotlightModules from './SpotlightModules.astro';
import WhatsNewBlock from './WhatsNewBlock.astro';
import BonusValueStack from './BonusValueStack.astro';
import WhyMeGrid from './WhyMeGrid.astro';
import InstructorProfile from './InstructorProfile.astro';
import SystemShowcase from './SystemShowcase.astro';

interface Props { data: ProductDetailPageData; }
const { data } = Astro.props;
const catalog = resolveProductDetailCatalog(data.pricingKey);
const decisionCta = (location: 'after_proof' | 'after_scope' | 'after_fit') => data.decisionCtas?.find((cta) => cta.location === location);
const afterProofCta = decisionCta('after_proof');
const afterScopeCta = decisionCta('after_scope');
const afterFitCta = decisionCta('after_fit');
const scopeLineCta = data.cta.locations?.afterScope ?? { primary: data.cta.primary, primaryIntent: 'quote', secondary: data.cta.secondary, secondaryIntent: data.cta.secondaryIntent ?? 'lead_magnet' };
const investmentLineCta = data.cta.locations?.afterInvestment;
const finalLineCta = data.cta.locations?.final ?? { primary: data.cta.primary, primaryIntent: 'quote', secondary: data.cta.finalSecondary ?? data.cta.secondary, secondaryIntent: data.cta.finalSecondaryIntent ?? data.cta.secondaryIntent ?? 'lead_magnet' };
const chapters = data.chapters ?? [];
const isJourney = Boolean(data.journey);
// WEB-T2-SYSTEM-01: chapter "ระบบที่ทีมได้กลับไป" — flag ปิดอยู่จนกว่า Kit v1 ผ่าน Non-builder trial
const systemSection = data.systemSection?.enabled ? data.systemSection : undefined;
const offerCore = data.takeHome.slice(0, systemSection ? 5 : 4);
---

{isJourney && data.journey ? (
  <>
    <JourneyHero data={data} journey={data.journey} name={catalog.name} duration={catalog.duration} price={catalog.price} />

    <OfferStack code={data.code} keyword={data.cta.keyword} name={catalog.name} price={catalog.price} core={offerCore} bonuses={data.bonusCards?.items ?? []} values={data.bonusValues?.items} journey={data.journey} />

    <div data-t4-section={data.code === 'T4' ? 'logos' : undefined} data-journey-section="logos" data-detail-block="authority">
      <InstructorCard authority={data.authority} heading={data.sections?.authority?.heading ?? 'สอนจากประสบการณ์ขาย โค้ชทีม และสร้าง AI Workflow ใช้งานจริง'} compact />
      <ClientLogoWall items={data.clientLogos} />
    </div>

    <div data-journey-section="proof"><ProofGallery items={data.proof} testimonials={data.testimonials ?? []} heading={data.sections?.proof?.heading ?? 'ภาพจากห้องอบรมจริง'} intro={data.sections?.proof?.intro ?? ''} /></div>
    {afterProofCta && <section class="bg-[#f4f1ea] px-5 py-8 sm:py-10"><div class="mx-auto max-w-6xl"><JourneyCTA code={data.code} location="after_proof" keyword={data.cta.keyword} decision={afterProofCta} /></div></section>}

    {systemSection && <SystemShowcase data={systemSection} code={data.code} keyword={data.cta.keyword} part="proof" />}

    <WhyNowBlock code={data.code} items={data.pains} journey={data.journey} />
    {data.spotlight && <div data-journey-section="spotlight"><SpotlightModules data={data.spotlight} /></div>}

    <JourneyCurriculum code={data.code} items={data.scope} heading={data.sections?.scope?.heading ?? 'Choose → Map → Build → Guardrail → Adopt'} intro={data.sections?.scope?.intro ?? ''} journey={data.journey} />
    <section class="bg-[#fdfaf4] px-5 pb-14 sm:pb-20"><div class="mx-auto max-w-6xl">
      {afterScopeCta
        ? <JourneyCTA code={data.code} location="after_scope" keyword={data.cta.keyword} decision={afterScopeCta} />
        : <JourneyCTA code={data.code} location="after_scope" keyword={data.cta.keyword} primary={scopeLineCta.primary} primaryIntent={scopeLineCta.primaryIntent} secondary={scopeLineCta.secondary} secondaryIntent={scopeLineCta.secondaryIntent} />}
    </div></section>

    {systemSection && <SystemShowcase data={systemSection} code={data.code} keyword={data.cta.keyword} part="main" />}

    {data.whatsNew && <div data-journey-section="whats-new"><WhatsNewBlock data={data.whatsNew} /></div>}
    <div data-t4-section={data.code === 'T4' ? 'take-home' : undefined} data-journey-section="take-home" data-detail-block="take-home"><TakeHomeStack items={data.takeHome} {...data.sections?.takeHome} /></div>
    {data.bonusValues
      ? <div data-journey-section="bonus"><BonusValueStack data={data.bonusValues} price={catalog.price} /></div>
      : data.bonusCards?.enabled && <div data-journey-section="bonus"><BonusCardStack {...data.bonusCards} /></div>}
    {data.whyMe && <div data-journey-section="why-me"><WhyMeGrid data={data.whyMe} code={data.code} keyword={data.cta.keyword} price={catalog.price} amount={catalog.amount} bonusTotal={data.bonusValues?.items.reduce((sum, item) => sum + item.value, 0)} /></div>}

    <div data-t4-section={data.code === 'T4' ? 'fit' : undefined} data-journey-section="fit" data-detail-block="fit">
      <FitBlock fit={data.fit} notFit={data.notFit} heading={data.sections?.fit?.heading} relatedOffer={data.relatedOffer} />
      {afterFitCta && <section class="bg-navy px-5 pb-14 sm:pb-20"><div class="mx-auto max-w-6xl"><JourneyCTA code={data.code} location="after_fit" keyword={data.cta.keyword} decision={afterFitCta} /></div></section>}
    </div>

    {data.instructorProfile
      ? <div data-journey-section="instructor"><InstructorProfile data={data.instructorProfile} /></div>
      : <div data-t4-section={data.code === 'T4' ? 'instructor' : undefined} data-journey-section="instructor" data-detail-block="instructor"><InstructorCard authority={data.authority} paragraphs={data.bio} heading={data.sections?.bio?.heading ?? 'คนสอนคือคนที่สร้าง AI Workflow ใช้กับธุรกิจตัวเองทุกวัน'} /></div>}

    {systemSection && <SystemShowcase data={systemSection} code={data.code} keyword={data.cta.keyword} part="investment" />}

    <div data-t4-section={data.code === 'T4' ? 'investment' : undefined} data-journey-section="investment" data-detail-block="investment" class="bg-white pb-14 sm:pb-20">
      <InvestmentBlock name={catalog.name} price={catalog.price} amount={catalog.amount} regularPrice={catalog.regularPrice} eyebrow={data.sections?.investment?.eyebrow} {...data.investment} />
      <div class="mx-auto max-w-5xl px-5">
        <JourneyCTA code={data.code} location="after_investment" keyword={data.cta.keyword} primary={investmentLineCta?.primary ?? 'จองคิวรับบริการ'} primaryIntent={investmentLineCta?.primaryIntent ?? 'book_training'} secondary={investmentLineCta?.secondary ?? 'ทัก LINE เช็กคิวว่าง'} secondaryIntent={investmentLineCta?.secondaryIntent ?? 'availability'} />
      </div>
    </div>

    <div data-t4-section={data.code === 'T4' ? 'faq' : undefined} data-journey-section="faq" data-detail-block="faq"><ProductFAQ code={data.code} items={data.faq} /></div>

    <section data-t4-section={data.code === 'T4' ? 'final' : undefined} data-journey-section="final" data-detail-block="final-cta" data-cta-location="final" class="bg-navy py-14 text-white sm:py-20">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{data.journey.finalEyebrow}</p>
        <h2 class="mt-3 max-w-4xl text-balance font-display text-3xl font-bold sm:text-5xl">{data.sections?.final?.heading}</h2>
        <p class="mt-4 max-w-2xl leading-7 text-white/75">{data.sections?.final?.copy}</p>
        <div class="mt-7"><JourneyCTA code={data.code} location="final" keyword={data.cta.keyword} primary={finalLineCta.primary} primaryIntent={finalLineCta.primaryIntent} secondary={finalLineCta.secondary} secondaryIntent={finalLineCta.secondaryIntent} /></div>
        <a data-detail-chooser-link href="/services#offer-chooser" class="mt-5 inline-flex min-h-11 items-center font-semibold text-white underline decoration-coral decoration-2 underline-offset-4 transition-colors hover:text-coral focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-coral">ยังไม่แน่ใจ? กลับไปเลือกจากอาการของทีม</a>
        <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
          <figure data-final-line-qr class="hidden rounded-2xl bg-white p-2 sm:block"><Image src={LINE_QR_IMAGE} alt="QR code สำหรับเพิ่มเพื่อน LINE ของปัน ณัฐพัชร์" width={120} height={120} class="size-30" /></figure>
          <div>
            <p data-final-line-scan class="hidden text-sm leading-6 text-white/75 sm:block">{data.cta.finalCaption}</p>
            <p data-final-line-mobile-instruction class="text-sm leading-6 text-white/75 sm:hidden">{data.cta.finalMobileInstruction}</p>
            <p class="mt-2 max-w-xl text-sm leading-6 text-white/60">{data.cta.finalMicrocopy}</p>
          </div>
        </div>
      </div>
    </section>
  </>
) : (
  <>
    <div data-detail-block="hero"><ProductHero data={data} name={catalog.name} duration={catalog.duration} price={catalog.price} /></div>
    {chapters.length > 0 && <ProductChapterMap chapters={chapters} />}
    {chapters[0] && <ProductChapterGate chapter={chapters[0]} />}
    <div data-detail-block="authority"><AuthoritySnapshot items={data.authority} {...data.sections?.authority} /></div>
    <div data-detail-block="proof"><ProofWall items={data.proof} testimonials={data.testimonials} {...data.sections?.proof} /></div>
    {data.code === 'C1' && <div data-detail-block="consult-systems"><ProofSystems context="consult" /></div>}
    {afterProofCta && <DecisionCTA code={data.code} keyword={data.cta.keyword} cta={afterProofCta} />}
    {chapters[1] && <ProductChapterGate chapter={chapters[1]} />}
    <div data-detail-block="pain"><PainChecklist items={data.pains} {...data.sections?.pain} /></div>
    <div data-detail-block="boundary"><OfferBoundary {...data.boundary} /></div>
    <div data-detail-block="reasons"><ReasonBlock items={data.reasons} analogy={data.analogy} {...data.sections?.reasons} /></div>
    {chapters[2] && <ProductChapterGate chapter={chapters[2]} />}
    <div data-detail-block="scope"><ScopeTimeline items={data.scope} chooser={data.symptomChooser} supportDuration={catalog.duration} {...data.sections?.scope} /></div>
    {afterScopeCta
      ? <DecisionCTA code={data.code} keyword={data.cta.keyword} cta={afterScopeCta} />
      : <section class="mx-auto max-w-6xl px-5 pb-14 sm:pb-20">{data.sections?.scope?.ctaHeading && <h2 class="mb-6 max-w-3xl font-display text-2xl font-bold text-navy sm:text-3xl">{data.sections.scope.ctaHeading}</h2>}<DetailLineCTA code={data.code} location="after_scope" keyword={data.cta.keyword} {...scopeLineCta} /></section>}
    <div data-detail-block="take-home"><TakeHomeStack items={data.takeHome} {...data.sections?.takeHome} /></div>
    {data.bonusCards?.enabled && <BonusCardStack {...data.bonusCards} />}
    <!-- ใต้ Offer: ใครสอน + เคยทำกับใครมาแล้ว (คุณปันสั่ง 2026-09-02 หลังคู่แข่งเริ่มยิงแอดชนตรงๆ) · T4 journey มีของตัวเองด้านบน -->
    <div data-detail-block="instructor"><InstructorBio paragraphs={data.bio} heading={data.sections?.bio?.heading} eyebrow={data.sections?.bio?.eyebrow} /></div>
    <ClientLogoWall items={data.clientLogos ?? CLIENT_LOGOS} />
    {chapters[3] && <ProductChapterGate chapter={chapters[3]} />}
    <div data-detail-block="fit"><FitBlock fit={data.fit} notFit={data.notFit} heading={data.sections?.fit?.heading} relatedOffer={data.relatedOffer} /></div>
    {afterFitCta && <DecisionCTA code={data.code} keyword={data.cta.keyword} cta={afterFitCta} />}
    <div data-detail-block="investment"><InvestmentBlock name={catalog.name} price={catalog.price} amount={catalog.amount} regularPrice={catalog.regularPrice} eyebrow={data.sections?.investment?.eyebrow} {...data.investment} /></div>
    {investmentLineCta && <section data-detail-block="investment-cta" class="mx-auto max-w-5xl px-5 pb-14 sm:pb-20"><DetailLineCTA code={data.code} location="after_investment" keyword={data.cta.keyword} {...investmentLineCta} /></section>}
    <div data-detail-block="faq"><ProductFAQ code={data.code} items={data.faq} /></div>
    <section data-detail-block="final-cta" class="bg-navy py-14 text-white sm:py-20"><div class="mx-auto max-w-6xl px-5"><h2 class="font-display text-3xl font-bold sm:text-4xl">{data.sections?.final?.heading ?? 'อยากเช็กว่าหน้านี้เหมาะกับโจทย์ทีมคุณไหม?'}</h2><p class="mt-4 max-w-2xl leading-7 text-white/80">{data.sections?.final?.copy ?? `ทัก LINE พร้อม keyword ${data.cta.keyword} แล้วเล่าโจทย์ที่ทีมกำลังติดอยู่ได้เลยครับ`}</p><div class="mt-7"><DetailLineCTA code={data.code} location="final" keyword={data.cta.keyword} {...finalLineCta} inverse /></div><a data-detail-chooser-link href="/services#offer-chooser" class="mt-5 inline-flex min-h-11 items-center font-semibold text-white underline decoration-coral decoration-2 underline-offset-4 transition-colors hover:text-coral focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-coral">ยังไม่แน่ใจ? กลับไปเลือกจากอาการของทีม</a>{data.cta.finalCaption && <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center"><figure data-final-line-qr class="hidden rounded-2xl bg-white p-2 sm:block"><Image src={LINE_QR_IMAGE} alt="QR code สำหรับเพิ่มเพื่อน LINE ของปัน ณัฐพัชร์" width={120} height={120} class="size-30" /></figure><p data-final-line-scan class="hidden text-sm leading-6 text-white/75 sm:block">{data.cta.finalCaption}</p><p data-final-line-mobile-instruction class="text-sm leading-6 text-white/75 sm:hidden">{data.cta.finalMobileInstruction ?? `ทัก LINE แล้วพิมพ์คำว่า “${data.cta.keyword}” พร้อมจำนวนทีม`}</p></div>}{data.cta.finalMicrocopy && <p class="mt-2 text-sm leading-6 text-white/75">{data.cta.finalMicrocopy}</p>}</div></section>
  </>
)}
