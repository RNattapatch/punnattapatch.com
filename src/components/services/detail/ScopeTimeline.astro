---
import type { ScopeItem, SymptomChooser } from '../../../data/product-details/types';
interface Props { items: ScopeItem[]; heading?: string; intro?: string; chooser?: SymptomChooser; }
const { items, heading = 'สิ่งที่ทีมจะทำและถือกลับไป', intro, chooser } = Astro.props;
---
<section aria-labelledby="scope-heading" class="py-14 sm:py-20"><div class="mx-auto max-w-6xl px-5"><p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Scope</p><h2 id="scope-heading" class="mt-3 font-display text-3xl font-bold text-navy sm:text-4xl">{heading}</h2>{intro && <p class="mt-4 max-w-3xl leading-7 text-navy/80">{intro}</p>}{chooser && <aside data-symptom-chooser class="mt-7 rounded-3xl border border-navy/10 bg-[#f4f1ea] p-5 sm:p-6"><h3 class="font-bold text-navy">{chooser.heading}</h3>{chooser.intro && <p class="mt-2 max-w-3xl leading-7 text-navy/75">{chooser.intro}</p>}<div class="mt-4 flex flex-wrap gap-3">{chooser.actions.map((action) => <a data-track-chooser href={`#${action.targetId}`} class="rounded-full border border-navy/15 bg-white px-4 py-2 text-sm font-semibold text-navy transition hover:border-coral hover:text-coral focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-coral">{action.label}</a>)}</div></aside>}<ol class="mt-8 grid gap-5">{items.map((item) => <li id={item.id} tabindex={item.id ? '-1' : undefined} data-scope-item data-primary-outcome-track={item.id ? '' : undefined} class="scroll-mt-24 grid gap-4 rounded-3xl border border-navy/10 p-6 outline-none transition focus:border-coral focus:ring-4 focus:ring-coral/20 md:grid-cols-[8rem_1fr_1fr]"><p class="font-bold text-coral">{item.label}</p><div><h3 class="font-bold text-navy">{item.title}</h3>{item.learn && <p class="mt-2 text-sm text-navy/70">{item.learnLabel ?? 'เรียน'}: {item.learn}</p>}<p class="mt-2 leading-7 text-navy/80">{item.actionLabel ?? 'ลงมือ'}: {item.action}</p></div><p class="rounded-2xl bg-[#f4f1ea] p-4 leading-7 text-navy">{item.outputLabel ?? 'Output'}: {item.output}</p></li>)}</ol></div></section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-track-chooser]').forEach((action) => {
    action.addEventListener('click', (event) => {
      const targetId = action.getAttribute('href')?.slice(1);
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;
      event.preventDefault();
      history.pushState(null, '', `#${targetId}`);
      target.scrollIntoView({ block: 'start' });
      target.focus({ preventScroll: true });
    });
  });
</script>
