---
interface Props { items: string[]; heading?: string; close?: string; }
const { items, heading = 'สิ่งที่ทีมถือกลับไป', close } = Astro.props;
---
<section aria-labelledby="take-home-heading" class="bg-[#f4f1ea] py-14 sm:py-20"><div class="mx-auto max-w-5xl px-5"><h2 id="take-home-heading" class="font-display text-3xl font-bold text-navy sm:text-4xl">{heading}</h2><div class="mt-7 grid gap-4 md:grid-cols-3">{items.map((item) => { const isLine = item.startsWith('line::'); const plain = isLine ? item.slice('line::'.length) : item; const [title, body] = plain.includes('||') ? plain.split('||') : [plain, '']; return <p class:list={['rounded-2xl bg-white p-5 font-semibold leading-7 text-navy shadow-sm', isLine && 'border-l-4 border-[#06c755]']}><span class="block">{title}</span>{body && <span class="mt-1 block text-sm font-medium leading-6 text-navy/75">{body}</span>}</p>; })}</div>{close && <p class="mt-6 leading-7 text-navy/80">{close}</p>}</div></section>
