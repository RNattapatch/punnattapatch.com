---
import { Image } from 'astro:assets';
import { OFFER_ASSET_BY_CODE } from '../../../data/service-offer-assets';
import type { ProductDetailPageData, PublicProofImage } from '../../../data/product-details/types';
import DetailLineCTA from './DetailLineCTA.astro';

interface Props { data: ProductDetailPageData; name: string; duration: string; }
const { data, name, duration } = Astro.props;
const image = OFFER_ASSET_BY_CODE[data.code];
const visual = data.hero.visual;
const isPublicImage = (candidate: NonNullable<ProductDetailPageData['hero']['visual']>['image']): candidate is PublicProofImage => 'publicSrc' in candidate;
const visualClass = visual?.fit === 'contain' ? 'h-auto w-full bg-white object-contain' : 'aspect-[4/3] w-full object-cover';
---

<section class="bg-navy py-12 text-white sm:py-18">
  <div class="mx-auto grid max-w-6xl gap-9 px-5 lg:grid-cols-[1.1fr_.9fr] lg:items-center">
    <div>
      <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{data.hero.eyebrow}</p>
      <h1 class="mt-4 text-balance font-display text-4xl font-bold leading-tight sm:text-5xl">{name}</h1>
      <p class="mt-5 text-pretty text-xl font-semibold leading-relaxed text-white sm:text-2xl">{data.hero.customerJob}</p>
      {data.hero.steps?.length ? (
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {data.hero.steps.map((step, index) => (
            <article data-hero-step class:list={["rounded-2xl border border-white/15 bg-white/[0.07] p-4", index === 2 && 'sm:col-span-2']}>
              <p class="text-[11px] font-bold uppercase tracking-[.16em] text-coral">{step.label}</p>
              <p class="mt-1 font-semibold leading-6 text-white">{step.title}</p>
              <p class="mt-1 text-sm leading-6 text-white/75">{step.body}</p>
            </article>
          ))}
        </div>
      ) : data.hero.supportingCopy.map((copy) => <p class="mt-4 max-w-2xl leading-7 text-white/80">{copy}</p>)}
      <div class="mt-6 flex flex-wrap gap-2">{[duration, ...data.hero.badges].map((badge) => <span class="rounded-full border border-white/25 px-3 py-1 text-sm font-semibold text-white/90">{badge}</span>)}</div>
      <div class="mt-8">
        <DetailLineCTA
          code={data.code}
          location="hero"
          primary={data.cta.primary}
          secondary={data.cta.heroSecondary ?? data.cta.secondary}
          secondaryIntent={data.cta.heroSecondaryIntent ?? data.cta.secondaryIntent}
          keyword={data.cta.keyword}
          inverse
        />
      </div>
      {data.hero.microcopy && <p class="mt-4 max-w-2xl text-sm leading-6 text-white/70">{data.hero.microcopy}</p>}
    </div>
    {visual ? (
      <figure data-hero-activity class="relative overflow-hidden rounded-3xl border border-white/15 bg-white/5 shadow-2xl">
        {isPublicImage(visual.image)
          ? <img src={visual.image.publicSrc} alt={visual.alt} width={visual.image.width} height={visual.image.height} loading="eager" fetchpriority="high" class={visualClass} />
          : <Image src={visual.image} alt={visual.alt} width={visual.image.width} height={visual.image.height} loading="eager" fetchpriority="high" class={visualClass} />}
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy via-navy/75 to-transparent px-5 pb-5 pt-16">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-coral">{visual.label}</p>
          <figcaption class="mt-2 font-semibold leading-6 text-white">{visual.caption}</figcaption>
        </div>
      </figure>
    ) : <Image src={image} alt={name} width={image.width} height={image.height} loading="eager" fetchpriority="high" class="w-full rounded-3xl border border-white/15 shadow-2xl" />}
  </div>
</section>
