---
// C1 Offer ใต้ hero ทันที (ปันสั่ง 2026-09-30: คนไม่ต้องเลื่อนนานกว่าจะเห็นข้อเสนอ)
// แทน InvestmentBlock ตัวล่าง — ราคา · ระยะเวลา · ของที่ได้ · เงื่อนไข · CTA อยู่ในบล็อกเดียว
// กติกา price-never-last-line: ราคาอยู่กลางบล็อก มีของที่ได้ + ขั้นถัดไป + ปุ่มตามหลัง
import type { ProductDetailPageData } from '../../../data/product-details/types';
import DetailLineCTA from './DetailLineCTA.astro';
import ContentUpdateRibbon from './ContentUpdateRibbon.astro';

interface Props { data: ProductDetailPageData; name: string; price: string; duration: string; }
const { data, name, price, duration } = Astro.props;
const copy = data.leakHero!;
const cta = data.cta.locations?.afterInvestment ?? { primary: data.cta.primary, primaryIntent: 'consult_booking', secondary: data.cta.secondary, secondaryIntent: 'track_selection' };
---

<section data-detail-block="investment" aria-labelledby="c1-offer-heading" class="bg-[#f7f1e7] px-5 py-12 sm:py-16">
  <div class="relative mx-auto grid max-w-6xl overflow-hidden rounded-[2rem] border border-navy/10 bg-white shadow-[0_30px_90px_rgba(7,43,78,.10)] lg:grid-cols-[.8fr_1.2fr]">
    <div class="bg-[#fff4ec] p-7 pt-24 sm:p-10 sm:pt-24 lg:pt-10">
      <ContentUpdateRibbon />
      <p class="text-xs font-bold uppercase tracking-[.2em] text-[#c43245]">{copy.offerEyebrow}</p>
      <h2 id="c1-offer-heading" class="mt-3 text-balance font-display text-3xl font-bold leading-tight text-navy sm:text-4xl">{name}</h2>
      <p class="mt-5 font-display text-5xl font-bold text-[#c43245]">{price}</p>
      <p class="mt-2 font-semibold text-navy/75">{duration}</p>
      <p class="mt-5 text-sm leading-6 text-navy/70">{data.investment.terms}</p>
      <p class="mt-2 text-sm leading-6 text-navy/70">{data.investment.scarcity}</p>
    </div>
    <div class="p-7 sm:p-10">
      <h3 class="font-display text-2xl font-bold text-navy">{copy.offerHeading}</h3>
      <ul class="mt-5 space-y-3">
        {data.investment.included.map((item) => <li class="flex gap-3 leading-7 text-navy/85"><span aria-hidden="true" class="font-bold text-[#c43245]">✓</span><span>{item}</span></li>)}
      </ul>
      <p class="mt-6 rounded-2xl bg-[#f4f1ea] px-4 py-3 leading-7 text-navy/80">{copy.offerNext}</p>
      <div class="mt-7">
        <DetailLineCTA code={data.code} location="after_investment" keyword={data.cta.keyword} {...cta} />
      </div>
    </div>
  </div>
</section>
