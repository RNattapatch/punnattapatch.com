---
import type { ProductInstructorProfile } from '../../../data/product-details/types';
interface Props { data: ProductInstructorProfile; }
const { data } = Astro.props;
---

<section data-t4-section="instructor" data-detail-block="instructor" aria-labelledby="t4-instructor-heading" class="bg-[#ece6da] py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{data.eyebrow}</p>
    <h2 id="t4-instructor-heading" class="mt-3 max-w-4xl text-balance font-display text-3xl font-bold text-navy sm:text-5xl">{data.heading}</h2>
    <p class="mt-4 max-w-3xl leading-7 text-navy/75">{data.intro}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="บทบาท">
      {data.chips.map((chip) => <li class="rounded-full bg-white px-4 py-1.5 text-sm font-bold text-navy">{chip}</li>)}
    </ul>
    <div class="mt-10 grid gap-8 md:grid-cols-[320px_1fr]">
      <div>
        <figure class="overflow-hidden rounded-[1.5rem] border-t-8 border-coral bg-white">
          <img src={data.image.publicSrc} width={data.image.width} height={data.image.height} alt={data.imageAlt} loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
        </figure>
        <p class="mt-5 text-center font-display text-2xl font-bold text-navy">{data.name}</p>
        <p class="text-center text-sm text-navy/60">{data.handle}</p>
        <div class="mt-5 rounded-[1.25rem] bg-white p-5">
          <p class="text-[11px] font-bold uppercase tracking-[.16em] text-coral">Credentials</p>
          <ul data-instructor-credentials class="mt-3 space-y-2.5 text-sm leading-6 text-navy/85">
            {data.credentials.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="mt-0.5 font-bold text-[#05a648]">✓</span><span>{item}</span></li>)}
          </ul>
        </div>
      </div>
      <div>
        <div class="grid gap-4 sm:grid-cols-2">
          {data.angles.map((angle) => (
            <article data-instructor-angle class="rounded-[1.5rem] border border-navy/10 bg-white p-6">
              <span aria-hidden="true" class="text-2xl">{angle.icon}</span>
              <h3 class="mt-3 text-lg font-bold text-navy">{angle.title}</h3>
              <p class="mt-2 text-sm leading-6 text-navy/75">{angle.body}</p>
            </article>
          ))}
        </div>
        <blockquote class="mt-5 rounded-[1.5rem] bg-[#00162f] p-7 text-white">
          <p class="font-display text-xl font-bold leading-relaxed">“{data.quote}”</p>
          <footer class="mt-3 text-sm text-[#65d7f2]">— {data.name}</footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>
