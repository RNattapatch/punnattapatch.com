---
import type { ProductSpotlight } from '../../../data/product-details/types';
interface Props { data: ProductSpotlight; }
const { data } = Astro.props;
---

<section data-t4-section="spotlight" aria-labelledby="t4-spotlight-heading" class="relative overflow-hidden bg-[#00162f] py-14 text-white sm:py-20">
  <div aria-hidden="true" class="absolute inset-0 opacity-[.07] [background-image:linear-gradient(rgba(255,255,255,.6)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.6)_1px,transparent_1px)] [background-size:48px_48px]"></div>
  <div class="relative mx-auto max-w-6xl px-5">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-[#65d7f2]">{data.eyebrow}</p>
    <h2 id="t4-spotlight-heading" class="mt-3 max-w-4xl text-balance font-display text-3xl font-bold sm:text-5xl">{data.heading}</h2>
    <p class="mt-4 max-w-3xl leading-7 text-white/75">{data.intro}</p>
    <div class="mt-9 grid gap-5 md:grid-cols-2">
      {data.modules.map((module) => (
        <article data-spotlight-module class="relative overflow-hidden rounded-[1.75rem] border border-[#65d7f2]/25 bg-navy p-7 sm:p-9">
          <span aria-hidden="true" class="absolute -right-3 -top-6 font-display text-[9rem] font-bold leading-none text-white/[0.04]">{module.number}</span>
          <div class="relative">
            <p class="flex flex-wrap items-center gap-2"><span class="text-xs font-bold uppercase tracking-[.18em] text-[#65d7f2]">Module {module.number}</span><span class="rounded-full bg-[#65d7f2] px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-[.12em] text-[#00162f]">{module.tag}</span></p>
            <h3 class="mt-3 font-display text-2xl font-bold leading-snug sm:text-[1.65rem]">{module.title}</h3>
            <p class="mt-2 font-semibold leading-6 text-[#65d7f2]">{module.question}</p>
            <ul class="mt-5 space-y-2.5 border-t border-white/10 pt-5 text-sm leading-6 text-white/90">
              {module.points.map((point) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] size-1.5 shrink-0 rounded-full bg-[#65d7f2]"></span><span>{point}</span></li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
    {data.note && <p class="mt-6 text-sm leading-6 text-white/60">{data.note}</p>}
  </div>
</section>
