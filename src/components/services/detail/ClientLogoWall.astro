---
import type { ClientLogo } from '../../../data/product-details/types';

interface Props { items?: ClientLogo[]; }

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby="client-logo-heading" class="border-y border-navy/10 bg-white py-9 sm:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Organisations</p>
      <h2 id="client-logo-heading" class="mt-2 font-display text-2xl font-bold text-navy sm:text-3xl">องค์กรที่เคยร่วมงานกับปัน</h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-navy/70">หลักฐานระดับองค์กรของงาน Training, Sales และ AI ที่ปันเคยทำร่วมด้วย ไม่ได้หมายความว่าแต่ละองค์กรเป็นผู้ซื้อคอร์สนี้</p>
      <div class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-9">
        {items.map((item) => (
          <figure data-client-logo class="flex aspect-[4/3] items-center justify-center rounded-2xl border border-navy/10 bg-white p-3">
            <img src={item.src} alt={item.alt} width="180" height="120" loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
