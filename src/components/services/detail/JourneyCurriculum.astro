---
import type { ProductDetailCode, ProductJourneyPresentation, ScopeItem } from '../../../data/product-details/types';

interface Props { code: ProductDetailCode; items: ScopeItem[]; heading: string; intro: string; journey: ProductJourneyPresentation; }
const { code, items, heading, intro, journey } = Astro.props;
const media = journey.curriculum.media;
const headingId = `${code.toLowerCase()}-curriculum-heading`;
---

<section data-t4-section={code === 'T4' ? 'curriculum' : undefined} data-journey-section="curriculum" data-detail-block="scope" aria-labelledby={headingId} class="bg-[#fdfaf4] py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{journey.curriculum.eyebrow}</p>
    <h2 id={headingId} class="mt-3 max-w-4xl text-balance font-display text-3xl font-bold text-navy sm:text-5xl">{heading}</h2>
    <p class="mt-4 max-w-3xl leading-7 text-navy/70">{intro}</p>

    <ol class="relative mt-10 space-y-5 before:absolute before:bottom-8 before:left-[1.45rem] before:top-8 before:w-px before:bg-coral/30 sm:before:left-[2.1rem]">
      {items.map((item, index) => (
        <>
          <li data-curriculum-step data-step={item.id} class="relative grid gap-5 rounded-[1.5rem] border border-navy/10 bg-white p-5 shadow-sm sm:grid-cols-[4.25rem_1fr] sm:p-7">
            <div class="relative z-10 flex size-12 items-center justify-center rounded-full bg-coral font-display text-xl font-bold text-white shadow-[0_0_0_8px_#fdfaf4] sm:size-16 sm:text-2xl">{index + 1}</div>
            <div>
              <p class="text-xs font-bold uppercase tracking-[.18em] text-coral">{item.label}</p>
              <h3 class="mt-2 font-display text-2xl font-bold text-navy sm:text-3xl">{item.title}</h3>
              <div class="mt-5 grid gap-3 lg:grid-cols-3">
                <div class="rounded-xl bg-[#f4f1ea] p-4"><p class="text-xs font-bold text-coral">เข้าใจอะไร</p><p class="mt-2 text-sm leading-6 text-navy/75">{item.learn}</p></div>
                <div class="rounded-xl bg-[#eef6f8] p-4"><p class="text-xs font-bold text-[#087a91]">ลงมือทำ</p><p class="mt-2 text-sm leading-6 text-navy/75">{item.action}</p></div>
                <div class="rounded-xl bg-navy p-4 text-white"><p class="text-xs font-bold text-[#ff677a]">ได้อะไรกลับไป</p><p data-curriculum-output class="mt-2 text-sm font-semibold leading-6 text-white/85">{item.output}</p></div>
              </div>
            </div>
          </li>
          {media && index === media.afterStep && (
            <figure class="ml-0 overflow-hidden rounded-[1.5rem] border border-navy/10 bg-white shadow-sm sm:ml-[5.5rem] sm:grid sm:grid-cols-[1.15fr_.85fr] sm:items-center">
              <img src={media.image.publicSrc} alt={media.alt} width={media.image.width} height={media.image.height} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
              <figcaption class="p-5 sm:p-6">
                <p class="text-xs font-bold uppercase tracking-[.16em] text-coral">{media.eyebrow}</p>
                <p class="mt-2 font-display text-xl font-bold text-navy">{media.heading}</p>
                <p class="mt-3 text-sm leading-6 text-navy/65">{media.copy}</p>
              </figcaption>
            </figure>
          )}
        </>
      ))}
    </ol>
  </div>
</section>
