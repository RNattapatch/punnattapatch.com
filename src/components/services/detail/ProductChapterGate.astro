---
import type { ProductDetailChapter } from '../../../data/product-details/types';

interface Props {
  chapter: ProductDetailChapter;
}

const { chapter } = Astro.props;
const surface = chapter.tone === 'sand' ? 'bg-[#e8dfd0]' : 'bg-[#f7f3ea]';
---

<section
  id={`chapter-${chapter.id}`}
  data-product-chapter
  data-chapter-number={chapter.number}
  data-chapter-tone={chapter.tone}
  aria-labelledby={`chapter-${chapter.id}-heading`}
  class:list={[surface, 'scroll-mt-20 border-b border-navy/20 py-9 sm:py-12']}
>
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid border-2 border-navy bg-white shadow-[7px_7px_0_#072b4e] md:grid-cols-[9.5rem_1fr]">
      <div class="flex min-h-28 items-center justify-between gap-4 bg-navy px-5 py-5 text-white md:min-h-full md:flex-col md:items-start md:justify-center md:px-7">
        <span class="font-sans text-[0.68rem] font-bold uppercase tracking-[0.2em] text-white/70">Chapter</span>
        <span aria-hidden="true" class="font-display text-6xl font-bold leading-none text-coral md:text-7xl">{chapter.number}</span>
      </div>
      <div class="flex flex-col justify-center px-5 py-6 sm:px-8 sm:py-8 md:px-10">
        <h2 id={`chapter-${chapter.id}-heading`} class="max-w-3xl font-display text-3xl font-bold leading-tight text-navy sm:text-4xl">{chapter.heading}</h2>
        <p class="mt-3 max-w-3xl font-sans text-base leading-7 text-navy/75 sm:text-lg">{chapter.copy}</p>
      </div>
    </div>
  </div>
</section>
