---
import { SITE } from '../../../data/site';
import type { ProductDetailCode } from '../../../data/product-details/types';

interface Props {
  code: ProductDetailCode;
  location: string;
  primary: string;
  primaryIntent?: string;
  secondary: string;
  secondaryIntent?: string;
  keyword: string;
  inverse?: boolean;
}

const { code, location, primary, primaryIntent = 'quote', secondary, secondaryIntent = 'lead_magnet', keyword } = Astro.props;
---

<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <a href={SITE.social.line} target="_blank" rel="noopener" data-contact-cta data-product-code={code} data-cta-location={location} data-cta-intent={primaryIntent} data-cta-keyword={keyword} data-cta-label={primary} class="btn min-h-12 border-0 bg-[#06C755] px-6 text-white hover:bg-[#05ad49]">{primary}</a>
  <a href={SITE.social.line} target="_blank" rel="noopener" data-contact-cta data-product-code={code} data-cta-location={location} data-cta-intent={secondaryIntent} data-cta-keyword={keyword} data-cta-label={secondary} class="btn min-h-12 border-0 bg-[#06C755] px-6 text-white hover:bg-[#05ad49]">{secondary}</a>
</div>
