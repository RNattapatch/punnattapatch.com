---
import { SITE } from '../../../data/site';
import type { ProductDetailCode } from '../../../data/product-details/types';
import { isFormFirst, lineLinkClass } from '../../../data/product-details/cta-policy';

interface Props {
  code: ProductDetailCode;
  location: string;
  primary: string;
  primaryIntent?: string;
  secondary: string;
  secondaryIntent?: string;
  keyword: string;
  inverse?: boolean;
}

const { code, location, primary, primaryIntent = 'quote', secondary, secondaryIntent = 'lead_magnet', keyword, inverse = false } = Astro.props;
// หน้าฟอร์มก่อน (T2 · T4 · C1): ปุ่มหลักเดียว = ฟอร์ม · LINE เป็นลิงก์ตัวหนังสือ
const lineAsLink = isFormFirst(code);
const lineClass = lineAsLink ? lineLinkClass(inverse) : 'btn min-h-12 border-0 bg-[#06C755] px-6 text-[#072B4E] hover:bg-[#05ad49] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#072B4E]';
const bookingHref = `/booking?package=${encodeURIComponent(code)}&intent=${encodeURIComponent(primaryIntent)}`;
---

<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
  <a href={bookingHref} data-booking-cta data-contact-cta data-product-code={code} data-cta-location={location} data-cta-intent={primaryIntent} data-cta-label={primary} class="btn min-h-12 border-0 bg-[#c43245] px-6 text-white hover:bg-[#ad293a] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-coral">{primary}</a>
  <a href={SITE.social.line} target="_blank" rel="noopener" data-line-cta data-contact-cta data-product-code={code} data-cta-location={location} data-cta-intent={secondaryIntent} data-cta-keyword={keyword} data-cta-label={secondary} data-line-as-link={lineAsLink ? true : undefined} class={lineClass}>{secondary}</a>
</div>
