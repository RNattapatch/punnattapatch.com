---
// S4 · Golden path 6 ขั้น — spec: docs/superpowers/specs/2026-09-05-t2-system-section-design.md
import type { SystemGoldenPath } from '../../../data/product-details/types';

interface Props { data: SystemGoldenPath; }
const { data } = Astro.props;
const shot = data.shot?.delta.length ? data.shot : undefined;
const shotSrc = shot ? ('publicSrc' in shot.image ? shot.image.publicSrc : shot.image.src) : '';
---

<section data-system-block="golden-path" aria-labelledby="t2-system-golden-heading" class="bg-[#fdfaf4] py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-5">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{data.eyebrow}</p>
    <h3 id="t2-system-golden-heading" class="mt-3 max-w-3xl text-balance font-display text-2xl font-bold text-navy sm:text-4xl">{data.heading}</h3>
    <p class="mt-4 max-w-3xl leading-7 text-navy/70">{data.intro}</p>

    <ol class="mt-9 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {data.steps.map((step) => (
        <li data-golden-step class="flex flex-col rounded-[1.5rem] border border-navy/10 bg-white p-6">
          <div class="flex items-center gap-3">
            <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-coral font-display text-base font-bold text-white">{step.number}</span>
            <span class="rounded-md bg-[#ece6da] px-2.5 py-1 text-xs font-bold text-navy">{step.actor}</span>
          </div>
          <h4 class="mt-4 font-display text-lg font-bold leading-snug text-navy">{step.title}</h4>
          <dl class="mt-4 space-y-3 text-sm leading-6">
            <div class="rounded-xl bg-[#f4f1ea] p-3"><dt class="text-xs font-bold text-coral">เข้า</dt><dd class="mt-1 text-navy/80">{step.input}</dd></div>
            <div class="mt-auto rounded-xl bg-navy p-3 text-white"><dt class="text-xs font-bold text-[#ff677a]">ออก</dt><dd class="mt-1 text-white/85">{step.output}</dd></div>
          </dl>
        </li>
      ))}
    </ol>

    <p class="mt-6 max-w-3xl rounded-2xl border-l-4 border-coral bg-white px-5 py-4 leading-7 text-navy">{data.note}</p>

    {shot && (
      <figure data-system-shot class="mt-8 overflow-hidden rounded-[1.5rem] border border-navy/10 bg-white">
        <div class="relative">
          <img src={shotSrc} alt={shot.alt} width={shot.image.width} height={shot.image.height} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
          <p data-shot-label class="absolute left-4 top-4 rounded-lg bg-navy/90 px-3 py-1.5 text-xs font-bold text-white">{shot.label}</p>
        </div>
        <figcaption class="p-5 sm:p-6">
          <p class="leading-7 text-navy/75">{shot.caption}</p>
          <table class="mt-4 w-full border-collapse text-left text-sm">
            <caption class="sr-only">ตารางเทียบสิ่งที่เห็นในภาพกับรุ่นที่ลูกค้าได้รับ</caption>
            <thead><tr class="border-b border-navy/15">
              <th scope="col" class="py-2 pr-4 font-bold text-navy">ในภาพ</th>
              <th scope="col" class="py-2 font-bold text-navy">รุ่นที่คุณได้รับ</th>
            </tr></thead>
            <tbody>
              {shot.delta.map((row) => (
                <tr class="border-b border-navy/10 align-top"><td class="py-2 pr-4 leading-6 text-navy/70">{row.inShot}</td><td class="py-2 leading-6 text-navy/85">{row.youGet}</td></tr>
              ))}
            </tbody>
          </table>
        </figcaption>
      </figure>
    )}
  </div>
</section>
