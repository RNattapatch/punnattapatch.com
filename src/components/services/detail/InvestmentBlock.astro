---
interface Props { name: string; price: string; amount: number; regularPrice?: string; included: string[]; terms: string; scarcity: string; perHeadFor?: number; eyebrow?: string; }
const { name, price, amount, regularPrice, included, terms, scarcity, perHeadFor, eyebrow = 'Investment' } = Astro.props;
const perHeadPrice = perHeadFor ? `฿${(amount / perHeadFor).toLocaleString('en-US')}` : undefined;
---
<section aria-labelledby="investment-heading" class="py-14 sm:py-20"><div class="mx-auto grid max-w-5xl gap-7 rounded-[2rem] border border-navy/10 bg-[#f4f1ea] p-6 sm:p-10 md:grid-cols-[1fr_auto]"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-coral">{eyebrow}</p><h2 id="investment-heading" class="mt-3 font-display text-3xl font-bold text-navy">{name}</h2><ul class="mt-5 space-y-3">{included.map((item) => <li class="flex gap-3 leading-7 text-navy/80"><span class="font-bold text-coral">✓</span>{item}</li>)}</ul><p class="mt-6 text-sm leading-6 text-navy/70">{terms}</p><p class="mt-2 text-sm leading-6 text-navy/70">{scarcity}</p></div><div class="self-center md:text-right">{regularPrice && <p class="text-lg text-navy/50 line-through">{regularPrice}</p>}<p class="font-display text-4xl font-bold text-coral">{price}</p>{perHeadPrice && <p class="mt-2 text-sm leading-6 text-navy/70">เฉลี่ย {perHeadPrice} ต่อคน เมื่อเข้าอบรม {perHeadFor} คน</p>}</div></div></section>
