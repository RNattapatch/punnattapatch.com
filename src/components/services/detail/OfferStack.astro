---
import type { ProductBonusCard, ProductBonusValueItem, ProductDetailCode, ProductJourneyPresentation } from '../../../data/product-details/types';
import JourneyCTA from './JourneyCTA.astro';
import ContentUpdateRibbon from './ContentUpdateRibbon.astro';

interface Props {
  code: ProductDetailCode;
  keyword: string;
  name: string;
  price: string;
  core: string[];
  /** ข้อความของ core item ที่ต้องเด่นกว่าตัวอื่น (T2: Marketing Warroom OS — สีส้มโทน Claude) */
  highlight?: string;
  bonuses: ProductBonusCard[];
  values?: ProductBonusValueItem[];
  journey: ProductJourneyPresentation;
}
const { code, keyword, name, price, core, bonuses, values, journey, highlight } = Astro.props;
const valueOf = (number: string) => values?.find((item) => item.number === number)?.value;
const total = values?.filter((item) => !item.valueLabel).reduce((sum, item) => sum + item.value, 0) ?? 0;
const labelOf = (number: string) => values?.find((item) => item.number === number)?.valueLabel;
const pieces = bonuses.filter((item) => labelOf(item.number) !== '∞').length;
const fmt = (n: number) => `฿${n.toLocaleString('en-US')}`;
const headingId = `${code.toLowerCase()}-offer-heading`;
---

<section data-t4-section={code === 'T4' ? 'offer' : undefined} data-journey-section="offer" aria-labelledby={headingId} class="bg-[#f7f1e7] py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid overflow-hidden rounded-[2rem] border border-navy/10 bg-white shadow-[0_30px_90px_rgba(7,43,78,.10)] lg:grid-cols-[.78fr_1.22fr]">
      <div class="relative overflow-hidden bg-navy p-7 text-white sm:p-10">
        <ContentUpdateRibbon />
        <div aria-hidden="true" class="absolute -bottom-20 -right-16 size-64 rounded-full border-[44px] border-coral/20"></div>
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Offer · เห็นครบก่อนจอง</p>
        <h2 id={headingId} class="mt-4 text-balance font-display text-3xl font-bold leading-tight sm:text-4xl">{name}</h2>
        <p class="mt-5 text-5xl font-bold text-[#ff677a]">{price}</p>
        <p class="mt-2 font-semibold text-white/75">{journey.offerMeta}</p>
        <p class="mt-6 max-w-md leading-7 text-white/75">{journey.offerBody}</p>
      </div>

      <div class="p-7 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Core {core.length}</p>
        <h3 class="mt-2 font-display text-2xl font-bold text-navy">สิ่งที่ทีมสร้างเสร็จในห้อง</h3>
        <ol class="mt-6 grid gap-3 sm:grid-cols-2">
          {core.map((item, index) => {
            const isHighlight = Boolean(highlight) && item === highlight;
            return (
              <li
                data-offer-core
                data-offer-core-highlight={isHighlight ? '' : undefined}
                class:list={[
                  'flex gap-3 rounded-2xl border p-4 text-sm font-semibold leading-6',
                  isHighlight
                    ? 'border-[#d97757] bg-[#fff3ec] text-navy shadow-[0_10px_30px_rgba(217,119,87,.18)] sm:col-span-2'
                    : 'border-navy/10 bg-[#fdfaf4] text-navy',
                ]}
              >
                <span class:list={['flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white', isHighlight ? 'bg-[#d97757]' : 'bg-coral']}>{index + 1}</span>
                <span>
                  {isHighlight && <span class="mb-1 block text-[11px] font-bold uppercase tracking-[.16em] text-[#c2603f]">ระบบที่ติดตั้งให้ · ห้องเดียวกับที่ผมใช้ทุกวัน</span>}
                  {item}
                </span>
              </li>
            );
          })}
        </ol>

        <div class="mt-8 border-t border-navy/10 pt-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Bonus {pieces} ชิ้น + Certificate</p>
              <h3 class="mt-2 font-display text-2xl font-bold text-navy">{total ? `Bonus หลังคอร์ส ${pieces} ชิ้น มูลค่ารวม ${fmt(total)} แถมฟรี` : 'Material ที่ช่วยให้ทีมเริ่มง่ายและใช้ต่อได้'}</h3>
            </div>
            <span class="rounded-full bg-[#06c755]/15 px-3 py-1.5 text-xs font-bold text-[#05a648]">แถมฟรี · ส่งให้หลังจบคลาส</span>
          </div>
          <ol class="mt-5 space-y-3">
            {bonuses.map((item) => (
              <li data-offer-bonus class="grid gap-2 rounded-xl border-l-4 border-coral bg-[#f7f1e7] px-4 py-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] sm:items-center">
                <span class="font-bold text-navy">BONUS {item.number} · {item.title}</span>
                <span class="flex flex-col items-start gap-1 sm:items-end">
                  <span class="flex items-center gap-2">
                    {valueOf(item.number)
                      ? <><s class="text-base font-bold text-coral">{fmt(valueOf(item.number)!)}</s><span class="rounded-md bg-[#06c755]/15 px-2.5 py-1 text-xs font-bold text-[#05a648]">ฟรี</span></>
                      : <span class="rounded-md bg-navy/10 px-2.5 py-1 text-xs font-bold text-navy">{labelOf(item.number) === '∞' ? 'ประเมินค่าไม่ได้ · ฟรี' : `${labelOf(item.number) ?? 'รวมในคอร์ส'} · ฟรี`}</span>}
                  </span>
                  <span class="text-xs text-navy/55">{item.format}</span>
                </span>
              </li>
            ))}
          </ol>
          {total ? <p class="mt-4 text-sm"><a href="#bonus" class="font-bold text-navy underline decoration-coral decoration-2 underline-offset-4">ดูรายละเอียด Bonus ทั้ง {pieces} ชิ้น + Certificate</a></p> : null}
        </div>

        <div class="mt-8">
          <JourneyCTA code={code} location="offer" keyword={keyword} primary="จองคิวรับบริการ" primaryIntent="book_training" secondary="ทัก LINE เช็กโจทย์ก่อน" secondaryIntent="fit_check" />
        </div>
      </div>
    </div>
  </div>
</section>
