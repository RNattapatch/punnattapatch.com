---
import type { ProductBonusCard, ProductDetailCode } from '../../../data/product-details/types';
import JourneyCTA from './JourneyCTA.astro';

interface Props {
  code: ProductDetailCode;
  keyword: string;
  name: string;
  price: string;
  core: string[];
  bonuses: ProductBonusCard[];
}
const { code, keyword, name, price, core, bonuses } = Astro.props;
---

<section data-t4-section="offer" aria-labelledby="t4-offer-heading" class="bg-[#f7f1e7] py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid overflow-hidden rounded-[2rem] border border-navy/10 bg-white shadow-[0_30px_90px_rgba(7,43,78,.10)] lg:grid-cols-[.78fr_1.22fr]">
      <div class="relative overflow-hidden bg-navy p-7 text-white sm:p-10">
        <div aria-hidden="true" class="absolute -bottom-20 -right-16 size-64 rounded-full border-[44px] border-coral/20"></div>
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Offer · เห็นครบก่อนจอง</p>
        <h2 id="t4-offer-heading" class="mt-4 text-balance font-display text-3xl font-bold leading-tight sm:text-4xl">{name}</h2>
        <p class="mt-5 text-5xl font-bold text-[#ff677a]">{price}</p>
        <p class="mt-2 font-semibold text-white/75">1 องค์กร · 1 วัน · 1 Workflow</p>
        <p class="mt-6 max-w-md leading-7 text-white/75">ไม่ขายแค่ชั่วโมงสอน แต่จัดให้ทีมได้ทั้งต้นแบบ กติกาความปลอดภัย และแผนใช้ต่อหลังคลาส</p>
      </div>

      <div class="p-7 sm:p-10">
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Core 4</p>
        <h3 class="mt-2 font-display text-2xl font-bold text-navy">สิ่งที่ทีมสร้างเสร็จในห้อง</h3>
        <ol class="mt-6 grid gap-3 sm:grid-cols-2">
          {core.map((item, index) => (
            <li data-offer-core class="flex gap-3 rounded-2xl border border-navy/10 bg-[#fdfaf4] p-4 text-sm font-semibold leading-6 text-navy">
              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-coral text-xs font-bold text-white">{index + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>

        <div class="mt-8 border-t border-navy/10 pt-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Bonus 5</p>
              <h3 class="mt-2 font-display text-2xl font-bold text-navy">Material ที่ช่วยให้ทีมเริ่มง่ายและใช้ต่อได้</h3>
            </div>
            <span class="rounded-full bg-[#f4f1ea] px-3 py-1.5 text-xs font-bold text-navy/65">กำลังจัดทำไฟล์ใช้งานจริง</span>
          </div>
          <ol class="mt-5 space-y-3">
            {bonuses.map((item) => (
              <li data-offer-bonus class="grid gap-1 rounded-xl border-l-4 border-coral bg-[#f7f1e7] px-4 py-3 sm:grid-cols-[1fr_auto] sm:items-center">
                <span class="font-bold text-navy">BONUS {item.number} · {item.title}</span>
                <span class="text-xs font-semibold text-navy/55">{item.format}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="mt-8">
          <JourneyCTA code={code} location="offer" keyword={keyword} primary="จองคิวรับบริการ" primaryIntent="book_training" secondary="ทัก LINE เช็กโจทย์ก่อน" secondaryIntent="workflow_fit" />
        </div>
      </div>
    </div>
  </div>
</section>
