---
import type { ProductBonusCard, ProductBonusValueItem, ProductDetailCode, ProductJourneyPresentation } from '../../../data/product-details/types';
import JourneyCTA from './JourneyCTA.astro';
import ContentUpdateRibbon from './ContentUpdateRibbon.astro';

interface Props {
  code: ProductDetailCode;
  keyword: string;
  name: string;
  price: string;
  core: string[];
  /** ข้อความของ core item ที่ต้องเด่นกว่าตัวอื่น (T2: Marketing Warroom OS — สีส้มโทน Claude) */
  highlight?: string;
  bonuses: ProductBonusCard[];
  values?: ProductBonusValueItem[];
  journey: ProductJourneyPresentation;
  primaryLabel?: string;
  primaryIntent?: string;
}
// Default keeps T1–T4 wording; public tickets pass their own "จองที่นั่ง" label.
const { code, keyword, name, price, core, bonuses, values, journey, highlight, primaryLabel = 'จองคิวรับบริการ', primaryIntent = 'book_training', hasCertificate = true } = Astro.props;
// P1 ย้ายใบรับรองไปอยู่ใน Core จึงส่ง hasCertificate={false} · T1–T4 ไม่ขยับ
const bonusSuffix = hasCertificate ? ' + Certificate' : '';
const valueOf = (number: string) => values?.find((item) => item.number === number)?.value;
const total = values?.filter((item) => !item.valueLabel).reduce((sum, item) => sum + item.value, 0) ?? 0;
const labelOf = (number: string) => values?.find((item) => item.number === number)?.valueLabel;
const pieces = bonuses.filter((item) => labelOf(item.number) !== '∞').length;
const fmt = (n: number) => `฿${n.toLocaleString('en-US')}`;
const headingId = `${code.toLowerCase()}-offer-heading`;
// core item ที่ขึ้นต้นด้วย 'line::' = ของที่ทีมได้ใช้บน LINE OA ของบริษัท → การ์ดสีแบรนด์ LINE + โลโก้
// (คุณปันสั่ง 2026-09-08: ให้เห็นตั้งแต่กวาดตาว่า Agent ตัวนี้อยู่ในไลน์)
const LINE_MARK = 'M21.5 11.1c0-4.6-4.8-8.3-10.8-8.3S0 6.5 0 11.1c0 4.1 3.8 7.5 8.9 8.2-.2.2-.4.5-.5.8-.2.5-.1.9.4 1 .4.1.8-.1 1.2-.3l3.3-2.1c4.6-.8 8.2-3.7 8.2-7.6Z';
---

<section data-t4-section={code === 'T4' ? 'offer' : undefined} data-journey-section="offer" aria-labelledby={headingId} class="bg-[#f7f1e7] py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid overflow-hidden rounded-[2rem] border border-navy/10 bg-white shadow-[0_30px_90px_rgba(7,43,78,.10)] lg:grid-cols-[.78fr_1.22fr]">
      <div class="relative overflow-hidden bg-navy p-7 text-white sm:p-10">
        <ContentUpdateRibbon />
        <div aria-hidden="true" class="absolute -bottom-20 -right-16 size-64 rounded-full border-[44px] border-coral/20"></div>
        <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Offer · เห็นครบก่อนจอง</p>
        <h2 id={headingId} class="mt-4 text-balance font-display text-3xl font-bold leading-tight sm:text-4xl">{name}</h2>
        <p class="mt-5 text-5xl font-bold text-[#ff677a]">{price}</p>
        <p class="mt-2 font-semibold text-white/75">{journey.offerMeta}</p>
        <p class="mt-6 max-w-md leading-7 text-white/75">{journey.offerBody}</p>
      </div>

      <div class="p-7 sm:p-10">
        {/* Core panel — คุณปันสั่ง 2026-09-08: บล็อกนี้ต้องเด่นจนเลื่อนผ่านไม่ได้ และภาษาต้องคุยกับอาเฮีย/เซลล์แล้วเก็ตทันที
            item รูปแบบ "หัวข้อสั้น||คำอธิบาย" จะแยกเป็น 2 ชั้น · item ธรรมดาที่ไม่มี || แสดงเหมือนเดิม */}
        <div data-offer-core-panel class="rounded-[1.75rem] border-2 border-coral/45 bg-[#fff4ec] p-5 shadow-[0_18px_50px_rgba(214,69,80,.14)] sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Core {core.length}</p>
              <h3 class="mt-2 font-display text-3xl font-bold text-navy sm:text-4xl">สิ่งที่ทีมสร้างเสร็จในห้อง</h3>
              <p class="mt-2 text-base font-semibold text-navy/70">จบวันได้ {core.length} อย่างนี้กลับบ้านแน่ๆ ไม่ใช่แค่สไลด์กับความรู้</p>
            </div>
            <span class="rounded-full bg-coral px-4 py-2 text-sm font-bold text-white shadow-[0_8px_20px_rgba(214,69,80,.3)]">ทำเสร็จในห้อง · ใช้ต่อได้เลย</span>
          </div>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {core.map((item, index) => {
              const isHighlight = Boolean(highlight) && item === highlight;
              const isLine = item.startsWith('line::');
              const plain = isLine ? item.slice('line::'.length) : item;
              const [title, body] = plain.includes('||') ? plain.split('||') : [plain, ''];
              return (
                <li
                  data-offer-core
                  data-offer-core-line={isLine ? '' : undefined}
                  data-offer-core-highlight={isHighlight ? '' : undefined}
                  class:list={[
                    'flex gap-4 rounded-2xl border-l-4 bg-white p-5 shadow-[0_10px_30px_rgba(7,43,78,.08)] leading-7 text-navy',
                    isLine
                      ? 'border-[#06c755] bg-[#f1fbf4] shadow-[0_12px_34px_rgba(6,199,85,.18)] sm:col-span-2'
                      : isHighlight
                        ? 'border-[#d97757] bg-[#fff3ec] sm:col-span-2'
                        : 'border-coral',
                  ]}
                >
                  <span class:list={['flex size-9 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white', isLine ? 'bg-[#06c755]' : isHighlight ? 'bg-[#d97757]' : 'bg-coral']}>{index + 1}</span>
                  <span class="min-w-0">
                    {isLine && (
                      <span class="mb-2 inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[#06c755] px-3 py-1 text-[11px] font-bold leading-4 text-white">
                        <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" d={LINE_MARK} /></svg>
                        ทำงานบน LINE OA ของบริษัท
                      </span>
                    )}
                    {isHighlight && !isLine && <span class="mb-1 block text-[11px] font-bold uppercase tracking-[.16em] text-[#c2603f]">ระบบพร้อมใช้บนเครื่องบริษัท · ห้องเดียวกับที่ผมใช้ทุกวัน</span>}
                    <span class:list={['block text-lg font-bold leading-7', isLine && 'text-xl sm:text-2xl']}>{title}</span>
                    {body && <span class="mt-1 block text-[15px] font-medium leading-6 text-navy/75">{body}</span>}
                  </span>
                </li>
              );
            })}
          </ol>
        </div>

        <div class="mt-8 border-t border-navy/10 pt-7">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.2em] text-coral">Bonus {pieces} ชิ้น{bonusSuffix}</p>
              <h3 class="mt-2 font-display text-2xl font-bold text-navy">{total ? `Bonus หลังคลาส ${pieces} ชิ้น มูลค่ารวม ${fmt(total)} แถมฟรี` : 'Material ที่ช่วยให้ทีมเริ่มง่ายและใช้ต่อได้'}</h3>
            </div>
            <span class="rounded-full bg-[#06c755]/15 px-3 py-1.5 text-xs font-bold text-[#05a648]">แถมฟรี · ส่งให้หลังจบคลาส</span>
          </div>
          <ol class="mt-5 space-y-3">
            {bonuses.map((item) => (
              <li data-offer-bonus class="grid gap-2 rounded-xl border-l-4 border-coral bg-[#f7f1e7] px-4 py-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] sm:items-center">
                <span class="font-bold text-navy">BONUS {item.number} · {item.title}</span>
                <span class="flex flex-col items-start gap-1 sm:items-end">
                  <span class="flex items-center gap-2">
                    {valueOf(item.number)
                      ? <><s class="text-base font-bold text-coral">{fmt(valueOf(item.number)!)}</s><span class="rounded-md bg-[#06c755]/15 px-2.5 py-1 text-xs font-bold text-[#05a648]">ฟรี</span></>
                      : <span class="rounded-md bg-navy/10 px-2.5 py-1 text-xs font-bold text-navy">{labelOf(item.number) === '∞' ? 'ประเมินค่าไม่ได้ · ฟรี' : `${labelOf(item.number) ?? 'รวมในคลาส'} · ฟรี`}</span>}
                  </span>
                  <span class="text-xs text-navy/55">{item.format}</span>
                </span>
              </li>
            ))}
          </ol>
          {total ? <p class="mt-4 text-sm"><a href="#bonus" class="font-bold text-navy underline decoration-coral decoration-2 underline-offset-4">ดูรายละเอียด Bonus ทั้ง {pieces} ชิ้น{bonusSuffix}</a></p> : null}
        </div>

        <div class="mt-8">
          <JourneyCTA code={code} location="offer" keyword={keyword} primary={primaryLabel} primaryIntent={primaryIntent} secondary="ทัก LINE เช็กโจทย์ก่อน" secondaryIntent="fit_check" />
        </div>
      </div>
    </div>
  </div>
</section>
