---
import { SITE } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const hideFromNav = new Set(['Free Kit', 'Public Training']);
const navLinks = SITE.nav.filter((item) => !item.cta && !hideFromNav.has(item.label));
const ctaItem = SITE.nav.find((item) => item.cta);
---

<nav class="site-nav" aria-label="หลัก">
  <div class="nav-inner">
    <div class="nav-brand">
      <a href="/" class="font-display text-lg font-bold tracking-tight" aria-label="กลับหน้าแรก">
        <span class="text-base-content">Pun</span><span class="text-secondary"> Nattapatch</span>
      </a>
    </div>

    <div class="nav-links hidden md:flex">
      <ul class="menu menu-horizontal gap-0 text-sm">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-md px-2.5 py-2 font-medium transition-colors',
                isActive(item.href) ? 'text-secondary' : 'text-base-content/80 hover:text-base-content',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-end">
      {ctaItem && (
        <a href={ctaItem.href} class="nav-cta">{ctaItem.label}</a>
      )}
    </div>
  </div>
</nav>

<!-- Mobile menu (below nav) -->
<details class="menu-mobile md:hidden">
  <summary class="cursor-pointer px-4 py-2 text-sm font-medium text-base-content/70">
    เมนู ▾
  </summary>
  <ul class="menu px-2 pb-3">
    {navLinks.map((item) => (
      <li>
        <a href={item.href} class={isActive(item.href) ? 'text-secondary' : ''}>
          {item.label}
        </a>
      </li>
    ))}
    {ctaItem && (
      <li class="mt-2 px-2">
        <a href={ctaItem.href} class="btn btn-sm w-full bg-secondary text-secondary-content">
          {ctaItem.label}
        </a>
      </li>
    )}
  </ul>
</details>

<style>
  .site-nav {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: rgba(244, 241, 234, 0.9);
    border-bottom: 1px solid rgba(138, 129, 117, 0.4);
    position: sticky;
    top: 0;
    z-index: 50;
    padding-inline: 1rem;
  }

  @media (min-width: 1024px) {
    .site-nav {
      padding-inline: 2rem;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    max-width: var(--pun-container);
    margin-inline: auto;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-links {
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-cta {
    background: var(--pun-coral);
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: var(--pun-radius-btn);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .nav-cta:hover {
    opacity: 0.9;
  }

  .menu-mobile {
    background: var(--pun-ivory);
    border-bottom: 1px solid rgba(138, 129, 117, 0.4);
  }
</style>
