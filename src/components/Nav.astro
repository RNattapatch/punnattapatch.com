---
import { SITE } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const hideFromNav = new Set(['Free Kit', 'Public Training']);
const navLinks = SITE.nav.filter((item) => !item.cta && !hideFromNav.has(item.label));
const ctaItem = SITE.nav.find((item) => item.cta);
---

<nav class="site-nav" aria-label="หลัก">
  <div class="nav-inner">
    <div class="nav-brand">
      <a href="/" class="font-display text-lg font-bold tracking-tight" aria-label="กลับหน้าแรก">
        <span class="text-base-content">Pun</span><span class="text-secondary"> Nattapatch</span>
      </a>
    </div>

    <div class="nav-links hidden md:flex">
      <ul class="menu menu-horizontal gap-0 text-sm">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-md px-2.5 py-2 font-medium transition-colors',
                isActive(item.href) ? 'text-secondary' : 'text-base-content/80 hover:text-base-content',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-end">
      <details data-mobile-nav class="dropdown dropdown-end md:hidden">
        <summary class="mobile-menu-trigger btn btn-circle btn-ghost min-h-11 h-11 w-11" aria-label="เปิดเมนูหลัก">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <span class="sr-only">เมนู</span>
        </summary>
        <ul class="menu dropdown-content z-[60] mt-3 w-52 rounded-2xl border border-base-300 bg-base-100 p-3 shadow-xl">
          {navLinks.map((item) => (
            <li>
              <a href={item.href} class={isActive(item.href) ? 'text-secondary' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          {ctaItem && (
            <li class="mt-2">
              <a href={ctaItem.href} class="btn btn-sm border-0 bg-secondary text-secondary-content">
                {ctaItem.label}
              </a>
            </li>
          )}
        </ul>
      </details>
      {ctaItem && (
        <a href={ctaItem.href} class="nav-cta">
          <span class="sm:hidden">จองคิว</span>
          <span class="hidden sm:inline">{ctaItem.label}</span>
        </a>
      )}
    </div>
  </div>
</nav>

<style>
  .site-nav {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: rgba(244, 241, 234, 0.9);
    border-bottom: 1px solid rgba(138, 129, 117, 0.4);
    position: sticky;
    top: 0;
    z-index: 50;
    padding-inline: 1rem;
  }

  @media (min-width: 1024px) {
    .site-nav {
      padding-inline: 2rem;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    max-width: var(--pun-container);
    margin-inline: auto;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-links {
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-cta {
    background: var(--pun-coral);
    color: white;
    padding: 0.5rem 1.25rem;
    border-radius: var(--pun-radius-btn);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .nav-cta:hover {
    opacity: 0.9;
  }

  .mobile-menu-trigger {
    list-style: none;
  }

  .mobile-menu-trigger::-webkit-details-marker { display: none; }
</style>
