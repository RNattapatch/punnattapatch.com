---
import Icon from './Icon.astro';

interface Props {
  bucket: 'time' | 'money' | 'scale' | 'freedom' | 'cost';
  headline: string;
  body: string;
  icon: string;
}
const { bucket, headline, body, icon } = Astro.props;

// Editorial accent palette (was neon) — navy / coral / muted earth tones
const bucketColor: Record<string, string> = {
  time:    '#072b4e',
  money:   '#2f7d5b',
  scale:   '#2f7d5b',
  freedom: '#7c5cbf',
  cost:    '#c9881f',
};
const accent = bucketColor[bucket] ?? '#072b4e';
---

<div class="outcome-card" style={`--accent: ${accent}`}>
  <span class="outcome-icon" aria-hidden="true">
    <Icon name={icon} size={22} />
  </span>
  <h3 class="outcome-headline">{headline}</h3>
  <p class="outcome-body">{body}</p>
</div>

<style>
  .outcome-card {
    background: var(--pun-surface-1);
    border: 1px solid var(--pun-border);
    border-left: 3px solid var(--accent, #072b4e);
    border-radius: var(--pun-radius-card);
    padding: 1.25rem 1.75rem;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .outcome-card:hover {
    transform: translateY(-2px);
    box-shadow: 3px 5px 0 rgba(30, 27, 22, 0.06);
  }
  .outcome-icon {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--accent, #072b4e);
  }
  .outcome-headline {
    font-family: 'Trirong', serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--pun-navy);
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }
  .outcome-body {
    font-family: 'Sarabun', sans-serif;
    font-size: 0.85rem;
    color: var(--pun-text-muted);
    margin: 0;
    line-height: 1.6;
  }
  @media (hover: none) { .outcome-card:hover { transform: none; } }
</style>
