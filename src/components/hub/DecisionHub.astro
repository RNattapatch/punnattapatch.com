---
// DecisionHub — Sales Funnel v2 (2026-09-03): หน้าหลังส่งฟอร์มแบบ "รายสินค้า"
// ทำหน้าที่ Selection ต่อทันทีหลัง submit: สิ่งที่จะเกิดขึ้น (SLA จริง) · ราคา/ขอบเขตเดิมจาก LP · proof 3 · FAQ 3 · CTA นัดคุยผ่าน LINE
// SSOT: wiki/pages/strategy-post-form-trust-to-decision-funnel.md + audit-…-thai-fit-2026-09.md §1.2
// Static build: render ทุก product แล้วซ่อน · script ในหน้า /thank-you เปิดตัวที่ตรง ?package=
import { resolveProductDetailCatalog } from '../../data/product-details/catalog';
import { SITE } from '../../data/site';
import type { ProductDetailPageData } from '../../data/product-details/types';

interface Props { data: ProductDetailPageData; }
const { data } = Astro.props;
const catalog = resolveProductDetailCatalog(data.pricingKey);
const photos = data.proof.filter((p) => p.kind === 'photo').slice(0, 3);
const faq = data.faq.slice(0, 3);
const imgSrc = (image: ProductDetailPageData['proof'][number]['image']) => ('publicSrc' in image ? image.publicSrc : image.src);
// ①②③ เต็มชุดอยู่บนหัวหน้า /thank-you แล้ว — ที่นี่แสดงเฉพาะสินค้าที่มีขั้นของตัวเอง (P1 คลาสสาธารณะ)
const steps = data.hubSteps ?? [];
---

<section data-decision-hub={data.code} hidden aria-labelledby={`hub-${data.code}-heading`} class="border-t border-[#c9c2b2] bg-base-100 px-4 py-14 md:py-16">
  <div class="mx-auto max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-secondary">ก่อนคุยโทร · {data.code}</p>
    <h2 id={`hub-${data.code}-heading`} class="mt-3 font-display text-2xl font-bold text-base-content md:text-3xl">บริการที่คุณดูอยู่: <span class="text-secondary">{catalog.name}</span></h2>

    {steps.length > 0 && <ol class="mt-6 grid gap-3 sm:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-2xl border border-[#c9c2b2] bg-white p-4">
          <p class="text-xs font-bold text-secondary">{['①', '②', '③', '④'][i] ?? i + 1} {s.when}</p>
          <p class="mt-1 text-sm leading-6 text-base-content/85">{s.text}</p>
        </li>
      ))}
    </ol>}

    <div class="mt-8 rounded-2xl bg-primary p-6 text-primary-content">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.16em] text-primary-content/70">ราคาเดิมจากหน้าบริการ ไม่มีเปลี่ยนตอนคุย</p>
        <p class="mt-1 font-display text-3xl font-bold">{catalog.price}</p>
        <p class="mt-1 text-sm text-primary-content/80">{catalog.duration} · {data.hero.customerJob}</p>
      </div>
    </div>

    {photos.length > 0 && (
      <div class="mt-8">
        <p class="text-sm font-bold text-base-content">ภาพจากงานจริงของบริการนี้</p>
        <div class="mt-3 grid grid-cols-3 gap-2">
          {photos.map((p) => (
            <figure class="overflow-hidden rounded-xl">
              <img src={imgSrc(p.image)} alt={p.alt} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
            </figure>
          ))}
        </div>
      </div>
    )}

    {faq.length > 0 && (
      <div class="mt-8">
        <p class="text-sm font-bold text-base-content">คำถามที่คนมักถามก่อนคอล</p>
        <div class="mt-3 divide-y divide-[#c9c2b2] rounded-2xl border border-[#c9c2b2] bg-white px-4">
          {faq.map((f) => (
            <details class="py-1">
              <summary class="cursor-pointer py-3 text-sm font-bold text-base-content">{f.question}</summary>
              <p class="pb-3 text-sm leading-6 text-base-content/80">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    <p class="mt-6 text-xs leading-5 text-base-content/60">ชำระ 100% ก่อนเริ่มงาน · ราคาและขอบเขตตรงกับหน้าบริการ · ข้อมูลไม่ส่งต่อบุคคลที่สาม</p>
  </div>
</section>
