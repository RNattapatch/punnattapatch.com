---
interface Props {
  badge?: string;
  headline: string;
  accentWord?: string;
  sub?: string;
  align?: 'center' | 'left';
}
const { badge, headline, accentWord, sub, align = 'center' } = Astro.props;

const parts = accentWord && headline.includes(accentWord)
  ? headline.split(accentWord)
  : null;
---

<div class:list={['section-header', `align-${align}`]}>
  {badge && <span class="sh-badge">{badge}</span>}
  <h2 class="sh-headline">
    {parts
      ? (<>{parts[0]}<span class="sh-accent">{accentWord}</span>{parts[1]}</>)
      : headline
    }
  </h2>
  {sub && <p class="sh-sub">{sub}</p>}
</div>

<style>
  .section-header { margin-bottom: 3rem; }
  .align-center { text-align: center; }
  .align-left    { text-align: left; }

  .sh-badge {
    display: inline-block;
    font-family: 'Sarabun', sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pun-cyan);
    border: 1px solid rgba(34,211,238,0.30);
    background: rgba(34,211,238,0.08);
    border-radius: var(--pun-radius-badge);
    padding: 3px 12px;
    margin-bottom: 0.75rem;
  }
  .sh-headline {
    font-family: 'Bai Jamjuree', sans-serif;
    font-size: clamp(1.6rem, 4vw, 2rem);
    font-weight: 700;
    color: white;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }
  .sh-accent { color: var(--pun-coral); }
  .sh-sub {
    font-family: 'Sarabun', sans-serif;
    font-size: 1rem;
    color: var(--pun-text-muted);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 600px;
  }
  .align-left .sh-sub { margin-left: 0; }
</style>
