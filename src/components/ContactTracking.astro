<script is:inline>
  (() => {
    if (window.__punContactTrackingBound) return;
    window.__punContactTrackingBound = true;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const cta = event.target.closest('[data-contact-cta]');
      if (!(cta instanceof HTMLAnchorElement)) return;

      const props = {
        cta_location: cta.dataset.ctaLocation || 'unknown',
        page_path: window.location.pathname,
        product_code: cta.dataset.productCode || 'none',
        cta_label: cta.dataset.ctaLabel || cta.textContent?.trim() || 'Contact',
      };

      try {
        window.plausible?.('Contact', { props });
      } catch {}
      try {
        window.fbq?.('track', 'Contact', { content_name: props.cta_location, content_ids: [props.product_code] });
        // 2026-09-12 (แบบ อ.เบิร์ด): ปุ่มที่ประกาศ data-cta-event ยิง event ชื่อตามปุ่มเพิ่ม
        // เพื่อให้ปันตั้ง Custom Conversion แยก "จองที่นั่ง" ออกจาก "ถามก่อน" ได้ใน Events Manager
        if (cta.dataset.ctaEvent) window.fbq?.('trackCustom', cta.dataset.ctaEvent, { content_ids: [props.product_code], cta_location: props.cta_location });
      } catch {}
      try {
        window.ttq?.track?.('Contact', props);
      } catch {}
    });
  })();
</script>
