---
/**
 * ProductLeadForm — ฟอร์มจองคิวที่อยู่ในหน้าสินค้าเลย ไม่ต้องพาไปหน้าอื่น
 *
 * ทำไมต้องมี (2026-09-04):
 * หน้า /services/* ทุกหน้าเคยส่งคนไป /booking เพื่อกรอกฟอร์ม แปลว่า
 *   1. มีหน้าคั่นเพิ่ม 1 หน้า = จุดหล่นที่มองไม่เห็น
 *   2. ปุ่ม "จองคิวรับบริการ" ยิงได้แค่ event `Contact` ซึ่งชนกับปุ่ม LINE
 *      จนแยกกันไม่ออกในรายงาน
 *   3. /booking ไม่มี fbq เลย → กดส่งสำเร็จก็ไม่มี `Lead` ยิง ทำให้ Meta
 *      มองไม่เห็น conversion ที่เกิดขึ้นจริง และ optimize ไม่ได้
 * ตัวนี้คือฟอร์มชุดเดียวกับที่ /ads/* ใช้อยู่ (พิสูจน์แล้วว่า `Lead` ยิงจริง
 * ทดสอบบน production 2026-09-04) ยกออกมาเป็นคอมโพเนนต์เพื่อวางในหน้าสินค้าได้ทุกหน้า
 *
 * ค่าคอนฟิกส่งผ่าน data-* บนตัว <form> เพราะสคริปต์ของคอมโพเนนต์ใน Astro
 * อ่าน props ตรงๆ ไม่ได้ — สคริปต์จะอ่านค่าจาก DOM แทน
 */
import AfterHoursField from '../AfterHoursField.astro';
import DarumaMark from '../DarumaMark.astro';

interface Props {
  /** รหัสสินค้า เช่น T4 — ใช้เป็น content_ids ของ pixel */
  code: string;
  /** ค่า source ที่จะเข้า CRM · ขึ้นต้น lp- เพื่อให้ funnel_watch นับเป็นลีดจากหน้าเว็บ */
  source: string;
  /** booking_type ที่ n8n/CRM ใช้แยกประเภทงาน */
  bookingType: string;
  /** คำนำหน้าชื่อ event: <prefix>_form / <prefix>_booking / line_add_<prefix> */
  eventPrefix: string;
  eyebrow?: string;
  heading: string;
  intro: string;
  /** ข้อความในช่อง "เรื่องที่อยากแก้ก่อน" */
  issuePlaceholder?: string;
  successNote?: string;
  lineUrl: string;
  lineLabel?: string;
  lineNote?: string;
  id?: string;
}

const {
  code,
  source,
  bookingType,
  eventPrefix,
  eyebrow = 'จองคิวคุยฟรี',
  heading,
  intro,
  issuePlaceholder = 'เช่น ทีมเสียเวลากับงานเอกสารซ้ำๆ ทุกวัน',
  successNote = 'ผมจะอ่านโจทย์ก่อนครับ แล้วทักกลับทาง LINE หรือโทรศัพท์ คุยกันฟรี 15–20 นาที',
  lineUrl,
  lineLabel = 'ทัก LINE ถามผมสั้นๆ ก่อน',
  lineNote = 'ยังไม่อยากกรอกฟอร์ม? ทักไลน์มาถามผมสั้นๆ ก่อนก็ได้ครับ',
  id = 'product-lead-form',
} = Astro.props;
---

<section id={id} class="scroll-mt-20 bg-ivory px-6 py-16 md:py-24" data-lead-form-section>
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">{eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-navy md:text-5xl">{heading}</h2>
      <p class="mt-5 leading-relaxed text-warm-ink/75">{intro}</p>
    </div>

    <form
      class="editorial-card p-6 md:p-9"
      novalidate
      data-lead-form
      data-code={code}
      data-source={source}
      data-booking-type={bookingType}
      data-event-prefix={eventPrefix}
    >
      <input name="honeypot-name" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
      <div class="space-y-5">
        <label class="field-label">ชื่อของคุณ<input name="name" required autocomplete="name" class="field" aria-label="ชื่อของคุณ" /></label>
        <label class="field-label">ชื่อบริษัท<input name="business" required autocomplete="organization" class="field" placeholder="เช่น บริษัท ตัวอย่าง จำกัด" aria-label="ชื่อบริษัท" /></label>
        <fieldset class="field-label">
          <legend class="mb-2">อยากให้ผมติดต่อกลับแบบไหนครับ</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="intent-option flex cursor-pointer items-start gap-3 rounded-xl border border-[#c9c2b2] bg-ivory p-4">
              <input type="radio" name="intent" value="chat" required class="mt-1 accent-coral" aria-label="คุยเบื้องต้นก่อน" />
              <span><span class="block font-semibold text-navy">คุยเบื้องต้นก่อน</span><span class="mt-0.5 block text-sm font-normal text-warm-ink/70">อยากสอบถามรายละเอียดก่อน</span></span>
            </label>
            <label class="intent-option flex cursor-pointer items-start gap-3 rounded-xl border border-[#c9c2b2] bg-ivory p-4">
              <input type="radio" name="intent" value="booking" required class="mt-1 accent-coral" aria-label="ขอนัดจองคิวเลย" />
              <span><span class="block font-semibold text-navy">ขอนัดจองคิวเลย</span><span class="mt-0.5 block text-sm font-normal text-warm-ink/70">พร้อมนัดคุยจริงจัง</span></span>
            </label>
          </div>
        </fieldset>
        <label class="field-label">เบอร์โทรมือถือ<input name="phone" type="tel" required inputmode="tel" autocomplete="tel" pattern={"[0-9\\(\\)\\+\\-\\s]{9,15}"} class="field" placeholder="เช่น 0812345678" aria-label="เบอร์โทรมือถือ" /></label>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="field-label">ตำแหน่งของคุณ<select name="position" required class="field" aria-label="ตำแหน่งของคุณ"><option value="">เลือกตำแหน่ง</option><option>CEO / เจ้าของกิจการ</option><option>Managing Director</option><option>Sales Director</option><option>Sales Manager</option><option>Marketing Manager</option><option>Operations Manager</option><option>อื่นๆ</option></select></label>
          <label class="field-label">LINE ID <span class="font-normal text-warm-ink/55">(ถ้ามี)</span><input name="line_id" autocomplete="off" class="field" placeholder="เช่น @yourshop หรือ ไอดีไลน์" aria-label="LINE ID" /></label>
        </div>
        <label class="field-label">งบที่พร้อมลงทุน<select name="budget" required class="field" aria-label="งบที่พร้อมลงทุน"><option value="">เลือกช่วงงบ</option><option>ยังไม่ได้ตั้งงบ — อยากเห็นโจทย์ก่อน</option><option>ต่ำกว่า ฿50,000</option><option>฿50,000–฿100,000</option><option>฿100,000–฿300,000</option><option>มากกว่า ฿300,000</option></select></label>
        <label class="field-label">เรื่องที่อยากแก้ก่อน <span class="font-normal text-warm-ink/55">(ถ้ามี)</span><textarea name="sales_issue" rows="4" class="field resize-y" placeholder={issuePlaceholder} aria-label="เรื่องที่อยากแก้ก่อน"></textarea></label>
        <input data-attr="utm_source" name="utm_source" type="hidden" />
        <input data-attr="utm_medium" name="utm_medium" type="hidden" />
        <input data-attr="utm_campaign" name="utm_campaign" type="hidden" />
        <input data-attr="utm_content" name="utm_content" type="hidden" />
        <input data-attr="utm_term" name="utm_term" type="hidden" />
        <input data-attr="fbclid" name="fbclid" type="hidden" />
        <input data-attr="ttclid" name="ttclid" type="hidden" />
        <AfterHoursField variant="warm" />
        <label class="flex cursor-pointer items-start gap-3 pt-1"><input name="consent" type="checkbox" required class="checkbox mt-0.5" aria-label="ยินยอมให้ติดต่อกลับตามนโยบายความเป็นส่วนตัว" /><span class="text-sm leading-relaxed text-warm-ink/75">ยินยอมให้ติดต่อกลับตาม <a href="/privacy" class="font-semibold text-cyan underline">นโยบายความเป็นส่วนตัว</a></span></label>
        <p data-lead-error class="hidden rounded-xl border border-error/40 bg-error/10 p-4 text-sm text-error" role="alert" aria-live="polite"></p>
        <button data-lead-submit type="submit" class="btn min-h-11 w-full border-0 bg-coral py-4 text-base text-white hover:bg-[#c43245]" aria-label="ส่งข้อมูล">ส่งข้อมูล</button>
      </div>
    </form>

    <div data-lead-success class="editorial-card hidden p-8 text-center lg:col-start-2" role="status" aria-live="polite">
      <DarumaMark class="mx-auto h-auto w-20" />
      <h2 class="mt-5 font-display text-3xl font-bold text-navy">รับข้อมูลแล้วครับ</h2>
      <p class="mt-3 leading-relaxed text-warm-ink/75">{successNote}</p>
      <p class="mt-5 border-t border-[#c9c2b2] pt-4 text-sm leading-relaxed text-warm-ink/75">ระหว่างรอผมติดต่อกลับ อ่านหน้านี้ 3 นาทีครับ จะได้รู้จักกันก่อนคุยจริง<br /><a href="/start" class="font-semibold text-cyan underline">รู้จักผมใน 3 นาที →</a></p>
    </div>
  </div>

  <div class="mx-auto mt-12 max-w-6xl border-t border-[#c9c2b2] pt-10">
    <p class="text-center text-lg font-semibold text-navy">{lineNote}</p>
    <div class="mx-auto mt-5 flex max-w-2xl justify-center">
      <a
        href={lineUrl}
        target="_blank"
        rel="noopener"
        data-contact-cta
        data-product-code={code}
        data-cta-location="lead_form"
        data-cta-label={lineLabel}
        class="line-button flex min-h-11 items-center justify-center gap-2 rounded-xl bg-[#06c755] px-4 py-3 text-center font-semibold text-white transition-colors hover:bg-[#05b34c]"
        aria-label={lineLabel}
      >
        <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" d="M21.5 11.1c0-4.6-4.8-8.3-10.8-8.3S0 6.5 0 11.1c0 4.1 3.8 7.5 8.9 8.2-.2.2-.4.5-.5.8-.2.5-.1.9.4 1 .4.1.8-.1 1.2-.3l3.3-2.1c4.6-.8 8.2-3.7 8.2-7.6Z"/></svg>
        <span>{lineLabel}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .intent-option { transition: border-color .15s, background .15s, box-shadow .15s; }
  .intent-option:has(input:checked) { border-color: var(--pun-coral); background: color-mix(in oklch, var(--pun-coral) 7%, transparent); box-shadow: inset 0 0 0 1px var(--pun-coral); }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; min-height: 44px; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
  .line-button { min-height: 44px; }
  @media (prefers-reduced-motion: reduce) { .line-button { transition: none; } }
</style>

<script>
  import { foldAfterHours } from '../../scripts/after-hours';
  import { submitLeadFallback, makeReference } from '../../scripts/lead-fallback';

  type Attribution = Record<string, string | undefined>;
  type MetaWindow = Window & {
    fbq?: (...args: unknown[]) => void;
    ttq?: { track: (...args: unknown[]) => void };
    pnAttribution?: Attribution;
  };

  const pageWindow = window as MetaWindow;
  const WEBHOOK = 'https://form-hook.punnattapatch.com/webhook/intake-form-v2';
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  // Click IDs are the strongest match signal for Meta/TikTok server-side events;
  // BaseLayout stashes them in pnAttribution with a 14-day TTL.
  const CLICK_ID_KEYS = ['fbclid', 'ttclid'];

  /** Reference token — same shape as intake-form's makeReference(); also the event_id for CAPI dedupe. */
  function makeFormReference(): string {
    const stamp = new Date().toISOString().replace(/[-:T.Z]/g, '').slice(0, 12);
    const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
    return `PN-${stamp}-${rand}`;
  }

  function bind(form: HTMLFormElement) {
    const section = form.closest('[data-lead-form-section]') as HTMLElement | null;
    const success = section?.querySelector('[data-lead-success]') as HTMLElement | null;
    const error = form.querySelector('[data-lead-error]') as HTMLElement | null;
    const submit = form.querySelector('[data-lead-submit]') as HTMLButtonElement | null;
    const code = form.dataset.code || '';
    const source = form.dataset.source || '';
    const bookingType = form.dataset.bookingType || '';
    const prefix = form.dataset.eventPrefix || 'product';
    const viewEvent = `${prefix}_form`;
    const leadEvent = `${prefix}_booking`;

    const query = new URLSearchParams(window.location.search);
    const stored = pageWindow.pnAttribution || {};
    [...UTM_KEYS, ...CLICK_ID_KEYS].forEach((key) => {
      const input = form.querySelector(`[data-attr="${key}"]`) as HTMLInputElement | null;
      if (input) input.value = query.get(key) || stored[key] || '';
    });

    // ViewContent เมื่อหัวฟอร์มเลื่อนขึ้นมาถึง 65% ของจอ — ไม่ผูกกับความสูงฟอร์ม
    // (threshold แบบสัดส่วนเคยทำให้ ViewContent ไม่เคยยิงบนมือถือเลย · 2026-08-31)
    if (section && 'IntersectionObserver' in window) {
      let fired = false;
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting) && !fired) {
          fired = true;
          if (typeof pageWindow.fbq === 'function') pageWindow.fbq('track', 'ViewContent', { content_name: viewEvent, content_ids: [code] });
          observer.disconnect();
        }
      }, { threshold: 0, rootMargin: '0px 0px -35% 0px' });
      observer.observe(section);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if ((new FormData(form).get('honeypot-name') as string)?.trim()) return;

      const phoneRaw = String(new FormData(form).get('phone') || '').replace(/[\s()\-]/g, '');
      if (!/^(?:\+?66|0)\d{8,9}$/.test(phoneRaw)) {
        if (error) { error.textContent = 'กรุณากรอกเบอร์โทรมือถือจริง เช่น 0812345678 ครับ'; error.classList.remove('hidden'); }
        (form.querySelector('[name="phone"]') as HTMLInputElement | null)?.focus();
        return;
      }

      const payload = Object.fromEntries(new FormData(form).entries());
      const intentLabel = payload.intent === 'booking' ? 'ขอนัดจองคิว' : 'คุยเบื้องต้นก่อน';
      // รหัสอ้างอิงตัวเดียว ใช้ทั้งใน payload · เป็น eventID ให้ Meta dedupe · และส่งต่อไป /thank-you
      const reference = makeFormReference();
      Object.assign(payload, {
        phone: phoneRaw,
        lead_temp: payload.intent === 'booking' ? 'hot' : 'warm',
        // Compatibility aliases for the shared intake-form-v2 flow + submit_lead RPC
        // (it reads company/tier/problems/comment, not the raw field names).
        company: payload.business || '',
        industry: '',
        tier: payload.intent === 'booking' ? 'HOT' : 'WARM',
        problems: (payload.sales_issue as string) || '',
        comment: [intentLabel, payload.sales_issue].filter(Boolean).join(' — '),
        source,
        source_page: window.location.pathname.replace(/^\//, ''),
        booking_type: bookingType,
        // Flatten Body1 reads `submittedAt` (camelCase); snake_case never matched.
        submittedAt: new Date().toISOString(),
        _meta: {
          reference,
          page: window.location.pathname,
          user_agent: navigator.userAgent,
          referrer: document.referrer || '',
        },
      });
      foldAfterHours(payload as Record<string, unknown>);

      // ตาข่ายในหน้าเดิม — ใช้เมื่อ redirect ไป /thank-you ไม่ทำงาน
      // (in-app browser ของ IG/LINE กลืน redirect · เป็นเหตุผลเดียวกับที่ booking.astro ต้องมี)
      const revealInlineSuccess = () => {
        if (form.classList.contains('hidden')) return;
        form.classList.add('hidden');
        if (success) {
          const note = document.createElement('p');
          note.className = 'mt-4 text-sm leading-relaxed text-warm-ink/75';
          note.innerHTML = `บันทึกไว้แล้วครับ · Reference: <code class="font-mono font-bold">${reference}</code>`
            + '<br/>ทัก LINE พร้อมส่งรหัสนี้มา ผมจะตอบได้เร็วขึ้น';
          success.appendChild(note);
          success.classList.remove('hidden');
        }
        success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      };

      const done = () => {
        // eventID = reference ตัวเดียวกับที่ /thank-you จะยิง → Meta dedupe ให้ ไม่นับซ้ำ
        if (typeof pageWindow.fbq === 'function') {
          pageWindow.fbq('track', 'Lead', { content_name: leadEvent, content_ids: [code], lead_temp: payload.lead_temp }, { eventID: reference });
        }
        if (typeof pageWindow.ttq?.track === 'function') pageWindow.ttq.track('SubmitForm', { content_name: leadEvent, lead_temp: payload.lead_temp });

        // Sales Funnel v2 (2026-09-03): หน้าหลังส่งฟอร์ม = Decision Hub ที่ /thank-you
        // ไม่ใช่การ์ด "รับข้อมูลแล้ว" ในหน้าเดิม — ที่นั่นมีรหัสอ้างอิง ปุ่ม LINE
        // และคำสัญญาขั้นถัดไปที่มีวัน (นัดคอล 25 นาที เสนอ 2 ช่วงเวลา)
        // ถ้าจบที่การ์ดในหน้า ดีลจะไม่มี Commitment Anchor ซึ่งคือปัญหาที่ funnel ใหม่ตั้งใจแก้
        const hub = new URL('/thank-you', window.location.origin);
        hub.searchParams.set('type', 'booking');
        hub.searchParams.set('ref', reference);
        hub.searchParams.set('package', code);
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'ttclid'].forEach((k) => {
          const v = String(payload[k] ?? '');
          if (v) hub.searchParams.set(k, v);
        });
        window.location.href = hub.toString();
        setTimeout(revealInlineSuccess, 800);
      };

      if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
      error?.classList.add('hidden');

      try {
        const response = await fetch(WEBHOOK, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          keepalive: true,
        });
        if (!response.ok) throw new Error('submission failed');
        done();
      } catch {
        // form-hook (มินิ) ไม่ตอบ → ชั้น 2: เขียน Supabase ตรง — การ์ดแจ้งเตือนมาจาก DB trigger → guardian
        if (await submitLeadFallback(payload as Record<string, unknown>, makeReference())) {
          done();
          return;
        }
        if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว — ข้อมูลยังไม่ถึงผม กรุณาลองใหม่ หรือแอด LINE เพื่อส่งโจทย์ให้ผม'; error.classList.remove('hidden'); }
        if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูล'; }
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach(bind);

  // ปุ่ม "จองคิวรับบริการ" ที่กระจายอยู่หลายจุดบนหน้า ชี้ไป /booking อยู่แล้ว
  // ถ้าหน้านี้มีฟอร์มอยู่ในตัว ให้เลื่อนลงมาหาฟอร์มแทนการย้ายหน้า — ปิดจุดหล่น
  // 1 จุด และทำให้ conversion ถูกนับที่ "ส่งฟอร์มสำเร็จ" ไม่ใช่ "กดปุ่ม"
  // ไม่มี JS → ลิงก์เดิมยังพาไป /booking ได้ตามปกติ
  const localForm = document.querySelector('[data-lead-form-section]');
  if (localForm) {
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const cta = event.target.closest('a[data-booking-cta]');
      if (!(cta instanceof HTMLAnchorElement)) return;
      event.preventDefault();
      // หน้าสินค้ายาวมาก (T4 ~68,000px) — smooth scroll ระยะขนาดนั้นใช้เวลาหลายวินาที
      // และดูเหมือนปุ่มไม่ทำงาน · ใกล้ค่อยเลื่อนนุ่ม ไกลให้กระโดดไปเลย
      const distance = Math.abs(localForm.getBoundingClientRect().top);
      localForm.scrollIntoView({ behavior: distance > 2500 ? 'auto' : 'smooth', block: 'start' });
      (localForm.querySelector('input[name="name"]') as HTMLInputElement | null)?.focus({ preventScroll: true });
    });
  }
</script>
