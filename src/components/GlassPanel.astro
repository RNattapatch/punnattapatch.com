---
interface Props {
  class?: string;
  elevated?: boolean;
  glow?: 'coral' | 'cyan' | 'navy';
}
const { class: className = '', elevated = false, glow } = Astro.props;
---

<div class:list={['glass-panel', { elevated }, glow && `glow-${glow}`, className]}>
  <slot />
</div>

<style>
  /* Editorial card — ivory/sand paper, ink border, no blur/glow */
  .glass-panel {
    background: var(--pun-surface-1);
    border: 1px solid var(--pun-border);
    border-radius: var(--pun-radius-panel);
  }
  .glass-panel.elevated {
    background: #ffffff;
    box-shadow: 3px 5px 0 rgba(30, 27, 22, 0.06);
  }
  /* glow variants → subtle accent left-border on paper */
  .glass-panel.glow-coral { border-left: 3px solid var(--pun-coral); }
  .glass-panel.glow-cyan  { border-left: 3px solid var(--pun-navy); }
  .glass-panel.glow-navy  { border-left: 3px solid var(--pun-navy); }
</style>
