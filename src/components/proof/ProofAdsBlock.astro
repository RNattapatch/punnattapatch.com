---
/**
 * ProofAdsBlock.astro — หลักฐาน "ระบบเดียว" สำหรับหน้ายิงแอด
 *
 * คนกดมาจากโฆษณาใจร้อนกว่าคนเข้าหน้าแรกมาก จึงใส่ระบบเดียวที่ตรงกับสัญญาในแอดนั้น
 * ไม่ใช่ห้าระบบ — และ **ห้ามมีลิงก์ออกนอกหน้า** (ไม่ลิงก์ /proof) CTA ชี้ฟอร์มของหน้าเท่านั้น
 */
import { getProofSystem } from '../../data/proofSystems';
import ProofShot from './ProofShot.astro';

interface Props {
  /** id จาก PROOF_SYSTEMS เช่น 'line-agent' | 'command-center' */
  systemId: string;
  /** anchor ของฟอร์มในหน้านั้น เช่น '#dealer-ai-form' */
  formAnchor: string;
  ctaLabel?: string;
  /** สองบรรทัดที่เขียนให้ตรงกับความเจ็บของหน้านั้น (ไม่ใส่ = ใช้ของกลางจาก data) */
  lead?: string;
  body?: string;
}

const { systemId, formAnchor, ctaLabel = 'คุยเรื่องทีมของคุณ ฟรี 15 นาที', lead, body } = Astro.props;
const system = getProofSystem(systemId);
---

{system && (
  <section class="border-y border-[#c9c2b2] bg-sand px-5 py-16 md:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-8 md:grid-cols-2 md:gap-12">
      <ProofShot image={system.images[system.heroImage]} sizes="(min-width: 768px) 50vw, 100vw" />

      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-coral">
          ผมใช้ระบบนี้เองอยู่ทุกวัน
        </p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-navy md:text-4xl">
          {lead ?? system.title}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-warm-ink/80">{body ?? system.what}</p>
        <p class="mt-3 leading-relaxed text-warm-ink/70">{system.cost}</p>

        <a
          href={formAnchor}
          class="mt-8 inline-flex min-h-11 items-center justify-center rounded-xl bg-coral px-6 py-3.5 font-semibold text-white transition hover:opacity-90 active:scale-[0.98]"
        >
          {ctaLabel}
        </a>
      </div>
    </div>
  </section>
)}
