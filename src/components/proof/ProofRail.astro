---
/**
 * ProofRail.astro — ตัวย่อของ "ระบบที่ผมใช้เอง" สามภาพ + หนึ่งบรรทัด
 *
 * aside   → ข้างฟอร์มบน /booking · หน้านั้นไม่ได้มีหน้าที่ขายแล้ว มีหน้าที่ทำให้คนกรอกจนจบ
 *           สามภาพคือเพดาน ใส่เยอะกว่านี้คนยิ่งกรอกไม่จบ
 * article → ท้ายบทความ insights · เขียนที่เดียว เปลี่ยนทุกบทความ
 */
import { PROOF_RAIL_IMAGES } from '../../data/proofSystems';

interface Props {
  variant?: 'aside' | 'article';
  class?: string;
}

const { variant = 'aside', class: klass = '' } = Astro.props;
---

<aside
  class:list={[
    'rounded-2xl border border-[#c9c2b2] bg-surface p-5 md:p-6',
    variant === 'article' && 'mt-14',
    klass,
  ]}
>
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">
    {variant === 'article' ? 'อ่านจบแล้วอยากดูของจริง' : 'ก่อนกดส่ง'}
  </p>

  <p class="mt-3 font-display text-lg font-bold leading-snug text-navy">
    {variant === 'article'
      ? 'ระบบที่ผมเขียนถึง ผมใช้เองอยู่ทุกวัน'
      : 'คนที่คุณกำลังจะคุยด้วย ใช้ระบบพวกนี้ทำงานอยู่ทุกวัน'}
  </p>

  <div class="mt-4 grid grid-cols-3 gap-2">
    {PROOF_RAIL_IMAGES.map((image) => (
      <img
        src={image.src.replace(/\.jpg$/, '@320.jpg')}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full rounded-lg border border-[#c9c2b2] object-cover object-top"
      />
    ))}
  </div>

  <p class="mt-4 text-sm leading-relaxed text-warm-ink/70">
    ภาพจริงจากระบบผมเอง เบลอชื่อและยอดเงินของลูกค้าไว้
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
    <a
      href="/proof"
      class="inline-flex items-center text-sm font-semibold text-navy underline decoration-coral/50 decoration-2 underline-offset-[6px] transition hover:decoration-coral"
    >
      ดูทั้งห้าระบบ →
    </a>
    {variant === 'article' && (
      <a
        href="/booking"
        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-coral px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90 active:scale-[0.98]"
      >
        จองคิวคุยกับผม
      </a>
    )}
  </div>
</aside>
