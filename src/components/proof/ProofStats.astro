---
/**
 * ProofStats.astro — แถบตัวเลขจากระบบจริง
 *
 * ตัวเลข "งาน" ล้วน ไม่มีตัวเงิน — ตัวเงินคือ P&L ของธุรกิจตัวเอง ไม่ควรอยู่หน้าแรก
 * และคนที่กำลังจะดูราคาไม่ควรเอายอดของปันไปเทียบกับค่าบริการ
 */
import { PROOF_STATS, PROOF_NOTE } from '../../data/proofSystems';

interface Props {
  /** hero = กะทัดรัดใต้ปุ่ม CTA · section = เต็มพร้อมบรรทัดกำกับ */
  variant?: 'hero' | 'section';
  class?: string;
}

const { variant = 'section', class: klass = '' } = Astro.props;
---

<div class:list={[klass]}>
  <dl
    class:list={[
      'grid overflow-hidden rounded-2xl border border-[#c9c2b2] bg-surface',
      variant === 'hero'
        ? 'grid-cols-2 lg:grid-cols-4'
        : 'grid-cols-2 md:grid-cols-4',
    ]}
  >
    {PROOF_STATS.map((stat, i) => (
      <div
        class:list={[
          'p-4 md:p-5',
          i % 2 === 1 && 'border-l border-[#c9c2b2]',
          i >= 2 && 'border-t border-[#c9c2b2]',
          'md:border-t-0 md:border-l',
          i === 0 && 'md:border-l-0',
        ]}
      >
        <dt class="sr-only">{stat.label}</dt>
        <dd>
          <span class="block font-display text-3xl font-bold tabular-nums leading-none text-navy">
            {stat.value}
          </span>
          <span class="mt-2 block text-[0.8rem] leading-snug text-muted">{stat.label}</span>
        </dd>
      </div>
    ))}
  </dl>

  {variant === 'section' && (
    <p class="mt-3 text-xs leading-relaxed text-muted">{PROOF_NOTE}</p>
  )}
</div>
