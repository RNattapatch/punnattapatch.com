---
/**
 * ConsultBusinessOS.astro — บล็อก "ระบบที่ผมใช้เอง" เฉพาะหน้า Consult (2026-10-14)
 *
 * แทน <ProofSystems context="consult" /> ที่ยาว 9,500px บนมือถือ
 * ลำดับ: ภาพใหญ่ก่อน (ข้อมูลรวมที่เดียว + AI หลายตัวทำงานบนนั้น) → 5 ระบบเรียงตามที่ลูกค้า Consult เลือกจริง
 * แต่ละระบบเป็นการ์ดกวาดตา (ภาพจริง 1 ใบ + ตัวเลขจริง 1 บรรทัด) · รายละเอียดกับภาพเพิ่มอยู่ในส่วนที่กดเปิด
 * → ตอบตัวขวางอันดับ 1 ของ Funnel Lab ("อยากเห็นเคส/หลักฐานก่อน") โดยไม่ทำให้หน้ายาวขึ้น
 * ข้อมูล: src/data/consultSystems.ts
 */
import { CONSULT_HUB, CONSULT_SYSTEMS } from '../../data/consultSystems';
import { PROOF_THINKING_STEPS } from '../../data/proofSystems';
import ProofShot from './ProofShot.astro';
import { FORM_CTA_LABEL, lineLinkClass } from '../../data/product-details/cta-policy';
import { SITE } from '../../data/site';

const MARKS = ['①', '②', '③', '④', '⑤'];
const portrait = (frame: string) => frame !== 'browser';
---

<section
  id="proof-systems"
  data-consult-proof-systems
  data-consult-business-os
  aria-labelledby="consult-os-heading"
  class="scroll-mt-20 border-y border-[#c9c2b2] bg-sand/55 px-margin-page py-14 md:py-20"
>
  <div class="mx-auto max-w-6xl">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold text-coral">{CONSULT_HUB.eyebrow}</p>
      <h2 id="consult-os-heading" class="mt-3 text-balance font-display text-3xl font-bold leading-tight text-navy md:text-5xl">
        {CONSULT_HUB.heading}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-warm-ink/80">{CONSULT_HUB.lead}</p>
    </header>

    <!-- ภาพใหญ่: ข้อมูลรวมที่เดียว -->
    <div data-consult-hub class="mt-8 grid gap-5 rounded-3xl border border-[#c9c2b2] bg-surface p-5 shadow-sm md:grid-cols-[.9fr_1.1fr] md:items-center md:gap-8 md:p-8">
      <div>
        <p class="text-sm font-semibold text-warm-ink/70">ข้อมูลรวมที่เดียว</p>
        <ul class="mt-3 flex flex-wrap gap-2" aria-label="ข้อมูลที่รวมไว้ที่เดียว">
          {CONSULT_HUB.dataChips.map((chip) => (
            <li class="rounded-full bg-navy px-3 py-1.5 text-sm font-semibold text-ivory">{chip}</li>
          ))}
        </ul>
        <p class="mt-4 leading-relaxed text-warm-ink/80">{CONSULT_HUB.hubCaption}</p>
      </div>
      <ProofShot image={CONSULT_HUB.hubImage} sizes="(min-width: 768px) 55vw, 100vw" />
    </div>
    <p data-consult-hub-arrow class="mt-5 flex items-center justify-center gap-2 font-semibold text-navy">
      <span aria-hidden="true" class="grid size-7 place-items-center rounded-full bg-coral text-sm text-white">↓</span>
      AI 5 ตัวที่ทำงานบนข้อมูลชุดนี้
    </p>

    <!-- 5 ระบบ เรียงตามที่ลูกค้า Consult เลือก -->
    <ol class="mt-4 grid gap-4 md:grid-cols-2" aria-label="AI 5 ตัวที่ผมใช้เอง เรียงตามที่ลูกค้า Consult เลือก">
      {CONSULT_SYSTEMS.map((system, index) => (
        <li
          id={`proof-system-${system.id}`}
          data-consult-system={system.id}
          class:list={[
            'scroll-mt-24 rounded-3xl border bg-surface p-4 shadow-sm sm:p-5',
            system.clientFavourite ? 'border-coral/45' : 'border-[#c9c2b2]',
          ]}
        >
          <article class:list={[portrait(system.thumb.frame) ? 'grid grid-cols-[104px_1fr] gap-4 sm:grid-cols-[128px_1fr]' : 'grid gap-4']}>
            {portrait(system.thumb.frame) ? (
              <figure class="overflow-hidden rounded-2xl border border-[#c9c2b2] bg-ivory">
                <img src={system.thumb.src} alt={system.thumb.alt} width={system.thumb.width} height={system.thumb.height} loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover object-top" />
              </figure>
            ) : null}

            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-warm-ink/70">
                <span aria-hidden="true" class="text-base text-coral">{MARKS[index]}</span>
                <span>{system.tag}</span>
                {system.clientFavourite && (
                  <span data-client-favourite class="rounded-full bg-coral px-2 py-0.5 text-[11px] font-bold text-white">ลูกค้า Consult ชอบที่สุด</span>
                )}
              </p>
              <h3 class="mt-2 text-balance font-display text-lg font-bold leading-snug text-navy sm:text-xl">{system.title}</h3>
              <p class="mt-2 flex items-start gap-2 text-sm font-semibold leading-6 text-[#2f6b4f]">
                <span aria-hidden="true" class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-[#2f7a55] text-[11px] text-white">✓</span>
                <span>{system.proof}</span>
              </p>
            </div>

            {!portrait(system.thumb.frame) && (
              <div class="min-w-0">
                <ProofShot image={system.thumb} sizes="(min-width: 768px) 45vw, 100vw" />
              </div>
            )}
          </article>

          <details data-consult-system-more class="group mt-3 border-t border-[#c9c2b2] pt-2">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral [&::-webkit-details-marker]:hidden">
              ดูว่าทำงานยังไง{system.more.length > 0 ? ` + ภาพจริงอีก ${system.more.length} ภาพ` : ''}
              <span aria-hidden="true" class="text-coral transition-transform group-open:rotate-45 motion-reduce:transition-none">+</span>
            </summary>
            <p class="pb-2 leading-relaxed text-warm-ink/80">{system.detail}</p>
            {system.more.length > 0 && (
              <div class="grid grid-cols-2 gap-3 pb-2">
                {system.more.map((image) => <ProofShot image={image} class={image.frame === 'browser' ? 'col-span-2' : ''} sizes={image.frame === 'browser' ? '(min-width: 768px) 60vw, 100vw' : '(min-width: 768px) 25vw, 50vw'} />)}
              </div>
            )}
          </details>
        </li>
      ))}
    </ol>

    <!-- บล็อกกันเข้าใจผิด: วันแรกไม่ได้ได้ทั้ง 5 ระบบ (ขอบเขตจริงของบริการ) -->
    <div class="mt-10 rounded-3xl bg-navy p-6 text-ivory/85 md:mt-14 md:p-10">
      <h3 class="max-w-2xl font-display text-2xl font-bold leading-snug text-ivory md:text-3xl">วันแรกไม่ได้สร้างทั้งห้าระบบให้เสร็จในวันเดียวครับ</h3>
      <p class="mt-4 max-w-3xl leading-relaxed">
        เราเลือก 2 เรื่องเป็นจุดเริ่ม แล้วลงระบบพื้นฐานของ 2 เรื่องนั้นให้ทีมใช้ เราจะระบุว่าข้อมูลมาจากไหน
        ใครรับผิดชอบ จุดไหนให้ระบบช่วย และจุดไหนต้องให้คนกดยืนยัน เรื่องถัดไปค่อยเพิ่มทีละรอบ
      </p>
      <ol class="mt-6 grid max-w-4xl gap-3 md:grid-cols-2">
        {PROOF_THINKING_STEPS.map((step, index) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-ivory/30 text-xs font-semibold text-ivory">{index + 1}</span>
            <p class="leading-relaxed"><span class="font-semibold text-ivory">{step.lead}</span> {step.tail}</p>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex flex-col items-start gap-3 border-t border-ivory/15 pt-6 sm:flex-row sm:items-center">
        <a href={`/booking?package=C1&intent=track_selection`} data-booking-cta data-contact-cta data-product-code="C1" data-cta-location="after_systems" data-cta-intent="track_selection" data-cta-label={FORM_CTA_LABEL} class="btn min-h-12 w-full border-0 bg-[#c43245] px-6 text-white hover:bg-[#ad293a] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-coral sm:w-auto">{FORM_CTA_LABEL}</a>
        <a href={SITE.social.line} target="_blank" rel="noopener" data-line-cta data-contact-cta data-product-code="C1" data-cta-location="after_systems" data-cta-intent="track_selection" data-cta-keyword="CONSULT" data-cta-label="หรือทัก LINE ให้ผมช่วยเลือกจุดเริ่ม" data-line-as-link class={lineLinkClass(true)}>หรือทัก LINE ให้ผมช่วยเลือกจุดเริ่ม</a>
      </div>
    </div>
  </div>
</section>
