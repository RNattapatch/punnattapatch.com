---
/**
 * ProofCard.astro — ระบบหนึ่งตัว เล่าสามชั้น
 *   1. เกิดอะไรขึ้น (ให้ wow)
 *   2. หลักคิดข้างหลัง (ของที่ปันขายจริง)
 *   3. ถ้าไม่มีระบบนี้จะเจ็บยังไง (ตัวที่ทำให้คนกดจองคิว ไม่ใช่ความว้าว)
 *
 * เลย์เอาต์เดินตามหน้าตาของภาพ ไม่ใช่ตามลำดับการ์ด:
 *   mediaWidth 'side' — ภาพจอมือถือ สูงพอ ๆ กับข้อความ → วางคู่กันซ้าย-ขวา สลับข้างไปมา
 *   mediaWidth 'full' — screenshot เดสก์ท็อป บีบลงครึ่งการ์ดแล้วอ่านไม่ออก → ข้อความอยู่บน ภาพกินเต็มความกว้าง
 *
 * variant="solo" ใช้บนหน้า ads — ภาพเดียว ไม่มีลิงก์ออกนอกหน้า
 */
import type { ProofSystem } from '../../data/proofSystems';
import ProofShot from './ProofShot.astro';
import LineCta from './LineCta.astro';

interface Props {
  system: ProofSystem;
  variant?: 'list' | 'solo';
  index?: number;
  context?: 'default' | 'consult';
}

const { system, variant = 'list', index = 0, context = 'default' } = Astro.props;
const full = variant === 'list' && system.mediaWidth === 'full';
const mediaFirst = !full && index % 2 === 0;
const [hero, ...rest] = system.images;
---

<article
  id={`proof-system-${system.id}`}
  data-proof-system-card
  data-system-id={system.id}
  class:list={[
    'scroll-mt-24',
    full ? 'flex flex-col gap-8' : 'grid items-center gap-6 md:grid-cols-2 md:gap-10',
  ]}
>
  <div class:list={['min-w-0', !full && (mediaFirst ? 'md:order-1' : 'md:order-2')]}>
    {full || variant === 'solo' ? (
      <ProofShot
        image={variant === 'solo' ? system.images[system.heroImage] : hero}
        sizes={full ? '(min-width: 1180px) 1120px, 100vw' : '(min-width: 768px) 50vw, 100vw'}
      />
    ) : system.images.length > 1 ? (
      /* แตกเป็นสองคอลัมน์ที่ lg ขึ้นไปเท่านั้น — ต่ำกว่านั้นการ์ดหาร 2 อยู่แล้ว (md:grid-cols-2)
         ถ้าคู่ภาพหารอีกชั้น จะเหลือใบละ ~155px แล้วอ่านข้อความในแชทไม่ออก
         ซึ่งฆ่าเหตุผลทั้งหมดของการเอาภาพมาลง (คนต้องอ่านได้ว่า Agent พูดอะไร) */
      <div class="grid grid-cols-1 items-start gap-3 lg:grid-cols-2">
        {system.images.map((image) => (
          <ProofShot image={image} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" />
        ))}
      </div>
    ) : (
      <ProofShot image={hero} />
    )}

    {full && rest.length > 0 && (
      <div class:list={['mt-3 grid gap-3', rest.length > 1 ? 'sm:grid-cols-2' : '']}>
        {rest.map((image) => (
          <ProofShot image={image} sizes="(min-width: 1180px) 550px, 100vw" />
        ))}
      </div>
    )}
  </div>

  <div
    class:list={[
      'min-w-0',
      full ? 'order-first max-w-3xl' : mediaFirst ? 'md:order-2' : 'md:order-1',
    ]}
  >
    <p class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-muted">
      {system.letters.map((letter) => (
        <span class="grid size-6 place-items-center rounded-md bg-navy font-display text-sm font-bold text-ivory">
          {letter}
        </span>
      ))}
      <span>{system.tagLabel}</span>
    </p>

    <h3 class="mt-3 font-display text-2xl font-bold text-navy md:text-3xl">{system.title}</h3>
    {context === 'consult' && (
      <p data-consult-outcome-detail class="mt-4 rounded-2xl border border-coral/20 bg-coral/5 p-4 font-semibold leading-relaxed text-navy">
        <span class="mb-1 block text-xs uppercase tracking-[0.14em] text-coral">{system.consultMoment}</span>
        {system.consultOutcome}
      </p>
    )}
    <p class="mt-3 leading-relaxed text-warm-ink/75">{system.what}</p>

    <blockquote class="my-6 border-l-[3px] border-coral pl-5">
      <p class="font-display text-lg font-bold leading-snug text-navy">{system.whyLead}</p>
      <p class="mt-2 text-[0.95rem] leading-relaxed text-warm-ink/75">{system.whyBody}</p>
    </blockquote>

    <p class="flex gap-2 text-sm leading-relaxed text-coral">
      <span aria-hidden="true" class="font-bold">&times;</span>
      <span>{system.cost}</span>
    </p>

    {variant === 'list' && context === 'default' && system.lineCta && (
      <LineCta lead={system.lineCta} class="mt-7 rounded-2xl border border-[#c9c2b2] bg-sand p-5" />
    )}
  </div>
</article>
