---
// Auth gate for the Marketing War Room — same Google FedCM → Supabase flow as
// the dashboard PinGate, but decoupled from the dashboard store (no CRM refresh
// on login). Reveals #war-room-app when a Supabase session exists.
---
<section id="wr-gate" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-base-100 px-6">
  <div class="flex flex-col items-center gap-8 w-full max-w-xs">
    <div class="text-center">
      <div class="w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4" style="background-color:var(--color-brand-coral);">
        <span class="text-white text-2xl">🎬</span>
      </div>
      <h1 class="text-xl font-display font-semibold">Marketing War Room</h1>
      <p class="text-sm opacity-60 mt-1">เข้าสู่ระบบด้วยบัญชี Google</p>
    </div>

    <button
      id="wr-g-signin"
      type="button"
      disabled
      class="flex items-center justify-center gap-3 w-[280px] h-11 rounded-full bg-white text-[#1f1f1f] text-sm font-medium shadow-sm transition hover:bg-gray-100 active:scale-[0.99] disabled:opacity-60 disabled:cursor-wait"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.616z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.583-5.036-3.71H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
        <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
      </svg>
      <span>ลงชื่อเข้าใช้ด้วย Google</span>
    </button>

    <div id="wr-gate-error" class="text-error text-sm min-h-[1.25rem] text-center" role="alert" aria-live="polite"></div>
  </div>
</section>

<script>
  import { signInToSupabase, getSupabaseSession } from '../../scripts/dashboard/supabase';
  import { GOOGLE_CLIENT_ID } from '../../scripts/dashboard/auth-config';

  type CredentialResponse = { credential?: string };
  type PromptNotification = { isNotDisplayed?: () => boolean; isSkippedMoment?: () => boolean };
  type GoogleId = {
    initialize: (cfg: {
      client_id: string;
      callback: (r: CredentialResponse) => void;
      auto_select?: boolean;
      use_fedcm_for_prompt?: boolean;
      cancel_on_tap_outside?: boolean;
      nonce?: string;
    }) => void;
    prompt: (listener?: (n: PromptNotification) => void) => void;
  };

  const errEl = document.getElementById('wr-gate-error');
  const btn = document.getElementById('wr-g-signin') as HTMLButtonElement | null;

  function reveal(authed: boolean) {
    document.getElementById('wr-gate')?.classList.toggle('hidden', authed);
    document.getElementById('war-room-app')?.classList.toggle('hidden', !authed);
    if (authed) document.dispatchEvent(new CustomEvent('war-room:authed'));
  }

  // Restore persisted Supabase session on load.
  void (async () => {
    const session = await getSupabaseSession();
    if (session) reveal(true);
  })();

  let rawNonce = '';
  async function makeNonce(): Promise<{ raw: string; hashed: string }> {
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    const raw = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(raw));
    const hashed = Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join('');
    return { raw, hashed };
  }

  async function onCredential(resp: CredentialResponse) {
    if (!resp?.credential) {
      if (errEl) errEl.textContent = 'ไม่ได้รับสิทธิ์จาก Google';
      if (btn) btn.disabled = false;
      return;
    }
    if (errEl) errEl.textContent = 'กำลังตรวจสอบสิทธิ์...';
    const ok = await signInToSupabase(resp.credential, rawNonce);
    if (ok) {
      if (errEl) errEl.textContent = '';
      reveal(true);
    } else {
      if (errEl) errEl.textContent = 'เข้าสู่ระบบไม่สำเร็จ — ลองใหม่อีกครั้ง';
      if (btn) btn.disabled = false;
    }
  }

  async function initGoogle(attempt = 0) {
    const gid = (window as unknown as { google?: { accounts?: { id?: GoogleId } } }).google?.accounts?.id;
    if (!gid) {
      if (attempt > 50) { if (errEl) errEl.textContent = 'โหลด Google Sign-In ไม่สำเร็จ'; return; }
      setTimeout(() => { void initGoogle(attempt + 1); }, 100);
      return;
    }
    const { raw, hashed } = await makeNonce();
    rawNonce = raw;
    gid.initialize({
      client_id: GOOGLE_CLIENT_ID,
      callback: onCredential,
      auto_select: false,
      use_fedcm_for_prompt: true,
      cancel_on_tap_outside: true,
      nonce: hashed,
    });
    if (btn) {
      btn.disabled = false;
      btn.addEventListener('click', () => {
        if (errEl) errEl.textContent = '';
        btn.disabled = true;
        gid.prompt((n) => {
          if (n && (n.isNotDisplayed?.() || n.isSkippedMoment?.())) {
            if (btn) btn.disabled = false;
            if (errEl) errEl.textContent = 'กดอีกครั้งเพื่อเข้าสู่ระบบ';
          }
        });
      });
    }
  }

  void initGoogle();
</script>
