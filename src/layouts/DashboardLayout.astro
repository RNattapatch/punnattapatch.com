---
import '../styles/global.css';
const { title = 'Dashboard — Pun' } = Astro.props;
---
<!doctype html>
<html lang="th" data-theme="punpaper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#F4F1EA" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pun_dash_theme');
          if (t === 'pundark' || t === 'punpaper') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline src="https://cdn.jsdelivr.net/npm/apexcharts@4.4.0/dist/apexcharts.min.js"></script>
    <style>
      :root {
        --font-brand: "Sukhumvit Set", Tahoma, "Helvetica Neue", sans-serif;
      }
      html, body {
        font-family: var(--font-brand);
      }
      .font-display {
        font-family: var(--font-brand);
      }
      button, .btn, .card, input, textarea, select, .badge, .chip {
        font-family: inherit;
      }
      body {
        min-height: 100dvh;
        background: var(--color-base-100);
        color: var(--color-base-content);
      }
      .tap-44 {
        min-width: 44px;
        min-height: 44px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
