---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = 'นโยบายความเป็นส่วนตัว';
const description = 'นโยบายความเป็นส่วนตัวสำหรับการติดต่อ รับคำปรึกษา และใช้บริการ Pun Nattapatch';
---

<BaseLayout title={title} description={description} schema={{ types: ['WebPage'], title, description }}>
  <section class="px-6 py-16 md:py-24">
    <article class="prose prose-lg mx-auto max-w-3xl prose-headings:font-display prose-headings:text-navy prose-p:text-warm-ink/80 prose-li:text-warm-ink/80">
      <p class="text-sm font-semibold text-cyan">Privacy Policy · Updated 21 July 2026</p>
      <h1>นโยบายความเป็นส่วนตัว</h1>
      <p>นโยบายนี้อธิบายว่าปัน ณัฐพัชร์ ผู้ให้บริการที่จดทะเบียนในประเทศไทย เก็บ ใช้ และดูแลข้อมูลส่วนบุคคลอย่างไร เมื่อคุณกรอกแบบฟอร์ม ติดต่อผ่านเว็บไซต์ หรือทัก LINE Official Account เพื่อขอคำปรึกษาและใช้บริการ</p>
      <h2>ข้อมูลที่เก็บ</h2>
      <p>เราเก็บเฉพาะข้อมูลที่คุณให้โดยสมัครใจ เช่น ชื่อ บริษัท ตำแหน่ง ช่องทางติดต่อ ขนาดทีม โจทย์ทางธุรกิจ งบประมาณที่สนใจ และข้อมูลการเข้าชมที่จำเป็นต่อการวัดผลแคมเปญ</p>
      <h2>ใช้ข้อมูลไปทำอะไร</h2>
      <ul><li>ติดต่อกลับเพื่อนัดคุย ตอบคำถาม หรือประเมินความเหมาะสมของบริการ</li><li>เตรียมข้อมูลเพื่อให้คำปรึกษาและดูแลลูกค้าที่เลือกใช้บริการ</li><li>วัดผลและปรับปรุงเว็บไซต์หรือแคมเปญ โดยใช้ข้อมูลแบบจำเป็นเท่านั้น</li></ul>
      <h2>การเปิดเผยและระยะเวลาเก็บ</h2>
      <p>เราไม่ขายหรือส่งต่อข้อมูลส่วนบุคคลให้บุคคลที่สามเพื่อการตลาดของเขา ข้อมูลอาจถูกประมวลผลโดยผู้ให้บริการระบบที่จำเป็นต่อการรับแบบฟอร์มและดูแลลูกค้า ภายใต้ขอบเขตที่จำเป็น และจะเก็บไว้เท่าที่จำเป็นต่อวัตถุประสงค์ข้างต้นหรือตามกฎหมาย</p>
      <h2>สิทธิของคุณ</h2>
      <p>คุณขอเข้าถึง แก้ไข คัดค้าน หรือขอลบข้อมูลส่วนบุคคลได้ รวมถึงถอนความยินยอมได้ทุกเมื่อ โดยทัก <a href={SITE.social.line} target="_blank" rel="noopener">LINE Official Account</a> และแจ้งชื่อกับช่องทางติดต่อที่ใช้กรอกแบบฟอร์ม เราจะดำเนินการตามกฎหมายคุ้มครองข้อมูลส่วนบุคคลของไทย</p>
      <h2>การเปลี่ยนแปลงนโยบาย</h2>
      <p>หากมีการปรับนโยบาย เราจะอัปเดตหน้านี้พร้อมวันที่แก้ไขล่าสุด</p>
    </article>
  </section>
</BaseLayout>
