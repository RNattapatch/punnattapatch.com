---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = 'นโยบายความเป็นส่วนตัว';
const description = 'นโยบายความเป็นส่วนตัวสำหรับการติดต่อ รับคำปรึกษา และใช้บริการ Pun Nattapatch';
---

<!-- noindex: หน้ากฎหมาย ไม่ใช่หน้าที่อยากให้ติดค้นหา — แต่ยังลิงก์จาก footer และเปิดตรงได้
     (ต้องเปิดได้จริง เพราะเป็น Privacy / ToS / Data-deletion URL ของแอป Messenger) -->
<BaseLayout title={title} description={description} noindex schema={{ types: ['WebPage'], title, description }}>
  <section class="px-6 py-16 md:py-24">
    <article class="prose prose-lg mx-auto max-w-3xl prose-headings:font-display prose-headings:text-navy prose-p:text-warm-ink/80 prose-li:text-warm-ink/80">
      <p class="text-sm font-semibold text-cyan">Privacy Policy · Updated 11 August 2026</p>
      <h1>นโยบายความเป็นส่วนตัว</h1>
      <p>นโยบายนี้อธิบายว่าปัน ณัฐพัชร์ ผู้ให้บริการที่จดทะเบียนในประเทศไทย เก็บ ใช้ และดูแลข้อมูลส่วนบุคคลอย่างไร เมื่อคุณกรอกแบบฟอร์ม ติดต่อผ่านเว็บไซต์ หรือทักเข้ามาทางช่องทางแชท ได้แก่ <strong>LINE Official Account</strong> และ <strong>Facebook Messenger (เพจ Pun Nattapatch)</strong> เพื่อขอคำปรึกษาและใช้บริการ</p>
      <h2>ข้อมูลที่เก็บ</h2>
      <p>เราเก็บเฉพาะข้อมูลที่คุณให้โดยสมัครใจ เช่น ชื่อ บริษัท ตำแหน่ง ช่องทางติดต่อ ขนาดทีม โจทย์ทางธุรกิจ งบประมาณที่สนใจ และข้อมูลการเข้าชมที่จำเป็นต่อการวัดผลแคมเปญ</p>
      <p>เมื่อคุณทักเข้ามาทางแชท เราจะได้รับและจัดเก็บเพิ่มเติมดังนี้:</p>
      <ul>
        <li><strong>ชื่อที่แสดงและรหัสผู้ใช้ของแพลตฟอร์ม</strong> — LINE user ID หรือ Facebook Page-Scoped ID (PSID) พร้อมรูปโปรไฟล์ ซึ่งแพลตฟอร์มส่งมาให้เพื่อให้เราตอบกลับคุณได้ถูกคน · รหัสเหล่านี้ใช้ได้เฉพาะกับช่องทางของเราเท่านั้น ไม่ใช่บัญชีส่วนตัวของคุณ</li>
        <li><strong>เนื้อหาข้อความในบทสนทนา</strong> — เก็บไว้เพื่อให้คุยต่อเนื่องได้โดยไม่ต้องเล่าซ้ำ และเพื่อให้คุณปันตามงานต่อได้</li>
      </ul>
      <h2>ผู้ช่วย AI ที่ตอบแชท</h2>
      <p>ช่องทางแชทของเรามีผู้ช่วย AI ช่วยตอบในช่วงที่คุณปันติดงานลูกค้า ผู้ช่วยจะแจ้งตัวเองว่าเป็นบอทเสมอ ไม่แอบอ้างเป็นคน และคุณปันเป็นผู้อ่านและดูแลบทสนทนาเองทั้งหมด หากต้องการคุยกับคนโดยตรง พิมพ์บอกในแชทได้ทุกเมื่อ</p>
      <p>ข้อความของคุณถูกส่งไปประมวลผลกับผู้ให้บริการโมเดลภาษาเพื่อสร้างคำตอบเท่านั้น ไม่ถูกนำไปใช้ฝึกโมเดลสาธารณะ</p>
      <h2>การเปิดเผยและระยะเวลาเก็บ</h2>
      <p>เราไม่ขายหรือส่งต่อข้อมูลส่วนบุคคลให้บุคคลที่สามเพื่อการตลาดของเขา ข้อมูลอาจถูกประมวลผลโดยผู้ให้บริการระบบที่จำเป็นต่อการรับแบบฟอร์ม ดูแลลูกค้า และให้บริการผู้ช่วย AI ภายใต้ขอบเขตที่จำเป็น และจะเก็บไว้เท่าที่จำเป็นต่อวัตถุประสงค์ข้างต้นหรือตามกฎหมาย</p>
      <h2>สิทธิของคุณ</h2>
      <p>คุณขอเข้าถึง แก้ไข คัดค้าน หรือขอลบข้อมูลส่วนบุคคลได้ รวมถึงถอนความยินยอมได้ทุกเมื่อ เราจะดำเนินการตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA)</p>
      <h2 id="data-deletion">วิธีขอลบข้อมูลของคุณ</h2>
      <p>ขอให้ลบข้อมูลทั้งหมดที่เรามีเกี่ยวกับคุณได้ด้วยวิธีใดวิธีหนึ่งต่อไปนี้:</p>
      <ol>
        <li>ทัก <a href={SITE.social.line} target="_blank" rel="noopener">LINE Official Account</a> หรือ <strong>Facebook Messenger ของเพจ Pun Nattapatch</strong> แล้วพิมพ์ว่า <strong>“ขอลบข้อมูล”</strong></li>
        <li>หรือส่งอีเมลมาที่ <a href={`mailto:${SITE.email}`}>{SITE.email}</a> พร้อมระบุชื่อและช่องทางที่เคยติดต่อเข้ามา</li>
      </ol>
      <p>เมื่อได้รับคำขอ เราจะลบประวัติบทสนทนา ข้อมูลผู้ติดต่อ และรหัสผู้ใช้ของแพลตฟอร์มที่ผูกกับคุณออกจากระบบภายใน <strong>30 วัน</strong> แล้วแจ้งยืนยันกลับทางช่องทางที่คุณติดต่อมา ยกเว้นข้อมูลที่กฎหมายกำหนดให้ต้องเก็บไว้ เช่น เอกสารทางบัญชีของลูกค้าที่ใช้บริการแล้ว</p>
      <h2>การเปลี่ยนแปลงนโยบาย</h2>
      <p>หากมีการปรับนโยบาย เราจะอัปเดตหน้านี้พร้อมวันที่แก้ไขล่าสุด</p>
    </article>
  </section>
</BaseLayout>
