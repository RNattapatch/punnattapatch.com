---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DarumaMark from '../components/DarumaMark.astro';
import Manifesto from '../components/Manifesto.astro';
import ProofSystems from '../components/proof/ProofSystems.astro';
import ProofStats from '../components/proof/ProofStats.astro';
import { SITE } from '../data/site';
import { fmtPrice, CATALOG } from '../data/pricing.mjs';
import ceoPhoto from '../assets/pun-ceo-1.jpg';

const title = 'ปั้นทีมขายให้เป็นระบบ × AI Agent และ Claude Code';
const description = 'ปั้นทีมขาย SME ให้เปลี่ยนจากการพึ่งคนเก่งและความรู้สึก สู่ระบบที่ทำซ้ำ วัดผล และใช้ AI Agent ทำงานจริง';
const daruma = [
  ['D', 'Data', 'ข้อมูลบ้านเดียว', 'ลูกค้า/ดีล/ราคา ไม่อยู่ในหัวหรือไลน์ส่วนตัวของใครคนเดียว ("สมองที่สอง")'],
  ['A', 'AI Agent', 'น้องฝึกงานที่รู้จักบริษัทคุณ', 'งานซ้ำ (เอกสาร·ใบเสนอราคา·follow-up) มี AI รับไป เซลล์เอาเวลาไปอยู่หน้าลูกค้า'],
  ['R', 'Repeatable', 'ทำซ้ำได้ ไม่วัดดวง', 'ขั้นตอนขายที่ใครทำตามก็ได้ผลใกล้เคียง ยอดไม่ผูกกับพรสวรรค์คนเดียว'],
  ['U', 'Upskill', 'คนเก่งขึ้นพร้อมระบบ', 'พัฒนาคนบนระบบ ไม่ใช่ให้ระบบแขวนกับคน (พี่เลี้ยงเซลล์ AI · Product Specialist AI)'],
  ['M', 'Measurable', 'วัดได้ ไม่ใช้ความรู้สึก', 'KPI · Bus Factor · ก่อน/หลัง — ประชุมเถียงกันด้วยตัวเลข'],
  ['A', 'Actionable', 'ทำทันที ใช้จริงวันจันทร์เช้า', 'ของทุกชิ้นเปิดใช้ได้จริง ไม่จบแค่รู้ (จิตวิญญาณดารุมะ: ล้มแล้วลุกเลย)'],
];
const pains = [
  ['ยอดเดาไม่ได้', 'เดือนนี้ปิดรัว เดือนหน้าเงียบกริบ ทุกดีลเหมือนวัดดวง'],
  ['ระบบอยู่ในหัวคนเก่งคนเดียว', 'เซลล์เก่งสุดลาออกทีไร ลูกค้าหายไปด้วยทุกที'],
  ['ข้อมูลกระจายทุกที่', 'ลูกค้า ราคา และดีลอยู่ในไลน์ส่วนตัวกับความจำของแต่ละคน ประชุมทีไรก็เถียงกันด้วยความรู้สึก'],
];
const clientLogos = [
  { src: '/logos/clients/futureskill.png', alt: 'FutureSkill' },
  { src: '/logos/clients/hfc-healthfoods.png', alt: 'HFC HealthFoods Corporation' },
  { src: '/logos/clients/home-plus.png', alt: 'ฮ.โฮมพลัส' },
  { src: '/logos/clients/ving.png', alt: 'V!NG' },
  { src: '/logos/clients/farevefarm.jpg', alt: 'Farevefarm' },
  { src: '/logos/clients/farmsuk.jpg', alt: 'ฟาร์มสุข farmsuk' },
  { src: '/logos/clients/business-boy.jpg', alt: 'เด็กประกอบการ The Business Boy' },
  { src: '/logos/clients/gpx.jpg', alt: 'GPX' },
  { src: '/logos/clients/aes.jpg', alt: 'AES' },
  { src: '/logos/clients/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/logos/clients/zontes.png', alt: 'Zontes' },
  { src: '/logos/clients/nissan.png', alt: 'Nissan' },
  { src: '/logos/clients/lambretta.png', alt: 'Lambretta' },
  { src: '/logos/clients/nsscrap.avif', alt: 'NSSCRAP' },
  { src: '/logos/clients/scenery-farm.jpeg', alt: 'Scenery' },
  { src: '/logos/clients/ud-clinic.jpg', alt: 'UD Clinic' },
];
const testimonials = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{ types: ['WebPage', 'Person'], title, description }}
>
  <section id="homepage-hero" class="border-b border-[#c9c2b2] bg-ivory px-6 py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-9 lg:grid-cols-[1.15fr_.85fr]">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">ปัน ณัฐพัชร์ · ปั้นทีมขาย × AI Agent</p>
        <h1 class="mt-5 font-display font-bold text-navy">
          <span class="block text-4xl leading-tight md:text-6xl">เลิกขายแบบพึ่งดวง</span>
          <span class="mt-3 block text-xl font-semibold leading-snug text-ink/85 md:text-[1.45rem] md:leading-snug">ด้วยระบบการขาย <span class="whitespace-nowrap font-bold text-coral">D.A.R.U.M.A. Framework</span> <span class="whitespace-nowrap">ที่จับต้องได้</span></span>
          <span class="mt-1 block text-xl font-semibold leading-snug text-ink/85 md:text-[1.45rem] md:leading-snug">และ <span class="font-bold text-navy">AI Agent</span> ที่ลดงานกับเพิ่มยอดขายได้จริง</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-warm-ink/75">ผมปั้นทีมขายจริง และใช้ AI ทำงานขายของตัวเองทุกวัน</p>
        <p class="mt-2 max-w-2xl leading-relaxed text-warm-ink/65">เริ่มจากข้อมูลและวิธีขายของทีมคุณก่อน แล้วค่อยใช้ AI เป็นแรงเสริม ไม่ใช่เอาเครื่องมือไปวางทับปัญหาเดิม</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/booking" class="btn border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยกับผม</a>
          <a href="/services" class="btn border-navy bg-transparent text-navy hover:bg-navy hover:text-white">ดูบริการที่เหมาะกับทีมคุณ</a>
        </div>

        <!-- ตัวเลขจากระบบที่ปันใช้เองจริง — ให้ประโยค "ใช้ AI ทำงานขายของตัวเองทุกวัน" ข้างบนมีน้ำหนักใน 2 วินาทีแรก -->
        <ProofStats variant="hero" class="mt-8" />

        <div class="mt-8 border-t border-[#c9c2b2] pt-5">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-warm-ink/60">ดูแลองค์กรชั้นนำและแบรนด์ดัง</p>
          <div class="homepage-proof-scroll mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="องค์กรที่ไว้ใจให้ปันดูแล">
            {clientLogos.map((logo) => (
              <div class="flex h-11 w-20 shrink-0 items-center justify-center rounded-lg border border-[#c9c2b2] bg-surface p-2">
                <img src={logo.src} alt={logo.alt} width="160" height="160" loading="lazy" decoding="async" class="max-h-full max-w-full object-contain opacity-70" />
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <figure class="rounded-2xl border border-[#c9c2b2] bg-surface p-3 shadow-[5px_7px_0_rgba(30,27,22,0.09)]">
          <Image src={ceoPhoto} alt="ปัน ณัฐพัชร์" width={733} height={1100} loading="lazy" class="aspect-[4/5] w-full rounded-xl object-cover object-top" />
          <figcaption class="px-2 pb-1 pt-4 font-display text-xl font-bold text-navy">ปัน ณัฐพัชร์</figcaption>
        </figure>
        <div class="absolute -left-3 -top-4 rounded-2xl border border-[#c9c2b2] bg-ivory p-3 shadow-[3px_4px_0_rgba(30,27,22,0.08)]">
          <DarumaMark class="h-auto w-14" />
        </div>
        <figure class="absolute -bottom-5 -left-4 hidden w-32 rounded-xl border border-[#c9c2b2] bg-surface p-2 shadow-[3px_4px_0_rgba(30,27,22,0.09)] sm:block">
          <img src="/testimonial/2026-05/review-02.jpg" alt={testimonials[1].alt} width="1000" height="1000" loading="lazy" decoding="async" class="aspect-square w-full rounded-lg object-cover" />
          <figcaption class="px-1 pt-2 text-[11px] font-semibold text-navy">เสียงจากลูกค้าจริง</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">สิ่งที่เห็นซ้ำในทุกบริษัท</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">เจ้าของ SME ส่วนใหญ่เจอ 3 เรื่องนี้</h2>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        {pains.map(([heading, body], index) => (
          <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-7">
            <p class="font-display text-4xl font-bold text-coral">0{index + 1}</p>
            <h3 class="mt-3 font-display text-2xl font-bold text-navy">{heading}</h3>
            <p class="mt-3 leading-relaxed text-warm-ink/75">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">ระบบ D-A-R-U-M-A</p>
      <h2 class="mt-3 max-w-4xl font-display text-3xl font-bold leading-snug text-navy md:text-5xl">ของที่คุณคิดว่าเรื่องดวง จริงๆ คือเรื่องระบบ</h2>
      <p class="mt-5 max-w-3xl leading-relaxed text-warm-ink/75">Daruma Framework คือเช็กลิสต์ที่ทำให้ทีมขายล้มแล้วลุกต่อได้เอง ไม่ใช่คำอธิษฐานหรือศัพท์ AI ลอยๆ</p>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {daruma.map(([letter, name, gloss, body]) => (
          <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-6">
            <div class="flex items-baseline gap-3"><span class="font-display text-5xl font-bold text-coral">{letter}</span><span class="font-display text-xl font-bold text-navy">{name}</span></div>
            <p class="mt-4 font-semibold text-navy">{gloss}</p>
            <p class="mt-2 text-sm leading-relaxed text-warm-ink/75">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#c9c2b2] bg-coral/10 px-6 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-5 md:flex-row md:items-center">
      <div><p class="font-display text-2xl font-bold text-navy">อยากรู้ว่าทีมคุณติดตรงไหน — นัดคุยกับผม ไม่มีค่าใช้จ่าย</p><p class="mt-1 text-sm text-warm-ink/70">เริ่มจากโจทย์จริงของทีมคุณก่อน</p></div>
      <a href="/booking" class="btn shrink-0 border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยกับผม</a>
    </div>
  </section>

  <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">องค์กรที่ไว้ใจ</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">องค์กรบางส่วนที่ไว้ใจให้ผมดูแล</h2>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {clientLogos.map((logo) => (
          <div class="flex aspect-[5/3] items-center justify-center rounded-2xl border border-[#c9c2b2] bg-surface p-5">
            <img src={logo.src} alt={logo.alt} width="160" height="160" loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
          </div>
        ))}
      </div>
      <div class="mt-16 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">เสียงจากลูกค้า</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">รีวิวจากงานที่เกิดขึ้นจริง</h2>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {testimonials.map((testimonial, index) => (
          <figure class:list={[
            'rounded-2xl border border-[#c9c2b2] bg-surface p-2 shadow-[3px_5px_0_rgba(30,27,22,0.07)]',
            index % 2 === 0 ? 'rotate-[0.4deg]' : '-rotate-[0.4deg]',
          ]}>
            <img src={testimonial.src} alt={testimonial.alt} width={testimonial.width} height={testimonial.height} loading="lazy" decoding="async" class="aspect-square w-full rounded-xl object-cover" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#c9c2b2] bg-coral/10 px-6 py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-5 md:flex-row md:items-center">
      <p class="font-display text-2xl font-bold text-navy">ลูกค้าเหล่านี้เริ่มจากนัดคุยครั้งเดียว</p>
      <a href="/booking" class="btn shrink-0 border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยกับผม</a>
    </div>
  </section>

  <!-- โชว์ครบห้าระบบ — section นี้คือชั้น trust/wow ยาวได้ (คุณปันเคาะ 2026-08-24) -->
  <ProofSystems />

  <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">เส้นทางทำงานร่วมกัน</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">เริ่มจากโจทย์ของคุณ</h2>
      <div class="mt-9 grid gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-7">
          <h3 class="font-display text-2xl font-bold text-navy">ฝึกทีมให้ใช้เป็น</h3>
          <p class="mt-2 text-sm text-warm-ink/65">คอร์สสด 1 วันที่ออฟฟิศคุณ · ราคาเดียวทั้งทีมไม่เกิน 20 คน</p>
          <p class="mt-6 font-semibold text-navy">{CATALOG['inhouse-a'].name} · 1 วัน</p>
          <p class="mt-1 text-sm text-warm-ink/70">คุยเป็น · ตามดีลเป็น · ปิดดีลดีขึ้น — AI ช่วยเตรียมงานและซ้อม</p>
          <p class="mt-2 font-display text-3xl font-bold tabular-nums text-coral">{fmtPrice('inhouse-a')}</p>
          <p class="mt-6 font-semibold text-navy">{CATALOG['ai-workshop-advance'].name} · 1 วัน</p>
          <p class="mt-1 text-sm text-warm-ink/70">ทีมรายงานภาษาเดียวกัน — ผู้จัดการเห็นดีลค้างโดยไม่ต้องไล่ถาม</p>
          <p class="mt-2 font-display text-3xl font-bold tabular-nums text-coral">{fmtPrice('ai-workshop-advance')}</p>
          <a href="/services#inhouse-a" class="btn mt-7 w-full border-0 bg-coral text-white hover:bg-[#c43245]">ดูรายละเอียด</a>
        </article>
        <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-7">
          <h3 class="font-display text-2xl font-bold text-navy">ให้ผมเข้าไปวางระบบให้</h3>
          <p class="mt-2 text-sm text-warm-ink/65">ที่ปรึกษาถึงที่บริษัท · คิดเป็นรายวันเหมือนกัน</p>
          <p class="mt-6 font-semibold text-navy">{CATALOG['sales-team-structure'].name} · 1 วัน</p>
          <p class="mt-1 text-sm text-warm-ink/70">เลือก 1 ปัญหาขายที่สำคัญที่สุด — Journey ออนไลน์ถึงปิดการขาย · โครงทีม+KPI+ค่าคอม · ออกแบบ Report/Dashboard · AI Workflow ต้นแบบ — วางทางออกให้จบใน 1 วัน</p>
          <p class="mt-2 font-display text-3xl font-bold tabular-nums text-coral">{fmtPrice('sales-team-structure')}</p>
          <a href="/services#sales-team-structure" class="btn mt-7 w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">ดูรายละเอียด</a>
        </article>
      </div>
