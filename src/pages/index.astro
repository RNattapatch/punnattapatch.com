---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Manifesto from '../components/Manifesto.astro';
import ProofSystems from '../components/proof/ProofSystems.astro';
import ProofStats from '../components/proof/ProofStats.astro';
import { SITE } from '../data/site';
import { fmtPrice, CATALOG } from '../data/pricing.mjs';
import ceoPhoto from '../assets/pun-ceo-1.jpg';

// หน้าแรก 2 ทาง (ล็อก 2026-10-07) — SSOT: claude-code-pun-nattapatch/wiki/pages/strategy-sales-team-x-ai-agent-modular-pack-2026-10.md
// ชื่อฝั่ง AI ใช้คำเดียวกับแอด carousel "AI Office" (ฝ่ายขาย · ฝ่ายเอกสาร · ฝ่ายคอนเทนต์)
// พัก Daruma + "ขายไม่วัดดวง" ในของที่ลูกค้าเห็น · ไม่มีรับประกันผล ขายด้วยหลักฐาน/ความเชื่อใจ
// Quiz /team-check สร้างใน branch feat/team-check-quiz · ราคาแพ็ก "ทำให้" / "ดูแลต่อ" ยังไม่เคาะ ห้ามพิมพ์ตัวเลข
const title = 'ปั้นทีมขาย × AI Office ฝ่ายขาย · ปัน ณัฐพัชร์';
const description = 'ทีมขายที่ยอดไม่นิ่ง ติดอยู่ 2 ที่ คือคนในทีม กับงานซ้ำที่กินวันเขาหมด · ปัน ณัฐพัชร์ ช่วยเจ้าของ SME ปั้นทีมขาย และวาง AI Office ให้ทั้งทีมใช้ได้จริง';
const QUIZ_HREF = '/team-check';
// ค่าตัวรายวันเดียวกัน ไม่ว่าจะสอนหรือวางระบบ (ปันเคาะ 2026-10-08) · ครบรอบ = 2 วัน คำนวณจาก catalog ห้ามพิมพ์ตัวเลข
const DAY = fmtPrice('daily-sales-consulting');
const FULL_ROUND = `฿${(CATALOG['daily-sales-consulting'].amount * 2).toLocaleString('en-US')}`;

const paths = [
  {
    id: 'path-team',
    no: 'ทางที่ 1 · คน',
    name: 'ปั้นทีมขาย',
    teaser: 'จ้างมาไม่นานก็ออก · เป้าตั้งจากความรู้สึก · ต้องถามเองทุกเช้า',
    topics: [
      {
        name: 'คัดคน',
        now: 'จ้างเซลล์มาไม่ถึง 3 เดือนก็ออก สัมภาษณ์ดูดี แต่ทำงานจริงขายไม่ได้',
        after: 'มี Scorecard ของตำแหน่ง ชุดคำถามสัมภาษณ์ และโจทย์ทดสอบงานจริง AI ช่วยอ่านเรซูเม่เทียบเกณฑ์ก่อนนัด',
        link: { href: '/ebook-sales-interview', label: 'อ่านวิธีสัมภาษณ์เซลล์ (ฟรี)' },
      },
      {
        name: 'เป้าและค่าคอม',
        now: 'เป้าตั้งจากยอดปีที่แล้วบวกเพิ่ม เซลล์เลือกขายแต่ของง่าย',
        after: 'KPI ที่ทั้งทีมเข้าใจตรงกัน และชีตคำนวณค่าคอมจากดีลจริง ลองย้อนหลัง 3 เดือนก่อนใช้',
        link: { href: '/services/daily-consulting', label: 'ดูวันวางระบบฝ่ายขาย' },
      },
      {
        name: 'หัวหน้าคุมทีม',
        now: 'ต้องถามเองทุกเช้าว่าดีลไหนถึงไหน ประชุมทุกสัปดาห์แต่ไม่มีอะไรเปลี่ยน',
        after: 'ประชุมเช้า 15 นาทีจากตัวเลขจริง หัวหน้ารู้ว่าต้องเข้าไปช่วยดีลไหนก่อน คุยรายคนเดือนละครั้ง',
        link: { href: '/services/t3-sales-back-office', label: 'ดูคลาสหลังบ้านฝ่ายขาย' },
      },
    ],
  },
  {
    id: 'path-ai-office',
    no: 'ทางที่ 2 · งานซ้ำ',
    name: 'AI Office ฝ่ายขาย',
    teaser: 'ลูกค้าทักแล้วเงียบ · ใบเสนอราคาช้า · ไม่มีใครทำคอนเทนต์',
    topics: [
      {
        name: 'ฝ่ายขาย',
        now: 'ลูกค้าทักมาตอนไม่มีใครว่าง เช้ามาเงียบไปแล้ว ส่งใบเสนอราคาแล้วไม่มีใครตาม',
        after: 'AI ตอบก่อนแล้วจดข้อมูลเข้า CRM เซลล์จดงานผ่าน LINE และรู้ทุกเช้าว่าต้องตามใคร',
        link: { href: '/services/t1-sales-skills', label: 'ดูคลาสทีมขาย + AI Agent' },
      },
      {
        name: 'ฝ่ายเอกสาร',
        now: 'ใบเสนอราคาใบละครึ่งชั่วโมง ลูกค้าได้ราคาช้ากว่าเจ้าอื่นหนึ่งวัน',
        after: 'พิมพ์บรรทัดเดียวจากมือถือ ได้ PDF ให้ตรวจก่อนกดส่ง ใบแจ้งหนี้กับใบเสร็จออกจากที่เดียวกัน',
        link: { href: '/services/t3-sales-back-office', label: 'ดูคลาสหลังบ้านฝ่ายขาย' },
      },
      {
        name: 'ฝ่ายคอนเทนต์',
        now: 'รู้ว่าต้องโพสต์ แต่ไม่มีใครมีเวลาทำ โพสต์แล้วก็ไม่ค่อยมีลูกค้าทัก',
        after: 'AI สืบหัวข้อที่ลูกค้าสนใจแล้วร่างโพสต์ให้ ทีมแค่ตรวจแล้วกดลง',
        link: { href: '/services/online-to-sales', label: 'ดูคลาสขายออนไลน์' },
      },
    ],
  },
];

const ways = [
  {
    name: 'สอนทีม',
    line: 'คลาส 1 วันที่ออฟฟิศคุณ ทีมกลับไปทำเองเป็น',
    detail: `${fmtPrice('inhouse-a')} ต่อวัน ค่าตัวเดียวกับวางระบบ · ทั้งทีมไม่เกิน 20 คน`,
    href: '/services',
    cta: 'ดูคลาสทั้งหมด',
  },
  {
    name: 'ทำให้',
    line: 'ผมเข้าไปวางระบบให้ทั้งทีมใช้ วันละไม่เกิน 2 เรื่อง',
    detail: `วางระบบ 1 วัน ${DAY} · แบบครบรอบ 2 วัน ${FULL_ROUND} (วันที่ 2 ภายใน 14 วัน + ดูแลต่อ 30 วัน)`,
    href: QUIZ_HREF,
    cta: 'เช็คก่อนว่าควรเริ่มเรื่องไหน',
  },
  {
    name: 'ดูแลต่อ',
    line: 'เดือนละ 1 วันเต็ม 09:00–17:00 ที่บริษัทคุณ',
    detail: 'ดูตัวเลขกับเจ้าของและหัวหน้า โค้ชทีมเรื่องที่ติด ปรับระบบ แล้วเลือกเรื่องถัดไป · เปิดหลังจบรอบแรก',
    href: SITE.social.line,
    cta: 'ถามใน LINE',
  },
];

const round = [
  ['วันที่ 1 · เช้า', 'คุยกับเจ้าของและคนที่ทำงานนั้นจริง จดตัวเลขตั้งต้น และตกลงกันว่าแบบไหนเรียกว่าใช้ได้'],
  ['วันที่ 1 · บ่าย', 'ลงระบบพื้นฐานที่เตรียมไว้แล้วให้ทีมเริ่มใช้วันนั้นเลย'],
  ['1–2 สัปดาห์', 'ทีมใช้กับงานจริง ผมปรับให้เข้ากับวิธีทำงานของบริษัทคุณ'],
  ['วันที่ 2', 'ส่งฉบับที่ปรับแล้ว ลองกับงานจริงด้วยกัน สอนทีม แล้วคุยว่าเรื่องถัดไปคืออะไร'],
];

// ทางเดินลูกค้าที่อยู่ยาว — ไม่ระบุชื่อจนกว่าคุณปันขออนุญาตแล้ว (ปันเคาะ 2026-10-07)
const longTerm = {
  who: 'ธุรกิจแฟชั่นออนไลน์ · ทีม 15 คน',
  months: '7 เดือนที่ทำงานด้วยกัน',
  steps: ['วางแผนระบบหลังบ้าน', 'การบ้าน AI ให้ทีม 2 รอบ', 'เวิร์กช็อปทั้งบริษัท', 'KPI ทีมขาย', 'บันไดอาชีพของทีม', 'อบรมรอบใหม่'],
};
const clientLogos = [
  { src: '/logos/clients/futureskill.png', alt: 'FutureSkill' },
  { src: '/logos/clients/nissan.png', alt: 'Nissan' },
  { src: '/logos/clients/ramkhamhaeng.png', alt: 'มหาวิทยาลัยรามคำแหง' },
  { src: '/logos/clients/tni.png', alt: 'สถาบันเทคโนโลยีไทย-ญี่ปุ่น (TNI)' },
  { src: '/logos/clients/hfc-healthfoods.png', alt: 'HFC HealthFoods Corporation' },
  { src: '/logos/clients/home-plus.png', alt: 'ฮ.โฮมพลัส' },
  { src: '/logos/clients/ving.png', alt: 'V!NG' },
  { src: '/logos/clients/farevefarm.jpg', alt: 'Farevefarm' },
  { src: '/logos/clients/farmsuk.jpg', alt: 'ฟาร์มสุข farmsuk' },
  { src: '/logos/clients/business-boy.jpg', alt: 'เด็กประกอบการ The Business Boy' },
  { src: '/logos/clients/gpx.jpg', alt: 'GPX' },
  { src: '/logos/clients/aes.jpg', alt: 'AES' },
  { src: '/logos/clients/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/logos/clients/zontes.png', alt: 'Zontes' },
  { src: '/logos/clients/lambretta.png', alt: 'Lambretta' },
  { src: '/logos/clients/nsscrap.avif', alt: 'NSSCRAP' },
  { src: '/logos/clients/scenery-farm.jpeg', alt: 'Scenery' },
  { src: '/logos/clients/ud-clinic.jpg', alt: 'UD Clinic' },
  { src: '/logos/clients/kanchanok-clinic.jpg', alt: 'Kanchanok Clinic' },
  { src: '/logos/clients/meetme-bkk.png', alt: 'MEET MÉ' },
];
const testimonials = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
// งานล่าสุดพร้อมคำบรรยาย — รูปเดี่ยวในแกลเลอรีรีวิวไม่บอกว่าเป็นงานไหน (คุณปันส่งมา 2026-09-23)
const recentWork = [
  { src: '/testimonial/2026-09/ram-class.jpg', alt: 'ปัน ณัฐพัชร์ เซลฟี่กับนักศึกษาในห้องเรียน ม.รามคำแหง', kicker: 'สอนคลาส', title: 'คลาส AI ที่ ม.รามคำแหง' },
  { src: '/testimonial/2026-09/ud-clinic-class.jpg', alt: 'ปัน ณัฐพัชร์ เซลฟี่กับทีม UD Clinic หลังจบคลาส', kicker: 'In-House', title: 'คลาส AI ให้ทีม UD Clinic' },
  { src: '/testimonial/2026-09/futureskill-studio.jpg', alt: 'ปัน ณัฐพัชร์ กับทีมงานในสตูดิโอถ่ายคลาสออนไลน์ FutureSkill', kicker: 'คลาสออนไลน์', title: 'ถ่ายคลาสออนไลน์กับ FutureSkill' },
  { src: '/testimonial/2026-09/kanchanok-meetme-consult.jpg', inset: '/testimonial/2026-09/kanchanok-meetme-consult-talk.jpg', alt: 'ปัน ณัฐพัชร์ กับทีมกานต์ชนกคลินิกและแบรนด์ MEET MÉ ในห้องประชุม', insetAlt: 'ปัน ณัฐพัชร์ อธิบายเครื่องมือ AI หน้าจอให้ทีมกานต์ชนกคลินิก', kicker: 'Consulting', title: 'วางระบบให้กานต์ชนกคลินิก และแบรนด์ MEET MÉ' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{ types: ['WebPage', 'Person'], title, description }}
>
  <section id="homepage-hero" class="border-b border-[#c9c2b2] bg-ivory px-6 py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl items-start gap-9 lg:grid-cols-[1.2fr_.8fr]">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">ปัน ณัฐพัชร์ · ปั้นทีมขาย × AI Agent</p>
        <h1 class="mt-5 font-display font-bold text-navy">
          <span class="block text-4xl leading-tight md:text-6xl">ทีมขายที่ยอดไม่นิ่ง<br />ติดอยู่ 2 ที่</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-warm-ink/80">คนในทีม กับงานซ้ำที่กินวันเขาหมด · ผมแก้ได้ทั้งสองทาง และใช้ AI ทำงานขายของตัวเองทุกวัน</p>

        <div class="mt-7 grid gap-4 sm:grid-cols-2" aria-label="2 ทางที่ผมช่วยทีมขาย">
          {paths.map((path, index) => (
            <a
              href={`#${path.id}`}
              class:list={[
                'group flex flex-col rounded-2xl border-2 p-4 transition-colors sm:p-5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy',
                index === 0 ? 'border-navy bg-surface hover:bg-sand' : 'border-coral bg-surface hover:bg-coral/10',
              ]}
            >
              <span class:list={['text-xs font-bold uppercase tracking-[0.14em]', index === 0 ? 'text-navy/70' : 'text-coral']}>{path.no}</span>
              <span class="mt-2 font-display text-2xl font-bold leading-tight text-navy md:text-[1.7rem]">{path.name}</span>
              <span class="mt-3 flex flex-wrap gap-1.5">
                {path.topics.map((topic) => (
                  <span class="rounded-full border border-[#c9c2b2] bg-ivory px-2.5 py-0.5 text-[13px] font-semibold text-navy sm:px-3 sm:py-1 sm:text-sm">{topic.name}</span>
                ))}
              </span>
              <span class="mt-3 text-sm leading-relaxed text-warm-ink/70">ติดที่: {path.teaser}</span>
              <span class="mt-3 text-sm font-bold text-navy underline decoration-coral/50 decoration-2 underline-offset-4 group-hover:decoration-coral">ดูทางนี้ ↓</span>
            </a>
          ))}
        </div>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href={QUIZ_HREF} data-cta-location="hero-quiz" class="btn min-h-12 border-0 bg-coral text-white hover:bg-[#c43245]">เช็คว่าทีมคุณติดทางไหน · 2 นาที</a>
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            data-line-cta
            data-product-code="C1"
            data-cta-keyword="ปิดยอด"
            data-cta-location="hero-line"
            data-cta-label="ทัก LINE เล่าโจทย์"
            class="btn min-h-12 border-navy bg-transparent text-navy hover:bg-navy hover:text-white"
          >ทัก LINE เล่าโจทย์</a>
        </div>

        <!-- ตัวเลขจากระบบที่ปันใช้เองจริง — ให้ประโยค "ใช้ AI ทำงานขายของตัวเองทุกวัน" มีน้ำหนัก -->
        <ProofStats variant="hero" class="mt-8" />

        <div class="mt-8 border-t border-[#c9c2b2] pt-5">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-warm-ink/60">องค์กรที่ใช้บริการผม</p>
          <div class="homepage-proof-scroll mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="องค์กรที่ใช้บริการปัน">
            {clientLogos.map((logo) => (
              <div class="flex h-16 w-36 shrink-0 items-center justify-center rounded-lg border border-[#c9c2b2] bg-surface p-2">
                <img src={logo.src} alt={logo.alt} width="160" height="160" loading="lazy" decoding="async" class="h-full w-full object-contain" />
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-md">
        <figure class="rounded-2xl border border-[#c9c2b2] bg-surface p-3 shadow-[5px_7px_0_rgba(30,27,22,0.09)]">
          <Image src={ceoPhoto} alt="ปัน ณัฐพัชร์" width={733} height={1100} loading="eager" class="aspect-[4/5] w-full rounded-xl object-cover object-top" />
          <figcaption class="px-2 pb-1 pt-4">
