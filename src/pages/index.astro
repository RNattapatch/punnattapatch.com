          วันนี้ผมเอาประสบการณ์นั้นมาวางระบบ AI ให้ทั้งธุรกิจของเจ้าของ SME เดินเองได้ ด้วย AI ที่ผมลงมือ build เองทุกวัน
        </p>

        <ul class="mt-7 space-y-4">
          <li class="flex items-start gap-3 text-warm-ink/85">
            <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={22} /></span>
            <span>ปั้นยอดขายให้ SME มาแล้วกว่า 10 ราย ยอดขายรวม 100M+ บาท — เข้าใจหน้างานจริงก่อนเอามาทำ AI</span>
          </li>
          <li class="flex items-start gap-3 text-warm-ink/85">
            <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={22} /></span>
            <span>ลงมือสร้าง AI Agent ที่ทำงานแทนคนได้จริงด้วย Claude Code + Automation ไม่ได้มาสอนแค่ทฤษฎี</span>
          </li>
          <li class="flex items-start gap-3 text-warm-ink/85">
            <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={22} /></span>
            <span>ผมไม่จัดคลาสใหญ่ที่ไปไวจนตามไม่ทัน — ผมเข้าไปที่บริษัทคุณ ทีมของคุณเท่านั้น</span>
          </li>
          <li class="flex items-start gap-3 text-warm-ink/85">
            <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={22} /></span>
            <span>ลูกค้าทุกคนได้ AI workflow กลับไปใช้จริงอย่างน้อย 1 ตัว ตั้งแต่วันส่งมอบ</span>
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-t border-[#c9c2b2] pt-6">
          <div>
            <div class="font-serif text-2xl font-semibold text-navy">฿100M+</div>
            <div class="text-xs uppercase tracking-wide text-muted">ยอดขาย SME ที่ช่วยปิด</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-semibold text-navy">1,000+</div>
            <div class="text-xs uppercase tracking-wide text-muted">เซลล์ที่สัมภาษณ์มา</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-semibold text-navy">20+</div>
            <div class="text-xs uppercase tracking-wide text-muted">องค์กรที่ดูแล</div>
          </div>
        </div>

        <div class="mt-8">
          <a href="/about" class="inline-flex items-center rounded-xl border border-navy/25 px-6 py-3 font-medium text-navy transition hover:bg-sand">
            อ่านเรื่องราวของผมเพิ่มเติม →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 13. QUALIFY — who this is for (personas) + fit check (yes/no) -->
  <!-- ============================================================= -->
  <section class="bg-sand px-margin-page py-20 md:py-24">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">เหมาะกับใคร</span>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy md:text-4xl">
          เช็คก่อนว่าเราเหมาะกันไหม
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-warm-ink/70">
          ลูกค้าที่ทำงานกับผมได้ดีที่สุด มักเป็น 3 แบบนี้ — ถ้าคุณไม่ใช่สักแบบ ผมบอกตรงๆ ว่าผมอาจไม่ใช่คนที่ใช่สำหรับคุณ
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {personas.map((p) => (
          <div class="rounded-2xl border border-[#c9c2b2] bg-surface p-6">
            <span class="text-coral" aria-hidden="true"><Icon name={p.icon} size={28} /></span>
            <h3 class="mt-3 font-serif text-lg font-semibold text-navy">{p.role}</h3>
            <p class="mt-2 text-sm leading-relaxed text-warm-ink/75">{p.line}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-[#c9c2b2] border-l-4 border-l-navy bg-surface p-6">
          <h3 class="mb-4 font-serif text-lg font-semibold text-navy">เหมาะกับธุรกิจคุณ ถ้า…</h3>
          <ul class="space-y-3 text-sm text-warm-ink/85">
            {qualifyYes.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={18} /></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-[#c9c2b2] border-l-4 border-l-[#c9c2b2] bg-sand/40 p-6">
          <h3 class="mb-4 font-serif text-lg font-semibold text-muted">อาจยังไม่เหมาะ ถ้า…</h3>
          <ul class="space-y-3 text-sm text-warm-ink/65">
            {qualifyNo.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 shrink-0 text-muted">✕</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 14. FREE RESOURCE (Agent Builder Kit) + FEATURED ARTICLES -->
  <!-- ============================================================= -->
  <section class="px-margin-page py-20 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="text-center">
        <span class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">แหล่งเรียนรู้ฟรี</span>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-navy md:text-4xl">
          ยังไม่พร้อมใช้บริการผม? เริ่มจากของฟรีตรงนี้ก่อนก็ได้
        </h2>
      </div>

      <!-- Free Kit (AI lead magnet · replaced sales e-books) -->
      <div class="mt-12">
        <div class="mx-auto flex max-w-3xl flex-col items-start gap-5 rounded-2xl border-2 border-coral/40 bg-surface p-8 paper-shadow md:flex-row md:items-center md:gap-8">
          <span class="text-coral" aria-hidden="true"><Icon name="folder-open" size={44} /></span>
          <div class="flex-1">
            <h3 class="font-serif text-2xl font-semibold leading-snug text-navy">{freeKit.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-warm-ink/75 md:text-base">{freeKit.body}</p>
          </div>
          <a href={freeKit.href} class="inline-flex shrink-0 items-center rounded-xl bg-coral px-7 py-3.5 font-medium text-white transition hover:opacity-90">
            {freeKit.cta}
          </a>
        </div>
      </div>

      <!-- Featured articles -->
      <div class="mt-16 flex flex-col items-start justify-between gap-3 md:flex-row md:items-end">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">บทเรียน 100 ล้าน</span>
          <h2 class="mt-3 font-serif text-2xl font-semibold text-navy md:text-3xl">
            บทความจากประสบการณ์จริง
          </h2>
        </div>
        <a href="/insights" class="text-sm font-medium text-navy underline-offset-4 hover:underline">
          ดูบทความทั้งหมด →
        </a>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {featuredCards.map((card) => (
          <a
            href={card.href}
            class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-[#c9c2b2] bg-surface p-6 no-underline transition hover:-translate-y-0.5 hover:shadow-[3px_5px_0_rgba(30,27,22,0.06)]"
            style={`--card-accent: ${card.accentVar}; --card-soft: ${card.accentSoftVar};`}
          >
            <span
              class="inline-block w-fit rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest"
              style="color: var(--card-accent); border-color: color-mix(in srgb, var(--card-accent) 35%, transparent); background: var(--card-soft);"
            >
              {card.pillarLabel}
            </span>
            <h3 class="mt-3 font-serif text-lg font-semibold leading-snug text-navy">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-warm-ink/70">{card.description}</p>
            <p class="mt-5 text-sm font-semibold" style="color: var(--card-accent);">อ่านบทความ →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================= -->
  <!-- 15. FINAL CTA + CONTACT — one closing section -->
  <!-- ============================================================= -->
  <section class="bg-navy px-margin-page py-20 md:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-serif text-3xl font-semibold leading-tight text-white md:text-4xl">
        ธุรกิจคุณ<span class="text-[#fe596b]">พร้อม</span>สำหรับ AI แล้วหรือยัง?
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-[#f4f1ea]/80">
        กรอกแบบฟอร์ม 3 นาที — ผมอ่านทุกใบเอง แล้วคุณจะรู้ว่าจุดไหนที่ AI เข้ามาช่วยได้เร็วที่สุดในธุรกิจของคุณ
      </p>
      <div class="mt-8">
        <a href="/intake-form" class="inline-flex items-center rounded-xl bg-coral px-9 py-4 font-semibold text-white transition hover:opacity-90">
          ทำ AI Readiness Assessment →
        </a>
      </div>

      <!-- trust grid -->
      <div class="mt-14 grid grid-cols-2 gap-6 md:grid-cols-4">
        {trustPoints.map((point) => (
          <div class="text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-white/[0.06] text-[#f4f1ea]/80">
              <Icon name={point.icon} size={22} />
            </div>
            <p class="font-serif text-sm font-semibold text-white">{point.title}</p>
            <p class="mt-1 text-xs text-[#f4f1ea]/55">{point.body}</p>
          </div>
        ))}
      </div>

      <!-- socials -->
      <div class="mt-14 border-t border-white/10 pt-10">
        <h3 class="font-serif text-xl font-semibold text-white">ติดตามและติดต่อผม</h3>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith('http') ? '_blank' : undefined}
              rel={s.href.startsWith('http') ? 'noopener' : undefined}
              class="rounded-xl border border-white/15 bg-white/[0.05] px-4 py-2.5 text-sm text-[#f4f1ea]/80 transition hover:border-[#fe596b]/50 hover:text-white"
            >
              {s.label}
            </a>
          ))}
        </div>

        <!-- Personal note — avatar + speech bubble -->
        <div class="mt-10 flex items-start justify-center gap-3 sm:gap-4">
          <Image
            src={avatar}
            alt="ปัน ณัฐพัชร์"
            width={128}
            height={128}
            class="h-14 w-14 shrink-0 rounded-full border-2 border-white/20 object-cover sm:h-16 sm:w-16"
          />
          <div class="relative max-w-md rounded-2xl rounded-tl-sm border border-white/15 bg-white/[0.06] px-5 py-4 text-left">
            <span class="absolute -left-1.5 top-5 h-3.5 w-3.5 rotate-45 border-b border-l border-white/15 bg-white/[0.06]" aria-hidden="true"></span>
            <p class="text-sm leading-relaxed text-[#f4f1ea]/85">
              <strong class="text-white">ผมติดต่อลูกค้าเองทุกราย</strong> หากติดจัดอบรม ผมจะติดต่อกลับในช่วงนอกเวลาทำการครับ
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
