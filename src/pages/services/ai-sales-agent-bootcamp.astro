---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailLayout from '../../components/services/detail/ProductDetailLayout.astro';
import { resolveProductDetailCatalog } from '../../data/product-details/catalog';
import { P1_PRODUCT_DETAIL } from '../../data/product-details/p1';
import { SITE } from '../../data/site';

const catalog = resolveProductDetailCatalog(P1_PRODUCT_DETAIL.pricingKey);
const canonical = `${SITE.url}${P1_PRODUCT_DETAIL.route}`;
// key ยัง internal จน Blind Ticket เปิดขาย → Catalog ยังไม่มี image ของตัวเอง ใช้ OG กลางของเว็บไปก่อน
const ogImage = `${SITE.url}${catalog.image ?? '/og-image.jpg'}`;
---

<BaseLayout title={P1_PRODUCT_DETAIL.seo.title} description={P1_PRODUCT_DETAIL.seo.description} canonical={canonical} ogImage={ogImage} noindex={P1_PRODUCT_DETAIL.noindex} schema={{ types: ['WebPage', 'FAQPage', 'BreadcrumbList', 'ProductDetail'], title: P1_PRODUCT_DETAIL.seo.title, description: P1_PRODUCT_DETAIL.seo.description, url: canonical, faq: P1_PRODUCT_DETAIL.faq, breadcrumbs: [{ name: 'บริการ', url: `${SITE.url}/services` }, { name: catalog.name, url: canonical }], productDetail: { code: P1_PRODUCT_DETAIL.code, kind: P1_PRODUCT_DETAIL.kind, name: catalog.name, description: P1_PRODUCT_DETAIL.seo.description, url: canonical, duration: catalog.duration } }}>
  <ProductDetailLayout data={P1_PRODUCT_DETAIL} />
</BaseLayout>
