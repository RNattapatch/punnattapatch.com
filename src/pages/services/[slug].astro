---
const legacyRedirects = {
  'ai-workshop': '/services#inhouse-a',
  'ai-workshop-advance': '/services#inhouse-a',
  'package-a': '/services#inhouse-b',
  'sales-system-sprint': '/services',
  'sale-training-bundle': '/services',
  'trust-content-tiktok-workshop': '/services#trust-content',
} as const;

export function getStaticPaths() {
  return [
    'ai-workshop',
    'ai-workshop-advance',
    'package-a',
    'sales-system-sprint',
    'sale-training-bundle',
    'trust-content-tiktok-workshop',
  ].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const destination = legacyRedirects[slug as keyof typeof legacyRedirects] ?? '/services';
return Astro.redirect(destination, 301);
---
