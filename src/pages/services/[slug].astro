---
const legacyRedirects = {
  'ai-workshop': '/services#inhouse-a',
  'ai-workshop-advance': '/services#sales-report',
  'paid-audit': '/services#offer-c1',
  'package-a': '/services#offer-c1',
  'sales-system-sprint': '/services#offer-c1',
  'sale-training-bundle': '/services#offer-t1',
  'trust-content-tiktok-workshop': '/services/online-to-sales',
} as const;

export function getStaticPaths() {
  return [
    'ai-workshop',
    'ai-workshop-advance',
    'paid-audit',
    'package-a',
    'sales-system-sprint',
    'sale-training-bundle',
    'trust-content-tiktok-workshop',
  ].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const destination = legacyRedirects[slug as keyof typeof legacyRedirects] ?? '/services';
return Astro.redirect(destination, 301);
---
