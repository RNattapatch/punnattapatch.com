---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailLayout from '../../components/services/detail/ProductDetailLayout.astro';
import { resolveProductDetailCatalog } from '../../data/product-details/catalog';
import { PRODUCT_DETAIL_FIXTURE } from '../../data/product-details/fixture';

const canonical = 'https://punnattapatch.com/services/detail-fixture';
const catalog = resolveProductDetailCatalog(PRODUCT_DETAIL_FIXTURE.pricingKey);
---

<BaseLayout title={PRODUCT_DETAIL_FIXTURE.seo.title} description={PRODUCT_DETAIL_FIXTURE.seo.description} canonical={canonical} noindex schema={{ types: ['WebPage', 'FAQPage', 'BreadcrumbList', 'ProductDetail'], title: PRODUCT_DETAIL_FIXTURE.seo.title, description: PRODUCT_DETAIL_FIXTURE.seo.description, url: canonical, faq: PRODUCT_DETAIL_FIXTURE.faq, breadcrumbs: [{ name: 'บริการ', url: 'https://punnattapatch.com/services' }, { name: 'Fixture', url: canonical }], productDetail: { code: PRODUCT_DETAIL_FIXTURE.code, kind: PRODUCT_DETAIL_FIXTURE.kind, name: catalog.name, description: PRODUCT_DETAIL_FIXTURE.seo.description, url: canonical, duration: catalog.duration } }}>
  <ProductDetailLayout data={PRODUCT_DETAIL_FIXTURE} />
</BaseLayout>
