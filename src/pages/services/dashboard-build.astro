---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailLayout from '../../components/services/detail/ProductDetailLayout.astro';
import { resolveProductDetailCatalog } from '../../data/product-details/catalog';
import { I1_PRODUCT_DETAIL } from '../../data/product-details/i1';
import { SITE } from '../../data/site';

const catalog = resolveProductDetailCatalog(I1_PRODUCT_DETAIL.pricingKey);
const canonical = `${SITE.url}${I1_PRODUCT_DETAIL.route}`;
---

<BaseLayout title={I1_PRODUCT_DETAIL.seo.title} description={I1_PRODUCT_DETAIL.seo.description} canonical={canonical} ogImage={`${SITE.url}${catalog.image}`} schema={{ types: ['WebPage', 'FAQPage', 'BreadcrumbList', 'ProductDetail'], title: I1_PRODUCT_DETAIL.seo.title, description: I1_PRODUCT_DETAIL.seo.description, url: canonical, faq: I1_PRODUCT_DETAIL.faq, breadcrumbs: [{ name: 'บริการ', url: `${SITE.url}/services` }, { name: catalog.name, url: canonical }], productDetail: { code: I1_PRODUCT_DETAIL.code, kind: I1_PRODUCT_DETAIL.kind, serviceType: I1_PRODUCT_DETAIL.serviceType, name: catalog.name, description: I1_PRODUCT_DETAIL.seo.description, url: canonical, duration: catalog.duration } }}>
  <ProductDetailLayout data={I1_PRODUCT_DETAIL} />
</BaseLayout>
