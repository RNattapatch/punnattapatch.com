---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailLayout from '../../components/services/detail/ProductDetailLayout.astro';
import { resolveProductDetailCatalog } from '../../data/product-details/catalog';
import { T4_PRODUCT_DETAIL } from '../../data/product-details/t4';
import { SITE } from '../../data/site';
import t2WorkshopHandsOn from '../../assets/services/proof/t2-workshop-hands-on.jpg';

const catalog = resolveProductDetailCatalog(T4_PRODUCT_DETAIL.pricingKey);
const canonical = `${SITE.url}${T4_PRODUCT_DETAIL.route}`;
---

<BaseLayout title={T4_PRODUCT_DETAIL.seo.title} description={T4_PRODUCT_DETAIL.seo.description} canonical={canonical} ogImage={`${SITE.url}${catalog.image ?? t2WorkshopHandsOn.src}`} schema={{ types: ['WebPage', 'FAQPage', 'BreadcrumbList', 'ProductDetail'], title: T4_PRODUCT_DETAIL.seo.title, description: T4_PRODUCT_DETAIL.seo.description, url: canonical, faq: T4_PRODUCT_DETAIL.faq, breadcrumbs: [{ name: 'บริการ', url: `${SITE.url}/services` }, { name: catalog.name, url: canonical }], productDetail: { code: T4_PRODUCT_DETAIL.code, kind: T4_PRODUCT_DETAIL.kind, name: catalog.name, description: T4_PRODUCT_DETAIL.seo.description, url: canonical, duration: catalog.duration } }}>
  <ProductDetailLayout data={T4_PRODUCT_DETAIL} />
</BaseLayout>
