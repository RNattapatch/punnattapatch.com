  heroPhotos: {
    main: { src: '/lp/inhouse/hero-pointing.jpg', alt: 'ปันยืนชี้อธิบายบนจอหน้าห้อง ขณะทีมขายลงมือทำบนเครื่องตัวเองในคลาสจริง', width: 1600, height: 1200 },
    left: { src: '/testimonial/2026-07/onsite-nissan-pun.jpg', alt: 'ปัน ณัฐพัชร์ ที่งาน Nissan Sales Manager Seminar 2026', width: 1100, height: 1466 },
