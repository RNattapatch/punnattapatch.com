---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DarumaMark from '../../components/DarumaMark.astro';
import { SITE } from '../../data/site';
import { PRICES, fmtPrice } from '../../data/pricing.mjs';

const title = 'Daruma Score — ตรวจระบบปั้นทีมขาย';
const description = 'วันตรวจระบบทีมขาย 6 ด้านบนข้อมูลจริง พร้อม Daruma Scorecard, Bus-Factor Report และ Roadmap 90 วัน';
const darumaScoreAmount = PRICES['daruma-score'].amount;
const checks = [
  ['D', 'ข้อมูลบ้านเดียว'], ['A', 'น้องฝึกงานที่รู้จักบริษัทคุณ'], ['R', 'ทำซ้ำได้ ไม่วัดดวง'],
  ['U', 'คนเก่งขึ้นพร้อมระบบ'], ['M', 'วัดได้ ไม่ใช้ความรู้สึก'], ['A', 'ทำทันที ใช้จริงวันจันทร์เช้า'],
];
---

<BaseLayout title={title} description={description} noindex schema={{ types: ['WebPage', 'Person'], title, description }}>
  <Fragment slot="head">
    <script is:inline define:vars={{ darumaScoreAmount }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '890649354099149');
      fbq('track', 'PageView');
      fbq('track', 'ViewContent', { content_name: 'daruma_score_pricing', value: darumaScoreAmount, currency: 'THB' });
    </script>
  </Fragment>

  <section class="border-b border-[#c9c2b2] bg-ivory px-6 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.2fr_.8fr]">
      <div><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Daruma Score · วันตรวจระบบทีมขาย</p><h1 class="mt-5 font-display text-4xl font-bold leading-tight text-navy md:text-6xl">ถ้าเซลล์เก่งสุดลาออกพรุ่งนี้ คุณเสียอะไรบ้าง?</h1><p class="mt-6 max-w-2xl text-lg leading-relaxed text-warm-ink/75">Daruma Score คือวันตรวจระบบขายบนข้อมูลจริง เพื่อให้คุณเห็นว่าอะไรแขวนอยู่กับคน อะไรวัดไม่ได้ และควรแก้ตรงไหนก่อน</p><div class="mt-8 flex flex-wrap gap-3"><a href={SITE.social.line} data-line-lead target="_blank" rel="noopener" class="btn border-0 bg-coral text-white hover:bg-[#c43245]">ทัก LINE คุยกับผมเลย</a><a href="#contact-form" class="btn border-navy bg-transparent text-navy hover:bg-navy hover:text-white">ไม่สะดวกแชท? ฝากข้อมูลไว้</a></div><p class="mt-5 text-sm text-warm-ink/60">ตรวจทีละบริษัท เพื่อให้เห็นภาพจากข้อมูลจริง</p></div>
      <div class="rounded-2xl border border-[#c9c2b2] bg-surface p-8 text-center"><DarumaMark class="mx-auto h-auto w-48" /><p class="mt-5 font-display text-xl font-bold text-navy">ไม่ใช่เครื่องราง คือระบบ</p><p class="mt-2 text-sm leading-relaxed text-warm-ink/70">ฐานหนักทำให้ล้มแล้วลุกเอง เป้าที่ดีต้องแต้มตาได้เมื่อวัดผลสำเร็จจริง</p></div>
    </div>
  </section>

  <section class="px-6 py-16 md:py-24"><div class="mx-auto max-w-6xl"><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">สัญญาณเตือน</p><h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">อาการที่เจอบ่อยในทีมขาย SME</h2><div class="mt-9 grid gap-5 md:grid-cols-3">{['“ยอดเดือนนี้มาจากไหน ตอบได้แค่ความรู้สึก”','“ทุกดีลวัดดวง — เดือนนี้ปิดรัว เดือนหน้าเงียบกริบ”','“ระบบทั้งบริษัทแขวนอยู่กับคนเก่งคนเดียว”'].map((pain) => <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-7"><p class="font-display text-2xl font-semibold leading-relaxed text-navy">{pain}</p></article>)}</div></div></section>

  <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16 md:py-24"><div class="mx-auto max-w-6xl"><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">ระบบ D-A-R-U-M-A</p><h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">วันเดียว ตรวจครบ 6 ด้าน ตามระบบดารุมะ</h2><div class="mt-9 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{checks.map(([letter, gloss]) => <article class="rounded-2xl border border-[#c9c2b2] bg-surface p-6"><span class="font-display text-5xl font-bold text-coral">{letter}</span><p class="mt-4 text-lg font-semibold text-navy">{gloss}</p></article>)}</div></div></section>

  <section class="px-6 py-16 md:py-24"><div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2"><div><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Deliverables</p><h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">ของที่ได้กลับไปจับต้องได้</h2><p class="mt-5 leading-relaxed text-warm-ink/75">ไม่ใช่สไลด์สวยๆ ที่อ่านแล้วเก็บ แต่เป็นเอกสารที่เอาไปใช้ต่อกับทีมได้ทันที</p></div><ol class="space-y-4">{[['Daruma Scorecard','คะแนน 6 ด้านพร้อมหลักฐาน'],['Bus-Factor Report','รายการความเสี่ยงที่แขวนกับตัวบุคคล'],['แผนภาพกระบวนการขายปัจจุบัน','เห็นทั้งเส้นทางดีลตั้งแต่ต้นจนจบ ว่าหลุดตรงไหน'],['Roadmap 90 วัน','เรียงว่าแก้อะไรก่อน']].map(([heading, body], index) => <li class="flex gap-4 rounded-2xl border border-[#c9c2b2] bg-surface p-5"><span class="font-display text-3xl font-bold text-coral">{index + 1}</span><div><h3 class="font-display text-xl font-bold text-navy">{heading}</h3><p class="mt-1 text-sm leading-relaxed text-warm-ink/70">{body}</p></div></li>)}</ol></div><p class="mx-auto mt-8 max-w-6xl rounded-xl border border-coral/30 bg-coral/10 p-5 font-semibold leading-relaxed text-[#9a2534]">ตัดสินใจทำต่อภายใน 14 วัน — นำค่าตรวจ {fmtPrice('daruma-score')} ไปหักเต็มจำนวนจากโปรแกรมใหญ่ได้</p><div class="mx-auto mt-8 max-w-6xl text-center"><a href={SITE.social.line} data-line-lead target="_blank" rel="noopener" class="btn border-0 bg-coral text-white hover:bg-[#c43245]">ทัก LINE คุยกับผมเลย</a></div></section>

  <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16"><div class="mx-auto max-w-6xl"><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Fit Check</p><h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-5xl">เหมาะกับใคร</h2><ul class="mt-8 grid gap-4 md:grid-cols-3">{['เจ้าของ SME ที่มีทีมขาย 5-20 คน','ขายแบบ B2B หรืออาศัยความสัมพันธ์','อยากรู้ว่าติดตรงไหนก่อนตัดสินใจลงทุนเรื่องระบบหรือ AI'].map((item) => <li class="rounded-2xl border border-[#c9c2b2] bg-surface p-6 font-semibold leading-relaxed text-navy">{item}</li>)}</ul><div class="mt-9 text-center"><a href={SITE.social.line} data-line-lead target="_blank" rel="noopener" class="btn border-0 bg-coral text-white hover:bg-[#c43245]">ทัก LINE คุยกับผมเลย</a></div></div></section>

  <section id="contact-form" class="px-6 py-16 md:py-24"><div class="mx-auto max-w-2xl rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:p-10"><h2 class="font-display text-3xl font-bold text-navy">ไม่สะดวกแชทตอนนี้? ฝากข้อมูลไว้ ผมทักกลับเอง</h2><p class="mt-2 leading-relaxed text-warm-ink/70">กรอกสั้นๆ เดี๋ยวผมส่งรายละเอียดวันตรวจและช่วงคิวว่างให้ครับ</p><form id="daruma-score-form" class="mt-7 space-y-5" novalidate><input name="honeypot-name" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" /><label class="field-label">ชื่อของคุณ<input name="name" required class="field" /></label><label class="field-label">บริษัท / ธุรกิจ<input name="company" required class="field" /></label><label class="field-label">ช่องทางติดต่อกลับ<input name="contact" required placeholder="เบอร์โทร หรือ LINE ID" class="field" /></label><label class="flex cursor-pointer items-start gap-3"><input name="consent" type="checkbox" required class="checkbox mt-0.5" /><span class="text-sm leading-relaxed text-warm-ink/75">ยินยอมให้ติดต่อกลับตาม <a href="/privacy" class="font-semibold text-cyan underline">นโยบายความเป็นส่วนตัว</a></span></label><p id="daruma-form-error" class="hidden rounded-xl border border-error/40 bg-error/10 p-4 text-sm text-error" role="alert"></p><button id="daruma-submit" class="btn w-full border border-navy bg-transparent py-4 text-base text-navy hover:bg-navy hover:text-white">ฝากข้อมูลให้ผมทักกลับ</button></form><div id="daruma-success" class="mt-6 hidden rounded-xl bg-sand p-5 text-center"><p class="font-semibold text-navy">รับข้อมูลแล้วครับ</p><a id="daruma-line" href={SITE.social.line} data-line-lead target="_blank" rel="noopener" class="btn mt-4 border-0 bg-[#06C755] text-white hover:bg-[#05a945]">ทัก LINE คุยกับผมเลย</a></div></div></section>
</BaseLayout>

<style>
  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
</style>

<script is:inline define:vars={{ darumaScoreAmount }}>
  const form = document.getElementById('daruma-score-form');
  const submit = document.getElementById('daruma-submit');
  const error = document.getElementById('daruma-form-error');
  const success = document.getElementById('daruma-success');
  const WEBHOOK = 'https://rnat.app.n8n.cloud/webhook/intake-form-v2';
  document.querySelectorAll('[data-line-lead]').forEach((lineCta) => {
    lineCta.addEventListener('click', () => {
      if (typeof window.fbq === 'function') window.fbq('track', 'Lead', { content_name: 'daruma_score_line', value: darumaScoreAmount, currency: 'THB' });
    });
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || new FormData(form).get('honeypot-name')) return;
    if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
    if (error) error.classList.add('hidden');
    try {
      const payload = Object.fromEntries(new FormData(form).entries());
      Object.assign(payload, { source: 'daruma-score-ads', source_page: 'ads/daruma-score', serviceInterest: 'daruma-score', submitted_at: new Date().toISOString() });
      const response = await fetch(WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true });
      if (!response.ok) throw new Error('submission failed');
      form.classList.add('hidden'); success?.classList.remove('hidden');
      if (typeof window.fbq === 'function') window.fbq('track', 'Lead', { content_name: 'add_line_oa', value: darumaScoreAmount, currency: 'THB' });
    } catch {
      if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว กรุณาทัก LINE OA เพื่อรับรายละเอียดวันตรวจ'; error.classList.remove('hidden'); }
      if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูล รับรายละเอียดวันตรวจ'; }
    }
  });
</script>
