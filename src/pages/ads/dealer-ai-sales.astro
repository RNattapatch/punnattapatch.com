  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .intent-option { transition: border-color .15s, background .15s, box-shadow .15s; }
  .intent-option:has(input:checked) { border-color: var(--pun-coral); background: color-mix(in oklch, var(--pun-coral) 7%, transparent); box-shadow: inset 0 0 0 1px var(--pun-coral); }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; min-height: 44px; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
  .line-button { min-height: 44px; }
  :global(body:has(#dealer-ai-page) .nav-cta),
  :global(body:has(#dealer-ai-page) .menu-mobile li.mt-2) { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .line-button { transition: none; }
  }
</style>

<script>
  type Attribution = Record<string, string | undefined>;
  type MetaWindow = Window & { fbq?: (...args: unknown[]) => void; ttq?: { track: (...args: unknown[]) => void }; pnAttribution?: Attribution };

  const pageWindow = window as MetaWindow;
  const form = document.getElementById('dealer-ai-booking-form') as HTMLFormElement | null;
  const formSection = document.getElementById('dealer-ai-form');
  const success = document.getElementById('dealer-ai-success');
  const error = document.getElementById('dealer-ai-error');
  const submit = document.getElementById('dealer-ai-submit') as HTMLButtonElement | null;
  const WEBHOOK = 'https://rnat.app.n8n.cloud/webhook/intake-form-v2';
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  function populateAttribution() {
    const query = new URLSearchParams(window.location.search);
    const stored = pageWindow.pnAttribution || {};
    UTM_KEYS.forEach((key) => {
      const input = document.getElementById(key) as HTMLInputElement | null;
      if (input) input.value = query.get(key) || stored[key] || '';
    });
  }

  populateAttribution();

  if (formSection && 'IntersectionObserver' in window) {
    let fired = false;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting) && !fired) {
        fired = true;
        if (typeof pageWindow.fbq === 'function') fbq('track', 'ViewContent', { content_name: 'dealer_ai_form' });
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(formSection);
  }

  document.querySelectorAll('[data-line-dealer]').forEach((lineButton) => {
    lineButton.addEventListener('click', () => {
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Contact', { content_name: 'line_add_dealer' });
      if (typeof pageWindow.ttq?.track === 'function') pageWindow.ttq.track('Contact', { content_name: 'line_add_dealer' });
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if ((new FormData(form).get('honeypot-name') as string)?.trim()) return;

    const phoneRaw = String(new FormData(form).get('phone') || '').replace(/[\s()\-]/g, '');
    if (!/^(?:\+?66|0)\d{8,9}$/.test(phoneRaw)) {
      if (error) { error.textContent = 'กรุณากรอกเบอร์โทรมือถือจริง เช่น 0812345678 ครับ'; error.classList.remove('hidden'); }
      (form.querySelector('[name="phone"]') as HTMLInputElement | null)?.focus();
      return;
    }

    const payload = Object.fromEntries(new FormData(form).entries());
    Object.assign(payload, {
      phone: phoneRaw,
      lead_temp: payload.intent === 'booking' ? 'hot' : 'warm',
      source: 'ads-dealer-ai-sales',
      source_page: 'ads/dealer-ai-sales',
      booking_type: 'dealer-ai-sales',
      submitted_at: new Date().toISOString(),
      path: window.location.pathname,
      recommended_path: 'free-consultation',
    });

    if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
    error?.classList.add('hidden');

    try {
      const response = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      });
      if (!response.ok) throw new Error('submission failed');
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Lead', { content_name: 'dealer_ai_booking', lead_temp: payload.lead_temp });
      if (typeof pageWindow.ttq?.track === 'function') pageWindow.ttq.track('SubmitForm', { content_name: 'dealer_ai_booking', lead_temp: payload.lead_temp });
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว กรุณาลองใหม่ หรือแอด LINE เพื่อส่งโจทย์ให้ผม'; error.classList.remove('hidden'); }
      if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูลขอคิวคุยฟรี 15–20 นาที'; }
    }
  });

  (function setupPixelConsent() {
    const key = 'pixel_consent';
    const bar = document.getElementById('consent-bar');
    if (!bar) return;
    try {
      if (!localStorage.getItem(key)) bar.classList.remove('hidden');
      const close = (value: string) => { localStorage.setItem(key, value); bar.classList.add('hidden'); };
      document.getElementById('consent-accept')?.addEventListener('click', () => close('granted'));
      document.getElementById('consent-decline')?.addEventListener('click', () => {
        close('denied');
        if (typeof pageWindow.fbq === 'function') fbq('consent', 'revoke');
      });
    } catch {
      bar.classList.remove('hidden');
    }
  })();
</script>
