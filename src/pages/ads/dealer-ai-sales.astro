  ],

  priceLabel: 'AI สำหรับทีมขาย 2026 · In-house สำหรับดีลเลอร์',
  priceAmount: fmtPrice('inhouse-a'),
  priceNote: `มากัน 20 คน เฉลี่ยคนละ ${perHead.toLocaleString('th-TH')} บาท ถูกกว่าส่งเซลล์ไปเรียนข้างนอก 1 ที่นั่ง`,
  priceIncludes: [
    'อบรม on-site ที่โชว์รูมหรือออฟฟิศคุณ 1 วันเต็ม (ทีม 5–20 คน)',
    'Specialist AI Agent คนละ 1 ตัว สร้างจากข้อมูลรุ่นรถจริง เสร็จในวันนั้น',
    'สมองดีลเลอร์: company-context.md + FFAB Sheet รายรุ่น + prompt 23+ ตัว',
    'Review Checklist + Data Rules + Monday Plan รายคน',
