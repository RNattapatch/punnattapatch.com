---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DarumaMark from '../../components/DarumaMark.astro';
import { SITE } from '../../data/site';
import { PRICES, fmtPrice } from '../../data/pricing.mjs';

const title = 'AI ช่วยทีมขายรถเพิ่มยอด — คุยฟรี';
const description = 'เซลล์ขายรถลืมตามลูกค้า = ยอดรั่วทุกเดือน AI ไม่ได้มาปิดการขายแทนเซลล์ แต่พาลูกค้ามาถึงมือเซลล์ให้เร็วขึ้น คุยฟรี 15–20 นาทีสำหรับดีลเลอร์รถยนต์';
const canonical = `${SITE.url}/ads/dealer-ai-sales`;
const lineUrl = 'https://line.me/R/ti/p/@011xgvap';
const perHead = Math.round(PRICES['inhouse-a'].amount / 20);
const clientLogos = [
  { src: '/logos/clients/nissan.png', alt: 'Nissan' },
  { src: '/logos/clients/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/logos/clients/zontes.png', alt: 'Zontes' },
  { src: '/logos/clients/lambretta.png', alt: 'Lambretta' },
  { src: '/logos/clients/hfc-healthfoods.png', alt: 'HFC HealthFoods Corporation' },
  { src: '/logos/clients/home-plus.png', alt: 'ฮ.โฮมพลัส' },
  { src: '/logos/clients/ving.png', alt: 'V!NG' },
  { src: '/logos/clients/farevefarm.jpg', alt: 'Farevefarm' },
  { src: '/logos/clients/farmsuk.jpg', alt: 'ฟาร์มสุข farmsuk' },
  { src: '/logos/clients/business-boy.jpg', alt: 'เด็กประกอบการ The Business Boy' },
  { src: '/logos/clients/gpx.jpg', alt: 'GPX' },
  { src: '/logos/clients/aes.jpg', alt: 'AES' },
  { src: '/logos/clients/nsscrap.avif', alt: 'NSSCRAP' },
  { src: '/logos/clients/scenery-farm.jpeg', alt: 'Scenery' },
];
const testimonials = [
  { src: '/testimonial/2026-07/onsite-nissan-pun.jpg', alt: 'ปัน ณัฐพัชร์ ที่งาน Nissan One Team Energy Goal กับรถ Nissan Kicks e-POWER', width: 1100, height: 1466 },
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
const productFacts = [
  ['ในคอร์สจะได้เรียนอะไร', 'ได้เรียนเทคนิคการขาย + การใช้ AI Agent โดยใช้ Daruma Framework — ทีมขายลงมือสร้าง AI Agent ตัวจริงเสร็จใน 1 วัน ไม่เขียน code โดยใช้ Claude หรือ ChatGPT'],
  ['คอร์สนี้เหมาะกับใคร', 'ทีมขาย/เซลล์ + เจ้าของดีลเลอร์ (เหมาะทีม 5–20 คน)'],
  ['จัดที่ไหน', 'ที่โชว์รูม/ออฟฟิศของคุณเอง (on-site กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง)'],
  ['ใช้ระยะเวลาเท่าไหร่', '1 วัน 8 ชม.เต็ม'],
  ['ดีกว่ายังไง?', 'ถูกกว่าส่งไปเรียนข้างนอก + ใช้โจทย์ธุรกิจจริง + ถามได้เต็มที่'],
  ['เรียนยังไง', 'จับมือทำทีละคนจนสร้าง AI Agent ของธุรกิจตัวเองได้ ก่อนกลับบ้าน'],
];
const productHighlights = [
  ['ผมไปจัดให้ถึงที่ จับมือทำ — หารต่อหัวถูกกว่าส่งไปข้างนอก', `จัดทั้งทีมราคาเดียว เริ่ม ${fmtPrice('inhouse-a')} เฉลี่ยแค่ ฿${perHead.toLocaleString('en-US')}/คน (คิดจากทีม 20 คน) · เทียบส่งไปเรียน public หลักหมื่น/คน — ถ้าจัด in-house ทีม 20 คน ค่าเฉลี่ยต่อหัวถูกกว่าส่งไปเรียนข้างนอกมากครับ`],
  ['In-house ใช้โจทย์จากธุรกิจคุณจริงๆ ในการเรียน', 'เอา walk-in / follow-up / เอกสารขายของดีลเลอร์คุณมาสร้าง Agent ในห้องเลย'],
  ['In-house ถามได้เต็มที่', 'เรียนกันเองในทีม ถามได้ทุกเรื่องของธุรกิจคุณ ไม่ต้องเกรงใจคนบริษัทอื่น'],
];
const courseMorning = [
  {
    code: 'C3',
    heading: 'วางขั้นตอนขาย + follow-up ที่ทำซ้ำได้',
    body: 'ใส่ขั้นดีล งานถัดไป วันครบกำหนด และหลักฐาน ให้คนอื่นเปิดแล้วรู้ว่าต้องทำอะไรต่อ ไม่พึ่งความจำครับ',
  },
  {
    code: 'C4',
    heading: '“สมองบริษัท”: รวมข้อมูลให้ AI รู้จักดีลเลอร์คุณ',
    body: 'รวมข้อมูลลูกค้า รุ่นรถ ไฟแนนซ์ โปร และกติกาการขาย เป็นชุดบริบทให้ AI กลายเป็นน้องฝึกงานที่รู้จักบริษัทคุณ',
  },
];
const courseAfternoon = [
  {
    code: 'C7/C8',
    heading: 'จับ walk-in + คนทักเพจ แล้วเตือนเซลล์ follow-up',
    body: 'เก็บลูกค้าเข้าระบบทันที แล้วส่งสัญญาณให้เซลล์ตามต่อได้ทันจังหวะครับ',
  },
  {
    code: 'C7/C8',
    heading: 'ช่วยตอบสเปค/ไฟแนนซ์/โปร + ร่างใบเสนอราคา',
    body: 'AI ช่วยร่างจากข้อมูลจริงของดีลเลอร์คุณ และมีคนตรวจก่อนส่งให้ลูกค้าทุกครั้ง',
  },
  {
    code: 'C10',
    heading: 'แผนเอาไปใช้จริงวันจันทร์',
    body: 'กำหนด Adoption (การนำไปใช้จริง) พร้อมเคสแรกและหลักฐานที่ทีมจะกลับไปทำต่อครับ',
  },
];
const darumaPillars = [
  { letter: 'D', name: 'Data', desc: 'ข้อมูลฝ่ายขายต้องเก็บได้' },
  { letter: 'A', name: 'AI Agent', desc: 'นำ AI Agent มาลดงาน เพิ่มยอดขายจริงได้' },
  { letter: 'R', name: 'Repeatable', desc: 'ทำซ้ำได้ ไม่พึ่งดวง' },
  { letter: 'U', name: 'Upskill', desc: 'คนเก่งขึ้นด้วยระบบ' },
  { letter: 'M', name: 'Measurable', desc: 'ทุกอย่างวัดผลได้ ไม่ใช้ความรู้สึก' },
  { letter: 'A', name: 'Actionable', desc: 'นำไปใช้ได้จริงทันที' },
];
const coursePhases = [
  { label: 'ช่วงเช้า · ระบบขายก่อนใส่ AI', items: courseMorning },
  { label: 'ช่วงบ่าย · สร้าง AI Sales Office (สำนักงานขายด้วย AI)', items: courseAfternoon },
];
const courseSteps = [];
coursePhases.forEach((phase) => {
  phase.items.forEach((item, ii) => {
    courseSteps.push({ ...item, phaseLabel: ii === 0 ? phase.label : null, n: courseSteps.length + 1 });
  });
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/og-image.jpg`}
  noindex
  robots="noindex,follow"
  schema={{ types: ['WebPage'], title, description }}
>
  <Fragment slot="head">
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '890649354099149');
      fbq('track', 'PageView');
    </script>
  </Fragment>

  <div id="consent-bar" class="consent-bar hidden" role="region" aria-label="การยินยอมใช้ Meta Pixel">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 py-2.5 text-sm sm:flex-row lg:px-8">
      <p class="flex-1 text-center text-ivory/90 sm:text-left">
        เราใช้ Meta Pixel เพื่อวัดผลโฆษณา · <a href="/privacy" class="underline underline-offset-2">นโยบายความเป็นส่วนตัว</a>
      </p>
      <div class="flex shrink-0 gap-2">
        <button id="consent-decline" type="button" class="consent-button rounded-lg px-3 py-1.5 text-ivory/80 hover:bg-white/10" aria-label="ไม่ยินยอมให้ใช้ Meta Pixel">ไม่ยินยอม</button>
        <button id="consent-accept" type="button" class="consent-button rounded-lg bg-coral px-4 py-1.5 font-semibold text-white hover:bg-[#c43245]" aria-label="ยินยอมให้ใช้ Meta Pixel">ยินยอม</button>
      </div>
    </div>
  </div>

  <div id="dealer-ai-page">
    <section class="border-b border-[#c9c2b2] bg-ivory px-6 py-14 md:py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.15fr_.85fr]">
        <div>
          <p class="inline-flex items-center rounded-full border border-[#c9c2b2] bg-sand px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-cyan">In-house Workshop · สำหรับดีลเลอร์รถยนต์</p>
          <h1 class="mt-5 font-display font-bold leading-[1.02] text-navy">
            <span class="block text-5xl md:text-7xl">Sale <span class="text-coral">×</span> AI Agent</span>
            <span class="mt-3 block text-xl font-semibold text-warm-ink/70 md:text-2xl">AI Agent สำหรับฝ่ายขาย · อบรม AI ทีมขายที่โชว์รูมคุณ</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-warm-ink/80"><span class="font-bold text-navy">เซลล์ขายรถลืมตามลูกค้า = ยอดรั่วทุกเดือน</span> — AI ไม่ได้มาปิดการขายแทนเซลล์ครับ แต่พาลูกค้ามาถึงมือเซลล์ให้ <span class="font-semibold text-navy">เร็วขึ้น</span> ก่อนลูกค้าจะเดินไปเจอค่ายอื่น</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#dealer-ai-form" data-primary-cta="booking" class="btn min-h-11 border-0 bg-coral px-6 text-base text-white hover:bg-[#c43245]" aria-label="จองคิวคุยฟรี 15–20 นาที">จองคิวคุยฟรี 15–20 นาที</a>
            <a href={lineUrl} data-line-dealer target="_blank" rel="noopener" class="line-button inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-[#06c755] px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-[#05b34c]" aria-label="Line คุยกับผมก่อน">
              <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" d="M21.5 11.1c0-4.6-4.8-8.3-10.8-8.3S0 6.5 0 11.1c0 4.1 3.8 7.5 8.9 8.2-.2.2-.4.5-.5.8-.2.5-.1.9.4 1 .4.1.8-.1 1.2-.3l3.3-2.1c4.6-.8 8.2-3.7 8.2-7.6Z"/></svg>
              <span>Line คุยกับผมก่อน</span>
            </a>
          </div>
          <div class="mt-6 flex max-w-xl flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl border-2 border-coral/30 bg-white px-5 py-4 shadow-[3px_4px_0_rgba(30,27,22,0.08)]" aria-label={`ราคาคอร์ส Sale × AI Agent — จัดทั้งทีมราคาเดียว เริ่ม ${fmtPrice('inhouse-a')} เฉลี่ย ฿${perHead.toLocaleString('en-US')} ต่อคน สำหรับทีม 20 คน จัด on-site ที่โชว์รูม 1 วัน`}>
            <div>
              <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-warm-ink/55">จัดทั้งทีม ราคาเดียว</p>
              <p class="font-display text-3xl font-bold tabular-nums text-coral md:text-4xl">{fmtPrice('inhouse-a')}</p>
            </div>
            <div class="h-11 w-px bg-[#c9c2b2]" aria-hidden="true"></div>
            <div>
              <p class="text-[0.7rem] font-bold uppercase tracking-[0.12em] text-warm-ink/55">เฉลี่ยต่อคน (ทีม 20)</p>
              <p class="font-display text-3xl font-bold tabular-nums text-navy md:text-4xl">฿{perHead.toLocaleString('en-US')}</p>
            </div>
            <div class="h-11 w-px bg-[#c9c2b2]" aria-hidden="true"></div>
            <p class="text-sm font-semibold leading-snug text-navy">on-site<br />จัดที่โชว์รูมคุณ · 1 วัน</p>
          </div>
          <p class="mt-3 text-sm text-warm-ink/60">ถูกกว่าส่งเซลล์ไปเรียนคอร์ส public หลักหมื่น/คนครับ</p>
        </div>
        <div class="relative mx-auto w-full max-w-sm">
          <div class="editorial-card overflow-hidden p-0 shadow-[5px_7px_0_rgba(30,27,22,0.09)]">
            <div class="relative">
              <img src="/car-dealer-material/pun-ceo-photoshoot-1.jpg" alt="ปัน ณัฐพัชร์ — ผู้สอนคอร์ส Sale × AI Agent สำหรับดีลเลอร์รถยนต์" width="1100" height="1650" class="aspect-[4/5] w-full object-cover object-top" loading="eager" fetchpriority="high" decoding="async" />
              <div class="absolute right-3 top-3 rounded-full border border-[#c9c2b2] bg-ivory/95 p-1.5 shadow-[2px_3px_0_rgba(30,27,22,0.12)]">
                <DarumaMark class="h-14 w-auto" />
              </div>
            </div>
            <div class="p-6">
              <p class="font-display text-xl font-bold leading-snug text-navy">ตอนปิดจริง ลูกค้าอยากคุยกับ "คน"</p>
              <p class="mt-2 text-sm leading-relaxed text-warm-ink/70">AI แค่พาเขามาถึงมือเซลล์ให้ไวที่สุดครับ ที่เหลือให้เซลล์คุยต่อ</p>
            </div>
          </div>
          <p class="mt-4 text-center text-xs font-semibold uppercase tracking-[0.16em] text-warm-ink/55">ปัน ณัฐพัชร์ · ผู้สอน &amp; ที่ปรึกษา</p>
        </div>
      </div>
    </section>

    <section class="border-y border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Product · In-house Workshop</p>
        <div class="mt-3 max-w-4xl">
          <h2 class="font-display text-3xl font-bold leading-tight text-navy md:text-5xl">Sale × AI Agent</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-warm-ink/75">ทีมขายลงมือสร้าง AI Agent ของดีลเลอร์ตัวเองให้เสร็จในวันเดียวครับ เรียนจากโจทย์จริง แล้วกลับไปใช้ต่อได้ทันที</p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {productFacts.map(([label, detail]) => (
            <article class="editorial-card p-5">
              <p class="font-display text-xl font-bold text-coral">{label}</p>
              <p class="mt-3 leading-relaxed text-navy">{detail}</p>
            </article>
          ))}
        </div>

        <div class="mt-12 border-t border-[#c9c2b2] pt-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">3 เหตุผลที่ดีลเลอร์เลือก in-house</p>
          <div class="mt-5 grid gap-4 lg:grid-cols-3">
            {productHighlights.map(([heading, body]) => (
              <article class="editorial-card p-6">
                <h3 class="font-display text-2xl font-bold leading-snug text-navy">{heading}</h3>
                <p class="mt-4 leading-relaxed text-warm-ink/75">{body}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#dealer-ai-form" data-primary-cta="booking" class="btn min-h-11 border-0 bg-coral px-6 text-base text-white hover:bg-[#c43245]" aria-label="จองคิวจัดอบรม">จองคิวจัดอบรม</a>
          <a href={lineUrl} data-line-dealer target="_blank" rel="noopener" class="line-button inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-[#06c755] px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-[#05b34c]" aria-label="Line คุยกับผมก่อน">
