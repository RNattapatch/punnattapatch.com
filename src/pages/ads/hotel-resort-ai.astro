---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DarumaMark from '../../components/DarumaMark.astro';
import { SITE } from '../../data/site';
import { PRICES, fmtPrice } from '../../data/pricing.mjs';

const title = 'อบรม AI ให้ทีมโรงแรม & รีสอร์ท — คุยฟรี';
const description = 'แขกต่างชาติทักมาตอนตีสอง กว่าจะตอบตอนเช้าเขาจองที่อื่นไปแล้ว Advance AI Agent & Business Automation — อบรมในองค์กร 1 วันที่โรงแรมของคุณเอง คุยฟรี 15–20 นาที';
const canonical = `${SITE.url}/ads/hotel-resort-ai`;
const lineUrl = 'https://line.me/R/ti/p/@011xgvap';
const perHead = Math.round(PRICES['inhouse-a'].amount / 20);

// Coconut palm silhouette, drawn once and reused as an atmospheric layer in the
// dark sections. Kept as a shape rather than a photo so it never competes with
// the content — it reads as moonlight through fronds, not as a stock beach.
const palmSvg = `<svg viewBox="-150 -50 300 210" fill="currentColor" aria-hidden="true" focusable="false">
  <g>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="rotate(-8)"/>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="rotate(-52)"/>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="rotate(38)"/>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="scale(-1,1) rotate(-8)"/>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="scale(-1,1) rotate(-52)"/>
    <path d="M0 0 C 32 -20, 82 -16, 116 4 C 78 6, 32 13, 0 0 Z" transform="scale(-1,1) rotate(38)"/>
    <circle cx="-6" cy="8" r="6"/><circle cx="7" cy="11" r="5"/>
  </g>
  <path d="M0 6 C -7 46, -16 92, -38 152" fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round"/>
</svg>`;

// A hotel's day, not a marketing timeline. Every entry is a moment the front
// desk is either awake for or losing money on — which is the whole argument
// for putting an agent on the messages that arrive outside working hours.
const hotelDay = [
  { time: '02:00', phase: 'ดึก', who: 'แขกจากยุโรป', event: 'ทักมาถามห้องว่างสุดสัปดาห์หน้า เป็นภาษาอังกฤษ', cost: 'ไม่มีใครตอบจนถึงเช้า' },
  { time: '07:40', phase: 'เช้า', who: 'รีวิว 3 ดาว', event: 'โผล่ใน Google เรื่องเดิมกับเมื่อเดือนที่แล้ว', cost: 'ไม่มีใครเห็นว่ามันซ้ำ' },
  { time: '13:20', phase: 'บ่าย', who: 'ลูกค้าองค์กร', event: 'ถามราคาพักยาว 10 คืน แต่คนที่รู้เรตลาหยุด', cost: 'ตอบช้า 2 วัน' },
  { time: '22:30', phase: 'ค่ำ', who: 'คนทักเพจ', event: 'ขอจองห้องพรุ่งนี้ ถามว่ามีรถรับไหม', cost: 'แอดมินเลิกงานไปแล้ว' },
];

const painPoints = [
  ['01', 'แขกต่างชาติทักตอนตีสอง กว่าจะตอบตอนเช้า เขาจองที่อื่นไปแล้ว'],
  ['02', 'รีวิวแย่โผล่มาทีหลัง ไม่รู้ว่าเรื่องไหนพังซ้ำๆ กว่าจะรู้ดาวก็ตกแล้ว'],
  ['03', 'ราคากับโปรฯ แต่ละคนตอบไม่เหมือนกัน คนที่รู้จริงมีคนเดียว ลาทีวุ่นทั้งโรงแรม'],
];

// Straight from what Pun says on camera — three jobs, in his order.
const threeJobs = [
  {
    n: '01',
    heading: 'AI Agent รับและคัดกรองการจองผ่านแชต',
    body: 'ตอบได้หลายภาษา ตลอด 24 ชั่วโมง แขกทักตอนตีสองก็ได้คำตอบทันที แล้วส่งต่อเคสที่ต้องใช้คนจริงให้ทีมตอนเช้า',
  },
  {
    n: '02',
    heading: 'รวมรีวิวกับคอมเพลนต์ทุกช่องทาง เป็นสรุปรายสัปดาห์',
    body: 'เจ้าของกับฝ่ายบริหารเห็นเลยว่าอะไรพังซ้ำๆ ทำไมแขกไม่ happy — ไม่ต้องรอให้ปัญหาบานปลายก่อนถึงจะรู้',
  },
  {
    n: '03',
    heading: 'ข้อมูลห้องกับโปรโมชัน ให้ทุกคนตอบเหมือนกันหมด',
    body: 'ทีม Front กับทีมเซลล์หยิบข้อมูลชุดเดียวกันมาตอบแขก ลดการพึ่ง keyman — คนที่รู้ทุกอย่างลาหยุดได้โดยที่งานไม่หยุด',
  },
];

const productFacts = [
  ['ในคอร์สจะได้เรียนอะไร', 'สร้าง AI Agent ของโรงแรมคุณเองด้วย Daruma Framework — ทีมลงมือทำจนได้ Agent ตัวจริงใน 1 วัน ไม่เขียน code ใช้ Claude หรือ ChatGPT'],
  ['คอร์สนี้เหมาะกับใคร', 'ทีม Front / Reservation / Sales + เจ้าของโรงแรมและรีสอร์ท (เหมาะทีม 5–20 คน)'],
  ['จัดที่ไหน', 'ที่โรงแรมหรือรีสอร์ทของคุณเอง (on-site กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง)'],
  ['เรียนยังไง', 'จับมือทำทีละคน จนสร้าง AI Agent ของที่พักตัวเองได้ก่อนกลับบ้าน'],
];

const courseMorning = [
  {
    heading: 'วางขั้นตอนรับจอง + ตามงานที่ทำซ้ำได้',
    body: 'ใส่ขั้นของแต่ละเคส งานถัดไป วันครบกำหนด และหลักฐาน ให้คนเข้ากะถัดไปเปิดแล้วรู้ทันทีว่าค้างอะไรอยู่ ไม่ต้องพึ่งความจำครับ',
  },
  {
    heading: '“สมองโรงแรม” — รวมข้อมูลให้ AI รู้จักที่พักของคุณ',
    body: 'รวมประเภทห้อง เรตแต่ละฤดู โปรโมชัน กติกาเช็กอิน–เช็กเอาต์ และคำถามที่แขกถามบ่อย เป็นชุดบริบทเดียว ให้ AI กลายเป็นน้องฝึกงานที่รู้จักโรงแรมคุณ',
  },
];

const courseAfternoon = [
  {
    heading: 'AI ตอบแชตจอง + คัดกรอง + หลายภาษา 24 ชม.',
    body: 'ต่อกับเพจและ LINE ของโรงแรม ตอบคำถามห้องว่าง–ราคา–ทางมาได้เอง แล้วส่งเคสที่ต้องใช้คนจริงเข้าคิวให้ทีม',
    proof: true,
  },
  {
    heading: 'รวมรีวิวกับคอมเพลนต์ เป็นสรุปให้ผู้บริหารอ่าน',
    body: 'ดึงจากทุกช่องทางมารวมกัน จัดกลุ่มว่าเรื่องไหนซ้ำ เรื่องไหนโผล่ครั้งเดียว แล้วสรุปสั้นๆ ส่งเข้ามือถือเจ้าของทุกสัปดาห์',
  },
  {
    heading: 'แผนเอาไปใช้จริงวันจันทร์',
    body: 'กำหนดว่าใครดูแลอะไร เริ่มจากเคสไหนก่อน และวัดผลด้วยตัวเลขอะไร ทีมกลับไปทำต่อได้เลยครับ',
  },
];

const courseSteps = [];
[
  { label: 'ช่วงเช้า · จัดระบบงานก่อนเอา AI มาใช้', items: courseMorning },
  { label: 'ช่วงบ่าย · ลงมือสร้าง AI Agent ของโรงแรมคุณ', items: courseAfternoon },
].forEach((phase) => {
  phase.items.forEach((item, ii) => {
    courseSteps.push({ ...item, phaseLabel: ii === 0 ? phase.label : null, n: courseSteps.length + 1 });
  });
});

const takeHome = [
  ['AI Agent ของโรงแรมคุณ', 'ที่ทีมสร้างเองกับมือในห้อง — ไม่ใช่เดโมของผม'],
  ['“สมองโรงแรม”', 'ชุดข้อมูลห้อง เรต โปรฯ และกติกา ที่ AI เอาไปใช้ตอบแขกต่อได้ทันที'],
  ['ขั้นตอนรับจอง + ตามงานที่เขียนไว้', 'ให้คนเข้ากะถัดไปเปิดแล้วทำต่อได้ ไม่พึ่งความจำใครคนเดียว'],
  ['แผนเอาไปใช้จริงวันจันทร์', 'พร้อมเคสแรกที่จะลงมือทำ'],
  ['ผมไปจัดให้ถึงที่พัก', 'กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง'],
  ['ทั้งทีมราคาเดียว', '1 วัน 8 ชม.เต็ม (เหมาะทีม 5–20 คน) ไม่คิดเพิ่มรายหัว'],
];

// Four angles instead of a linear résumé — each reader arrives doubting a
// different thing. Nothing here claims hotel-operator experience he doesn't have.
const angles = [
  {
    kicker: 'มุมที่ 2 · คนคัดคนเข้าทีม',
    heading: 'ผมสัมภาษณ์ทีมขายมาแล้วหลักพันคน',
    body: 'โรงแรมคือธุรกิจที่ขึ้นกับคนหน้างานมากที่สุด ผมเคยเป็นคนคัดคนเข้าทีมมาก่อน เลยรู้ว่างานไหนควรโยนให้ AI และงานไหนต้องเก็บไว้ให้คนทำ',
  },
  {
    kicker: 'มุมที่ 3 · คนสร้างระบบเอง',
    heading: 'ผมไม่ได้สอนอย่างเดียว — ผม build ใช้เองทุกวัน',
    body: 'ระบบหลังบ้าน CRM และ AI Agent ที่ผมใช้ในธุรกิจตัวเอง ผมเขียนเอง ในห้องเรียนผมเลยเปิดของจริงให้ดูได้ ไม่ใช่เปิดสไลด์ทฤษฎี',
  },
  {
    kicker: 'มุมที่ 4 · ครู',
    heading: 'ผมจับมือทำทีละคน',
    body: 'ไม่ใช่ยืนบรรยาย 8 ชม.แล้วกลับ ทุกคนในห้องต้องมี Agent ของตัวเองก่อนเลิกเรียน ถ้าใครยังไม่ได้ ผมยังไม่ปล่อยกลับครับ',
  },
];

const clientLogos = [
  { src: '/logos/clients/nissan.png', alt: 'Nissan' },
  { src: '/logos/clients/hfc-healthfoods.png', alt: 'HFC HealthFoods Corporation' },
  { src: '/logos/clients/home-plus.png', alt: 'ฮ.โฮมพลัส' },
  { src: '/logos/clients/ving.png', alt: 'V!NG' },
  { src: '/logos/clients/scenery-farm.jpeg', alt: 'Scenery Farm' },
  { src: '/logos/clients/farevefarm.jpg', alt: 'Farevefarm' },
  { src: '/logos/clients/farmsuk.jpg', alt: 'ฟาร์มสุข farmsuk' },
  { src: '/logos/clients/zontes.png', alt: 'Zontes' },
  { src: '/logos/clients/lambretta.png', alt: 'Lambretta' },
  { src: '/logos/clients/gpx.jpg', alt: 'GPX' },
  { src: '/logos/clients/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/logos/clients/business-boy.jpg', alt: 'เด็กประกอบการ The Business Boy' },
  { src: '/logos/clients/aes.jpg', alt: 'AES' },
  { src: '/logos/clients/nsscrap.avif', alt: 'NSSCRAP' },
];

const classPhotos = [
  { src: '/testimonial/web/class-selfie.jpg', alt: 'ทีมงานทั้งทีมใส่เสื้อบริษัทนั่งเรียนพร้อมโน้ตบุ๊ก ในคลาส in-house ที่ออฟฟิศลูกค้า', width: 1080, height: 1080 },
  { src: '/testimonial/web/pun-consulting.jpg', alt: 'ปัน ณัฐพัชร์ ถือไมค์สอนหน้าห้องประชุมลูกค้า ผู้เรียนเปิดโน้ตบุ๊กทำตาม', width: 900, height: 1200 },
  { src: '/testimonial/web/seminar-room.jpg', alt: 'ห้องอบรมเต็มห้อง ผู้เรียนนั่งประจำโต๊ะพร้อมโน้ตบุ๊ก', width: 1080, height: 1080 },
];

const proofBuildIt = { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่าใช้ AI ทำเว็บที่เคยจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 };

const testimonials = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชทชมว่าสอนถูกใจทีมงาน AI ทั้งบริษัท', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิวองค์กรที่เรียนรู้เร็วที่สุด', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่าใครสนใจเรียน AI แนะนำน้องปัน', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI', width: 914, height: 914 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
];

const darumaPillars = [
  { letter: 'D', name: 'Data', desc: 'ข้อมูลของโรงแรมต้องเก็บได้' },
  { letter: 'A', name: 'AI Agent', desc: 'นำ AI Agent มาลดงาน เพิ่มยอดจองได้จริง' },
  { letter: 'R', name: 'Repeatable', desc: 'ทำซ้ำได้ ไม่พึ่งดวง' },
  { letter: 'U', name: 'Upskill', desc: 'คนเก่งขึ้นด้วยระบบ' },
  { letter: 'M', name: 'Measurable', desc: 'ทุกอย่างวัดผลได้ ไม่ใช้ความรู้สึก' },
  { letter: 'A', name: 'Actionable', desc: 'นำไปใช้ได้จริงทันที' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/og-image.jpg`}
  noindex
  robots="noindex,follow"
  schema={{ types: ['WebPage'], title, description }}
>
  <Fragment slot="head">
    <script is:inline>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '890649354099149');
      fbq('track', 'PageView');
    </script>
  </Fragment>

  <div id="consent-bar" class="consent-bar hidden" role="region" aria-label="การยินยอมใช้ Meta Pixel">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 py-2.5 text-sm sm:flex-row lg:px-8">
      <p class="flex-1 text-center text-ivory/90 sm:text-left">
        เราใช้ Meta Pixel เพื่อวัดผลโฆษณา · <a href="/privacy" class="underline underline-offset-2">นโยบายความเป็นส่วนตัว</a>
      </p>
      <div class="flex shrink-0 gap-2">
        <button id="consent-decline" type="button" class="consent-button rounded-lg px-3 py-1.5 text-ivory/80 hover:bg-white/10" aria-label="ไม่ยินยอมให้ใช้ Meta Pixel">ไม่ยินยอม</button>
        <button id="consent-accept" type="button" class="consent-button rounded-lg bg-coral px-4 py-1.5 font-semibold text-white hover:bg-[#c43245]" aria-label="ยินยอมให้ใช้ Meta Pixel">ยินยอม</button>
      </div>
    </div>
  </div>

  <div id="hotel-ai-page">
    <section class="hero-shore relative overflow-hidden border-b border-[#c9c2b2] px-6 py-14 md:py-24">
      <div class="palm palm-hero" set:html={palmSvg} />
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.15fr_.85fr]">
        <div>
          <p class="inline-flex items-center rounded-full border border-[#c9c2b2] bg-white/70 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-cyan">สำหรับโรงแรม &amp; รีสอร์ท</p>
          <h1 class="mt-5">
            <span class="block text-2xl font-bold leading-snug text-navy md:text-[2rem]">
              <span class="block">คอร์สอบรมในองค์กร ที่ออกแบบมาเพื่อ<span class="whitespace-nowrap text-coral">งานโรงแรม</span>โดยเฉพาะ</span>
              <span class="block">ผมไปจัดให้ถึงที่พักของคุณเอง</span>
            </span>
            <span class="mt-4 block font-display text-[2.75rem] font-bold leading-[1.05] tracking-tight text-navy md:text-6xl">Advance AI Agent<br /><span class="text-cyan">&amp;</span> Business Automation</span>
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-warm-ink/80"><span class="font-bold text-navy">แขกทักตอนตีสอง กว่าจะตอบตอนเช้า เขาจองที่อื่นไปแล้ว</span> — AI ไม่ได้มาต้อนรับแขกแทนคนครับ แต่รับสายที่ไม่มีใครรับ และเก็บงานซ้ำๆ ไปทำแทน</p>

          <div class="mt-8 flex flex-wrap gap-3">
