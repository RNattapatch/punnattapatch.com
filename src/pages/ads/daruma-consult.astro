<style>
  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; min-height: 44px; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
  .line-button { min-height: 44px; }
  .intent-btn { width: 100%; text-align: left; border: 2px solid var(--pun-border); border-radius: .75rem; background: #fff; color: var(--pun-navy); padding: .7rem 1rem; min-height: 44px; cursor: pointer; transition: border-color .15s, background-color .15s, color .15s; }
  .intent-btn:hover { border-color: var(--pun-coral); }
  .intent-btn.is-selected { border-color: var(--pun-coral); background: var(--pun-coral); color: #fff; }
  .intent-btn:focus-visible { outline: 2px solid color-mix(in oklch, var(--pun-coral) 40%, transparent); outline-offset: 2px; }
  :global(body:has(#daruma-consult-page) .nav-cta),
  :global(body:has(#daruma-consult-page) .menu-mobile li.mt-2) { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .line-button, .intent-btn { transition: none; }
  }
</style>

<script>
  type Attribution = Record<string, string | undefined>;
  type MetaWindow = Window & { fbq?: (...args: unknown[]) => void; pnAttribution?: Attribution };

  const pageWindow = window as MetaWindow;
  const form = document.getElementById('daruma-consult-booking-form') as HTMLFormElement | null;
  const formSection = document.getElementById('daruma-consult-form');
  const success = document.getElementById('daruma-consult-success');
  const error = document.getElementById('daruma-consult-error');
  const submit = document.getElementById('daruma-consult-submit') as HTMLButtonElement | null;
  const WEBHOOK = 'https://rnat.app.n8n.cloud/webhook/intake-form-v2';
  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];

  function populateAttribution() {
    const query = new URLSearchParams(window.location.search);
    const stored = pageWindow.pnAttribution || {};
    UTM_KEYS.forEach((key) => {
      const input = document.getElementById(key) as HTMLInputElement | null;
      if (input) input.value = query.get(key) || stored[key] || '';
    });
  }

  populateAttribution();

  if (formSection && 'IntersectionObserver' in window) {
    let fired = false;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting) && !fired) {
        fired = true;
        if (typeof pageWindow.fbq === 'function') fbq('track', 'ViewContent', { content_name: 'daruma_consult_form' });
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(formSection);
  }

  document.querySelectorAll('[data-line-daruma]').forEach((lineButton) => {
    lineButton.addEventListener('click', () => {
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Contact', { content_name: 'line_add_daruma' });
    });
  });

  // Intent selector — warm (free consult) vs hot (book training); value goes into the form payload
  const intentField = document.getElementById('intent-field') as HTMLInputElement | null;
  document.querySelectorAll('.intent-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.intent-btn').forEach((b) => {
        b.classList.remove('is-selected');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-selected');
      btn.setAttribute('aria-pressed', 'true');
      if (intentField) intentField.value = (btn as HTMLElement).dataset.intent || '';
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if ((new FormData(form).get('honeypot-name') as string)?.trim()) return;

    const payload = Object.fromEntries(new FormData(form).entries());
    const intentLabel = payload.intent === 'book-training' ? 'จองคิวจัดอบรม' : 'ขอคุยฟรีก่อน';
    Object.assign(payload, {
      // Canonical aliases — the shared intake-form-v2 flow + submit_lead RPC read
      // company/tier/problems/comment (see docs/INTAKE-DATA-CONTRACT.md).
      // `company` is now a real required form field (ชื่อบริษัท) — the business
      // description moves to `industry` → business_type column.
      company: ((payload.company as string) || '').trim() || (payload.business as string) || '',
      industry: payload.business || '',
      tier: payload.intent === 'book-training' ? 'HOT' : 'WARM',
      problems: (payload.issue as string) || '',
      comment: [intentLabel, payload.issue].filter(Boolean).join(' — '),
      source: 'ads-daruma-consult',
      source_page: 'ads/daruma-consult',
      booking_type: 'daruma-consult',
      submitted_at: new Date().toISOString(),
      path: window.location.pathname,
      recommended_path: 'free-consultation',
    });

    if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
    error?.classList.add('hidden');

    try {
      const response = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      });
      if (!response.ok) throw new Error('submission failed');
      const intentValue = (payload.intent as string) || 'free-consult';
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Lead', { content_name: 'daruma_consult_booking', content_category: intentValue });
      (window as unknown as { plausible?: (...args: unknown[]) => void }).plausible?.('Booking Submit', { props: { source: 'ads-daruma-consult', intent: intentValue } });
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว กรุณาลองใหม่ หรือแอด LINE เพื่อส่งโจทย์ให้ผม'; error.classList.remove('hidden'); }
      if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูล'; }
    }
  });

</script>
