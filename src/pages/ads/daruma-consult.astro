const courseSteps = [];
[
  { label: 'ช่วงเช้า · จัดระบบขายก่อนเอา AI มาใช้', items: courseMorning },
  { label: 'ช่วงบ่าย · สร้าง AI Sales Office (สำนักงานขายด้วย AI)', items: courseAfternoon },
].forEach((phase) => {
  phase.items.forEach((item, ii) => {
    courseSteps.push({ ...item, phaseLabel: ii === 0 ? phase.label : null, n: courseSteps.length + 1 });
  });
});

const takeHome = [
  ['AI Agent ของธุรกิจคุณ', 'ที่ทีมสร้างเองกับมือในห้อง — ไม่ใช่เดโมของผม'],
  ['“สมองบริษัท”', 'ชุดบริบทธุรกิจคุณที่ AI เอาไปใช้ต่อได้ทันที'],
  ['ขั้นตอนขาย + follow-up ที่เขียนไว้', 'ให้คนอื่นเปิดแล้วทำต่อได้ ไม่พึ่งความจำใครคนเดียว'],
  ['แผนเอาไปใช้จริงวันจันทร์', 'พร้อมเคสแรกที่จะลงมือทำ'],
  ['ผมไปจัดให้ถึงออฟฟิศ', 'กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง'],
  ['ทั้งทีมราคาเดียว', '1 วัน 8 ชม.เต็ม (เหมาะทีม 5–20 คน) ไม่คิดเพิ่มรายหัว'],
