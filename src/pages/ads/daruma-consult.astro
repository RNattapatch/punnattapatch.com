const proofBuildIt = {
  src: '/testimonial/2026-07/scenery/scenery-screen.jpg',
  alt: 'ทีมลูกค้านั่งดูจอที่กำลังเปิดระบบ CRM ระหว่างคลาส in-house',
  width: 825,
  height: 1100,
