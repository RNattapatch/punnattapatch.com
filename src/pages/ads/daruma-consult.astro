---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DarumaMark from '../../components/DarumaMark.astro';
import { SITE } from '../../data/site';
import { PRICES, fmtPrice } from '../../data/pricing.mjs';

const title = 'Sale × AI Agent — คอร์ส AI สำหรับฝ่ายขายโดยเฉพาะ';
const description = 'ไม่ใช่คอร์ส AI ทั่วไปที่ให้ไปปรับใช้กับงานขายเอง — ออกแบบมาเพื่อฝ่ายขายตั้งแต่ต้น สอนโดยคนที่ทำงานขายจริงและ build AI Agent ใช้เองจริง จัด in-house ที่ออฟฟิศคุณ 1 วัน คุยฟรี 15–20 นาที';
const canonical = `${SITE.url}/ads/daruma-consult`;
const lineUrl = 'https://line.me/R/ti/p/@011xgvap';
const perHead = Math.round(PRICES['inhouse-a'].amount / 20);
// Qualification options mirrored from /booking so ads leads populate the same CRM columns via intake-form-v2
const issues = [
  'ข้อมูลลูกค้ากระจาย อยู่ในไลน์กับหัวคน',
  'เซลล์หมดเวลาไปกับงานเอกสารและงานซ้ำ',
  'ยอดขึ้นๆ ลงๆ เดาไม่ได้ว่าเดือนหน้าจะเป็นยังไง',
  'ทีมพึ่งคนเก่งคนเดียว คนอื่นตามไม่ทัน',
  'วัดผลทีมไม่ได้ ประชุมด้วยความรู้สึก',
  'ลงทุนเรียนหรือซื้อเครื่องมือมาแล้ว แต่ทีมไม่ได้ใช้จริง',
];

const painPoints = [
  ['01', 'ลูกค้าที่เคยคุยไว้หายไปเงียบๆ ไม่มีใครตามต่อ'],
  ['02', 'คนทักเพจ / LINE ตกค้าง กว่าจะตอบ ลูกค้าไปเจ้าอื่นแล้ว'],
  ['03', 'ไม่รู้ว่าลูกค้าคนไหนใกล้ปิด ควรโทรหาใครก่อน'],
];

// The whole point of this page: the course is built for one department, not
// adapted to it. Each row contrasts what a general AI course leaves the team
// holding vs. what this one hands them.
const specificity = [
  {
    generic: 'สอนวิธี prompt แล้วให้ไปคิดต่อเองว่าจะใช้กับงานขายยังไง',
    ours: 'เริ่มจากขั้นตอนขายของคุณก่อน แล้วค่อยวางว่า AI เข้าไปยืนตรงไหน',
  },
  {
    generic: 'ใช้เคสตัวอย่างกลางๆ ที่ไม่ใช่สินค้าและลูกค้าของคุณ',
    ours: 'เอาลูกค้าจริง ราคาจริง โปรจริง ของธุรกิจคุณมาสร้าง Agent ในห้อง',
  },
  {
    generic: 'จบคอร์สได้ความรู้ แต่พรุ่งนี้เซลล์ยังทำงานแบบเดิม',
    ours: 'จบคอร์สทีมมี Agent ของตัวเอง + แผนว่าใครใช้ตรงไหนตั้งแต่วันแรก',
  },
];

const threeJobs = [
  {
    n: '01',
    heading: 'จับลูกค้าเข้าระบบทันที แล้วเตือนเซลล์ให้ตามต่อ',
    body: 'คนทักเพจ คนกรอกฟอร์ม คนเดินเข้ามา — เก็บเข้าระบบอัตโนมัติ แล้วส่งเตือนเข้า LINE ให้เซลล์ตามได้ทันจังหวะ ไม่มีลืม',
  },
  {
    n: '02',
    heading: 'อ่านข้อมูลหลังบ้าน บอกว่าควรโฟกัสใครก่อน',
    body: 'แทนที่เซลล์จะไล่โทรตามลำดับที่จำได้ AI ช่วยจัดว่าดีลไหนใกล้ปิด ดีลไหนเงียบไปนานเกินไปแล้ว',
  },
  {
    n: '03',
    heading: 'ตอบสเปค ราคา โปรฯ และร่างใบเสนอราคาให้',
