const classPhotos = [
  { src: '/testimonial/web/class-selfie.jpg', alt: 'ทีมงานทั้งทีมใส่เสื้อบริษัทนั่งเรียนพร้อมโน้ตบุ๊ก ในคลาส in-house ที่ออฟฟิศลูกค้า', width: 1080, height: 1080 },
  { src: '/testimonial/2026-07/scenery/scenery-room.jpg', alt: 'คลาส in-house ที่ The Scenery สวนผึ้ง — ทีมงานนั่งประจำโต๊ะพร้อมโน้ตบุ๊ก', width: 1100, height: 825 },
