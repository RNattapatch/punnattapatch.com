  },
];

// Four angles instead of a linear résumé. The featured one carries the thesis
// of this page: most AI teachers have never sold, most sales teachers have
// never built. Nothing here is a credential he doesn't have.
const angles = [
  {
    kicker: 'มุมที่ 2 · สายบริหาร',
    heading: 'ผมบริหารทีมขายและบริหารธุรกิจมาเอง',
    body: 'คนละช่วงกับตอนอยู่บริษัทรถครับ — ผมเป็นคนคัดคนเข้าทีม สัมภาษณ์มาแล้วหลักพันคน แล้วต้องมาคุมยอด คุมคน คุมต้นทุนเอง เลยรู้ว่างานไหนควรโยนให้ AI และงานไหนต้องเก็บไว้ให้คนทำ',
    photo: { src: '/about/pun-cert-management.jpg', alt: 'ปัน ณัฐพัชร์ รับวุฒิบัตรหลักสูตรด้านบริหารธุรกิจ', width: 1100, height: 733 },
  },
  {
    kicker: 'มุมที่ 3 · คนสร้างระบบเอง',
