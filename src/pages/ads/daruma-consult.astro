    body: 'ระบบหลังบ้าน CRM และ AI Agent ที่ผมใช้ในธุรกิจตัวเอง ผมเขียนเอง ในห้องเรียนผมเลยเปิดของจริงให้ดูได้ ไม่ใช่เปิดสไลด์ทฤษฎี',
    photo: { src: '/about/pun-build-desk.jpg', alt: 'โต๊ะทำงานของปัน ณัฐพัชร์ จอสองใบเปิดโค้ดและเทอร์มินัลระหว่าง build ระบบ', width: 1100, height: 825 },
  },
  {
    kicker: 'มุมที่ 4 · การทำงาน',
    heading: 'ผมจับมือทำทีละคน',
    body: 'ไม่ใช่ยืนบรรยาย 8 ชม.แล้วกลับ ทุกคนในห้องต้องมี Agent ของตัวเองก่อนเลิกเรียน ถ้าใครยังไม่ได้ ผมยังไม่ปล่อยกลับครับ',
    photo: { src: '/about/pun-working-with-team.jpg', alt: 'ปัน ณัฐพัชร์ ยืนอธิบายหน้าจอให้ทีมลูกค้าที่เปิดโน้ตบุ๊กทำตามในออฟฟิศ', width: 1100, height: 825 },
  },
];

const productFacts = [
  ['ในคอร์สจะได้เรียนอะไร', 'เทคนิคการขาย + การใช้ AI Agent ด้วย Daruma Framework — ทีมลงมือสร้าง AI Agent ตัวจริงเสร็จใน 1 วัน ไม่เขียน code ใช้ Claude หรือ ChatGPT'],
  ['คอร์สนี้เหมาะกับใคร', 'ทีมขาย/เซลล์ + เจ้าของธุรกิจ (เหมาะทีม 5–20 คน)'],
  ['จัดที่ไหน', 'ที่ออฟฟิศของคุณเอง (on-site กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง)'],
  ['เรียนยังไง', 'จับมือทำทีละคน จนสร้าง AI Agent ของธุรกิจตัวเองได้ก่อนกลับบ้าน'],
];

const courseMorning = [
  {
    heading: 'วางขั้นตอนขาย + follow-up ที่ทำซ้ำได้',
    body: 'ใส่ขั้นดีล งานถัดไป วันครบกำหนด และหลักฐาน ให้คนอื่นเปิดแล้วรู้ว่าต้องทำอะไรต่อ ไม่พึ่งความจำครับ',
  },
  {
    heading: '“สมองบริษัท” — รวมข้อมูลให้ AI รู้จักธุรกิจคุณ',
    body: 'รวมข้อมูลลูกค้า สินค้า ราคา โปรฯ และกติกาการขาย เป็นชุดบริบทให้ AI กลายเป็นน้องฝึกงานที่รู้จักบริษัทคุณ',
