  priceLabel: 'AI สำหรับทีมขาย 2026 · In-house Workshop',
  priceAmount: fmtPrice('inhouse-a'),
  priceNote: `มากัน 20 คน เฉลี่ยคนละ ${perHead.toLocaleString('th-TH')} บาท ถูกกว่าค่าคอร์ส public ต่อ 1 ที่นั่ง`,
  priceIncludes: [
    'อบรม on-site ที่ออฟฟิศคุณ 1 วันเต็ม (ทีม 5–20 คน)',
    'Specialist AI Agent คนละ 1 ตัว สร้างจากข้อมูลจริง เสร็จในวันนั้น',
    'สมองบริษัท: company-context.md + FFAB Sheet + prompt 23+ ตัว',
    'Review Checklist + Data Rules + Monday Plan รายคน',
    'ติดตามผ่าน LINE 7 วันหลังเรียน',
    'ใบกำกับภาษีนามบริษัท ฝ่ายบัญชีเบิกได้',
  ],
  priceTerms: [
    'เงื่อนไขเดียวที่ผมขอ: ชำระเต็มจำนวนก่อนวันอบรมครับ เพื่อให้ทั้งสองฝั่งจริงจังกับวันนั้นเท่ากัน · on-site กรุงเทพฯ และปริมณฑล ไม่คิดค่าเดินทาง',
    'อยากให้ผมอยู่ยาวกว่า 7 วัน มีแพ็กเกจ "พาลงมือทำ" ต่อยอดหลังคอร์ส ถามรายละเอียดได้ในคิวคุยฟรี',
  ],
  priceReassure: 'ยังไม่ต้องเชื่อผมครับ ให้ผมดูขั้นตอนขายของคุณก่อน แล้วค่อยตัดสินใจว่าคุ้มไหม',

  faqs: [
    { q: 'ทีมผมไม่เก่งเทคโนโลยีเลย เรียนไหวไหม', a: 'ไหวครับ ไม่ต้องเขียนโค้ด สั่งงานเป็นภาษาไทยได้ และเราเริ่มจาก template ไม่ใช่หน้าจอว่างๆ ทุกขั้นตอนทำตามพร้อมกันทีละคลิก ใครหลุดผมเดินไปนั่งข้างๆ จนตามทัน คนที่พิมพ์ช้าที่สุดในห้องคือ KPI ของผม' },
    { q: 'ต้องเตรียมอะไรก่อนวันอบรม', a: 'เตรียมข้อมูลบริษัทและงานขายตาม Pre-work Checklist ที่ผมส่งให้หลังยืนยันวัน ติดตั้งเครื่องมือให้พร้อม และให้ IT เช็คการเข้าถึงเครือข่ายก่อนวันจริง เพื่อให้เวลาในห้องหมดไปกับการลงมือทำ ไม่ใช่การลงโปรแกรม' },
    { q: 'ข้อมูลบริษัทที่ใช้ในคลาส ปลอดภัยไหม', a: 'ในคลาสมี Data Rules ชัดเจนครับ ข้อมูลส่วนตัวลูกค้า ต้นทุน สัญญา และข้อมูลที่บริษัทไม่อนุญาต ต้องตัดออกหรือทำให้ไม่ระบุตัวตนก่อนใช้ และกติกานี้เป็นหนึ่งในของที่ทีมได้กลับไปใช้ต่อด้วย' },
    { q: 'AI จะมาแทนเซลล์ของผมหรือเปล่า', a: 'ไม่ครับ และผมพูดเรื่องนี้ตรงๆ ในคลาสด้วย agent มีหน้าที่ร่าง เตรียม สรุป และซ้อม ส่วนงานที่แตะลูกค้า ราคา หรือเงื่อนไข ต้องมีคนตรวจและอนุมัติทุกครั้ง AI รับงานครับ ไม่ได้รับตำแหน่งใคร' },
    { q: 'จบคลาสแล้ว ถ้าติดปัญหาถามใครได้', a: 'มีติดตามผ่าน LINE 7 วันหลังเรียนครับ อาทิตย์แรกคือช่วงที่คำถามจริงโผล่ ผมตอบเองทั้งหมด ถ้าอยากได้คนพาไปต่อยาวกว่านั้น มีแพ็กเกจ "พาลงมือทำ" ที่ผมเข้าไปทำงานกับทีมต่อเนื่อง คุยกันได้ครับ' },
    { q: 'อยากได้ระบบอัตโนมัติเต็มบริษัท ทำในวันเดียวได้ไหม', a: 'ไม่ได้ครับ และผมไม่รับปากในสิ่งที่วันเดียวทำไม่ได้ หนึ่งวันนี้ล็อก scope ที่ agent 1 ตัวต่อคน สมองบริษัทเวอร์ชันแรก และกติกาใช้ต่อ ระบบหลายแผนกหรือ automation เต็มรูปแบบต้องประเมินและออกแบบแยกเป็นงานที่ปรึกษา' },
    { q: 'จ่ายเงินยังไง มีเอกสารให้ฝ่ายบัญชีไหม', a: 'ชำระเต็มจำนวนก่อนวันอบรม ออกใบกำกับภาษีในนามบริษัทให้ครบครับ ใบเสนอราคาสำหรับขออนุมัติภายในก็ทำให้ได้ บอกผมในคิวคุยฟรีได้เลย' },
  ],
  nudgeFaq: 'คำถามของคุณไม่อยู่ในลิสต์นี้ใช่ไหมครับ? ถามผมตรงๆ ในไลน์ได้เลย ไม่ต้องกรอกฟอร์ม',
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}/og-image.jpg`}
  noindex
  robots="noindex,follow"
  schema={{ types: ['WebPage'], title, description }}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:wght@500;600;700&display=swap"
  />

  {/* Meta Pixel loads site-wide from BaseLayout (MetaPixel.astro).
      The conversion events below still fire from this page. */}

  <div id="daruma-consult-page" class="lp-v2">
    <AdsContentV2 {...content} />

    <section id="daruma-consult-form" class="scroll-mt-20 px-6 py-16 md:py-24">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">จองคิวคุยฟรี</p>
          <h2 class="mt-3 font-display text-3xl font-bold leading-tight text-navy md:text-5xl">เล่าโจทย์ทีมขายของคุณให้ผมฟัง</h2>
          <p class="mt-5 leading-relaxed text-warm-ink/75">กรอกข้อมูลสั้นๆ ไว้ครับ เดี๋ยวผมทักกลับทาง LINE หรือโทรศัพท์ แล้วคุยกัน 15–20 นาที ว่าทีมขายคุณควรเริ่มวางระบบ AI ตรงไหนก่อน</p>
        </div>

        <form id="daruma-consult-booking-form" class="editorial-card p-6 md:p-9" novalidate>
          <input name="honeypot-name" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
          <div class="space-y-5">
            <fieldset aria-label="เลือกสิ่งที่คุณต้องการให้ผมช่วย">
              <legend class="field-label mb-2">คุณอยากให้ผมช่วยเรื่องไหนครับ</legend>
              <div class="grid gap-3 sm:grid-cols-2">
                <button type="button" class="intent-btn" data-intent="book-training" aria-pressed="false">
                  <span class="block font-bold">ขอนัดคิวจัดอบรม</span>
                  <span class="mt-0.5 block text-sm opacity-80">AI สำหรับทีมขาย 2026 · in-house 1 วัน</span>
                </button>
                <button type="button" class="intent-btn is-selected" data-intent="free-consult" aria-pressed="true">
                  <span class="block font-bold">ขอปรึกษาฟรีเบื้องต้น</span>
                  <span class="mt-0.5 block text-sm opacity-80">คุยก่อน 15–20 นาที</span>
                </button>
              </div>
              <input type="hidden" name="intent" id="intent-field" value="free-consult" />
            </fieldset>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="field-label">ชื่อของคุณ<input name="name" required autocomplete="name" class="field" aria-label="ชื่อของคุณ" /></label>
              <label class="field-label">เบอร์โทรมือถือ<input name="phone" type="tel" required inputmode="tel" autocomplete="tel" pattern={"[0-9\\(\\)\\+\\-\\s]{9,15}"} class="field" placeholder="เช่น 0812345678" aria-label="เบอร์โทรมือถือ" /></label>
            </div>
            <div class="grid gap-5 sm:grid-cols-2"> <label class="field-label">ตำแหน่งของคุณ<select name="position" required class="field" aria-label="ตำแหน่งของคุณ"><option value="">เลือกตำแหน่ง</option><option>CEO / เจ้าของกิจการ</option><option>Managing Director</option><option>Sales Director</option><option>Sales Manager</option><option>Marketing Manager</option><option>Operations Manager</option><option>อื่นๆ</option></select></label> <label class="field-label">LINE ID <span class="font-normal text-warm-ink/55">(ถ้ามี)</span><input name="line_id" autocomplete="off" class="field" placeholder="เช่น @yourshop หรือ ไอดีไลน์" aria-label="LINE ID" /></label> </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="field-label">ชื่อบริษัท<input name="company" required autocomplete="organization" placeholder="เช่น บจก. สยามเครื่องจักรกล" class="field" aria-label="ชื่อบริษัท" /></label>
              <label class="field-label">ธุรกิจของคุณทำเกี่ยวกับอะไร<input name="business" required placeholder="เช่น ขายเครื่องจักร B2B, ตัวแทนจำหน่ายอะไหล่" class="field" aria-label="ธุรกิจของคุณทำเกี่ยวกับอะไร" /></label>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="field-label">ทีมขายกี่คน<select name="team_size" required class="field" aria-label="ทีมขายกี่คน"><option value="">เลือกขนาดทีม</option><option value="0">ยังไม่มีทีมขาย</option><option value="1-4">1–4 คน</option><option value="5-10">5–10 คน</option><option value="11-20">11–20 คน</option><option value="20+">มากกว่า 20 คน</option></select></label>
              <label class="field-label">งบที่พร้อมลงทุน<select name="budget" required class="field" aria-label="งบที่พร้อมลงทุน"><option value="">เลือกช่วงงบ</option><option>ยังไม่ได้ตั้งงบ — อยากเห็นโจทย์ก่อน</option><option>ต่ำกว่า ฿50,000</option><option>฿50,000–฿100,000</option><option>฿100,000–฿300,000</option><option>มากกว่า ฿300,000</option></select></label>
            </div>
            <label class="field-label">ตอนนี้เรื่องไหนติดสุด<select name="issue" required class="field" aria-label="ตอนนี้เรื่องไหนติดสุด"><option value="">เลือกเรื่องที่ตรงที่สุด</option>{issues.map((issue) => <option value={issue}>{issue}</option>)}</select></label>
            <input id="utm_source" name="utm_source" type="hidden" />
            <input id="utm_medium" name="utm_medium" type="hidden" />
            <input id="utm_campaign" name="utm_campaign" type="hidden" />
            <input id="utm_content" name="utm_content" type="hidden" />
            <input id="utm_term" name="utm_term" type="hidden" />
            <input id="fbclid" name="fbclid" type="hidden" />
            <input id="ttclid" name="ttclid" type="hidden" />
            <AfterHoursField variant="warm" />
            <label class="flex cursor-pointer items-start gap-3 pt-1"><input name="consent" type="checkbox" required class="checkbox mt-0.5" aria-label="ยินยอมให้ติดต่อกลับตามนโยบายความเป็นส่วนตัว" /><span class="text-sm leading-relaxed text-warm-ink/75">ยินยอมให้ติดต่อกลับตาม <a href="/privacy" class="font-semibold text-cyan underline">นโยบายความเป็นส่วนตัว</a></span></label>
            <p id="daruma-consult-error" class="hidden rounded-xl border border-error/40 bg-error/10 p-4 text-sm text-error" role="alert" aria-live="polite"></p>
            <button id="daruma-consult-submit" type="submit" class="btn min-h-11 w-full border-0 bg-coral py-4 text-base text-white hover:bg-[#c43245]" aria-label="ส่งข้อมูล">ส่งข้อมูล</button>
          </div>
        </form>

        <div id="daruma-consult-success" class="editorial-card hidden p-8 text-center lg:col-start-2" role="status" aria-live="polite">
          <DarumaMark class="mx-auto h-auto w-20" />
          <h2 class="mt-5 font-display text-3xl font-bold text-navy">รับข้อมูลแล้วครับ</h2>
          <p class="mt-3 leading-relaxed text-warm-ink/75">ผมจะอ่านโจทย์ก่อนครับ แล้วทักกลับทาง LINE หรือโทรศัพท์ คุยกันฟรี 15–20 นาที</p>
          <p class="mt-5 border-t border-[#c9c2b2] pt-4 text-sm leading-relaxed text-warm-ink/75">ระหว่างรอผมติดต่อกลับ อ่านหน้านี้ 3 นาทีครับ จะได้รู้จักกันก่อนคุยจริง<br /><a href="/start" class="font-semibold text-cyan underline">รู้จักผมใน 3 นาที →</a></p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-6xl border-t border-[#c9c2b2] pt-10">
        <p class="text-center text-lg font-semibold text-navy">ไม่แน่ใจว่าควรเริ่มยังไง? อยากคุยกับผมก่อนก็ได้ครับ</p>
        <div class="mx-auto mt-5 flex max-w-sm justify-center">
          <a href={lineUrl} data-line-daruma target="_blank" rel="noopener" class="line-button flex w-full min-h-11 items-center justify-center gap-2 rounded-xl bg-[#06c755] px-4 py-3 text-center font-semibold text-white transition-colors hover:bg-[#05b34c]" aria-label="แอดไลน์คุยกับปันก่อน">
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" d="M21.5 11.1c0-4.6-4.8-8.3-10.8-8.3S0 6.5 0 11.1c0 4.1 3.8 7.5 8.9 8.2-.2.2-.4.5-.5.8-.2.5-.1.9.4 1 .4.1.8-.1 1.2-.3l3.3-2.1c4.6-.8 8.2-3.7 8.2-7.6Z"/></svg>
            <span>แอดไลน์คุยกับปันก่อน</span>
          </a>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; min-height: 44px; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
  .line-button { min-height: 44px; }
  .intent-btn { width: 100%; text-align: left; border: 2px solid var(--pun-border); border-radius: .75rem; background: #fff; color: var(--pun-navy); padding: .7rem 1rem; min-height: 44px; cursor: pointer; transition: border-color .15s, background-color .15s, color .15s; }
  .intent-btn:hover { border-color: var(--pun-coral); }
  .intent-btn.is-selected { border-color: var(--pun-coral); background: var(--pun-coral); color: #fff; }
  .intent-btn:focus-visible { outline: 2px solid color-mix(in oklch, var(--pun-coral) 40%, transparent); outline-offset: 2px; }
  :global(body:has(#daruma-consult-page) .nav-cta),
  :global(body:has(#daruma-consult-page) .menu-mobile li.mt-2) { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .line-button, .intent-btn { transition: none; }
  }
</style>

<script>
  import { foldAfterHours } from '../../scripts/after-hours';
  import { submitLeadFallback, makeReference } from '../../scripts/lead-fallback';

  type Attribution = Record<string, string | undefined>;
  type MetaWindow = Window & { fbq?: (...args: unknown[]) => void; pnAttribution?: Attribution };

  const pageWindow = window as MetaWindow;
  const form = document.getElementById('daruma-consult-booking-form') as HTMLFormElement | null;
  const formSection = document.getElementById('daruma-consult-form');
  const success = document.getElementById('daruma-consult-success');
  const error = document.getElementById('daruma-consult-error');
  const submit = document.getElementById('daruma-consult-submit') as HTMLButtonElement | null;
  const WEBHOOK = 'https://form-hook.punnattapatch.com/webhook/intake-form-v2';

  /**
   * Reference token, same shape as intake-form.astro's makeReference().
   * Added 2026-08-01: the ads landing pages never sent one, so `reference`
   * arrived empty at n8n — which meant the TikTok Events API node posted
   * event_id: "" on every ads lead and could not dedupe against the browser
   * pixel. It is also the event_id Meta CAPI will need.
   */
  function makeAdsReference(): string {
    const stamp = new Date().toISOString().replace(/[-:T.Z]/g, '').slice(0, 12);
    const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
    return `PN-${stamp}-${rand}`;
  }

  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  // Click IDs are the strongest match signal for Meta/TikTok server-side events.
  // BaseLayout already stashes them in pnAttribution (14-day TTL); before
  // 2026-08-01 the ads forms simply never read them back out, so every ads lead
  // reached the CRM with fbclid/ttclid empty.
  const CLICK_ID_KEYS = ['fbclid', 'ttclid'];

  function populateAttribution() {
    const query = new URLSearchParams(window.location.search);
    const stored = pageWindow.pnAttribution || {};
    [...UTM_KEYS, ...CLICK_ID_KEYS].forEach((key) => {
      const input = document.getElementById(key) as HTMLInputElement | null;
      if (input) input.value = query.get(key) || stored[key] || '';
    });
  }

  populateAttribution();

  if (formSection && 'IntersectionObserver' in window) {
    let fired = false;
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting) && !fired) {
        fired = true;
        if (typeof pageWindow.fbq === 'function') fbq('track', 'ViewContent', { content_name: 'daruma_consult_form' });
        observer.disconnect();
      }
    }, { threshold: 0.4 });
    observer.observe(formSection);
  }

  document.querySelectorAll('[data-line-daruma]').forEach((lineButton) => {
    lineButton.addEventListener('click', () => {
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Contact', { content_name: 'line_add_daruma' });
    });
  });

  // Intent selector — warm (free consult) vs hot (book training); value goes into the form payload
  const intentField = document.getElementById('intent-field') as HTMLInputElement | null;
  document.querySelectorAll('.intent-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.intent-btn').forEach((b) => {
        b.classList.remove('is-selected');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-selected');
      btn.setAttribute('aria-pressed', 'true');
      if (intentField) intentField.value = (btn as HTMLElement).dataset.intent || '';
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if ((new FormData(form).get('honeypot-name') as string)?.trim()) return;

    // Contract rule 5 — validate the number client-side. This page had no phone
    // check at all until 2026-08-01, which is how a LINE handle ("ss_aor") and a
    // placeholder ("0800000000") reached the phone column in the CRM.
    const phoneRaw = String(new FormData(form).get('phone') || '').replace(/[\s()\-]/g, '');
    if (!/^(?:\+?66|0)\d{8,9}$/.test(phoneRaw)) {
      if (error) { error.textContent = 'กรุณากรอกเบอร์โทรมือถือจริง เช่น 0812345678 ครับ'; error.classList.remove('hidden'); }
      (form.querySelector('[name="phone"]') as HTMLInputElement | null)?.focus();
      return;
    }

    const payload = Object.fromEntries(new FormData(form).entries());
    const intentLabel = payload.intent === 'book-training' ? 'จองคิวจัดอบรม' : 'ขอคุยฟรีก่อน';
    Object.assign(payload, {
      phone: phoneRaw,
      // Canonical aliases — the shared intake-form-v2 flow + submit_lead RPC read
      // company/tier/problems/comment (see docs/INTAKE-DATA-CONTRACT.md).
      // `company` is now a real required form field (ชื่อบริษัท) — the business
      // description moves to `industry` → business_type column.
      company: ((payload.company as string) || '').trim() || (payload.business as string) || '',
      industry: payload.business || '',
      tier: payload.intent === 'book-training' ? 'HOT' : 'WARM',
      problems: (payload.issue as string) || '',
      comment: [intentLabel, payload.issue].filter(Boolean).join(' — '),
      source: 'ads-daruma-consult',
      source_page: 'ads/daruma-consult',
      booking_type: 'daruma-consult',
      // Flatten Body1 reads `submittedAt` (camelCase) — the snake_case key used
      // here until 2026-08-01 never matched, so n8n silently fell back to its
      // own execution time.
      submittedAt: new Date().toISOString(),
      // Flatten Body1 sources reference/user_agent/referrer from `_meta` only.
      _meta: {
        reference: makeAdsReference(),
        page: window.location.pathname,
        user_agent: navigator.userAgent,
        referrer: document.referrer || '',
      },
    });
    // ⏰ นอกเวลาทำการ — พ่วงเข้า comment ด้วย เพราะ n8n Flatten Body1 ยังไม่รู้จัก key นี้
    foldAfterHours(payload as Record<string, unknown>);

    if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
    error?.classList.add('hidden');

    try {
      const response = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      });
      if (!response.ok) throw new Error('submission failed');
      const intentValue = (payload.intent as string) || 'free-consult';
      if (typeof pageWindow.fbq === 'function') fbq('track', 'Lead', { content_name: 'daruma_consult_booking', content_category: intentValue });
      (window as unknown as { plausible?: (...args: unknown[]) => void }).plausible?.('Booking Submit', { props: { source: 'ads-daruma-consult', intent: intentValue } });
      form.classList.add('hidden');
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      // form-hook (มินิ) ไม่ตอบ → ชั้น 2: เขียน Supabase ตรง — การ์ดแจ้งเตือนมาจาก DB trigger → guardian
      if (await submitLeadFallback(payload as Record<string, unknown>, makeReference())) {
        const intentValue = (payload.intent as string) || 'free-consult';
        if (typeof pageWindow.fbq === 'function') fbq('track', 'Lead', { content_name: 'daruma_consult_booking', content_category: intentValue });
        (window as unknown as { plausible?: (...args: unknown[]) => void }).plausible?.('Booking Submit', { props: { source: 'ads-daruma-consult', intent: intentValue, status: 'sent-fallback' } });
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว — ข้อมูลยังไม่ถึงผม กรุณาลองใหม่ หรือแอด LINE เพื่อส่งโจทย์ให้ผม'; error.classList.remove('hidden'); }
      if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูล'; }
    }
  });

</script>
