---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { META_APP } from '../../data/meta-app';

const title = `นโยบายความเป็นส่วนตัว ${META_APP.name} โดย ${SITE.nameTh}`;
const description = `นโยบายความเป็นส่วนตัวของบริการ ${META_APP.name} สำหรับเพจ Facebook และบัญชี Instagram ที่เชื่อมกับบริการ`;
---

<!-- noindex: หน้ากฎหมายของแอป Meta ไม่ใช่หน้าที่อยากให้ติดค้นหา แต่ต้องเปิดได้จริงจาก URL สาธารณะ
     เพราะ Meta ใช้เป็น Privacy Policy URL ของแอป และไม่อยู่ใต้ /app (ผ่าน prune-for-marketing) -->
<BaseLayout title={title} description={description} noindex hideFloatingLine schema={{ types: ['WebPage'], title, description }}>
  <section class="px-6 py-16 md:py-24">
    <nav aria-label="Language" class="mx-auto mb-8 flex max-w-3xl gap-6 text-sm font-semibold text-cyan">
      <a href="#th" class="underline-offset-4 hover:underline">ภาษาไทย</a>
      <a href="#en" class="underline-offset-4 hover:underline">English version</a>
    </nav>

    <article class="mx-auto max-w-3xl text-lg leading-relaxed text-warm-ink/80 [&_h1]:font-display [&_h1]:text-navy [&_h1]:text-3xl [&_h1]:md:text-4xl [&_h1]:font-bold [&_h1]:mt-2 [&_h1]:mb-6 [&_h2]:font-display [&_h2]:text-navy [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-3 [&_h3]:font-display [&_h3]:text-navy [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:mb-4 [&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-6 [&_ol]:pl-6 [&_ul]:mb-4 [&_ol]:mb-4 [&_li]:mb-2 [&_a]:text-navy [&_a]:underline [&_strong]:text-navy">
      <section id="th" lang="th">
        <p class="text-sm font-semibold text-cyan">อัปเดตล่าสุด {META_APP.updatedTh}</p>
        <h1>นโยบายความเป็นส่วนตัวของบริการ {META_APP.name}</h1>
        <p>{META_APP.name} เป็นบริการที่ช่วยให้ธุรกิจรับและตอบข้อความจาก Facebook Messenger, Instagram และ WhatsApp ในกล่องข้อความเดียว รวมถึงร่าง อนุมัติ และตั้งเวลาโพสต์ให้เพจและบัญชี Instagram ของธุรกิจนั้น หน้านี้อธิบายว่าเราเก็บ ใช้ และดูแลข้อมูลส่วนบุคคลอย่างไรในบริการนี้ ผู้ให้บริการคือ ปัน ณัฐพัชร์ ตั้งอยู่ที่กรุงเทพฯ ประเทศไทย</p>

        <h2>ใครเป็นผู้รับผิดชอบข้อมูล</h2>
        <p>ธุรกิจที่เชื่อมเพจ Facebook หรือบัญชี Instagram เข้ากับบริการ คือ ผู้ควบคุมข้อมูลส่วนบุคคล ของคนที่ทักข้อความเข้ามาหาธุรกิจนั้น ธุรกิจเป็นผู้ตัดสินใจว่าจะเก็บข้อมูลไปทำอะไร และเป็นผู้ตอบคำขอของลูกค้าเป็นหลัก</p>
        <p>ปัน ณัฐพัชร์ ทำหน้าที่เป็นผู้ประมวลผลข้อมูลส่วนบุคคลตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 (PDPA) โดยทำตามคำสั่งของธุรกิจลูกค้าเท่านั้น</p>
        <p>เพจ Pun Nattapatch ของปันเองไม่ได้อยู่ในบริการนี้ นโยบายความเป็นส่วนตัวของเพจนั้นอยู่ที่ <a href="/privacy">หน้านโยบายความเป็นส่วนตัวหลัก</a></p>

        <h2>ข้อมูลที่บริการเก็บ</h2>
        <p>เราเก็บเฉพาะข้อมูลที่จำเป็นต่อการทำงาน แบ่งเป็นสองกลุ่ม</p>
        <h3>ข้อมูลของธุรกิจและทีมงาน</h3>
        <ul>
          <li>รหัสและชื่อของเพจ Facebook และบัญชี Instagram professional ที่เชื่อมไว้</li>
          <li>รหัสบัญชี WhatsApp Business และเบอร์โทรศัพท์ของธุรกิจ ถ้าธุรกิจเชื่อม WhatsApp ไว้</li>
          <li>Page access token ที่ถูกเข้ารหัสไว้ในระบบ และไม่แสดงในเบราว์เซอร์ของผู้ใช้</li>
          <li>รหัสผู้ใช้ Facebook และชื่อของผู้ดูแลที่เข้าสู่ระบบด้วย Facebook Login for Business</li>
          <li>ข้อความของโพสต์ที่ร่างไว้ ลิงก์รูปภาพที่ขึ้นต้นด้วย https และเวลาที่ตั้งไว้ให้เผยแพร่ ซึ่งทีมธุรกิจสร้างขึ้นในบริการ</li>
        </ul>
        <h3>ข้อมูลของคนที่ทักข้อความถึงธุรกิจ</h3>
        <ul>
          <li>รหัสผู้ใช้ที่ Meta ออกให้เฉพาะเพจหรือบัญชีนั้น (PSID สำหรับ Messenger และ IGSID สำหรับ Instagram) รหัสนี้ใช้กับบัญชีอื่นไม่ได้</li>
          <li>สำหรับ WhatsApp คือเบอร์โทรศัพท์ของคนที่ทักเข้ามาหาธุรกิจ และชื่อโปรไฟล์ WhatsApp ที่เขาตั้งไว้</li>
          <li>ชื่อที่แสดงบนโปรไฟล์</li>
          <li>เนื้อหาข้อความที่ส่งเข้ามา คำตอบที่ส่งกลับ และเวลาที่ส่ง</li>
        </ul>

        <h2>ผู้ช่วย AI ที่ตอบข้อความ</h2>
        <p>บางข้อความอาจถูกตอบโดยผู้ช่วย AI ที่ทำงานอัตโนมัติ ผู้ช่วยจะแจ้งว่าตัวเองเป็นระบบอัตโนมัติ และจะไม่แอบอ้างเป็นคน หากลูกค้าอยากคุยกับคนจริง พิมพ์บอกในแชทได้ทุกเวลา แล้วทีมธุรกิจจะเข้ามาตอบแทน</p>
        <p>ธุรกิจเลือกได้ว่าจะให้ AI ทำงานแบบไหน คือปิด AI ทั้งหมด ให้ AI เขียนร่างแล้วรอให้คนอนุมัติก่อนส่ง หรือให้ตอบอัตโนมัติ</p>
        <p>เมื่อ AI ต้องเขียนคำตอบ ข้อความของลูกค้าจะถูกส่งไปยังผู้ให้บริการโมเดล AI ผ่าน OpenRouter เพื่อสร้างคำตอบนั้นเพียงครั้งเดียว ข้อมูลนี้ไม่ถูกนำไปใช้ฝึกโมเดลสาธารณะ</p>

        <h2>เราใช้ข้อมูลเพื่ออะไร</h2>
        <ul>
          <li>ส่งข้อความตอบกลับผ่าน Messenger, Instagram และ WhatsApp ภายในกรอบเวลาที่ Meta อนุญาต และส่งข้อความแม่แบบที่ Meta อนุมัติแล้วให้เฉพาะคนที่เคยทักธุรกิจมาก่อน</li>
          <li>ให้ทีมธุรกิจอ่าน ตอบ และรับงานต่อจาก AI ได้ในกล่องข้อความเดียว</li>
          <li>ร่าง อนุมัติ และตั้งเวลาโพสต์ให้เพจหรือบัญชี Instagram ของธุรกิจ</li>
          <li>ยืนยันตัวผู้ดูแล และควบคุมว่าใครเข้าถึงข้อมูลของธุรกิจใดได้บ้าง</li>
        </ul>
        <p>เราไม่ขายข้อมูลส่วนบุคคล และไม่นำไปใช้โฆษณาของบุคคลที่สาม นอกจากผู้ให้บริการช่วงต่อที่ระบุไว้ด้านล่าง ซึ่งได้รับข้อมูลเท่าที่จำเป็นต่อการทำงานของบริการ</p>

        <h2>ผู้ให้บริการช่วงต่อ</h2>
        <ol>
          <li>Meta Platforms, Inc. เจ้าของ Facebook, Messenger, Instagram และ WhatsApp ใช้เป็นช่องทางรับส่งข้อความและโพสต์</li>
          <li>Cloudflare, Inc. ใช้เป็นที่โฮสต์ระบบและฐานข้อมูลของบริการ ข้อมูลอาจถูกจัดเก็บหรือประมวลผลในประเทศอื่นนอกประเทศไทย</li>
          <li>OpenRouter และผู้ให้บริการโมเดล AI ที่ OpenRouter เชื่อมต่อให้ ใช้เฉพาะตอนสร้างคำตอบ ตามที่อธิบายไว้ข้างต้น</li>
        </ol>

        <h2>ระยะเวลาเก็บข้อมูล</h2>
        <ul>
          <li>เนื้อหาข้อความ เก็บ 90 วันนับจากวันที่ส่ง แล้วลบออกจากระบบโดยอัตโนมัติ</li>
          <li>ข้อมูลบัญชีและโพสต์ เก็บตลอดช่วงที่ธุรกิจยังเชื่อมต่ออยู่กับบริการ</li>
          <li>เมื่อธุรกิจยกเลิกการเชื่อมต่อแอป (deauthorize) เราลบ token ทันที และลบข้อมูลทั้งหมดของธุรกิจนั้นภายใน 30 วัน</li>
        </ul>
        <p>หากกฎหมายกำหนดให้ต้องเก็บข้อมูลบางส่วนไว้ เราจะเก็บเท่าที่กฎหมายกำหนดเท่านั้น</p>

        <h2>การลบข้อมูล</h2>
        <p>คุณขอให้ลบข้อมูลได้สามทาง รายละเอียดทีละขั้นตอนอยู่ที่ <a href="/hub/data-deletion">หน้าวิธีลบข้อมูล</a></p>
        <ol>
          <li>ติดต่อธุรกิจที่คุณทักเข้าไปหาโดยตรง ธุรกิจเป็นผู้ควบคุมข้อมูลจึงเป็นผู้ดำเนินการหลัก</li>
          <li>ลบแอปออกจาก Facebook ที่การตั้งค่า แอปและเว็บไซต์ ระบบจะได้รับคำขอลบข้อมูลโดยอัตโนมัติ และออกรหัสยืนยันให้คุณ</li>
          <li>ส่งอีเมลมาที่ <a href={`mailto:${SITE.email}`}>{SITE.email}</a> พร้อมชื่อและช่องทางที่เคยติดต่อเข้ามา</li>
        </ol>

        <h2>ความปลอดภัย</h2>
        <ul>
          <li>Token ของเพจและบัญชีถูกเข้ารหัสก่อนบันทึกลงฐานข้อมูล</li>
          <li>ตรวจลายเซ็นของทุกคำขอ webhook ที่ส่งมาจาก Meta ก่อนประมวลผลทุกครั้ง</li>
          <li>จำกัดการเข้าถึงข้อมูลตามธุรกิจ ทีมของธุรกิจหนึ่งไม่เห็นข้อมูลของอีกธุรกิจหนึ่ง</li>
          <li>ไม่แสดง token ในเบราว์เซอร์ และไม่ขายข้อมูลใดๆ ทั้งสิ้น</li>
        </ul>
        <p>ไม่มีระบบใดปลอดภัยได้ 100 เปอร์เซ็นต์ หากเกิดเหตุข้อมูลรั่วไหล เราจะแจ้งธุรกิจที่เกี่ยวข้อง และดำเนินการตามที่ PDPA กำหนด</p>

        <h2>สิทธิของคุณ</h2>
        <p>คุณขอเข้าถึง ขอรับสำเนา ขอแก้ไข ขอลบ ขอระงับ หรือคัดค้านการใช้ข้อมูลส่วนบุคคลของคุณได้ และถอนความยินยอมได้ทุกเมื่อ ตามที่ PDPA กำหนด หากคุณเห็นว่าข้อมูลถูกใช้ไม่ถูกต้อง คุณร้องเรียนต่อสำนักงานคณะกรรมการคุ้มครองข้อมูลส่วนบุคคลได้</p>

        <h2>การเปลี่ยนแปลงนโยบาย</h2>
        <p>หากมีการปรับนโยบายนี้ เราจะอัปเดตหน้านี้และระบุวันที่แก้ไขล่าสุดไว้ด้านบน</p>

        <h2>ติดต่อเรา</h2>
        <p>ปัน ณัฐพัชร์ ผู้ให้บริการ กรุงเทพฯ ประเทศไทย<br />อีเมล <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </section>

      <section id="en" lang="en">
        <p class="text-sm font-semibold text-cyan">Last updated {META_APP.updatedEn}</p>
        <h2>{META_APP.name}: Privacy Policy</h2>
        <p>{META_APP.name} helps businesses receive and reply to messages from Facebook Messenger, Instagram and WhatsApp in one inbox. It also lets a business draft, approve, and schedule posts for its own Facebook Page and Instagram professional account. This page explains what personal data we process in the service, why we process it, and how we protect it. The service is operated by Pun Nattapatch in Bangkok, Thailand.</p>

        <h3>Who is responsible for the data</h3>
        <p>A business that connects its Facebook Page or Instagram professional account to the service is the data controller for the personal data of people who message that business. The business decides what it collects and why, and it responds to those people's requests first.</p>
        <p>Pun Nattapatch acts as a data processor under Thailand's Personal Data Protection Act B.E. 2562 (2019) (PDPA). We process personal data only on the documented instructions of the business that uses the service.</p>
        <p>Pun Nattapatch's own Facebook Page is not part of this service. Its privacy notice is on the <a href="/privacy">main privacy policy page</a>.</p>

        <h3>Data we process</h3>
        <p>We process only what the service needs. The data falls into two groups.</p>
        <h4>Business and team data</h4>
        <ul>
          <li>The ID and name of each connected Facebook Page and Instagram professional account.</li>
          <li>The WhatsApp Business Account ID and the business phone number, if the business connects WhatsApp.</li>
          <li>Page access tokens. They are encrypted at rest and are never shown in the browser.</li>
          <li>The Facebook user ID and name of the administrator who signs in with Facebook Login for Business.</li>
          <li>Post text, links to images (https), and scheduled publishing times that the business team creates.</li>
        </ul>
        <h4>Data about people who message a business</h4>
        <ul>
          <li>The platform-scoped ID that Meta issues for that Page or account only (PSID for Messenger and IGSID for Instagram). It cannot be used with any other account.</li>
          <li>For WhatsApp, the phone number of the person who messages the business and the WhatsApp profile name they chose.</li>
          <li>The display name shown on the person's profile.</li>
          <li>The content of messages, including replies sent back by the AI assistant or by staff, and the time each message was sent.</li>
        </ul>

        <h3>AI assistant</h3>
        <p>Some replies are written by an AI assistant that runs automatically. The assistant tells people that it is automated and does not pretend to be a human. Anyone can ask for a human at any time by saying so in the chat, and the business's staff will take over.</p>
        <p>Each business chooses one mode: AI off, draft only (staff approve each reply before it is sent), or automatic replies.</p>
        <p>When the AI needs to write a reply, the content of the message is sent to an AI model provider reached through OpenRouter, only to generate that reply. This data is not used to train public AI models.</p>

        <h3>How we use the data</h3>
        <ul>
          <li>To send replies through Messenger, Instagram and WhatsApp within the time limits that Meta allows, and to send Meta-approved message templates only to people who contacted the business before.</li>
          <li>To let the business team read, reply to, and take over conversations from the AI in one inbox.</li>
          <li>To draft, approve, and schedule posts for the business's Page or Instagram account.</li>
          <li>To confirm who the administrators are and to control who can access each business's data.</li>
        </ul>
        <p>We do not sell personal data, and we do not use it for a third party's advertising. Apart from the sub-processors listed below, we do not share it. Each sub-processor receives only what it needs to run its part of the service.</p>

        <h3>Sub-processors</h3>
        <ol>
          <li>Meta Platforms, Inc., the owner of Facebook, Messenger, Instagram, and WhatsApp. It is the channel through which messages and posts are sent and received.</li>
          <li>Cloudflare, Inc., which hosts the application and its database. Data may be stored or processed in countries outside Thailand.</li>
          <li>OpenRouter, and the AI model providers that OpenRouter connects us to. They receive message content only when a reply is generated, as described above.</li>
        </ol>

        <h3>How long we keep data</h3>
        <ul>
          <li>Message content is kept for 90 days from the day it was sent and is then deleted automatically.</li>
          <li>Account and post data is kept for as long as the business stays connected to the service.</li>
          <li>When a business disconnects the app (deauthorize), we delete its tokens immediately and delete all of that business's data within 30 days.</li>
        </ul>
        <p>If the law requires us to keep some data longer, we keep only what the law requires.</p>

        <h3>How to ask for deletion</h3>
        <p>You can ask for your data to be deleted in three ways. The step-by-step instructions are on the <a href="/hub/data-deletion">data deletion page</a>.</p>
        <ol>
          <li>Contact the business you messaged directly. The business is the controller of that data, so it leads the deletion.</li>
          <li>Remove the app in Facebook under Settings, then Apps and Websites. This sends a deletion request to our system automatically, and we give you a confirmation code.</li>
          <li>Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with your name and the channel you used to contact the business.</li>
        </ol>

        <h3>Security</h3>
        <ul>
          <li>Page and account tokens are encrypted before they are stored in the database.</li>
          <li>We verify the signature of every webhook request from Meta before we process it.</li>
          <li>Access is limited by business. One business's team cannot see another business's data.</li>
          <li>Tokens are never shown in the browser, and we do not sell any data.</li>
        </ul>
        <p>No system is perfectly secure. If a data breach happens, we will notify the business concerned and act as the PDPA requires.</p>

        <h3>Your rights</h3>
        <p>Under the PDPA you can request access to your personal data, a copy of it, correction, deletion, restriction, or you can object to its use. You can also withdraw your consent at any time. If you believe your data has been used unlawfully, you can complain to the Office of the Personal Data Protection Committee of Thailand.</p>

        <h3>Changes to this policy</h3>
        <p>If we change this policy, we will update this page and show the new date at the top.</p>

        <h3>Contact us</h3>
        <p>Pun Nattapatch, service provider, Bangkok, Thailand<br />Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </section>
    </article>
  </section>
</BaseLayout>
