---
/**
 * หน้ารับของ — เปิดหลังกรอกฟอร์มที่ /ebook-sales-interview
 *
 * สัญญาที่ให้ไว้คือ "กรอกแล้วได้อ่านทันที" → ปุ่มอ่านต้องมาก่อนทุกอย่าง
 * แล้วค่อยเสนอ 2 ทางเลือกถัดไป (ดูบริการ / ทักไลน์ถามว่าเหมาะกับตัวไหน)
 *
 * ปุ่ม PDF โผล่เฉพาะเมื่อไฟล์มีอยู่จริงตอน build — กันลิงก์เสียระหว่างที่ยังไม่ได้ export
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const READ_URL = '/downloads/ebook-stop-hiring-wrong-sales.html';
const PDF_URL = '/downloads/ebook-stop-hiring-wrong-sales.pdf';
const hasPdf = fs.existsSync(path.join(process.cwd(), 'public', PDF_URL.replace(/^\//, '')));

const title = 'E-Book พร้อมอ่านแล้ว — หยุดหาเซลล์ผิดคน';
const description = 'เปิดอ่าน 67 คำถามสัมภาษณ์เซลล์ได้ทันที';
---

<BaseLayout title={title} description={description} noindex={true} hideFloatingLine={true}>
  <section class="px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-2xl">
      <div
        class="mx-auto flex size-16 items-center justify-center rounded-full bg-secondary text-3xl text-secondary-content"
        aria-hidden="true"
      >
        ✓
      </div>

      <h1 class="mt-6 text-center font-display text-3xl font-black leading-tight md:text-4xl">
        เล่มพร้อมอ่านแล้ว
      </h1>
      <p class="mt-4 text-center text-lg leading-relaxed text-base-content/80">
        67 คำถามสัมภาษณ์เซลล์ พร้อมเหตุผลกำกับทุกข้อว่ากำลังวัดอะไร
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href={READ_URL}
          target="_blank"
          rel="noopener"
          class="btn btn-lg border-none bg-secondary text-secondary-content hover:bg-secondary/90"
        >
          เปิดอ่านทั้งเล่ม
        </a>
        {
          hasPdf && (
            <a href={PDF_URL} download class="btn btn-lg btn-outline">
              ดาวน์โหลด PDF
            </a>
          )
        }
      </div>
      <p class="mt-4 text-center text-sm text-base-content/60">
        เปิดในแท็บใหม่ · PDF 17 หน้า สั่งพิมพ์ A4 ถือเข้าห้องสัมภาษณ์ได้ · เก็บลิงก์นี้ไว้อ่านซ้ำได้
      </p>

      <p id="ref-line" class="mt-6 hidden text-center text-sm text-base-content/50">
        รหัสอ้างอิง <span id="ref-code" class="font-mono"></span>
      </p>

      {/* 2 ทางเลือกถัดไป — ไม่ยัดขาย แค่บอกว่าประตูอยู่ตรงไหน */}
      <div class="mt-14 border-t border-base-content/10 pt-10">
        <h2 class="font-display text-2xl font-black leading-tight">อ่านจบแล้วอยากไปต่อ</h2>
        <p class="mt-3 leading-relaxed text-base-content/75">
          คำถามที่ดีช่วยให้คุณเลือกคนถูกขึ้น แต่คนที่ใช่จะอยู่ได้นานแค่ไหน
          ขึ้นกับระบบที่รออยู่หลังวันแรกของเขา — ทั้งคนสอน KPI ค่าคอม และกระบวนการขาย
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <a
            href="/services"
            class="group rounded-2xl border border-base-content/10 bg-base-100 p-6 transition-colors duration-150 hover:border-secondary"
          >
            <p class="font-display text-lg font-bold group-hover:text-secondary">ดูบริการทั้งหมด</p>
            <p class="mt-2 leading-relaxed text-base-content/75">
              วางระบบทีมขาย ปั้นทีม และติดตั้ง AI Agent — ดูว่าแต่ละแบบทำอะไรให้บ้าง
            </p>
          </a>
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            class="group flex gap-4 rounded-2xl border border-base-content/10 bg-base-100 p-6 transition-colors duration-150 hover:border-[#06C755]"
          >
            <div class="flex-1">
              <p class="font-display text-lg font-bold group-hover:text-[#06C755]">
                ทักมาถามว่าเหมาะกับตัวไหน
              </p>
              <p class="mt-2 leading-relaxed text-base-content/75">
                เล่าสถานการณ์ทีมคุณสั้นๆ ใน LINE ผมบอกตรงๆ ว่าควรเริ่มจากอะไรก่อน
              </p>
            </div>
            <img
              src="/images/line-qr.png"
              alt=""
              width="72"
              height="72"
              loading="lazy"
              class="hidden size-[72px] shrink-0 self-start rounded ring-1 ring-base-content/10 sm:block"
            />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // รหัสอ้างอิงมาจาก query string ที่หน้าเดิมส่งต่อมา — โชว์เฉพาะเมื่อมีจริง
  const ref = new URLSearchParams(location.search).get('ref');
  if (ref) {
    const code = document.getElementById('ref-code');
    const line = document.getElementById('ref-line');
    if (code && line) {
      code.textContent = ref;
      line.classList.remove('hidden');
    }
  }
</script>
