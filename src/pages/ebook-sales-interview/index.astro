  </section>

  {/* แถบ CTA ติดล่างบนมือถือ — ซ่อนเมื่อฟอร์มอยู่ในจอแล้ว */}
  <div
    id="sticky-cta"
    class="fixed inset-x-0 bottom-0 z-30 border-t border-base-content/10 bg-base-100/95 px-4 py-3 backdrop-blur transition-transform duration-200 md:hidden"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))"
  >
    <a
      href="#form"
      class="btn w-full border-none bg-secondary text-secondary-content hover:bg-secondary/90"
    >
      รับ E-Book ฟรี
    </a>
  </div>
</BaseLayout>

<script>
  import { submitAudienceFallback } from '../../scripts/lead-fallback';

  // ของฟรี → ท่อ Audience Center (ไม่ใช่ท่อ CRM/Telegram ของ lead จริง)
  // spec: claude-code repo → docs/superpowers/specs/2026-08-17-audience-center-design.md
  const WEBHOOK = 'https://form-hook.punnattapatch.com/webhook/free-material';
  const ASSET_SLUG = 'ebook-sales-interview';

  const form = document.getElementById('ebook-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('eb-submit') as HTMLButtonElement | null;

  function fieldError(id: string, errId: string, bad: boolean): void {
    const input = document.getElementById(id);
    const err = document.getElementById(errId);
    if (!input || !err) return;
    err.classList.toggle('hidden', !bad);
    input.setAttribute('aria-invalid', bad ? 'true' : 'false');
    if (bad) input.setAttribute('aria-describedby', errId);
    else input.removeAttribute('aria-describedby');
  }

  // error ไม่หายเอง แต่ต้องหายทันทีที่คนแก้ — ไม่ปล่อยให้ค้างจนคนงงว่าแก้แล้วยังผิดอยู่ไหม
  for (const [id, errId] of [
    ['eb-name', 'eb-name-err'],
    ['eb-contact', 'eb-contact-err'],
  ]) {
    document.getElementById(id)?.addEventListener('input', (ev) => {
      if ((ev.target as HTMLInputElement).value.trim()) fieldError(id, errId, false);
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = (id: string): string =>
      ((document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '').trim();

    const name = val('eb-name');
    const contact = val('eb-contact');
    fieldError('eb-name', 'eb-name-err', !name);
    fieldError('eb-contact', 'eb-contact-err', !contact);
    if (!name) return document.getElementById('eb-name')?.focus();
    if (!contact) return document.getElementById('eb-contact')?.focus();

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'กำลังเปิดเล่ม…';
    }

    const params = new URLSearchParams(location.search);
    const reference = `EBK-${Date.now()}`;
    const payload = {
      lead_kind: 'audience',
      asset_slug: ASSET_SLUG,
      source_page: 'ebook-sales-interview',
      name,
      contact,
      company: val('eb-company'),
      position: val('eb-position'),
      own_words: val('eb-problem'),
      _meta: {
        reference,
        submitted_at: new Date().toISOString(),
        path: window.location.pathname,
        referrer: document.referrer || '',
        utm_source: params.get('utm_source') || '',
        utm_medium: params.get('utm_medium') || '',
        utm_campaign: params.get('utm_campaign') || '',
        utm_content: params.get('utm_content') || '',
        fbclid: params.get('fbclid') || '',
      },
    };

    try {
      const ctrl = new AbortController();
      const kill = setTimeout(() => ctrl.abort(), 10_000);
      const res = await fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: ctrl.signal,
        keepalive: true,
      });
      clearTimeout(kill);
      if (!res.ok) throw new Error(`webhook ${res.status}`);
    } catch (err) {
      console.error('[ebook-form] webhook error', err);
      // form-hook (มินิ) ไม่ตอบ → เขียนตรงเข้า submit_audience ยังคงเป็น audience ไม่ปน leads
      await submitAudienceFallback(payload as unknown as Record<string, unknown>);
    }

    // ของฟรีไม่ยิง Lead — Lead สงวนไว้ให้คน "ยกมือขอคุย" เท่านั้น
    // ใช้ custom event เพื่อให้ Meta optimise แคมเปญ lead magnet ได้โดยไม่ปน dataset ของดีลจริง
    if (typeof (window as unknown as { fbq?: unknown }).fbq === 'function') {
      (window as unknown as { fbq: (...a: unknown[]) => void }).fbq('trackCustom', 'FreeEbookDownload', {
        content_name: 'ebook-sales-interview',
      });
    }

    // ดาวน์โหลดคือสัญญาที่ให้ไว้ — ต้องได้ของแม้ webhook ล่ม
    location.href = `/ebook-sales-interview/thank-you?ref=${encodeURIComponent(reference)}`;
  });

  // แถบ CTA ล่าง: ซ่อนตอนฟอร์มโผล่ในจอ จะได้ไม่บังปุ่มส่งจริง
  const bar = document.getElementById('sticky-cta');
  const formSection = document.getElementById('form');
  if (bar && formSection && 'IntersectionObserver' in window) {
    new IntersectionObserver(
      ([entry]) => bar.classList.toggle('translate-y-full', entry.isIntersecting),
      { threshold: 0.1 }
    ).observe(formSection);
  }
</script>
