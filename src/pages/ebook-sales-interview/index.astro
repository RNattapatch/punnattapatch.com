---
/**
 * Lead magnet LP — E-Book "หยุดหาเซลล์ผิดคน" (67 คำถามสัมภาษณ์เซลล์)
 *
 * ปลายทางของโฆษณา Meta → อ่าน → กรอกฟอร์ม → /ebook-sales-interview/thank-you
 *
 * โครง funnel ยกมาจาก teardown 16 บล็อก (wiki/pages/teardown-lp-benzarnun-90day-opb-2026-08-24.md)
 * แปลงจาก "หน้าขายคอร์ส" เป็น "หน้าแจกของฟรี" — ราคาที่คนต้องจ่ายคือ *ข้อมูลติดต่อ*
 * จึงวางฟอร์มไว้ท้ายสุดหลัง FAQ เหมือนที่เขาวางราคาไว้บล็อกสุดท้าย และโปรย CTA ทั้งหน้าไปที่ #form
 *
 * ⚠️ ของฟรี = audience ไม่ใช่ lead — ยิงเข้า /webhook/free-material พร้อม lead_kind:'audience'
 * ห้ามยิงเข้าท่อ intake/CRM (memory: audience-center-free-material)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import LineAskCta from '../../components/LineAskCta.astro';

const title = 'หยุดหาเซลล์ผิดคน — E-Book 67 คำถามสัมภาษณ์เซลล์ (ฟรี)';
const description =
  'จ้างเซลล์ผิดหนึ่งคน ราคาที่จ่ายจริงไม่ใช่เงินเดือน — E-Book ฟรี รวม 67 คำถามสัมภาษณ์เซลล์ที่ผมใช้จริง พร้อมเหตุผลว่าแต่ละข้อกำลังวัดอะไร โดยปัน ณัฐพัชร์';
const COVER = '/images/ebook-cover-page.jpg';
/** ภาพหน้าจริงในเล่ม — เรนเดอร์จากตัวไฟล์ e-book ด้วย scripts/shoot-ebook.mjs */
const PAGES = [
  {
    src: '/images/ebook-page-toc.jpg',
    alt: 'หน้าสารบัญของอีบุ๊ก แสดง 4 หมวดคำถามพร้อมช่วงเลขข้อ',
    cap: 'สารบัญ — 4 หมวด แบ่งตามสิ่งที่ต้องการวัด',
  },
  {
    src: '/images/ebook-page-questions.jpg',
    alt: 'หน้าคำถามในอีบุ๊ก แต่ละข้อมีคำถามและบล็อกอธิบายว่าทำไมต้องถาม',
    cap: 'หน้าคำถามจริง — ทุกข้อมีบล็อก “ทำไมต้องถาม” กำกับ',
  },
];

/** ตัวอย่างคำถามจริงจากในเล่ม — ให้คนได้ "ชิม" ก่อนกรอกฟอร์ม */
const samples = [
  {
    no: '07',
    q: 'เคยทำงานที่ไหนมาบ้าง และถ้าขออนุญาตติดต่อที่เก่าสะดวกไหม',
    why: 'วัดความมั่นใจและความซื่อสัตย์ในการให้ข้อมูล บางคนที่ไม่ยอมให้ติดต่อบริษัทเก่า อาจมีประวัติไม่ดีติดตัวมา เป็นสัญญาณอันตราย',
  },
  {
    no: '17',
    q: 'เล่าเรื่องตอนที่โกรธที่สุดจนฟิวส์ขาดให้ฟังหน่อย เกิดขึ้นได้ยังไง แล้วจัดการยังไง',
    why: 'วัดการควบคุมอารมณ์ EQ และสติ เพราะเซลล์เปรียบเหมือนหน้าตาและ Branding ของบริษัท ถ้าเขาคุมสติไม่อยู่ ไประเบิดอารมณ์ใส่ลูกค้า แบรนด์คุณพังพินาศได้เลย',
  },
  {
    no: '47',
    q: 'ขายของให้ดูหน่อย (ไม่เอาขายปากกา เพราะคนถามเยอะแล้ว)',
    why: 'ดูของจริงว่าเขาขายเป็นไหม ไม่ใช่ท่องมาว่าเคยขายอะไร',
  },
];

const chapters = [
  {
    n: '01',
    name: 'วัดกันเลยว่าจะรุ่งหรือร่วง',
    range: 'ข้อ 1–17',
    detail: 'แรงขับ · ความอดทน · ความเสี่ยงที่จะลาออกเร็ว · ประวัติที่เรซูเม่ไม่เขียน',
  },
  {
    n: '02',
    name: 'เจาะลึกตัวตนและวิธีคิด',
    range: 'ข้อ 18–37',
    detail: 'วิธีแก้ปัญหา · การตัดสินใจ · ความรับผิดชอบต่อผลลัพธ์ · เข้ากับวัฒนธรรมทีมได้ไหม',
  },
  {
    n: '03',
    name: 'วัดสัญชาตญาณเซลล์',
    range: 'ข้อ 38–57',
    detail: 'หาลูกค้าใหม่เป็นไหม · ตัวเลขจริงที่เคยทำ · ปิดดีลด้วยอะไร · เจอราคาแพงกว่าคู่แข่งแล้วพูดยังไง',
  },
  {
    n: '04',
    name: 'Feature Ready — หาคนให้ทันโลก',
    range: 'ข้อ 58–67',
    detail: 'เรียนรู้ของใหม่เป็นไหม · ใช้ AI ช่วยงานเป็นหรือกลัว · รับมือความเปลี่ยนแปลงยังไง',
  },
];

const faqs = [
  {
    q: 'ฟรีจริงไหม มีอะไรแอบขายทีหลังหรือเปล่า',
    a: 'ฟรีจริง ไม่มีค่าใช้จ่าย ไม่ต้องใส่บัตร กรอกเสร็จกดอ่านได้ทันทีในหน้าถัดไป ถ้าอ่านแล้วอยากให้ผมช่วยวางระบบทีมขายต่อ คุณเป็นคนทักมาเอง ผมไม่โทรตื๊อ',
  },
  {
    q: 'ทำไมต้องกรอกข้อมูลด้วย ในเมื่อของฟรี',
    a: 'เพราะผมอยากรู้ว่าคนอ่านเป็นใคร ทำธุรกิจแบบไหน จะได้เอาไปปรับเนื้อหาเล่มต่อไปให้ตรงขึ้น และถ้าคุณเขียนปัญหาที่เจอมาด้วย ผมอ่านทุกข้อความจริงๆ',
  },
  {
    q: 'ข้อมูลที่กรอกเอาไปทำอะไร',
    a: `เก็บไว้ในระบบของผมเองเพื่อส่งเนื้อหาที่เกี่ยวข้องและติดต่อกลับถ้าคุณขอ ไม่ขายต่อ ไม่ส่งให้บุคคลที่สาม แจ้งลบได้ตลอดเวลา รายละเอียดอยู่ในหน้า Privacy`,
  },
  {
    q: 'ผมไม่ได้จ้างเซลล์ ใช้กับตำแหน่งอื่นได้ไหม',
    a: 'ได้ประมาณครึ่งเล่ม หมวดวัดใจกับหมวดวิธีคิดใช้กับทุกตำแหน่งได้เลย ส่วนหมวดสัญชาตญาณเซลล์ออกแบบมาสำหรับคนที่ต้องหาลูกค้าและปิดดีลโดยเฉพาะ',
  },
  {
    q: 'ต้องถามครบทั้ง 67 ข้อไหม',
    a: 'ไม่ต้อง และไม่ควร เลือกเฉพาะข้อที่ตรงกับตำแหน่งและความเสี่ยงที่คุณอยากตรวจ ประมาณ 12–15 ข้อต่อการสัมภาษณ์หนึ่งครั้งกำลังดี ที่เหลือเก็บไว้ถามรอบสอง',
  },
  {
    q: 'อ่านจบแล้วอยากให้ช่วยวางระบบทีมขายต่อ ทำยังไง',
    a: 'ทักมาใน LINE บอกสถานการณ์ทีมคุณสั้นๆ ผมจะบอกตรงๆ ว่าควรเริ่มจากอะไร และเหมาะกับบริการตัวไหน หรือถ้าอยากดูเองก่อนก็เปิดหน้าบริการได้เลย',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`${SITE.url}${COVER}`}
  hideFloatingLine={true}
  schema={{
    types: ['WebPage', 'FAQPage', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'E-Book หยุดหาเซลล์ผิดคน', url: `${SITE.url}/ebook-sales-interview` },
    ],
    faq: faqs.map((f) => ({ question: f.q, answer: f.a })),
  }}
>
  {/* ══ 1 · HERO — ขายผลลัพธ์ปลายทาง ไม่ขายชื่อสินค้า ══ */}
  <section class="border-b border-base-content/10 px-4 pb-14 pt-10 md:pt-16 lg:px-8">
    <div class="mx-auto grid max-w-5xl items-center gap-10 md:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-secondary">
          E-Book ฟรี · 67 คำถามสัมภาษณ์เซลล์
        </p>
        <h1 class="mt-4 font-display text-4xl font-black leading-[1.12] tracking-tight text-balance md:text-5xl">
          จ้างเซลล์ผิดหนึ่งคน<br />
          <span class="text-secondary">ราคาที่จ่ายจริง ไม่ใช่เงินเดือน</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/80">
          เสียเวลาสอนงานใหม่ เสียโอกาสการขายทั้งไตรมาส เสียลูกค้าที่เขาดูแลอยู่
          และเสียแรงของคนที่เหลือในทีม
        </p>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-content/80">
          เล่มนี้คือ <strong class="font-bold">คำถาม 67 ข้อที่ผมใช้จริงในห้องสัมภาษณ์</strong>
          พร้อมเหตุผลกำกับทุกข้อว่ากำลังวัดอะไร และควรฟังอะไรจากคำตอบ
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#form"
            class="btn btn-lg border-none bg-secondary text-secondary-content hover:bg-secondary/90"
          >
            รับ E-Book ฟรี
          </a>
          <p class="text-sm text-base-content/60">
            ไม่มีค่าใช้จ่าย · กรอก 30 วินาที · อ่านออนไลน์หรือโหลด PDF 17 หน้า
          </p>
        </div>

        <LineAskCta
          class="mt-6 border-t border-base-content/10 pt-6"
          label="หรือทักไลน์ถามผมก่อน"
          note="อยากรู้ว่าผมช่วยธุรกิจคุณได้ไหม ถามมาได้เลย ผมตอบเอง"
        />
      </div>

      {/* ปกจริงจากในเล่ม (เรนเดอร์ด้วย scripts/shoot-ebook.mjs) — บนมือถือให้พาดหัวมาก่อนปก */}
      <figure>
        <img
          src={COVER}
          alt="ปกอีบุ๊ก หยุดหาเซลล์ผิดคน — ผู้จัดการคุกเข่าส่องเรซูเม่ด้วยแว่นขยาย แล้วเห็นตัวจริงของผู้สมัครในเลนส์"
          width="1000"
          height="1414"
          class="mx-auto w-full max-w-sm rounded-sm shadow-2xl ring-1 ring-base-content/10"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  {/* ══ 2 · PHILOSOPHY / ANTI-PROMISE — คัดคนออกก่อนขาย ══ */}
  <section class="px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">อ่านก่อนกรอก</p>
      <h2 class="mt-3 font-display text-3xl font-black leading-tight md:text-4xl">
        เล่มนี้ไม่ใช่สูตรลับที่ทำให้คุณอ่านคนออกใน 5 นาที
      </h2>
      <div class="mt-6 space-y-4 text-lg leading-[1.9] text-base-content/85">
        <p>
          ถ้าคุณกำลังหาเทคนิคจับโกหก หรือแบบทดสอบที่ให้คะแนนแล้วบอกได้ว่าคนนี้ใช่หรือไม่ใช่
          ผมบอกตรงนี้เลยว่าเล่มนี้ไม่มีให้
        </p>
        <p>
          เพราะการสัมภาษณ์ไม่ใช่ข้อสอบ ไม่มีคำถามข้อไหนรับประกันได้ว่าคุณจะไม่จ้างคนผิด
          สิ่งที่คำถามที่ดีทำได้จริงคือ
          <strong class="font-bold text-base-content">
            ทำให้คุณเห็นข้อมูลที่เรซูเม่ไม่เคยบอก
          </strong>
          แล้วตัดสินใจด้วยหลักฐาน ไม่ใช่ด้วยความรู้สึกว่า “คุยแล้วถูกคอ”
        </p>
      </div>
      <blockquote
        class="mt-8 rounded-2xl border-l-4 border-secondary bg-base-200/40 p-6 font-display text-lg italic leading-relaxed"
      >
        คำตอบที่น่าเชื่อถือ ไม่ใช่คำตอบที่สวยที่สุด
        แต่เป็นคำตอบที่มีหลักฐานจากพฤติกรรมจริงรองรับ
      </blockquote>
    </div>
  </section>

  {/* ══ 3 · ปัญหา + ตั้งชื่อศัตรู ══ */}
  <section class="bg-base-200/40 px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">ศัตรูตัวจริง</p>
      <h2 class="mt-3 font-display text-3xl font-black leading-tight md:text-4xl">
        คนที่ตอบคำถามเก่งที่สุด<br class="hidden sm:block" />
        ไม่ใช่คนที่ขายเก่งที่สุดเสมอไป
      </h2>
      <p class="mt-6 text-lg leading-[1.9] text-base-content/85">
        บางคนเตรียมคำตอบมาดี พูดคล่อง สร้างความประทับใจได้ตั้งแต่นาทีแรก
        แต่พอเริ่มงานจริงกลับรับแรงกดดันไม่ได้ ไม่กล้าโทรหาลูกค้าใหม่ หรือทำงานกับทีมไม่เป็น
      </p>
      <p class="mt-4 text-lg leading-[1.9] text-base-content/85">
        ขณะเดียวกัน คนที่ดูธรรมดาในวันสัมภาษณ์
        กลับกลายเป็นคนที่มีวินัยที่สุดในทีมเมื่อผ่านไปหกเดือน
      </p>

      <div class="mt-10">
        <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">
          อาการที่เจ้าของมักเป็น
        </p>
        <ul class="mt-4 space-y-3">
          {
            [
              'สัมภาษณ์ด้วยความรู้สึก — รับเพราะคุยถูกคอ ไม่ใช่เพราะเห็นหลักฐาน',
              'ถามครบทุกข้อในใบ แต่จบแล้วยังตอบไม่ได้ว่าเขาทำงานยังไง',
              'ตัดสินจากเรซูเม่สวย ทั้งที่เรซูเม่คือเอกสารที่ผู้สมัครเขียนเอง',
              'รู้ว่าเลือกผิดตอนเดือนที่สาม ซึ่งสายเกินกว่าจะย้อนกลับ',
            ].map((item) => (
              <li class="flex gap-3 rounded-xl border border-base-content/10 bg-base-100 p-4">
                <span class="shrink-0 font-display font-black text-secondary" aria-hidden="true">
                  ✕
                </span>
                <span class="leading-relaxed text-base-content/85">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 rounded-2xl border border-base-content/10 bg-base-100 p-6">
        <p class="font-display text-lg font-bold">ต้นทุนจริงของการจ้างผิดหนึ่งคน</p>
        <p class="mt-3 leading-relaxed text-base-content/80">
          ไม่ได้จบที่เงินเดือนที่จ่ายไป แต่รวมเวลาสอนงานที่หายไปทั้งก้อน
          โอกาสการขายในพื้นที่ที่เขารับผิดชอบ ความเชื่อมั่นของลูกค้าที่เขาไปเจอ
          และพลังของคนที่เหลือในทีมที่ต้องรับงานแทน
        </p>
      </div>
    </div>
  </section>

  {/* ══ 4 · CTA #2 ══ */}
  <section class="px-4 py-12 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <a
        href="#form"
        class="btn btn-lg border-none bg-secondary text-secondary-content hover:bg-secondary/90"
      >
        ขอ 67 คำถามไปใช้ในรอบสัมภาษณ์หน้า
      </a>
      <LineAskCta class="mt-6 items-center" />
    </div>
  </section>

  {/* ══ 5 · MECHANISM — ตั้งชื่อ "ของที่ขาด" ══ */}
  <section class="px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-base-content/60">
        สิ่งที่ขาดจริงๆ
      </p>
      <h2 class="mt-3 font-display text-3xl font-black leading-tight md:text-4xl">
        คุณไม่ได้ขาดคนเก่ง คุณขาดคำถามที่ทำให้คนเก่งเผยตัว
      </h2>
      <p class="mt-6 text-lg leading-[1.9] text-base-content/85">
        ใครๆ ก็หาชุดคำถามสัมภาษณ์จาก Google ได้ในสามวินาที —
        <strong class="font-bold text-base-content">
          แต่ถ้าไม่รู้ว่าแต่ละข้อกำลังวัดอะไร
        </strong>
