---
import BaseLayout from '../layouts/BaseLayout.astro';
import StartContent from '../components/StartContent.astro';
import DecisionHub from '../components/hub/DecisionHub.astro';
import { T1_PRODUCT_DETAIL } from '../data/product-details/t1';
import { T2_PRODUCT_DETAIL } from '../data/product-details/t2';
import { T3_PRODUCT_DETAIL } from '../data/product-details/t3';
import { T4_PRODUCT_DETAIL } from '../data/product-details/t4';
import { C1_PRODUCT_DETAIL } from '../data/product-details/c1';
import { P1_PRODUCT_DETAIL } from '../data/product-details/p1';

// Sales Funnel v2 (2026-09-03): หน้าหลังส่งฟอร์ม = Decision Hub รายสินค้า (เปิดตัวที่ตรง ?package= ด้วย script ด้านล่าง)
const HUB_PRODUCTS = [T1_PRODUCT_DETAIL, T2_PRODUCT_DETAIL, T3_PRODUCT_DETAIL, T4_PRODUCT_DETAIL, C1_PRODUCT_DETAIL, P1_PRODUCT_DETAIL];
import { SITE } from '../data/site';

const title = 'ได้โจทย์แล้วครับ';
const description =
  'ได้โจทย์แล้ว ผมอ่านเองแล้วโทรกลับภายในวันนี้ คุย 15 นาที ไม่มีค่าใช้จ่าย';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-xl text-center">
      <div
        class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-success text-5xl text-success-content"
        aria-hidden="true"
      >
        ✓
      </div>

      <h1 id="thankyou-heading" class="mt-6 font-display text-3xl font-bold text-base-content md:text-4xl">
        บันทึกแบบประเมินแล้วครับ
      </h1>

      {/* audit ด่านคุณยาย 2026-10-14: หน้านี้ให้ทำอย่างเดียว = บอกเวลารับสาย · ไม่บอกว่า "จองแล้ว" เพราะลูกค้าแค่ทิ้งเบอร์ */}
      <p class="mt-5 text-lg leading-relaxed text-base-content/80">
        ผมอ่านเอง แล้วโทรกลับภายในวันนี้ ส่วนใหญ่ช่วงเย็น
        <strong class="text-base-content">คุย 15 นาที ไม่มีค่าใช้จ่าย</strong>
        ว่าทีมคุณควรเริ่มเรื่องไหน และควรสอนทีมหรือให้ผมเข้าไปทำให้
      </p>

      <div class="mt-8 rounded-2xl border border-[#c9c2b2] bg-white p-6">
        <p class="font-display text-xl font-bold text-base-content">สะดวกรับสายช่วงไหน กดบอกผมได้เลย</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          {['เย็นนี้', 'พรุ่งนี้เช้า', 'พรุ่งนี้บ่าย'].map((slot) => (
            <a
              href={SITE.social.line}
              target="_blank"
              rel="noopener"
              data-contact-cta
              data-call-slot={slot}
              data-cta-location="thankyou_call_slot"
              data-cta-intent="call_time"
              data-cta-label={`สะดวกรับสาย${slot}`}
              data-cta-keyword={`สะดวกรับสาย${slot}`}
              class="btn min-h-12 border-0 bg-[#c43245] text-base text-white hover:bg-[#ad293a] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-coral"
            >{slot}</a>
          ))}
        </div>
        <p class="mt-3 text-sm leading-6 text-base-content/70">กดแล้ว LINE จะเปิดพร้อมข้อความกับรหัสของคุณ แค่กดส่งครับ · บนคอมพิวเตอร์ สแกน QR แล้วพิมพ์ช่วงเวลาที่สะดวก</p>
        <p class="mt-3 text-xs text-base-content/55">รหัสของคุณ <code id="ref-display" class="rounded bg-base-200 px-2 py-0.5 font-mono font-bold text-base-content">—</code></p>
      </div>

      <div class="mt-8 rounded-2xl border border-secondary/30 bg-secondary/5 p-6 text-left">
        <p class="font-display text-base font-bold text-base-content">จากนี้ไปเป็นแบบนี้ครับ</p>
        <ol class="mt-3 space-y-2 text-sm leading-relaxed text-base-content/80">
          <li id="thankyou-read-line">① ผมโทรคุย 15 นาที ฟังโจทย์ แล้วบอกว่าควรสอนทีม หรือให้ผมเข้าไปทำให้ ใช้กี่วัน</li>
          <li>② ถ้าตรงกัน ผมส่งใบเสนอราคาให้ในวันที่คุย ถ้าไม่ตรง ผมบอกตรงๆ</li>
          <li>③ ชำระก่อนเริ่มงาน แล้วนัดวันที่ผมเข้าไปบริษัทคุณ</li>
        </ol>
        <p class="mt-3 text-sm text-base-content/65">ยังไม่ได้จองอะไรนะครับ คุยกันก่อน</p>
      </div>

      <div class="mt-12 rounded-2xl bg-primary p-7 text-left text-primary-content shadow-lg">
        <p class="font-display text-2xl font-bold leading-snug md:text-3xl">
          <span aria-hidden="true">⏳</span> มีเวลาสัก <span class="text-[#fe596b]">2-3 นาที</span> ไหมครับ
        </p>
        <p class="mt-3 text-base leading-relaxed text-primary-content/85">
          เลื่อนลงอ่านต่อ จะได้รู้จักกันก่อนคุยจริง แล้วคอลแรกของเราจะสั้นลงครึ่งหนึ่ง
        </p>
        <p class="mt-5 flex items-center gap-2 font-display text-lg font-bold">
          <span class="thankyou-scroll-hint" aria-hidden="true">↓</span> เลื่อนลงเลยครับ
        </p>
      </div>
    </div>
  </section>

  {HUB_PRODUCTS.map((product) => <DecisionHub data={product} />)}

  <StartContent context="thankyou" />

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const ref = params.get('ref') || '—';

      const refNode = document.getElementById('ref-display');
      if (refNode) refNode.textContent = ref;

      // หน้านี้รับสองทาง — แบบประเมิน (/intake-form) กับจองคิว (/booking)
      // สลับคำที่พูดถึง "แบบประเมิน" ให้ตรงกับสิ่งที่เขาเพิ่งกรอกจริง
      const formType = params.get('type') === 'booking' ? 'booking' : 'intake_form';
      // 2026-09-02: content_name รายคลาสเมื่อมาจากหน้า product (booking?package=T4 → thank-you?package=T4)
      const packageCode = (params.get('package') || '').replace(/[^a-z0-9]/gi, '').toLowerCase();
      const leadContentName = packageCode ? `${packageCode}_product_booking` : formType;
      // Decision Hub รายสินค้า — เปิดเฉพาะตัวที่ตรง ?package= (T1/T2/T3/T4/C1)
      const hub = packageCode ? document.querySelector(`[data-decision-hub="${packageCode.toUpperCase()}"]`) : null;
      if (hub) {
        hub.hidden = false;
        try {
          if (typeof window.fbq === 'function') window.fbq('trackCustom', 'HubView', { content_ids: [packageCode.toUpperCase()] });
        } catch {}
      }

      if (formType === 'booking') {
        const heading = document.getElementById('thankyou-heading');
        if (heading) heading.textContent = 'ได้โจทย์กับเบอร์แล้วครับ';
        document.title = 'ได้โจทย์แล้ว · ปัน ณัฐพัชร์';
      }

      // ปุ่มเลือกเวลารับสาย → LINE เปิดพร้อม "สะดวกรับสาย<ช่วง> รหัส <ref> [รหัสสินค้า]"
      // LinePrefill (module script · รันหลังสคริปต์นี้) อ่าน data-cta-keyword + data-product-code ไปสร้างลิงก์ oaMessage บนมือถือ
      document.querySelectorAll('[data-call-slot]').forEach((a) => {
        const slot = a.getAttribute('data-call-slot');
        a.setAttribute('data-cta-keyword', ref !== '—' ? `สะดวกรับสาย${slot} รหัส ${ref}` : `สะดวกรับสาย${slot}`);
        if (packageCode) a.setAttribute('data-product-code', packageCode.toUpperCase());
      });

      // Collect attribution from URL for conversion event payloads
      const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const attribution = {};
      utmKeys.forEach((k) => {
        const v = params.get(k);
        if (v) attribution[k] = v;
      });
      const fbclid = params.get('fbclid');
      const ttclid = params.get('ttclid');
      if (fbclid) attribution.fbclid = fbclid;
      if (ttclid) attribution.ttclid = ttclid;

      // Plausible — Lead Success conversion goal (fires always; Plausible is loaded in BaseLayout)
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
      window.plausible('Lead Success', { props: { ref, ...attribution } });

      // Meta Pixel — Lead event. Guarded; fires only if fbq loaded (post H1 unblock)
      if (typeof window.fbq === 'function') {
        window.fbq(
          'track',
          'Lead',
          { content_name: leadContentName, content_ids: packageCode ? [packageCode.toUpperCase()] : undefined, currency: 'THB', value: 0 },
          { eventID: ref }
        );
      }

      // TikTok Pixel — CompleteRegistration event. Guarded; fires only if ttq loaded (post H2)
      if (window.ttq && typeof window.ttq.track === 'function') {
        window.ttq.track('CompleteRegistration', {
          content_id: ref,
          currency: 'THB',
          value: 0,
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  /* ลูกศรกระตุกเบาๆ ให้สายตาไปต่อท้ายหน้า — ปิดเองเมื่อผู้ใช้ตั้งค่าลดการเคลื่อนไหว */
  .thankyou-scroll-hint {
    display: inline-block;
    animation: thankyou-nudge 1.6s ease-in-out infinite;
  }
  @keyframes thankyou-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .thankyou-scroll-hint { animation: none; }
  }
</style>
