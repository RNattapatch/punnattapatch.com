---
import BaseLayout from '../layouts/BaseLayout.astro';
import StartContent from '../components/StartContent.astro';
import { SITE } from '../data/site';

const title = 'ขอบคุณที่กรอกแบบประเมิน';
const description =
  'รับแบบประเมินแล้ว ผมจะอ่านและตอบกลับภายใน 2 วันทำการ — ขั้นตอนสุดท้าย ทักใน LINE OA พร้อมรหัสอ้างอิง';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="px-4 py-24">
    <div class="mx-auto max-w-xl text-center">
      <div
        class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-success text-5xl text-success-content"
        aria-hidden="true"
      >
        ✓
      </div>

      <h1 id="thankyou-heading" class="mt-6 font-display text-3xl font-bold text-base-content md:text-4xl">
        บันทึกแบบประเมินเรียบร้อย
      </h1>

      <p class="mt-5 text-lg leading-relaxed text-base-content/80">
        ขั้นตอนสุดท้าย — <strong class="text-secondary">ทักหาผมใน LINE</strong>
        พร้อมแนบ Reference ด้านล่าง
      </p>

      <div class="mt-8">
        <span class="text-xs uppercase tracking-widest text-base-content/50">Reference</span>
        <div class="mt-2">
          <code
            id="ref-display"
            class="inline-block rounded-lg bg-base-200 px-6 py-3 font-mono text-xl font-bold text-base-content"
          >—</code>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={SITE.social.line}
          rel="noopener"
          target="_blank"
          class="btn btn-lg gap-2 border-none font-bold text-white shadow-lg hover:opacity-90 active:opacity-80"
          style="background: #06C755;"
        >
          <img src="/line-logo.png" alt="" class="h-6 w-6 shrink-0" aria-hidden="true" />
          ทักใน LINE OA →
        </a>
        <button id="copy-ref" type="button" class="btn btn-lg btn-outline">
          คัดลอก Reference
        </button>
      </div>

      <div class="mt-10 rounded-2xl border border-secondary/30 bg-secondary/5 p-6 text-left">
        <p class="flex items-center gap-2 font-display text-base font-bold text-base-content">
          <span aria-hidden="true">🤝</span> สิ่งที่จะเกิดขึ้นต่อจากนี้
        </p>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-base-content/80">
          <li id="thankyou-read-line">ผมอ่านแบบประเมินของคุณเอง ไม่ใช่ทีมงาน ไม่ใช่ AI ตอบแทน</li>
          <li>ตอบกลับภายใน 2 วันทำการ (ช่วงกลางวันผมมักติดหน้างานลูกค้า อาจได้ตอบช่วงเย็นครับ)</li>
          <li>
            คอลแรกประมาณ 10-15 นาที <strong>ผมถามมากกว่าพูด</strong>
            เพราะต้องเข้าใจธุรกิจคุณก่อนถึงจะรู้ว่าช่วยได้จริงไหม
          </li>
          <li>
            <strong>ผมจะไม่ขายอะไรในคอลแรก</strong> ถ้าคุยแล้วไม่ตรง ผมบอกตรงๆ
            และแนะนำทางที่เหมาะกว่าให้
          </li>
        </ol>
      </div>

      <p class="mt-8 text-sm text-base-content/70">
        ตอบกลับภายใน 2 วันทำการ · ไม่มี mass email · ข้อมูลไม่ส่งต่อบุคคลที่สาม
      </p>

      <p class="mt-12 text-base leading-relaxed text-base-content/80">
        ⏳ ถ้ามีเวลาอีก 3 นาที เลื่อนลงอ่านต่อครับ จะได้รู้จักกันก่อนคุยจริง
        แล้วคอลแรกของเราจะสั้นลงครึ่งหนึ่ง
      </p>
    </div>
  </section>

  <StartContent context="thankyou" />

  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const ref = params.get('ref') || '—';

      const refNode = document.getElementById('ref-display');
      if (refNode) refNode.textContent = ref;

      // หน้านี้รับสองทาง — แบบประเมิน (/intake-form) กับจองคิว (/booking)
      // สลับคำที่พูดถึง "แบบประเมิน" ให้ตรงกับสิ่งที่เขาเพิ่งกรอกจริง
      const formType = params.get('type') === 'booking' ? 'booking' : 'intake_form';
      // 2026-09-02: content_name รายคอร์สเมื่อมาจากหน้า product (booking?package=T4 → thank-you?package=T4)
      const packageCode = (params.get('package') || '').replace(/[^a-z0-9]/gi, '').toLowerCase();
      const leadContentName = packageCode ? `${packageCode}_product_booking` : formType;
      if (formType === 'booking') {
        const heading = document.getElementById('thankyou-heading');
        if (heading) heading.textContent = 'รับเรื่องจองคิวแล้วครับ';
        const readLine = document.getElementById('thankyou-read-line');
        if (readLine) readLine.textContent = 'ผมอ่านโจทย์ของคุณเอง ไม่ใช่ทีมงาน ไม่ใช่ AI ตอบแทน';
        document.title = 'ขอบคุณที่จองคิว · ปัน ณัฐพัชร์';
      }

      const copyBtn = document.getElementById('copy-ref');
      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          if (ref === '—') return;
          try {
            await navigator.clipboard.writeText(ref);
            const orig = copyBtn.textContent;
            copyBtn.textContent = 'คัดลอกแล้ว ✓';
            setTimeout(() => {
              copyBtn.textContent = orig;
            }, 2000);
          } catch {
            /* clipboard blocked — user can still highlight + copy */
          }
        });
      }

      // Collect attribution from URL for conversion event payloads
      const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const attribution = {};
      utmKeys.forEach((k) => {
        const v = params.get(k);
        if (v) attribution[k] = v;
      });
      const fbclid = params.get('fbclid');
      const ttclid = params.get('ttclid');
      if (fbclid) attribution.fbclid = fbclid;
      if (ttclid) attribution.ttclid = ttclid;

      // Plausible — Lead Success conversion goal (fires always; Plausible is loaded in BaseLayout)
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
      window.plausible('Lead Success', { props: { ref, ...attribution } });

      // Meta Pixel — Lead event. Guarded; fires only if fbq loaded (post H1 unblock)
      if (typeof window.fbq === 'function') {
        window.fbq(
          'track',
          'Lead',
          { content_name: leadContentName, content_ids: packageCode ? [packageCode.toUpperCase()] : undefined, currency: 'THB', value: 0 },
          { eventID: ref }
        );
      }

      // TikTok Pixel — CompleteRegistration event. Guarded; fires only if ttq loaded (post H2)
      if (window.ttq && typeof window.ttq.track === 'function') {
        window.ttq.track('CompleteRegistration', {
          content_id: ref,
          currency: 'THB',
          value: 0,
        });
      }
    })();
  </script>
</BaseLayout>
