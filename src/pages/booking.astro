---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarumaMark from '../components/DarumaMark.astro';
import AfterHoursField from '../components/AfterHoursField.astro';
import { SITE } from '../data/site';

const title = 'จองคิวคุยปั้นทีมขาย';
const description = 'จองคิวคุย 15–20 นาที เพื่อดูว่าทีมขายของคุณควรเริ่มตรงไหนระหว่าง In-house, Flagship และระบบคอนเทนต์';
const issues = [
  'ข้อมูลลูกค้ากระจาย อยู่ในไลน์กับหัวคน',
  'เซลล์หมดเวลาไปกับงานเอกสารและงานซ้ำ',
  'ยอดขึ้นๆ ลงๆ เดาไม่ได้ว่าเดือนหน้าจะเป็นยังไง',
  'ทีมพึ่งคนเก่งคนเดียว คนอื่นตามไม่ทัน',
  'วัดผลทีมไม่ได้ ประชุมด้วยความรู้สึก',
  'ลงทุนเรียนหรือซื้อเครื่องมือมาแล้ว แต่ทีมไม่ได้ใช้จริง',
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{ types: ['WebPage', 'BreadcrumbList'], title, description, breadcrumbs: [{ name: 'หน้าแรก', url: SITE.url }, { name: 'จองคิวคุย', url: `${SITE.url}/booking` }] }}
>
  <section class="border-b border-[#c9c2b2] bg-ivory px-6 py-16 md:py-20">
    <div class="mx-auto max-w-6xl"><p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">ปรึกษาปั้นทีมขาย สำหรับเจ้าของ SME ไทย</p><h1 class="mt-3 font-display text-4xl font-bold text-navy md:text-6xl">จองคิวคุยกับผม</h1><p class="mt-5 max-w-3xl text-lg leading-relaxed text-warm-ink/75">เล่าโจทย์ให้ฟัง 15–20 นาที ไม่มีค่าใช้จ่ายและไม่มีการขายแบบกดดัน คุยจบผมจะบอกตรงๆ ว่าเส้นทางไหนคุ้มสุดสำหรับคุณ แม้คำตอบคือยังไม่ต้องจ้างผมก็ตาม</p></div>
  </section>

  <section class="px-6 py-12 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
      <form id="booking-form" class="rounded-2xl border border-[#c9c2b2] bg-surface p-6 lg:col-span-7 md:p-9" novalidate>
        <input name="honeypot-name" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
        <div class="flex items-start justify-between gap-5"><div><h2 class="font-display text-2xl font-bold text-navy">เล่าโจทย์ของคุณสั้นๆ</h2><p class="mt-1 text-sm text-warm-ink/65">กรอกไม่ถึง 2 นาที แล้วผมจะอ่านข้อมูลเพื่อเตรียมคุยให้ตรงเรื่อง</p></div><DarumaMark class="size-12 shrink-0" /></div>
        <div class="mt-8 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2"><label class="field-label">ชื่อของคุณ<input name="name" required autocomplete="name" class="field" /></label><label class="field-label">ช่องทางติดต่อกลับ<input name="contact" required autocomplete="tel" placeholder="เบอร์โทร หรือ LINE ID" class="field" /></label></div>
          <div class="grid gap-5 sm:grid-cols-2"><label class="field-label">ชื่อบริษัท<input name="company" required autocomplete="organization" placeholder="เช่น บจก. สยามเครื่องจักรกล" class="field" /></label><label class="field-label">ตำแหน่งของคุณ<select name="position" required class="field"><option value="">เลือกตำแหน่ง</option><option>CEO / เจ้าของกิจการ</option><option>Managing Director</option><option>Sales Director</option><option>Sales Manager</option><option>Marketing Manager</option><option>Operations Manager</option><option>อื่นๆ</option></select></label></div>
          <label class="field-label">ธุรกิจของคุณทำเกี่ยวกับอะไร<input name="business" required placeholder="เช่น ขายเครื่องจักร B2B, ตัวแทนจำหน่ายอะไหล่" class="field" /></label>
          <div class="grid gap-5 sm:grid-cols-2"><label class="field-label">ทีมขายกี่คน<select name="team_size" required class="field"><option value="">เลือกขนาดทีม</option><option value="0">ยังไม่มีทีมขาย</option><option value="1-4">1–4 คน</option><option value="5-10">5–10 คน</option><option value="11-20">11–20 คน</option><option value="20+">มากกว่า 20 คน</option></select></label><label class="field-label">งบที่พร้อมลงทุน<select name="budget" required class="field"><option value="">เลือกช่วงงบ</option><option>ยังไม่ได้ตั้งงบ — อยากเห็นโจทย์ก่อน</option><option>ต่ำกว่า ฿50,000</option><option>฿50,000–฿100,000</option><option>฿100,000–฿300,000</option><option>มากกว่า ฿300,000</option></select></label></div>
          <label class="field-label">ตอนนี้เรื่องไหนติดสุด<select name="issue" required class="field"><option value="">เลือกเรื่องที่ตรงที่สุด</option>{issues.map((issue) => <option value={issue}>{issue}</option>)}</select></label>
          <AfterHoursField variant="warm" />
          <label class="flex cursor-pointer items-start gap-3 pt-1"><input name="consent" type="checkbox" required class="checkbox mt-0.5" /><span class="text-sm leading-relaxed text-warm-ink/75">ยินยอมให้ติดต่อกลับตาม <a href="/privacy" class="font-semibold text-cyan underline">นโยบายความเป็นส่วนตัว</a></span></label>
          <p id="booking-error" class="hidden rounded-xl border border-error/40 bg-error/10 p-4 text-sm text-error" role="alert"></p>
          <button id="booking-submit" type="submit" class="btn w-full border-0 bg-coral py-4 text-base text-white hover:bg-[#c43245]">ส่งข้อมูล — ผมติดต่อกลับภายใน 1 วันทำการ</button>
          <div class="flex items-center gap-3 text-sm text-warm-ink/60"><span class="h-px flex-1 bg-[#c9c2b2]"></span>หรือสะดวกแชทมากกว่า<span class="h-px flex-1 bg-[#c9c2b2]"></span></div>
          <a href={SITE.social.line} target="_blank" rel="noopener" class="btn w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">ทัก LINE ได้เลย</a>
        </div>
      </form>

      <aside class="lg:col-span-5"><h2 class="font-display text-3xl font-bold text-navy">หลังจากกดส่ง เกิดอะไรต่อ</h2><ol class="mt-6 space-y-4">{['ผมทักกลับเพื่อนัดเวลา ภายใน 1 วันทำการ', 'คุยโจทย์ของคุณ 15–20 นาที ผมฟังมากกว่าพูด', 'ได้คำแนะนำเส้นทางที่คุ้มสุด — เริ่มเล็กก็ได้ ยังไม่เริ่มก็ได้'].map((item, index) => <li class="flex gap-4 rounded-2xl border border-[#c9c2b2] bg-surface p-5"><span class="font-display text-4xl font-bold text-coral">{index + 1}</span><p class="pt-1 leading-relaxed text-warm-ink/75">{item}</p></li>)}</ol><p class="mt-6 rounded-2xl border-l-4 border-cyan bg-sand p-5 text-sm leading-relaxed text-warm-ink/80"><strong class="text-navy">คุยก่อนได้ ไม่โดนขาย</strong><br />ถ้าโจทย์ของคุณแก้ได้ด้วยตัวเอง ผมจะบอกวิธีให้กลับไปทำต่อได้เลย ไม่ต้องเสียเงินกับผม</p></aside>
    </div>
    <div id="booking-success" class="mx-auto mt-10 hidden max-w-2xl rounded-2xl border border-coral/40 bg-surface p-8 text-center"><DarumaMark class="mx-auto size-16" /><h2 class="mt-5 font-display text-3xl font-bold text-navy">รับเรื่องแล้ว ขอบคุณครับ</h2><p id="booking-recommendation" class="mt-3 leading-relaxed text-warm-ink/75"></p><a href={SITE.social.line} target="_blank" rel="noopener" class="btn mt-6 border-0 bg-[#06C755] text-white hover:bg-[#05a945]">ทัก LINE OA ต่อ</a></div>
  </section>
</BaseLayout>

<style>
  .field-label { display: grid; gap: .45rem; color: var(--pun-navy); font-size: .95rem; font-weight: 600; }
  .field { width: 100%; border: 1px solid var(--pun-border); border-radius: .75rem; background: var(--pun-ivory); color: var(--pun-ink); padding: .75rem 1rem; }
  .field:focus { border-color: var(--pun-coral); outline: 2px solid color-mix(in oklch, var(--pun-coral) 25%, transparent); outline-offset: 2px; }
</style>

<script>
  import { foldAfterHours } from '../scripts/after-hours';

  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const success = document.getElementById('booking-success');
  const error = document.getElementById('booking-error');
  const submit = document.getElementById('booking-submit') as HTMLButtonElement | null;
  const recommendation = document.getElementById('booking-recommendation');
  const WEBHOOK = 'https://rnat.app.n8n.cloud/webhook/intake-form-v2';

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    if ((new FormData(form).get('honeypot-name') as string)?.trim()) return;
    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());
    Object.assign(payload, {
      // Canonical aliases — shared intake flow reads company/problems (see docs/INTAKE-DATA-CONTRACT.md)
      company: ((payload.company as string) || '').trim() || (payload.business as string) || '',
      industry: payload.business || '',
      problems: (payload.issue as string) || '',
      source: 'website-booking', source_page: 'website-booking', booking_type: 'daruma-qualification',
      submitted_at: new Date().toISOString(), path: window.location.pathname,
      recommended_path: 'free-consultation',
    });
    // ⏰ นอกเวลาทำการ — พ่วงเข้า comment เพราะ n8n Flatten Body1 ยังไม่รู้จัก key นี้
    foldAfterHours(payload as Record<string, unknown>);
    if (submit) { submit.disabled = true; submit.textContent = 'กำลังส่ง...'; }
    if (error) error.classList.add('hidden');
    try {
      const response = await fetch(WEBHOOK, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), keepalive: true });
      if (!response.ok) throw new Error('submission failed');
      form.classList.add('hidden');
      if (recommendation) recommendation.textContent = 'ผมจะอ่านโจทย์ของคุณก่อน แล้วคุยกันตรงๆ ว่าทีมควรเริ่มจาก In-house, โปรแกรมเต็ม หรือยังมีอะไรที่กลับไปทำเองได้ครับ';
      success?.classList.remove('hidden');
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      (window as unknown as { plausible?: (...args: unknown[]) => void }).plausible?.('Booking Submit', { props: { source: 'website-booking' } });
    } catch {
      if (error) { error.textContent = 'ระบบรับข้อมูลขัดข้องชั่วคราว กรุณาทัก LINE OA เพื่อส่งโจทย์ให้ผมโดยตรง'; error.classList.remove('hidden'); }
      if (submit) { submit.disabled = false; submit.textContent = 'ส่งข้อมูล — ผมติดต่อกลับภายใน 1 วันทำการ'; }
    }
  });
</script>
