---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = 'เช็คทีมขายของคุณใน 2 นาที · แนะนำเรื่องที่ควรเริ่ม';
const description =
  'แบบทดสอบเร็วไม่บังคับกรอกข้อมูล รู้ได้ทันที ว่าทีมขายติดเรื่องไหนมากที่สุด ควรเริ่มจากบริการใหน';
---

<BaseLayout
  title={title}
  description={description}
  hideFloatingLine={true}
  schema={{
    types: ['WebPage', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'เช็คทีมขาย', url: `${SITE.url}/team-check` },
    ],
  }}
>
  <!-- ===== INTRO SECTION ===== -->
  <section id="sec-intro" class="quiz-section px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">2 นาทีทำแบบทดสอบ</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        เช็คทีมขายของคุณใน 2 นาที
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-base-content/75">
        ไม่บังคับกรอกข้อมูล เพียง 15 คำถามเร็ว ได้ผลทันที ว่าทีมขายติดเรื่องไหนมากที่สุด
        ควรเริ่มแก้จากบริการไหน แบบไหน
      </p>

      <div class="mt-10 space-y-4 rounded-2xl border border-base-content/10 bg-base-200/30 p-6">
        <h2 class="font-display text-xl font-bold">เริ่มทดสอบ</h2>
        <p class="text-sm text-base-content/70">
          ใช้เวลา 2 นาที · ไม่ต้องสมัครสมาชิก · ได้ผลทันที
        </p>

        <button
          id="btn-start"
          type="button"
          class="btn btn-lg w-full bg-secondary text-secondary-content shadow-xl shadow-secondary/30 transition-all hover:scale-[1.01] hover:bg-secondary/90"
        >
          เริ่มเลย →
        </button>
      </div>
    </div>
  </section>

  <!-- ===== QUIZ SECTION ===== -->
  <section id="sec-quiz" class="quiz-section hidden px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <!-- Progress -->
      <div class="sticky top-0 z-20 -mx-4 border-b border-base-content/10 bg-base-100/95 px-4 py-3 backdrop-blur-lg lg:-mx-8 lg:px-8">
        <div class="flex items-center justify-between text-sm">
          <span id="progress-text" class="font-medium text-base-content">ตอบแล้ว 0 / 15 ข้อ</span>
          <span id="progress-pct" class="font-display font-bold text-secondary">0%</span>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-base-200">
          <div
            id="progress-fill"
            class="h-full bg-secondary transition-all duration-300"
            style="width: 0%;"
          >
          </div>
        </div>
      </div>

      <div id="questions-container" class="mt-8 space-y-6">
        {/* Questions rendered by client script */}
      </div>

      <button
        id="btn-submit"
        type="button"
        disabled
        class="btn btn-lg mt-10 w-full bg-secondary text-secondary-content shadow-xl shadow-secondary/30 transition-all hover:scale-[1.01] hover:bg-secondary/90 disabled:cursor-not-allowed disabled:bg-base-200 disabled:text-base-content/40 disabled:shadow-none"
      >
        คำนวณผล →
      </button>
    </div>
  </section>

  <!-- ===== RESULT SECTION ===== -->
  <section id="sec-result" class="quiz-section hidden px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">ผลการทดสอบ</p>
      <h2 id="result-heading" class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
        {/* "ทีมคุณติด {path} · เริ่มที่เรื่อง {topic}" */}
      </h2>

      <!-- Topic card -->
      <div
        id="result-topic-card"
        class="mt-8 rounded-3xl border-2 border-base-content/10 p-8 md:p-12"
      >
        <p class="text-xs font-bold uppercase tracking-widest text-secondary">เรื่องที่ควรเริ่มก่อน</p>
        <h3 id="result-topic-name" class="mt-3 font-display text-3xl font-bold"></h3>

        <div class="mt-6 space-y-4">
          <div>
            <p class="text-sm font-semibold text-base-content/70">ตอนนี้</p>
            <p id="result-topic-current" class="mt-1 text-base leading-relaxed text-base-content/85"></p>
          </div>
          <div>
            <p class="text-sm font-semibold text-base-content/70">หลังวางระบบ</p>
            <p id="result-topic-after" class="mt-1 text-base leading-relaxed text-base-content/85"></p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            id="result-learn-link"
            href="#"
            class="btn btn-sm btn-ghost border border-base-content/25 text-sm"
          >
            ดูคลาส →
          </a>
          <a
            id="result-line-btn"
            href="https://lin.ee/ioSnSUG"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm bg-green-500 text-white hover:bg-green-600"
            data-cta-event="team-check-line-primary"
          >
            ส่งผลใน LINE
          </a>
        </div>
      </div>

      <!-- Score bars — all 6 topics -->
      <div class="mt-10 rounded-2xl border border-base-content/10 bg-base-100 p-6">
        <h4 class="font-display text-lg font-bold">คะแนนแต่ละเรื่อง</h4>
        <div id="result-scores" class="mt-5 space-y-3">
          {/* Populated by client script */}
        </div>
      </div>

      <!-- Next steps numbered list -->
      <div class="mt-8 space-y-4 rounded-2xl border border-base-content/10 bg-base-100 p-6">
        <h4 class="font-display text-lg font-bold">ขั้นตอนถัดไป</h4>
        <ol class="space-y-3 text-sm text-base-content/85">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">①</span>
            <span>กดส่งผลเข้า LINE</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">②</span>
            <span>บอกเพิ่มว่าทีมขายกี่คน ติดเรื่องไหนมากสุด</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">③</span>
            <span>ผมอ่านและตอบเองครับ</span>
          </li>
        </ol>
      </div>

      <!-- Secondary actions -->
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button
          id="btn-reset"
          type="button"
          class="btn btn-sm btn-ghost border border-base-content/20 text-sm"
        >
          ทำใหม่อีกรอบ
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .quiz-section.hidden { display: none !important; }
  .quiz-section:not(.hidden) { display: block; }

  .choice-label:has(input:checked) {
    border-color: var(--color-secondary) !important;
    background: color-mix(in oklch, var(--color-secondary) 10%, transparent) !important;
  }
  .q-card.answered {
    border-color: color-mix(in oklch, var(--color-secondary) 30%, transparent) !important;
  }
</style>

<script>
  import { buildLineHref, isMobile, currentAngle } from '../scripts/line-prefill';
  import {
    PROFILE_QUESTIONS,
    SYMPTOM_QUESTIONS,
    TOPIC_INFO,
    topicPriority,
    type Path,
    type Topic,
  } from '../data/team-check';

  interface State {
    profileAnswers: Array<number | null>;
    symptomAnswers: Array<number | null>;
  }

  let state: State = {
    profileAnswers: new Array(3).fill(null),
    symptomAnswers: new Array(12).fill(null),
  };

  const TOTAL_QUESTIONS = 15; // 3 profile + 12 symptoms
  const SYMPTOM_TOTAL_QUESTIONS = 12; // for topic scoring, max 2 per question
  const OA_ID = '011xgvap';

  function loadState(): void {
    try {
      const saved = localStorage.getItem('pn_team_check_answers');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.profileAnswers) state.profileAnswers = parsed.profileAnswers;
        if (parsed.symptomAnswers) state.symptomAnswers = parsed.symptomAnswers;
      }
    } catch {
      /* non-fatal */
    }
  }

  function saveState(): void {
    try {
      localStorage.setItem('pn_team_check_answers', JSON.stringify(state));
    } catch {
      /* non-fatal */
    }
  }

  function showSection(id: string): void {
    document.querySelectorAll('.quiz-section').forEach((s) => s.classList.add('hidden'));
    document.getElementById(id)?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress(): void {
    const profile = state.profileAnswers.filter((a) => a !== null).length;
    const symptom = state.symptomAnswers.filter((a) => a !== null).length;
    const answered = profile + symptom;
    const pct = Math.round((answered / TOTAL_QUESTIONS) * 100);

    const textEl = document.getElementById('progress-text');
    const pctEl = document.getElementById('progress-pct');
    const fillEl = document.getElementById('progress-fill');
    const btn = document.getElementById('btn-submit') as HTMLButtonElement | null;

    if (textEl) textEl.textContent = `ตอบแล้ว ${answered} / ${TOTAL_QUESTIONS} ข้อ`;
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (fillEl) fillEl.style.width = `${pct}%`;
    if (btn) btn.disabled = answered < TOTAL_QUESTIONS;
  }

  function renderQuestions(): void {
    const container = document.getElementById('questions-container');
    if (!container) return;

    // Profile questions
    PROFILE_QUESTIONS.forEach((q, idx) => {
      const card = document.createElement('article');
      card.className = 'q-card rounded-2xl border border-base-content/10 bg-base-100 p-6';
      card.id = `q-profile-${idx}`;
      card.dataset.qIdx = String(idx);
      card.dataset.type = 'profile';

      const label = document.createElement('p');
      label.className = 'text-xs font-bold uppercase tracking-widest text-secondary';
      label.textContent = `ข้อที่ ${idx + 1}`;
      card.appendChild(label);

      const heading = document.createElement('h3');
      heading.className = 'mt-2 font-display text-lg font-bold leading-snug';
      heading.textContent = q.text;
      card.appendChild(heading);

      const choicesDiv = document.createElement('div');
      choicesDiv.className = 'mt-5 space-y-2';

      q.choices.forEach((choice, ci) => {
        const choiceLabel = document.createElement('label');
        choiceLabel.className =
          'choice-label flex cursor-pointer items-start gap-3 rounded-xl border border-base-content/15 p-4 transition hover:border-secondary/50 hover:bg-base-200/40';
        choiceLabel.dataset.qIdx = String(idx);
        choiceLabel.dataset.choiceIdx = String(ci);
        choiceLabel.dataset.type = 'profile';

        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = `profile-${idx}`;
        radio.value = String(ci);

        const badge = document.createElement('div');
        badge.className =
          'flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-base-200 font-display text-sm font-bold';
        badge.textContent = String.fromCharCode(65 + ci); // A, B, C, D

        const text = document.createElement('span');
        text.className = 'flex-1 text-sm leading-relaxed text-base-content/85';
        text.textContent = choice;

        choiceLabel.appendChild(radio);
        choiceLabel.appendChild(badge);
        choiceLabel.appendChild(text);
        choicesDiv.appendChild(choiceLabel);
      });

      card.appendChild(choicesDiv);
      container.appendChild(card);
    });

    // Symptom questions
    SYMPTOM_QUESTIONS.forEach((q, idx) => {
      const card = document.createElement('article');
      card.className = 'q-card rounded-2xl border border-base-content/10 bg-base-100 p-6';
      card.id = `q-symptom-${idx}`;
      card.dataset.qIdx = String(idx);
      card.dataset.type = 'symptom';

      const label = document.createElement('p');
      label.className = 'text-xs font-bold uppercase tracking-widest text-secondary';
      label.textContent = `ข้อที่ ${3 + idx + 1}`;
      card.appendChild(label);

      const heading = document.createElement('h3');
      heading.className = 'mt-2 font-display text-lg font-bold leading-snug';
      heading.textContent = q.text;
      card.appendChild(heading);

      const choicesDiv = document.createElement('div');
      choicesDiv.className = 'mt-5 space-y-2';

      const levels = ['ไม่ตรง', 'ตรงบ้าง', 'ตรงมาก'];
      levels.forEach((level, ci) => {
        const choiceLabel = document.createElement('label');
        choiceLabel.className =
          'choice-label flex cursor-pointer items-start gap-3 rounded-xl border border-base-content/15 p-4 transition hover:border-secondary/50 hover:bg-base-200/40';
        choiceLabel.dataset.qIdx = String(idx);
        choiceLabel.dataset.choiceIdx = String(ci);
        choiceLabel.dataset.type = 'symptom';

        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = `symptom-${idx}`;
        radio.value = String(ci);

        const badge = document.createElement('div');
        badge.className =
          'flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-base-200 font-display text-sm font-bold';
        badge.textContent = String(ci);

        const text = document.createElement('span');
        text.className = 'flex-1 text-sm leading-relaxed text-base-content/85';
        text.textContent = level;

        choiceLabel.appendChild(radio);
        choiceLabel.appendChild(badge);
        choiceLabel.appendChild(text);
        choicesDiv.appendChild(choiceLabel);
      });

      card.appendChild(choicesDiv);
      container.appendChild(card);
    });

    // Restore saved answers
    loadState();
    state.profileAnswers.forEach((answer, idx) => {
      if (answer !== null) {
        const radio = document.querySelector<HTMLInputElement>(
          `input[name="profile-${idx}"][value="${answer}"]`
        );
        if (radio) {
          radio.checked = true;
          document.getElementById(`q-profile-${idx}`)?.classList.add('answered');
        }
      }
    });
    state.symptomAnswers.forEach((answer, idx) => {
      if (answer !== null) {
        const radio = document.querySelector<HTMLInputElement>(
          `input[name="symptom-${idx}"][value="${answer}"]`
        );
        if (radio) {
          radio.checked = true;
          document.getElementById(`q-symptom-${idx}`)?.classList.add('answered');
        }
      }
    });

    updateProgress();
  }

  function attachListeners(): void {
    document.querySelectorAll<HTMLLabelElement>('.choice-label').forEach((label) => {
      label.addEventListener('click', () => {
        const type = label.dataset.type;
        const qIdx = Number(label.dataset.qIdx);
        const cIdx = Number(label.dataset.choiceIdx);
        const radio = label.querySelector<HTMLInputElement>('input[type="radio"]');

        if (radio) radio.checked = true;

        if (type === 'profile') {
          state.profileAnswers[qIdx] = cIdx;
          document.getElementById(`q-profile-${qIdx}`)?.classList.add('answered');
        } else if (type === 'symptom') {
          state.symptomAnswers[qIdx] = cIdx;
          document.getElementById(`q-symptom-${qIdx}`)?.classList.add('answered');
        }

        saveState();
        updateProgress();
      });
    });

    document.getElementById('btn-start')?.addEventListener('click', () => {
      showSection('sec-quiz');
    });

    document.getElementById('btn-submit')?.addEventListener('click', () => {
      calculateResult();
    });

    document.getElementById('btn-reset')?.addEventListener('click', () => {
      state.profileAnswers.fill(null);
      state.symptomAnswers.fill(null);
      saveState();
      document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => {
        r.checked = false;
      });
      document.querySelectorAll('.q-card').forEach((c) => c.classList.remove('answered'));
      updateProgress();
      showSection('sec-intro');
    });
  }

  function calculateResult(): void {
    // Score by topic: 2 symptom questions per topic, max 2 points each = max 4 per topic
    const topicScores: Record<Topic, number> = {
      hiring: 0,
      comp: 0,
      lead: 0,
      sales: 0,
      docs: 0,
      content: 0,
    };

    state.symptomAnswers.forEach((answer, idx) => {
      if (answer === null) return;
      const topic = SYMPTOM_QUESTIONS[idx].topic;
      // answer is 0/1/2 (ไม่ตรง/ตรงบ้าง/ตรงมาก)
      topicScores[topic] += answer;
    });

    // Determine main path
    const teamBuildScore = topicScores.hiring + topicScores.comp + topicScores.lead;
    const aiOfficeScore = topicScores.sales + topicScores.docs + topicScores.content;

    let mainPath: Path;
    if (teamBuildScore > aiOfficeScore) {
      mainPath = 'team-build';
    } else if (aiOfficeScore > teamBuildScore) {
      mainPath = 'ai-office';
    } else {
      // Tie: use first topic with highest score
      const allTopics: Topic[] = ['sales', 'lead', 'docs', 'comp', 'hiring', 'content'];
      const firstHighest = allTopics.find((t) => topicScores[t] === Math.max(...allTopics.map((t) => topicScores[t])));
      mainPath = firstHighest && TOPIC_INFO[firstHighest].path ? TOPIC_INFO[firstHighest].path : 'team-build';
    }

    // Find top topic
    let topTopic: Topic = 'hiring';
    let topScore = 0;
    let secondTopic: Topic | null = null;
    let secondScore = 0;

    // Sort by score desc, then by priority
    const sorted = Object.entries(topicScores).sort(([t1, s1], [t2, s2]) => {
      if (s1 !== s2) return s2 - s1;
      return topicPriority(t1 as Topic) - topicPriority(t2 as Topic);
    });

    if (sorted.length > 0) {
      topTopic = sorted[0][0] as Topic;
      topScore = sorted[0][1];
    }
    if (sorted.length > 1 && sorted[1][1] >= 2) {
      secondTopic = sorted[1][0] as Topic;
      secondScore = sorted[1][1];
    }

    // Display results
    const p1 = state.profileAnswers[0];
    const p3 = state.profileAnswers[2];

    let heading = '';
    if (p1 === 0) {
      heading = 'แพ็กทีมขายออกแบบมาให้บริษัทที่มีทีมแล้ว';
    } else {
      const pathLabel = mainPath === 'team-build' ? 'ปั้นทีมขาย' : 'AI Office ฝ่ายขาย';
      const topicName = TOPIC_INFO[topTopic].name;
      heading = `ทีมคุณติดทาง ${pathLabel} · เริ่มที่เรื่อง ${topicName}`;
    }

    const headingEl = document.getElementById('result-heading');
    if (headingEl) headingEl.textContent = heading;

    // Render topic card
    const topicInfo = TOPIC_INFO[topTopic];
    const topicNameEl = document.getElementById('result-topic-name');
    const topicCurrentEl = document.getElementById('result-topic-current');
    const topicAfterEl = document.getElementById('result-topic-after');
    const learnLinkEl = document.getElementById('result-learn-link') as HTMLAnchorElement | null;

    if (topicNameEl) topicNameEl.textContent = topicInfo.name;
    if (topicCurrentEl) topicCurrentEl.textContent = topicInfo.current;
    if (topicAfterEl) topicAfterEl.textContent = topicInfo.after;

    if (learnLinkEl && topicInfo.learnLink) {
      learnLinkEl.href = topicInfo.learnLink;
      learnLinkEl.style.display = 'inline-block';
    } else if (learnLinkEl) {
      learnLinkEl.style.display = 'none';
    }

    // Render LINE button
    const lineBtn = document.getElementById('result-line-btn') as HTMLAnchorElement | null;
    if (lineBtn) {
      const teamSizeLabel = ['ยังไม่มี ผมขายเอง', '1–2 คน', '3–9 คน', '10–20 คน', 'มากกว่า 20 คน'][p1 ?? 0] || '';
      const angle = `team-check-${topTopic}`;
      const keyword = `ผลเช็คทีมขาย: ${mainPath === 'team-build' ? 'ปั้นทีมขาย' : 'AI Office'} · เริ่มที่${topicInfo.name} · ทีม ${teamSizeLabel}`;
      const isMobileView = isMobile();
      if (isMobileView) {
        lineBtn.href = buildLineHref(OA_ID, topicInfo.productCode, angle, keyword);
      } else {
        lineBtn.href = 'https://lin.ee/ioSnSUG';
      }
    }

    // Render score bars
    const scoresDiv = document.getElementById('result-scores');
    if (scoresDiv) {
      scoresDiv.innerHTML = '';
      const topics: Topic[] = ['hiring', 'comp', 'lead', 'sales', 'docs', 'content'];
      topics.forEach((topic) => {
        const score = topicScores[topic];
        const maxScore = 4; // 2 questions × max 2 points

        const row = document.createElement('div');
        row.className = 'score-row';

        const header = document.createElement('div');
        header.className = 'mb-1 flex items-center justify-between text-sm';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'font-display font-bold';
        nameSpan.textContent = TOPIC_INFO[topic].name;

        const scoreSpan = document.createElement('span');
        scoreSpan.className = 'font-mono text-xs text-base-content/70';
        scoreSpan.textContent = `${score} / ${maxScore}`;

        header.appendChild(nameSpan);
        header.appendChild(scoreSpan);
        row.appendChild(header);

        const barContainer = document.createElement('div');
        barContainer.className = 'h-3 overflow-hidden rounded-full bg-base-200';

        const bar = document.createElement('div');
        bar.className = 'h-full bg-secondary transition-all duration-700';
        bar.style.width = `${(score / maxScore) * 100}%`;

        barContainer.appendChild(bar);
        row.appendChild(barContainer);

        scoresDiv.appendChild(row);
      });
    }

    // Track event
    if ((window as unknown as { fbq?: (name: string, type: string, data: Record<string, string>) => void }).fbq) {
      (window as unknown as { fbq: (name: string, type: string, data: Record<string, string>) => void }).fbq(
        'trackCustom',
        'TeamCheckComplete',
        { path: mainPath, topic: topTopic, team_size: String(p1 ?? 0) }
      );
    }

    showSection('sec-result');
  }

  // Initialize
  loadState();
  renderQuestions();
  attachListeners();
</script>
