---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = 'เช็คทีมขายคุณติดทางไหน — ฟรี 2 นาที';
const description =
  'ตอบ 15 ข้อสั้นๆ แล้วรู้ว่าควรเริ่มเรื่องไหนก่อน ไม่ต้องกรอกข้อมูลติดต่อ';
---

<BaseLayout
  title={title}
  description={description}
  hideFloatingLine={true}
  schema={{
    types: ['WebPage', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'เช็คทีมขาย', url: `${SITE.url}/team-check` },
    ],
  }}
>
  <!-- ===== INTRO SECTION ===== -->
  <section id="sec-intro" class="quiz-section px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">เช็คทีมขาย 2 นาที</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-tight tracking-tight md:text-5xl">
        ทีมขายคุณติดทางไหน
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-base-content/75">
        ตอบ 15 ข้อสั้นๆ แล้วรู้ว่าควรเริ่มเรื่องไหนก่อน ไม่ต้องกรอกข้อมูลติดต่อครับ
      </p>

      <div class="mt-10 rounded-2xl border border-base-content/10 bg-base-200/30 p-6">
        <button
          id="btn-start"
          type="button"
          class="btn btn-lg w-full bg-secondary text-secondary-content shadow-xl shadow-secondary/30 transition-all hover:scale-[1.01] hover:bg-secondary/90"
        >
          เริ่มเช็ค →
        </button>
      </div>
    </div>
  </section>

  <!-- ===== QUIZ SECTION ===== -->
  <section id="sec-quiz" class="quiz-section hidden px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <!-- Progress -->
      <div class="sticky top-0 z-20 -mx-4 border-b border-base-content/10 bg-base-100/95 px-4 py-3 backdrop-blur-lg lg:-mx-8 lg:px-8">
        <div class="flex items-center justify-between text-sm">
          <span id="progress-text" class="font-medium text-base-content">ข้อ 1 / 15</span>
          <span id="progress-pct" class="font-display font-bold text-secondary">0%</span>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-base-200">
          <div
            id="progress-fill"
            class="h-full bg-secondary transition-all duration-300"
            style="width: 0%;"
          >
          </div>
        </div>
      </div>

      <div class="mt-12 space-y-8">
        <!-- Current question card -->
        <article id="current-question" class="rounded-3xl border-2 border-base-content/10 p-8 md:p-12">
          <h2 id="q-text" class="font-display text-2xl font-bold leading-snug"></h2>
          <div id="q-answers" class="mt-8 space-y-3">
            {/* Answer buttons rendered by script */}
          </div>
        </article>

        <!-- Navigation -->
        <div class="flex gap-3">
          <button
            id="btn-back"
            type="button"
            class="btn btn-outline flex-1"
          >
            ← ย้อนกลับ
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== RESULT SECTION ===== -->
  <section id="sec-result" class="quiz-section hidden px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">ผลเช็คทีมขาย</p>
      <h2 id="result-heading" class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
        {/* "ทีมคุณติด {path} · เริ่มที่เรื่อง {topic}" */}
      </h2>

      <!-- Topic card -->
      <div
        id="result-topic-card"
        class="mt-8 rounded-3xl border-2 border-base-content/10 p-8 md:p-12"
      >
        <p class="text-xs font-bold uppercase tracking-widest text-secondary">เรื่องที่ควรเริ่มก่อน</p>
        <h3 id="result-topic-name" class="mt-3 font-display text-3xl font-bold"></h3>

        <div class="mt-6 space-y-4">
          <div>
            <p class="text-sm font-semibold text-base-content/70">ตอนนี้</p>
            <p id="result-topic-current" class="mt-1 text-base leading-relaxed text-base-content/85"></p>
          </div>
          <div>
            <p class="text-sm font-semibold text-base-content/70">หลังวางระบบ</p>
            <p id="result-topic-after" class="mt-1 text-base leading-relaxed text-base-content/85"></p>
          </div>
        </div>
      </div>

      <!-- Second topic (if score >= 2) -->
      <div id="result-secondary-card" class="mt-6 hidden rounded-2xl border border-base-content/10 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-base-content/60">เรื่องถัดไปที่ควรดู</p>
        <h4 id="result-secondary-name" class="mt-2 font-display text-xl font-bold"></h4>
        <p id="result-secondary-current" class="mt-2 text-sm text-base-content/75"></p>
      </div>

      <!-- Score bars grouped by path -->
      <div class="mt-10 rounded-2xl border border-base-content/10 bg-base-100 p-6">
        <h4 class="font-display text-lg font-bold">คะแนนแต่ละเรื่อง</h4>

        <div class="mt-6">
          <h5 class="text-sm font-semibold text-base-content/70">ปั้นทีมขาย</h5>
          <div id="result-scores-team-build" class="mt-3 space-y-3"></div>
        </div>

        <div class="mt-6">
          <h5 class="text-sm font-semibold text-base-content/70">AI Office ฝ่ายขาย</h5>
          <div id="result-scores-ai-office" class="mt-3 space-y-3"></div>
        </div>
      </div>

      <!-- CTA section — dynamically routed based on P3 -->
      <div id="result-cta-section" class="mt-10 space-y-4">
        {/* Populated by script based on P3 answer */}
      </div>

      <!-- Next steps numbered list -->
      <div class="mt-8 space-y-4 rounded-2xl border border-base-content/10 bg-base-100 p-6">
        <h4 class="font-display text-lg font-bold">ขั้นตอนถัดไป</h4>
        <ol class="space-y-3 text-sm text-base-content/85">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">①</span>
            <span>กดส่งผลเข้า LINE</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">②</span>
            <span>บอกเพิ่มว่าทีมขายกี่คน ติดเรื่องไหนมากสุด</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-secondary font-display font-bold text-secondary-content">③</span>
            <span>ผมอ่านและตอบเองครับ</span>
          </li>
        </ol>
      </div>

      <!-- Secondary actions -->
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button
          id="btn-reset"
          type="button"
          class="btn btn-sm btn-ghost border border-base-content/20 text-sm"
        >
          ทำใหม่อีกรอบ
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .quiz-section.hidden { display: none !important; }
  .quiz-section:not(.hidden) { display: block; }

  .answer-btn.selected {
    border-color: var(--color-secondary) !important;
    background: color-mix(in oklch, var(--color-secondary) 10%, transparent) !important;
  }
</style>

<script>
  import { buildLineHref, isMobile, currentAngle } from '../scripts/line-prefill';
  import {
    PROFILE_QUESTIONS,
    SYMPTOM_QUESTIONS,
    TOPIC_INFO,
    topicPriority,
    type Path,
    type Topic,
  } from '../data/team-check';

  interface State {
    profileAnswers: Array<number | null>;
    symptomAnswers: Array<number | null>;
    currentQuestionIdx: number;
  }

  let state: State = {
    profileAnswers: new Array(3).fill(null),
    symptomAnswers: new Array(12).fill(null),
    currentQuestionIdx: 0,
  };

  const TOTAL_QUESTIONS = 15;
  const OA_ID = '011xgvap';

  function loadState(): void {
    try {
      const saved = localStorage.getItem('pn_team_check_answers');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (parsed.profileAnswers) state.profileAnswers = parsed.profileAnswers;
        if (parsed.symptomAnswers) state.symptomAnswers = parsed.symptomAnswers;
      }
    } catch {
      /* non-fatal */
    }
  }

  function saveState(): void {
    try {
      localStorage.setItem('pn_team_check_answers', JSON.stringify(state));
    } catch {
      /* non-fatal */
    }
  }

  function showSection(id: string): void {
    document.querySelectorAll('.quiz-section').forEach((s) => s.classList.add('hidden'));
    document.getElementById(id)?.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress(): void {
    const qNum = state.currentQuestionIdx + 1;
    const pct = Math.round((qNum / TOTAL_QUESTIONS) * 100);
    const textEl = document.getElementById('progress-text');
    const pctEl = document.getElementById('progress-pct');
    const fillEl = document.getElementById('progress-fill');

    if (textEl) textEl.textContent = `ข้อ ${qNum} / ${TOTAL_QUESTIONS}`;
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (fillEl) fillEl.style.width = `${pct}%`;
  }

  function renderCurrentQuestion(): void {
    const isProfile = state.currentQuestionIdx < 3;
    const qIdx = isProfile ? state.currentQuestionIdx : state.currentQuestionIdx - 3;
    const q = isProfile ? PROFILE_QUESTIONS[qIdx] : SYMPTOM_QUESTIONS[qIdx];

    const textEl = document.getElementById('q-text');
    const answersDiv = document.getElementById('q-answers');

    if (!textEl || !answersDiv) return;

    textEl.textContent = q.text;
    answersDiv.innerHTML = '';

    // ข้ออาการไม่มี choices ในข้อมูล — ใช้สเกลเดียวกันทุกข้อ (ค่าที่เก็บ = คะแนน 0–2) · แสดง "ตรงมาก" ก่อน
    const options: Array<[number, string]> = isProfile
      ? PROFILE_QUESTIONS[qIdx].choices.map((choice, ci) => [ci, choice] as [number, string])
      : [[2, 'ตรงมาก'], [1, 'ตรงบ้าง'], [0, 'ไม่ตรง']];

    options.forEach(([ci, choice]) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'answer-btn block w-full rounded-xl border-2 border-base-content/10 p-4 text-left transition-all hover:border-secondary/50 hover:bg-base-200/40';
      btn.setAttribute('data-choice-idx', String(ci));
      btn.setAttribute('aria-label', choice);
      btn.innerHTML = `<span class="font-medium">${choice}</span>`;

      // Check if this answer is already selected
      const currentAnswer = isProfile ? state.profileAnswers[qIdx] : state.symptomAnswers[qIdx];
      if (currentAnswer === ci) {
        btn.classList.add('selected');
      }

      btn.addEventListener('click', () => {
        if (isProfile) {
          state.profileAnswers[qIdx] = ci;
        } else {
          state.symptomAnswers[qIdx] = ci;
        }
        saveState();

        // Visual feedback
        btn.classList.add('selected');
        const otherBtns = answersDiv.querySelectorAll('.answer-btn');
        otherBtns.forEach((b) => {
          if (b !== btn) b.classList.remove('selected');
        });

        // Auto-advance after 200ms
        setTimeout(() => {
          if (state.currentQuestionIdx < TOTAL_QUESTIONS - 1) {
            state.currentQuestionIdx++;
            updateProgress();
            renderCurrentQuestion();
          } else {
            // After Q15, show result directly
            calculateResult();
            showSection('sec-result');
          }
        }, 200);
      });

      answersDiv.appendChild(btn);
    });

    updateProgress();
  }

  function goBack(): void {
    if (state.currentQuestionIdx > 0) {
      state.currentQuestionIdx--;
      updateProgress();
      renderCurrentQuestion();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  function calculateResult(): void {
    const topicScores: Record<Topic, number> = {
      hiring: 0,
      comp: 0,
      lead: 0,
      sales: 0,
      docs: 0,
      content: 0,
    };

    state.symptomAnswers.forEach((answer, idx) => {
      if (answer === null) return;
      const topic = SYMPTOM_QUESTIONS[idx].topic;
      topicScores[topic] += answer;
    });

    // Determine main path
    const teamBuildScore = topicScores.hiring + topicScores.comp + topicScores.lead;
    const aiOfficeScore = topicScores.sales + topicScores.docs + topicScores.content;

    let mainPath: Path;
    if (teamBuildScore > aiOfficeScore) {
      mainPath = 'team-build';
    } else if (aiOfficeScore > teamBuildScore) {
      mainPath = 'ai-office';
    } else {
      const allTopics: Topic[] = ['sales', 'lead', 'docs', 'comp', 'hiring', 'content'];
      const firstHighest = allTopics.find((t) => topicScores[t] === Math.max(...allTopics.map((t) => topicScores[t])));
      mainPath = firstHighest && TOPIC_INFO[firstHighest].path ? TOPIC_INFO[firstHighest].path : 'team-build';
    }

    // Find top topic
    let topTopic: Topic = 'hiring';
    let topScore = 0;
    let secondTopic: Topic | null = null;
    let secondScore = 0;

    const sorted = Object.entries(topicScores).sort(([t1, s1], [t2, s2]) => {
      if (s1 !== s2) return s2 - s1;
      return topicPriority(t1 as Topic) - topicPriority(t2 as Topic);
    });

    if (sorted.length > 0) {
      topTopic = sorted[0][0] as Topic;
      topScore = sorted[0][1];
    }
    if (sorted.length > 1 && sorted[1][1] >= 2) {
      secondTopic = sorted[1][0] as Topic;
      secondScore = sorted[1][1];
    }

    // Display results
    const p1 = state.profileAnswers[0];
    const p3 = state.profileAnswers[2];

    let heading = '';
    if (p1 === 0) {
      heading = 'แพ็กทีมขายออกแบบมาให้บริษัทที่มีทีมแล้ว';
    } else {
      const pathLabel = mainPath === 'team-build' ? 'ปั้นทีมขาย' : 'AI Office ฝ่ายขาย';
      const topicName = TOPIC_INFO[topTopic].name;
      heading = `ทีมคุณติดทาง ${pathLabel} · เริ่มที่เรื่อง ${topicName}`;
    }

    const headingEl = document.getElementById('result-heading');
    if (headingEl) headingEl.textContent = heading;

    // Render topic card
    const topicInfo = TOPIC_INFO[topTopic];
    const topicNameEl = document.getElementById('result-topic-name');
    const topicCurrentEl = document.getElementById('result-topic-current');
    const topicAfterEl = document.getElementById('result-topic-after');

    if (topicNameEl) topicNameEl.textContent = topicInfo.name;
    if (topicCurrentEl) topicCurrentEl.textContent = topicInfo.current;
    if (topicAfterEl) topicAfterEl.textContent = topicInfo.after;

    // Render second topic if applicable
    const secondaryCard = document.getElementById('result-secondary-card');
    if (secondTopic && secondScore >= 2 && secondaryCard) {
      secondaryCard.classList.remove('hidden');
      const secondaryNameEl = document.getElementById('result-secondary-name');
      const secondaryCurrentEl = document.getElementById('result-secondary-current');
      if (secondaryNameEl) secondaryNameEl.textContent = TOPIC_INFO[secondTopic].name;
      if (secondaryCurrentEl) secondaryCurrentEl.textContent = TOPIC_INFO[secondTopic].current;
    } else if (secondaryCard) {
      secondaryCard.classList.add('hidden');
    }

    // Render score bars grouped by path
    const scoreBuild = document.getElementById('result-scores-team-build');
    const scoreAI = document.getElementById('result-scores-ai-office');
    if (scoreBuild) {
      scoreBuild.innerHTML = '';
      (['hiring', 'comp', 'lead'] as const).forEach((topic) => {
        const score = topicScores[topic];
        const maxScore = 4;

        const row = document.createElement('div');
        row.className = 'score-row';

        const header = document.createElement('div');
        header.className = 'mb-1 flex items-center justify-between text-sm';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'font-display font-bold';
        nameSpan.textContent = TOPIC_INFO[topic].name;

        const scoreSpan = document.createElement('span');
        scoreSpan.className = 'font-mono text-xs text-base-content/70';
        scoreSpan.textContent = `${score} / ${maxScore}`;

        header.appendChild(nameSpan);
        header.appendChild(scoreSpan);
        row.appendChild(header);

        const barContainer = document.createElement('div');
        barContainer.className = 'h-3 overflow-hidden rounded-full bg-base-200';

        const bar = document.createElement('div');
        bar.className = 'h-full bg-secondary transition-all duration-700';
        bar.style.width = `${(score / maxScore) * 100}%`;

        barContainer.appendChild(bar);
        row.appendChild(barContainer);

        scoreBuild.appendChild(row);
      });
    }

    if (scoreAI) {
      scoreAI.innerHTML = '';
      (['sales', 'docs', 'content'] as const).forEach((topic) => {
        const score = topicScores[topic];
        const maxScore = 4;

        const row = document.createElement('div');
        row.className = 'score-row';

        const header = document.createElement('div');
        header.className = 'mb-1 flex items-center justify-between text-sm';

        const nameSpan = document.createElement('span');
        nameSpan.className = 'font-display font-bold';
        nameSpan.textContent = TOPIC_INFO[topic].name;

        const scoreSpan = document.createElement('span');
        scoreSpan.className = 'font-mono text-xs text-base-content/70';
        scoreSpan.textContent = `${score} / ${maxScore}`;

        header.appendChild(nameSpan);
        header.appendChild(scoreSpan);
        row.appendChild(header);

        const barContainer = document.createElement('div');
        barContainer.className = 'h-3 overflow-hidden rounded-full bg-base-200';

        const bar = document.createElement('div');
        bar.className = 'h-full bg-secondary transition-all duration-700';
        bar.style.width = `${(score / maxScore) * 100}%`;

        barContainer.appendChild(bar);
        row.appendChild(barContainer);

        scoreAI.appendChild(row);
      });
    }

    // Render CTA section based on P3
    const ctaSection = document.getElementById('result-cta-section');
    if (ctaSection) {
      ctaSection.innerHTML = '';

      const teamSizeLabel =
        ['ยังไม่มี ผมขายเอง', '1–2 คน', '3–9 คน', '10–20 คน', 'มากกว่า 20 คน'][p1 ?? 0] || '';
      const angle = `team-check-${topTopic}`;
      const pathLabel = mainPath === 'team-build' ? 'ปั้นทีมขาย' : 'AI Office ฝ่ายขาย';
      const keyword = `ผลเช็คทีมขาย: ${pathLabel} · เริ่มที่${topicInfo.name} · ทีม ${teamSizeLabel}`;
      const isMobileView = isMobile();

      if (p3 === 0) {
        // ให้ทีมทำเองเป็น → primary "ดูคลาส" + secondary LINE
        const div = document.createElement('div');
        div.className = 'mt-10 space-y-3 rounded-3xl border-2 border-base-content/10 p-8 md:p-10';

        const heading = document.createElement('h3');
        heading.className = 'font-display text-xl font-bold';
        heading.textContent = 'ให้ทีมทำเองเป็น';
        div.appendChild(heading);

        const btnContainer = document.createElement('div');
        btnContainer.className = 'mt-6 flex flex-col gap-3 sm:flex-row';

        const classBtn = document.createElement('a');
        classBtn.href = topicInfo.learnLink || '/services/online-to-sales';
        classBtn.className = 'btn btn-lg flex-1 bg-secondary text-secondary-content';
        classBtn.setAttribute('data-cta-event', 'team-check-learn-class');
        classBtn.textContent = 'ดูคลาสที่สอนเรื่องนี้ →';

        const lineBtn = document.createElement('a');
        lineBtn.href = isMobileView ? buildLineHref(OA_ID, topicInfo.productCode, angle, keyword) : 'https://lin.ee/ioSnSUG';
        lineBtn.target = '_blank';
        lineBtn.rel = 'noopener noreferrer';
        lineBtn.className = 'btn btn-lg flex-1 btn-ghost border-2 border-base-content/25';
        lineBtn.setAttribute('data-cta-event', 'team-check-line-secondary');
        lineBtn.textContent = 'ส่งผลใน LINE';

        btnContainer.appendChild(classBtn);
        btnContainer.appendChild(lineBtn);
        div.appendChild(btnContainer);

        ctaSection.appendChild(div);
      } else if (p3 === 1) {
        // ให้เข้ามาวางให้เลย → primary LINE green + secondary "จองคิวคุยกับผม"
        const div = document.createElement('div');
        div.className = 'mt-10 space-y-3 rounded-3xl border-2 border-base-content/10 p-8 md:p-10';

        const heading = document.createElement('h3');
        heading.className = 'font-display text-xl font-bold';
        heading.textContent = 'ให้มีคนเข้ามาวางให้เลย';
        div.appendChild(heading);

        const desc = document.createElement('p');
        desc.className = 'mt-2 text-base-content/75';
        desc.textContent = 'ส่งผลเข้า LINE ผมจะตรวจแล้วอ่านจัดแพ็กตามโจทย์คุณเอง';
        div.appendChild(desc);

        const btnContainer = document.createElement('div');
        btnContainer.className = 'mt-6 flex flex-col gap-3 sm:flex-row';

        const lineBtn = document.createElement('a');
        lineBtn.href = isMobileView ? buildLineHref(OA_ID, topicInfo.productCode, angle, keyword) : 'https://lin.ee/ioSnSUG';
        lineBtn.target = '_blank';
        lineBtn.rel = 'noopener noreferrer';
        lineBtn.className = 'btn btn-lg flex-1 bg-green-500 text-white hover:bg-green-600';
        lineBtn.setAttribute('data-cta-event', 'team-check-line-primary');
        lineBtn.textContent = 'ส่งผลนี้ให้ปันใน LINE →';

        const bookingBtn = document.createElement('a');
        bookingBtn.href = '/booking';
        bookingBtn.className = 'btn btn-lg flex-1 btn-ghost border-2 border-base-content/25';
        bookingBtn.setAttribute('data-cta-event', 'team-check-booking');
        bookingBtn.textContent = 'จองคิวคุยกับผม';

        btnContainer.appendChild(lineBtn);
        btnContainer.appendChild(bookingBtn);
        div.appendChild(btnContainer);

        ctaSection.appendChild(div);
      } else {
        // ยังไม่แน่ใจ → both buttons, LINE first
        const div = document.createElement('div');
        div.className = 'mt-10 space-y-3 rounded-3xl border-2 border-base-content/10 p-8 md:p-10';

        const heading = document.createElement('h3');
        heading.className = 'font-display text-xl font-bold';
        heading.textContent = 'ยังไม่แน่ใจ';
        div.appendChild(heading);

        const desc = document.createElement('p');
        desc.className = 'mt-2 text-base-content/75';
        desc.textContent = 'ลองทั้งสองวิธี — ส่งผลเข้า LINE หรือจองคิวคุยกับผมเลย';
        div.appendChild(desc);

        const btnContainer = document.createElement('div');
        btnContainer.className = 'mt-6 flex flex-col gap-3 sm:flex-row';

        const lineBtn = document.createElement('a');
        lineBtn.href = isMobileView ? buildLineHref(OA_ID, topicInfo.productCode, angle, keyword) : 'https://lin.ee/ioSnSUG';
        lineBtn.target = '_blank';
        lineBtn.rel = 'noopener noreferrer';
        lineBtn.className = 'btn btn-lg flex-1 bg-green-500 text-white hover:bg-green-600';
        lineBtn.setAttribute('data-cta-event', 'team-check-line-both');
        lineBtn.textContent = 'ส่งผลใน LINE';

        const bookingBtn = document.createElement('a');
        bookingBtn.href = '/booking';
        bookingBtn.className = 'btn btn-lg flex-1 btn-outline';
        bookingBtn.setAttribute('data-cta-event', 'team-check-booking-both');
        bookingBtn.textContent = 'จองคิวคุยกับผม';

        btnContainer.appendChild(lineBtn);
        btnContainer.appendChild(bookingBtn);
        div.appendChild(btnContainer);

        ctaSection.appendChild(div);
      }
    }

    // Track event
    if ((window as unknown as { fbq?: (name: string, type: string, data: Record<string, string>) => void }).fbq) {
      (window as unknown as { fbq: (name: string, type: string, data: Record<string, string>) => void }).fbq(
        'trackCustom',
        'TeamCheckComplete',
        { path: mainPath, topic: topTopic, team_size: String(p1 ?? 0) }
      );
    }
  }

  // Initialize
  loadState();
  renderCurrentQuestion();

  document.getElementById('btn-start')?.addEventListener('click', () => {
    state.currentQuestionIdx = 0;
    showSection('sec-quiz');
  });

  document.getElementById('btn-back')?.addEventListener('click', goBack);

  document.getElementById('btn-reset')?.addEventListener('click', () => {
    state.profileAnswers.fill(null);
    state.symptomAnswers.fill(null);
    state.currentQuestionIdx = 0;
    saveState();
    showSection('sec-intro');
  });
</script>
