---
/**
 * /free/tad-clip — landing page for the free "tad-clip" Claude Code plugin.
 *
 * Funnel: reel → viewer types "ตัดคลิป" (LINE / IG / FB / TikTok) → this page → GitHub.
 * No form. The page exists to build retargeting audiences:
 *   load  → fbq ViewContent + ttq ViewContent
 *   click → fbq trackCustom TadClipGithubClick + ttq ClickButton + sendBeacon to
 *           form-intake /webhook/free-click (CAPI), all three with one event_id.
 * Never `Lead` — free kit = audience, not lead.
 *
 * All copy, links and media paths: src/data/tad-clip.ts
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LineDecisionCTA from '../../components/services/LineDecisionCTA.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../data/site';
import { LINE_QR_IMAGE } from '../../data/service-offer-assets';
import {
  GITHUB_URL,
  META,
  HERO,
  PAINS,
  MECHANISM,
  DEMO,
  NEEDS,
  TOOLS,
  CTA,
  TEAM,
  FAQS,
} from '../../data/tad-clip';

const canonical = `${SITE.url}/free/tad-clip`;
const demoClips = [
  { ...DEMO.before, key: 'before', tag: 'bg-navy text-white' },
  { ...DEMO.after, key: 'after', tag: 'bg-coral text-white' },
];
// one container for every section so left edges line up on desktop
const wrap = 'mx-auto w-full max-w-4xl px-5 sm:px-8';
const h2 = 'font-display text-2xl font-bold text-navy sm:text-3xl';
---

<BaseLayout
  title={META.title}
  description={META.description}
  canonical={canonical}
  ogImage={`${SITE.url}${META.ogImage}`}
  hideFloatingLine={true}
  schema={{
    types: ['WebPage', 'FAQPage', 'BreadcrumbList'],
    title: META.title,
    description: META.description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: META.breadcrumb, url: canonical },
    ],
    faq: FAQS.map((f) => ({ question: f.q, answer: f.a })),
  }}
>
  <div class="min-w-0 overflow-x-clip bg-ivory">
    {/* 1 · belief line */}
    <section id="tc-hero" class="border-b border-sand-deep bg-surface">
      <div class={`${wrap} pb-14 pt-12 sm:pb-20 sm:pt-20`}>
        <p class="text-sm font-bold text-coral">{HERO.eyebrow}</p>
        <h1 class="mt-4 max-w-3xl font-display text-[2.1rem] font-bold leading-[1.22] text-navy text-balance sm:text-5xl sm:leading-[1.18]">
          {
            HERO.belief.map((group, gi) => (
              <Fragment>
                {gi > 0 && ' '}
                {group.map((p) => (
                  <span class={'accent' in p && p.accent ? 'hand-underline' : 'inline-block'}>{p.t}</span>
                ))}
              </Fragment>
            ))
          }
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-warm-ink/80">{HERO.sub}</p>
        <a
          href="#get"
          class="mt-7 inline-flex min-h-11 items-center gap-2 font-semibold text-coral underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral"
        >
          {HERO.skipLink}<span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    {/* 2 · three pains, in the creator's own words */}
    <section aria-labelledby="tc-pains-h" class="py-14 sm:py-20">
      <div class={wrap}>
        <h2 id="tc-pains-h" class={h2}>{PAINS.heading}</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {
            PAINS.quotes.map((quote) => (
              <li class="relative rounded-2xl border border-[#c9c2b2] bg-surface p-6 pt-9">
                <span class="absolute left-5 top-2 font-display text-5xl leading-none text-coral" aria-hidden="true">
                  “
                </span>
                <p class="text-lg leading-8 text-warm-ink text-pretty">{quote}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* 3 · mechanism, one sentence */}
    <section aria-labelledby="tc-how-h" class="border-y border-sand-deep bg-sand py-14 sm:py-20">
      <div class={`${wrap} md:grid md:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] md:items-center md:gap-12`}>
        <div>
          <h2 id="tc-how-h" class="text-sm font-bold text-coral">{MECHANISM.eyebrow}</h2>
          {/* two-message chat: what you send → what comes back (decorative; the sentence says it in words) */}
          <div class="mt-6 max-w-sm space-y-3 rounded-2xl border border-[#c9c2b2] bg-surface p-4 paper-shadow" aria-hidden="true">
            <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-sm bg-navy px-4 py-3 text-white">
              <span class="inline-flex items-center gap-2 rounded-lg bg-white/15 px-2.5 py-1.5 text-sm">
                <Icon name="document-text" size={16} />
                {MECHANISM.fileIn}
              </span>
              <p class="mt-2 font-semibold">{MECHANISM.prompt}</p>
            </div>
            <div class="w-fit max-w-[85%] rounded-2xl rounded-bl-sm border border-[#c9c2b2] bg-ivory px-4 py-3">
              <span class="inline-flex items-center gap-2 rounded-lg border-2 border-coral bg-surface px-2.5 py-1.5 text-sm font-semibold text-navy">
                <Icon name="check-circle" size={16} class="text-coral" />
                {MECHANISM.fileOut}
                <span class="font-normal text-warm-ink/70">{MECHANISM.fileOutNote}</span>
              </span>
            </div>
          </div>
        </div>
        <p class="mt-8 font-display text-xl leading-[1.7] text-navy md:mt-0 sm:text-2xl sm:leading-[1.6]">{MECHANISM.sentence}</p>
      </div>
    </section>

    {/* 4 · before / after */}
    <section aria-labelledby="tc-demo-h" class="py-14 sm:py-20">
      <div class={wrap}>
        <h2 id="tc-demo-h" class={h2}>{DEMO.heading}</h2>
        <div class="mt-8 md:grid md:grid-cols-[minmax(0,34rem)_minmax(0,1fr)] md:items-center md:gap-10">
          <div class="grid grid-cols-2 gap-3 sm:gap-5">
            {
              demoClips.map((clip) => (
                <figure class="min-w-0">
                  <div class="relative aspect-[9/16] overflow-hidden rounded-2xl border border-[#c9c2b2] bg-navy-deep">
                    <video
                      class="absolute inset-0 size-full object-cover"
                      src={clip.src}
                      poster={clip.poster}
                      width="720"
                      height="1280"
                      preload="metadata"
                      muted
                      loop
                      playsinline
                      controls
                      data-demo-video={clip.key}
                      aria-label={clip.alt}
                    />
                    <span class={`pointer-events-none absolute left-2 top-2 rounded-full px-3 py-1 text-xs font-bold sm:left-3 sm:top-3 sm:text-sm ${clip.tag}`}>
                      {clip.label}
                    </span>
                  </div>
                  <button
                    type="button"
                    hidden
                    data-sound-toggle={clip.key}
                    aria-pressed="false"
                    class="group mt-2 inline-flex min-h-11 items-center gap-1.5 rounded-full border border-[#c9c2b2] bg-surface px-3 text-sm font-semibold text-navy transition-transform active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy motion-reduce:transition-none"
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="group-aria-pressed:hidden">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75 19.5 12m0 0 2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6 4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                    </svg>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="hidden group-aria-pressed:block">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
                    </svg>
                    <span>{clip.sound}</span>
                  </button>
                  <figcaption class="mt-2 text-sm leading-6 text-warm-ink/80 sm:text-base sm:leading-7">{clip.caption}</figcaption>
                </figure>
              ))
            }
          </div>
          <div class="mt-8 md:mt-0">
            <div class="rounded-2xl border border-[#c9c2b2] bg-surface p-5">
              <p class="font-semibold leading-7 text-navy">{DEMO.stat}</p>
              <p class="mt-3 leading-7 text-warm-ink/80">{DEMO.disclosure}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 5 · need / don't pay */}
    <section aria-labelledby="tc-need-h" class="border-y border-sand-deep bg-sand py-14 sm:py-20">
      <div class={wrap}>
        <h2 id="tc-need-h" class={h2}>{NEEDS.heading}</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-[#c9c2b2] bg-surface p-6">
            <h3 class="font-display text-xl font-bold text-navy">{NEEDS.haveTitle}</h3>
            <ul class="mt-4 space-y-3">
              {
                NEEDS.have.map((item) => (
                  <li class="flex gap-3 leading-7 text-warm-ink">
                    <Icon name="check-circle" size={22} class="mt-0.5 shrink-0 text-navy" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-2xl border-2 border-coral bg-surface p-6 paper-shadow">
            <h3 class="font-display text-xl font-bold text-coral">{NEEDS.skipTitle}</h3>
            <ul class="mt-4 space-y-3">
              {
                NEEDS.skip.map((item) => (
                  <li class="flex gap-3 leading-7 text-warm-ink">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 shrink-0 text-coral" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* 6 · tool names as proof */}
    <section aria-labelledby="tc-tools-h" class="py-14 sm:py-20">
      <div class={wrap}>
        <h2 id="tc-tools-h" class={h2}>{TOOLS.heading}</h2>
        <p class="mt-3 max-w-2xl leading-7 text-warm-ink/80">{TOOLS.intro}</p>
        <dl class="mt-8 grid gap-x-10 border-t border-[#c9c2b2] sm:grid-cols-2">
          {
            TOOLS.items.map((tool) => (
              <div class="border-b border-[#c9c2b2] py-4">
                <dt class="font-semibold text-navy">{tool.name}</dt>
                <dd class="mt-1 leading-7 text-warm-ink/80">{tool.does}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-6 leading-7 text-warm-ink/80">{TOOLS.proof}</p>
        <p class="mt-2 text-sm text-warm-ink/70">{TOOLS.credit}</p>
      </div>
    </section>

    {/* 7 · primary CTA */}
    <section id="get" aria-labelledby="tc-get-h" class="scroll-mt-20 border-y border-sand-deep bg-surface py-16 sm:py-24">
      <div class={`${wrap} text-center`}>
        <h2 id="tc-get-h" class="font-display text-3xl font-bold text-navy sm:text-4xl">{CTA.heading}</h2>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener"
          data-tadclip-github="main"
          class="mt-8 inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-full bg-coral px-8 text-lg font-bold text-white transition-[transform,background-color] duration-100 hover:bg-navy active:scale-[0.97] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral motion-reduce:transition-none sm:w-auto"
        >
          <svg viewBox="0 0 16 16" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          {CTA.button}
          <span class="sr-only">(เปิดในแท็บใหม่)</span>
        </a>
        <p class="mx-auto mt-5 max-w-xl leading-7 text-warm-ink/80">{CTA.note}</p>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-warm-ink/70 md:hidden">{CTA.mobileNote}</p>
      </div>
    </section>

    {/* 8 · secondary CTA — LINE, "เล่าโจทย์มา" */}
    <div class="py-14 sm:py-20">
      <div class={`${wrap} [&_p.uppercase]:tracking-normal`}>
        <LineDecisionCTA
          location={TEAM.location}
          headline={TEAM.headline}
          copy={TEAM.copy}
          lineLabel={TEAM.lineLabel}
          eyebrow={TEAM.eyebrow}
          desktopQr={LINE_QR_IMAGE}
        />
      </div>
    </div>

    {/* 9 · FAQ */}
    <section id="faq" aria-labelledby="tc-faq-h" class="scroll-mt-20 border-t border-sand-deep bg-sand py-14 sm:py-20">
      <div class={wrap}>
        <h2 id="tc-faq-h" class={h2}>คำถามที่ถามบ่อย</h2>
        <div class="mt-8 space-y-3">
          {
            FAQS.map((faq, index) => (
              <details class="group overflow-hidden rounded-2xl border border-[#c9c2b2] bg-surface" open={index === 0}>
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 p-5 font-display text-lg font-bold text-navy [&::-webkit-details-marker]:hidden">
                  <span>{faq.q}</span>
                  <span class="shrink-0 font-body text-2xl font-normal leading-none text-coral transition-transform group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</span>
                </summary>
                <div class="border-t border-sand-deep px-5 pb-5 pt-4 leading-7 text-warm-ink/85">
                  <p>{faq.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* sticky GitHub CTA on phones: only between the hero and #get, so it never covers the LINE CTA, FAQ or footer */}
  <div
    id="tc-sticky"
    data-hidden="true"
    inert
    class="fixed inset-x-0 bottom-0 z-30 border-t border-[#c9c2b2] bg-surface px-4 pt-3 transition-[transform,visibility] duration-200 data-[hidden=true]:invisible data-[hidden=true]:pointer-events-none data-[hidden=true]:translate-y-full motion-reduce:transition-none md:hidden"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))"
  >
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noopener"
      tabindex="-1"
      data-tadclip-github="sticky"
      class="flex min-h-12 w-full items-center justify-center rounded-full bg-coral px-6 font-bold text-white active:scale-[0.97]"
    >
      {CTA.button}
      <span class="sr-only">(เปิดในแท็บใหม่)</span>
    </a>
  </div>

  {/* LINE buttons on this page open the chat prefilled with "<keyword> [WEB]" on phones (src/scripts/line-prefill.ts) */}
  <div data-line-close data-line-keyword={TEAM.lineKeyword} hidden></div>
</BaseLayout>

<script>
  import { FREE_CLICK_BEACON_URL, TAD_CLIP_SLUG } from '../../data/tad-clip';

  type Attribution = Record<string, string | number | undefined>;
  type Win = Window & {
    fbq?: (...args: unknown[]) => void;
    ttq?: { track?: (...args: unknown[]) => void };
    pnAttribution?: Attribution;
  };
  const w = window as Win;

  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'] as const;

  function cookie(name: string): string | undefined {
    const match = document.cookie.match(new RegExp(`(?:^|;\\s*)${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : undefined;
  }

  /** BaseLayout stores utm_* + fbclid in window.pnAttribution (localStorage `pn_attribution`, 14-day TTL). */
  function storedAttribution(): Attribution {
    if (w.pnAttribution) return w.pnAttribution;
    try {
      const parsed = JSON.parse(localStorage.getItem('pn_attribution') || 'null') as Attribution | null;
      if (parsed && Number(parsed.expires) > Date.now()) return parsed;
    } catch {
      /* storage blocked */
    }
    return {};
  }

  /** _fbc missing (pixel blocked, or it never ran) → rebuild it from the stored fbclid: fb.1.<ms>.<fbclid> */
  function fbcFromStoredFbclid(): string | undefined {
    const attr = storedAttribution();
    const fbclid = typeof attr.fbclid === 'string' ? attr.fbclid : '';
    if (!fbclid) return undefined;
    // last_seen = when BaseLayout last wrote attribution from a URL that carried the click id
    const capturedAt = Date.parse(String(attr.last_seen || attr.first_seen || '')) || Date.now();
    return `fb.1.${capturedAt}.${fbclid}`;
  }

  function utmParams(): Record<string, string> {
    const attr = storedAttribution();
    const query = new URLSearchParams(location.search);
    const out: Record<string, string> = {};
    for (const key of UTM_KEYS) {
      const value = query.get(key) || attr[key];
      if (value) out[key] = String(value);
    }
    return out;
  }

  function newEventId(): string {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    const b = crypto.getRandomValues(new Uint8Array(16));
    b[6] = (b[6] & 0x0f) | 0x40;
    b[8] = (b[8] & 0x3f) | 0x80;
    const h = Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
    return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
  }

  // ── on load: ViewContent (PageView already fired by BaseLayout) ──
  try {
    w.fbq?.('track', 'ViewContent', { content_name: TAD_CLIP_SLUG, content_category: 'free-kit' });
  } catch {}
  try {
    w.ttq?.track?.('ViewContent', {
      content_id: TAD_CLIP_SLUG,
      contents: [{ content_id: TAD_CLIP_SLUG, content_type: 'product', content_name: TAD_CLIP_SLUG }],
    });
  } catch {}

  // ── GitHub click: browser pixels + server beacon share one event_id; the link opens on its own ──
  function onGithubClick(event: MouseEvent): void {
    if (event.type === 'auxclick' && event.button !== 1) return; // middle-click opens a tab; right-click does not
    const link = event.target instanceof Element ? event.target.closest('a[data-tadclip-github]') : null;
    if (!link) return;
    const id = newEventId();
    try {
      w.fbq?.('trackCustom', 'TadClipGithubClick', { content_name: TAD_CLIP_SLUG }, { eventID: id });
    } catch {}
    try {
      w.ttq?.track?.('ClickButton', { content_id: TAD_CLIP_SLUG }, { event_id: id });
    } catch {}
    try {
      const body = JSON.stringify({
        event_name: 'TadClipGithubClick',
        event_id: id,
        asset_slug: TAD_CLIP_SLUG,
        page_url: location.href,
        fbp: cookie('_fbp'),
        fbc: cookie('_fbc') || fbcFromStoredFbclid(),
        utm: utmParams(),
      });
      navigator.sendBeacon?.(FREE_CLICK_BEACON_URL, new Blob([body], { type: 'text/plain' }));
    } catch {}
  }
  document.addEventListener('click', onGithubClick);
  document.addEventListener('auxclick', onGithubClick);

  // ── demo videos: play while on screen, one sound at a time, respect reduced motion ──
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-demo-video]'));
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-sound-toggle]'));

  function setSound(target: HTMLVideoElement | null): void {
    for (const video of videos) {
      const on = video === target;
      video.muted = !on;
      const btn = toggles.find((b) => b.dataset.soundToggle === video.dataset.demoVideo);
      if (!btn) continue;
      btn.setAttribute('aria-pressed', String(on));
    }
  }

  // Autoplay can still be refused (iOS Low Power Mode, data saver, strict webviews):
  // hand the native controls back so the clip is never a dead poster.
  const play = (video: HTMLVideoElement) =>
    video.play().catch(() => {
      video.controls = true;
    });

  if (!reduceMotion) {
    for (const video of videos) video.controls = false;
    for (const btn of toggles) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const video = videos.find((v) => v.dataset.demoVideo === btn.dataset.soundToggle) || null;
        if (!video) return;
        setSound(video.muted ? video : null);
        if (!video.muted) void play(video);
      });
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) void play(video);
            else video.pause();
          }
        },
        { threshold: 0.35 },
      );
      for (const video of videos) io.observe(video);
    } else {
      for (const video of videos) void play(video);
    }
  }

  // ── sticky CTA (phones): visible only between the hero and #get ──
  const sticky = document.getElementById('tc-sticky');
  const hero = document.getElementById('tc-hero');
  const get = document.getElementById('get');
  if (sticky && hero && get) {
    const stickyLink = sticky.querySelector('a');
    // Measured on every scroll instead of IntersectionObserver: jumping from the footer back
    // above #get never changes #get's intersection, so an observer would leave the bar hidden.
    const update = () => {
      const heroOnScreen = hero.getBoundingClientRect().bottom > 0;
      const getReached = get.getBoundingClientRect().top < window.innerHeight; // on screen or scrolled past
      const hide = heroOnScreen || getReached;
      if (sticky.dataset.hidden === String(hide)) return;
      sticky.dataset.hidden = String(hide);
      sticky.toggleAttribute('inert', hide);
      stickyLink?.setAttribute('tabindex', hide ? '-1' : '0');
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>
