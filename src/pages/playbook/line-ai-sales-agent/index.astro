---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="LINE AI Sales Agent Playbook"
  description="คู่มือทำตามทีละขั้นสำหรับสร้าง LINE AI Agent ที่ช่วยปิดการขายได้จริง โดย @pun_nattapatch"
  noindex={false}
>
  <div id="line-ai-sales-agent-app" class="line-ai-sales-agent-app">
    <noscript>
      <div class="no-script-message">Playbook นี้ต้องเปิด JavaScript เพื่อบันทึก checklist และแสดงเนื้อหาตามขั้น</div>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { playbook } from '../../../data/line-ai-sales-agent/playbook.js';
  import { createPlaybookEngine } from '../../../scripts/line-ai-sales-agent/app.js';
  import { mountPlaybook } from '../../../scripts/line-ai-sales-agent/ui.js';

  const root = document.querySelector('#line-ai-sales-agent-app');
  if (root) {
    document.documentElement.dataset.lineAiSalesAgent = 'true';
    document.querySelectorAll('.site-nav, .menu-mobile, body > footer').forEach((element) => {
      element.setAttribute('hidden', '');
    });
    const engine = createPlaybookEngine({ playbook });
    mountPlaybook({ root, playbook, engine });
  }
</script>

<style is:global>
  :global(html[data-line-ai-sales-agent='true'] body) {
    background-color: #f4f1ea;
    background-image: none;
  }

  :global(html[data-line-ai-sales-agent='true'] .site-nav),
  :global(html[data-line-ai-sales-agent='true'] .menu-mobile),
  :global(html[data-line-ai-sales-agent='true'] body > footer) {
    display: none;
  }

  :global(html[data-line-ai-sales-agent='true'] #main) {
    margin: 0;
  }

  .line-ai-sales-agent-app {
    --app-ink: #1e1b16;
    --app-navy: #072b4e;
    --app-navy-deep: #00162f;
    --app-coral: #dd4155;
    --app-paper: #f4f1ea;
    --app-surface: #fcf9f2;
    --app-sand: #ece6da;
    --app-border: #c9c2b2;
    --app-muted: #746d63;
    --app-radius: 14px;
    /* Site typography tokens (src/styles/global.css @theme) — the Playbook
       inherits the same Trirong + Sarabun pairing as the rest of the site. */
    --pb-display: var(--font-display, "Trirong", "Noto Serif", serif);
    --pb-body: var(--font-body, "Sarabun", "IBM Plex Sans Thai", sans-serif);
    min-height: 100vh;
    color: var(--app-ink);
    font-family: var(--pb-body);
    font-size: 16px;
    line-height: 1.55;
    overflow-x: hidden;
  }

  .line-ai-sales-agent-app * { box-sizing: border-box; }
  .line-ai-sales-agent-app button,
  .line-ai-sales-agent-app input { font: inherit; }
  .line-ai-sales-agent-app button { cursor: pointer; }
  .line-ai-sales-agent-app button:disabled { cursor: not-allowed; opacity: 0.5; }
  .line-ai-sales-agent-app :focus-visible { outline: 3px solid var(--app-coral); outline-offset: 3px; }
  .line-ai-sales-agent-app h1,
  .line-ai-sales-agent-app h2,
  .line-ai-sales-agent-app h3,
  .line-ai-sales-agent-app .rail-brand { font-family: var(--pb-display); }

  .visually-hidden {
    border: 0; clip: rect(0 0 0 0); height: 1px; margin: -1px; overflow: hidden;
    padding: 0; position: absolute; white-space: nowrap; width: 1px;
  }

  .no-script-message { margin: 2rem auto; max-width: 40rem; border: 1px solid var(--app-coral); padding: 1rem; background: var(--app-surface); }
  .playbook-app { min-height: 100vh; }
  .playbook-layout { display: grid; grid-template-columns: 248px minmax(0, 1fr) 286px; min-height: 100vh; }

  .phase-rail {
    background: var(--app-navy);
    color: var(--app-paper);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 1.8rem 1.1rem 1.2rem;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .rail-kicker { color: #a9c0cf; font-size: 0.68rem; letter-spacing: 0.16em; margin: 0 0 1.4rem; }
  .rail-brand { align-items: center; color: var(--app-paper); display: flex; gap: 0.65rem; text-decoration: none; }
  .rail-brand strong, .mobile-brand strong { display: block; font-size: 0.86rem; letter-spacing: 0.04em; line-height: 1; }
  .rail-brand small, .mobile-brand small { color: #aac1cf; display: block; font-family: var(--pb-body); font-size: 0.76rem; margin-top: 0.16rem; }
  .rail-mark { align-items: center; background: var(--app-coral); color: #fff; display: inline-flex; flex: 0 0 auto; font-family: var(--pb-body); font-size: 1.15rem; font-weight: 700; height: 2.45rem; justify-content: center; width: 2.45rem; }
  .rail-rule { border-top: 1px solid rgba(244, 241, 234, 0.2); margin: 1.6rem 0 1.1rem; }
  .phase-list { display: grid; gap: 0.35rem; }
  .phase-item { align-items: start; border-left: 3px solid transparent; color: #c4d3dc; display: grid; gap: 0.65rem; grid-template-columns: 1.7rem minmax(0, 1fr) 1.2rem; padding: 0.8rem 0.45rem 0.8rem 0.7rem; text-decoration: none; transition: background 160ms ease, border-color 160ms ease; }
  .phase-item:hover, .phase-item.is-active { background: rgba(252, 249, 242, 0.1); border-left-color: var(--phase-color); color: #fff; }
  .phase-number { color: var(--phase-color, #a9c0cf); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; padding-top: 0.16rem; }
  .phase-copy { min-width: 0; }
  .phase-copy strong { display: block; font-size: 0.84rem; letter-spacing: 0.08em; }
  .phase-copy small { color: inherit; display: block; font-family: var(--pb-body); font-size: 0.74rem; line-height: 1.4; margin-top: 0.2rem; opacity: 0.8; }
  .phase-copy em { color: #8aa9ba; display: block; font-family: var(--pb-body); font-size: 0.68rem; font-style: normal; margin-top: 0.32rem; }
  .phase-state { align-items: center; border: 1px solid rgba(244, 241, 234, 0.32); border-radius: 50%; color: var(--phase-color); display: flex; font-size: 0.72rem; height: 1.1rem; justify-content: center; margin-top: 0.18rem; width: 1.1rem; }
  .phase-state.is-done { background: var(--phase-color); border-color: var(--phase-color); color: #fff; }
  .rail-bottom { margin-top: auto; }
  .rail-utility { background: transparent; border: 0; color: #b4c7d2; display: block; font-size: 0.78rem; padding: 0.45rem 0; text-align: left; width: 100%; }
  .rail-utility:hover { color: #fff; }
  .rail-utility span { color: var(--app-coral); display: inline-block; font-size: 1rem; margin-right: 0.5rem; width: 1.1rem; }
  .rail-byline { border-top: 1px solid rgba(244, 241, 234, 0.16); color: #8ba8b8; font-size: 0.72rem; line-height: 1.5; margin: 1.2rem 0 0; padding-top: 1rem; }
  .rail-byline strong { color: var(--app-paper); font-family: var(--pb-body); }

  .playbook-main { min-width: 0; padding: 0 clamp(1.1rem, 3vw, 3.5rem) 4rem; }
  .app-topbar { align-items: center; border-bottom: 1px solid var(--app-border); display: flex; justify-content: space-between; min-height: 4.1rem; padding: 0.7rem 0; }
  .breadcrumb { align-items: center; display: flex; flex-wrap: wrap; gap: 0.65rem; font-family: var(--pb-body); font-size: 0.76rem; letter-spacing: 0.08em; }
  .breadcrumb span:first-child { color: var(--app-muted); }
  .breadcrumb-slash { color: var(--app-coral); }
  .topbar-actions { align-items: center; display: flex; gap: 0.75rem; }
  .save-status { color: var(--app-muted); font-size: 0.72rem; }
  .text-button, .mini-link { background: transparent; border: 0; color: var(--app-navy); font-size: 0.76rem; font-weight: 700; min-height: 2.75rem; padding: 0.35rem 0; }
  .text-button:hover, .mini-link:hover { color: var(--app-coral); }
  .mobile-header, .mobile-bottom-nav { display: none; }

  .view { max-width: 920px; padding: clamp(2rem, 4vw, 4.2rem) 0 1rem; }
  .home-view { display: grid; gap: 2.7rem; grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr); }
  .home-intro { align-self: end; padding: 1rem 0 0; }
  .eyebrow { color: var(--app-muted); display: inline-block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; line-height: 1.4; }
  .eyebrow.coral { color: var(--app-coral); }
  .home-intro h1 { color: var(--app-navy); font-size: clamp(2.4rem, 5vw, 4.65rem); letter-spacing: -0.01em; line-height: 1.06; margin: 1rem 0 1.25rem; }
  .home-intro h1 span { color: var(--app-coral); display: block; }
  .home-lead { color: #4d4a44; font-size: 1.05rem; line-height: 1.8; max-width: 31rem; }
  .home-meta { align-items: center; color: var(--app-muted); display: flex; flex-wrap: wrap; font-size: 0.76rem; gap: 0.7rem; margin-top: 1.6rem; }
  .meta-divider { background: var(--app-coral); display: inline-block; height: 0.35rem; width: 0.35rem; }
  .home-action-panel { align-self: end; background: var(--app-navy); color: var(--app-paper); padding: 1.5rem; position: relative; }
  .action-panel-top, .utility-heading, .section-heading, .phase-progress-head, .phase-progress-foot, .prompt-output-head, .step-overline, .step-nav, .step-meta, .milestone-panel, .trouble-card-top, .trouble-actions { align-items: center; display: flex; justify-content: space-between; gap: 0.8rem; }
  .home-action-panel .eyebrow { color: #a9c0cf; }
  .stamp { border: 1px solid var(--app-coral); color: #ffafba; font-size: 0.68rem; letter-spacing: 0.08em; padding: 0.25rem 0.4rem; transform: rotate(-2deg); }
  .home-action-panel h2 { font-size: 1.55rem; line-height: 1.25; margin: 2.2rem 0 0.65rem; }
  .home-action-panel p { color: #c6d4db; font-size: 0.86rem; line-height: 1.7; margin: 0 0 1.3rem; }
  .primary-button, .secondary-button, .danger-button { align-items: center; border: 1px solid transparent; display: inline-flex; font-family: var(--pb-body); font-size: 0.82rem; font-weight: 700; gap: 0.65rem; justify-content: center; min-height: 2.9rem; padding: 0.65rem 1rem; text-decoration: none; transition: background 150ms ease, color 150ms ease, border-color 150ms ease; }
  .primary-button { background: var(--app-coral); color: #fff; }
  .primary-button:hover { background: #c43245; }
  .primary-button.compact, .secondary-button.compact { min-height: 2.75rem; padding: 0.48rem 0.75rem; }
  .secondary-button { background: var(--app-surface); border-color: var(--app-border); color: var(--app-navy); }
  .secondary-button:hover { border-color: var(--app-navy); }
  .danger-button { background: transparent; border-color: #d5a2a9; color: var(--app-coral); }
  .danger-button:hover { background: #f9e0e4; }
  .home-action-panel .primary-button { background: #f6a0aa; color: var(--app-navy-deep); }
  .home-action-panel .primary-button:hover { background: #fff; }

  .home-section { grid-column: 1 / -1; }
  .home-section .section-heading { align-items: end; border-bottom: 1px solid var(--app-border); padding-bottom: 0.7rem; }
  .section-heading h2, .step-section h2, .shop-fields h2 { color: var(--app-navy); font-family: var(--pb-display); font-size: 1.35rem; letter-spacing: -0.01em; line-height: 1.25; margin: 0.35rem 0 0; }
  .section-note, .section-intro { color: var(--app-muted); font-size: 0.8rem; }
  .journey-line { align-items: stretch; display: flex; gap: 0.45rem; justify-content: space-between; padding: 1.2rem 0 0; }
  .journey-node { background: transparent; border: 0; border-top: 4px solid var(--phase-color); color: var(--app-ink); flex: 1; min-width: 0; padding: 0.8rem 0.4rem 0.3rem; text-align: left; }
  .journey-node:hover { background: var(--phase-soft); }
  .journey-node-number { color: var(--phase-color); display: block; font-family: var(--pb-body); font-size: 0.8rem; font-weight: 700; }
  .journey-node strong { display: block; font-size: 0.9rem; letter-spacing: 0.07em; margin-top: 0.25rem; }
  .journey-node small { color: var(--app-muted); display: block; font-size: 0.73rem; line-height: 1.5; margin-top: 0.25rem; }
  .journey-node em { color: var(--phase-color); display: block; font-size: 0.68rem; font-style: normal; font-weight: 700; margin-top: 0.55rem; }
  .journey-connector { align-self: center; color: var(--app-border); font-size: 1.4rem; }
  .architecture-flow { align-items: center; display: grid; gap: 0.7rem; grid-template-columns: 1fr auto 1fr auto 1fr; padding-top: 1.4rem; }
  .architecture-node { background: var(--app-surface); border: 1px solid var(--app-border); min-height: 9rem; padding: 1.1rem; }
  .architecture-node.featured { background: var(--app-navy); border-color: var(--app-navy); color: var(--app-paper); }
  .architecture-label { color: var(--app-coral); display: block; font-family: var(--pb-body); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; }
  .architecture-node strong { display: block; font-size: 1rem; margin-top: 1.1rem; }
  .architecture-node small { color: var(--app-muted); display: block; font-size: 0.76rem; line-height: 1.55; margin-top: 0.3rem; }
  .architecture-node.featured small { color: #c5d2d9; }
  .architecture-arrow { color: var(--app-coral); font-family: var(--pb-body); font-size: 1.3rem; }
  .rule-list { display: grid; gap: 0.7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-top: 1rem; }
  .rule-list > div { align-items: start; border-bottom: 1px solid var(--app-border); display: flex; gap: 0.8rem; padding: 0.8rem 0; }
  .rule-list > div > span { color: var(--app-coral); font-family: var(--pb-body); font-size: 0.75rem; font-weight: 700; }
  .rule-list p { margin: 0; }
  .rule-list strong, .rule-list small { display: block; }
  .rule-list strong { font-size: 0.9rem; }
  .rule-list small { color: var(--app-muted); font-size: 0.76rem; line-height: 1.5; margin-top: 0.2rem; }

  .utility-rail { background: var(--app-sand); border-left: 1px solid var(--app-border); min-height: 100vh; padding: 1.35rem 1.1rem; }
  .utility-section { border-bottom: 1px solid var(--app-border); padding: 0.5rem 0 1.35rem; }
  .utility-section + .utility-section { padding-top: 1.25rem; }
  .utility-heading { color: var(--app-muted); font-family: var(--pb-body); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .search-key { border: 1px solid var(--app-border); font-family: var(--pb-body); font-size: 0.64rem; padding: 0.15rem 0.3rem; text-transform: none; }
  .utility-progress-row { align-items: center; display: flex; gap: 0.9rem; padding-top: 0.9rem; }
  .utility-progress-row strong, .utility-progress-row span, .utility-progress-row small { display: block; }
  .utility-progress-row strong { color: var(--app-navy); font-family: var(--pb-display); font-size: 1.35rem; line-height: 1.1; }
  .utility-progress-row span { color: var(--app-muted); font-size: 0.72rem; margin-top: 0.15rem; }
  .utility-progress-row small { color: var(--app-coral); font-size: 0.7rem; margin-top: 0.5rem; }
  .progress-ring { --ring-track: var(--app-border); --ring-progress: var(--app-coral); align-items: center; border-radius: 50%; display: flex; height: 4.4rem; justify-content: center; position: relative; width: 4.4rem; }
  .progress-ring svg { height: 100%; inset: 0; position: absolute; width: 100%; }
  .progress-ring circle { fill: none; stroke-width: 4; }
  .progress-ring-track { stroke: var(--ring-track); }
  .progress-ring-value { stroke: var(--ring-progress); stroke-linecap: square; }
  .progress-ring__inner { align-items: center; display: flex; flex-direction: column; position: relative; z-index: 1; }
  .progress-ring__inner strong { color: var(--app-navy); font-family: var(--pb-display); font-size: 0.9rem; line-height: 1; }
  .progress-ring__inner span { color: var(--app-muted); font-size: 0.53rem; line-height: 1; margin-top: 0.2rem; }
  .resume-card p { color: var(--app-coral); font-size: 0.78rem; margin: 0.8rem 0 0.35rem; }
  .resume-card > strong { color: var(--app-navy); display: block; font-family: var(--pb-display); font-size: 0.95rem; line-height: 1.35; }
  .resume-card .primary-button { margin-top: 0.9rem; width: 100%; }
  .search-field { align-items: center; background: var(--app-surface); border: 1px solid var(--app-border); display: flex; gap: 0.4rem; margin-top: 0.8rem; min-height: 2.65rem; padding: 0 0.55rem; }
  .search-field > span { color: var(--app-coral); font-size: 1.2rem; }
  .search-field input { background: transparent; border: 0; color: var(--app-ink); min-width: 0; outline: 0; width: 100%; }
  .search-field input::placeholder { color: #9d968a; }
  .search-field kbd { border: 1px solid var(--app-border); color: var(--app-muted); font-size: 0.62rem; padding: 0.08rem 0.2rem; }
  .search-filters { display: grid; gap: 0.35rem; grid-template-columns: 1fr 1fr 1fr; margin-top: 0.45rem; }
  .search-filters select { background: var(--app-surface); border: 1px solid var(--app-border); color: var(--app-muted); font-size: 0.65rem; min-height: 2.3rem; min-width: 0; padding: 0.25rem; }
  .search-results { max-height: 15rem; overflow: auto; }
  .search-result-count, .search-empty { color: var(--app-muted); font-size: 0.7rem; margin: 0.7rem 0 0.4rem; }
  .search-result { background: transparent; border: 0; border-bottom: 1px solid var(--app-border); display: block; padding: 0.55rem 0; text-align: left; width: 100%; }
  .search-result:hover { background: var(--app-surface); }
  .search-result span, .search-result strong, .search-result small { display: block; }
  .search-result span { color: var(--app-coral); font-family: var(--pb-body); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; }
  .search-result strong { color: var(--app-navy); font-size: 0.77rem; line-height: 1.35; margin-top: 0.14rem; }
  .search-result small { color: var(--app-muted); font-size: 0.69rem; line-height: 1.4; margin-top: 0.15rem; }
  .safety-note { align-items: start; display: flex; gap: 0.65rem; }
  .safety-icon { align-items: center; background: var(--app-coral); color: #fff; display: inline-flex; flex: 0 0 auto; font-family: var(--pb-body); font-weight: 700; height: 1.4rem; justify-content: center; width: 1.4rem; }
  .safety-note strong { color: var(--app-navy); display: block; font-family: var(--pb-body); font-size: 0.78rem; }
  .safety-note p { color: var(--app-muted); font-size: 0.7rem; line-height: 1.5; margin: 0.25rem 0 0; }

  .step-view { --step-border: var(--app-border); max-width: 890px; }
  .step-hero { border-bottom: 1px solid var(--step-border); padding-bottom: 1.8rem; }
  .step-overline { justify-content: start; }
  .step-number { background: var(--phase-soft); color: var(--phase-color); font-family: var(--pb-body); font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.5rem; }
  .step-phase { color: var(--app-muted); font-family: var(--pb-body); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; }
  .block-button { background: transparent; border: 1px solid var(--app-border); color: var(--app-muted); font-family: var(--pb-body); font-size: 0.65rem; min-height: 2.75rem; padding: 0.35rem 0.55rem; }
  .block-button:hover, .block-button.is-blocked { border-color: var(--app-coral); color: var(--app-coral); }
  .status-pill { align-items: center; background: var(--app-sand); color: var(--app-muted); display: inline-flex; font-family: var(--pb-body); font-size: 0.67rem; font-weight: 700; gap: 0.35rem; margin-left: auto; padding: 0.28rem 0.45rem; }
  .status-dot { background: currentColor; border-radius: 50%; height: 0.38rem; width: 0.38rem; }
  .status-working { background: #e4f0e5; color: #2f7d5b; }
  .status-in-progress { background: #e8eef2; color: var(--app-navy); }
  .status-needs-attention { background: #f9e0e4; color: var(--app-coral); }
  .step-hero h1 { color: var(--app-navy); font-family: var(--pb-display); font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -0.01em; line-height: 1.08; margin: 1.35rem 0 1rem; max-width: 46rem; }
  .step-meta { align-items: start; border-left: 3px solid var(--phase-color); flex-direction: column; gap: 0.18rem; padding-left: 0.8rem; }
  .step-meta span { color: var(--app-muted); font-size: 0.7rem; }
  .step-meta strong { color: var(--app-ink); font-size: 0.86rem; font-weight: 500; line-height: 1.55; }
  .dependency-warning { align-items: center; background: #fff3e7; border: 1px solid #e7c5a8; display: flex; gap: 0.65rem; margin: 1.2rem 0; padding: 0.75rem 0.85rem; }
  .warning-mark { align-items: center; background: #d06442; color: #fff; display: inline-flex; flex: 0 0 auto; font-family: var(--pb-body); font-weight: 700; height: 1.45rem; justify-content: center; width: 1.45rem; }
  .dependency-warning strong { color: #9a4a2f; display: block; font-family: var(--pb-body); font-size: 0.75rem; }
  .dependency-warning p { color: #795d4a; font-size: 0.7rem; line-height: 1.45; margin: 0.12rem 0 0; }
  .dependency-warning .mini-link { margin-left: auto; white-space: nowrap; }
  .why-panel { background: var(--app-navy); color: var(--app-paper); margin: 1.6rem 0; padding: 1.4rem 1.5rem; }
  .why-panel .eyebrow { color: #a9c0cf; }
  .why-panel p { font-family: var(--pb-display); font-size: 1.25rem; line-height: 1.5; margin: 0.65rem 0 0.85rem; max-width: 44rem; }
  .dependency-line { color: #b9cbd4; font-size: 0.74rem; }
  .dependency-line strong { color: #fff; }
  .dependency-line span { color: var(--app-coral); margin: 0 0.5rem; }
  .step-section, .shop-fields { border-bottom: 1px solid var(--step-border); padding: 1.6rem 0 1.9rem; }
  .compact-heading { align-items: end; }
  .completion-count, .field-safe { color: var(--app-coral); font-size: 0.72rem; font-weight: 700; }
