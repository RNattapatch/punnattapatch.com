---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferCard from '../components/services/OfferCard.astro';
import OfferChooser from '../components/services/OfferChooser.astro';
import AdvanceProgramStrip from '../components/services/AdvanceProgramStrip.astro';
import LineDecisionCTA from '../components/services/LineDecisionCTA.astro';
import { SERVICE_OFFERS } from '../data/service-offers';
import { LINE_QR_IMAGE, OFFER_ASSET_BY_CODE } from '../data/service-offer-assets';
import { fmtPrice } from '../data/pricing.mjs';

const offerByCode = Object.fromEntries(SERVICE_OFFERS.map((offer) => [offer.code, offer]));
const paidCodes = ['T2', 'T1', 'T3', 'C1', 'I1'] as const;
---

<BaseLayout title="Services component preview" noindex={true} hideFloatingLine={true}>
  <section class="border-b border-sand-deep bg-sand">
      <div class="mx-auto max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-coral">Temporary Phase 3 preview</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-navy">Reusable services components</h1>
      </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-5 py-12 sm:px-8 lg:px-10">
      <div class="grid gap-6 lg:grid-cols-2">
        {paidCodes.map((code) => {
          const offer = offerByCode[code];
          return <OfferCard offer={offer} image={OFFER_ASSET_BY_CODE[code]} featured={code === 'T2'} priceLabel={fmtPrice(offer.pricingKey!)} eagerImage={code === 'T2'} />;
        })}
      </div>
  </section>

  <section class="mx-auto max-w-[1180px] px-5 pb-12 sm:px-8 lg:px-10">
      <AdvanceProgramStrip offer={offerByCode.A1} image={OFFER_ASSET_BY_CODE.A1} />
  </section>

  <section class="mx-auto max-w-[1180px] px-5 pb-12 sm:px-8 lg:px-10">
      <OfferChooser />
  </section>

  <section class="mx-auto max-w-[1180px] px-5 pb-16 sm:px-8 lg:px-10">
      <LineDecisionCTA
        location="services_final_cta"
        headline="ยังไม่แน่ใจว่าควรเริ่มจากคอร์สหรือวางระบบ?"
        copy="เล่าสถานการณ์ทีมขายสั้น ๆ ให้ผมฟัง แล้วผมช่วยชี้ทางที่เหมาะกับจุดที่ทีมกำลังติดอยู่"
        desktopQr={LINE_QR_IMAGE}
      />
  </section>
</BaseLayout>
