---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import promptRaw from '../data/nissan-prompt.txt?raw';

const title = 'ของขวัญจากงาน Nissan Sale Manager Conference 2026 — AI Image Prompt Generator';
const description =
  'Welcome ผู้เข้าร่วมงาน Nissan Sale Manager Conference 2026 — รับเครื่องมือเขียน prompt ทำภาพด้วย AI ระดับเอเจนซี ฟรีจากปัน ณัฐพัชร์';

const EXAMPLES = [
  {
    id: 'kicks',
    img: '/images/nissan/textad-kicks.jpg',
    file: 'nissan-kicks-ai-ad.jpg',
    title: 'KICKS e-Power — เจาะ First Jobber',
    prompt: `Keep the Nissan Kicks EXACTLY as the reference photo, photorealistic, same model/color/wheels/badges.
Make a premium VERTICAL mobile ad 9:16, Bangkok city scene for a young Thai first-jobber.
Render a bold legible Thai headline at top: "ออกตัวทันใจ เหมือนรถไฟฟ้า ไม่ต้องชาร์จ" + English tagline: "KICKS ON. GAME ON."
+ a small Nissan-red rounded CTA button: "นัดทดลองขับ". Nissan red & black accents, clean, sharp readable text.`,
  },
  {
    id: 'serena',
    img: '/images/nissan/textad-serena.jpg',
    file: 'nissan-serena-ai-ad.jpg',
    title: 'SERENA — เจาะครอบครัว',
    prompt: `Keep the Nissan Serena EXACTLY as the reference photo, photorealistic, same model/color/wheels/badges.
Make a premium VERTICAL mobile ad 9:16, warm candid scene of a Thai family loading up for a trip.
Render a bold legible Thai headline at top: "พื้นที่รถตู้ ประตูเปิดได้แม้มือไม่ว่าง" + English tagline: "Convenience in Every Detail."
+ a small Nissan-red rounded CTA button: "นัดชมรถที่โชว์รูม". Nissan red & black accents, clean, sharp readable text.`,
  },
  {
    id: 'xtrail',
    img: '/images/nissan/textad-xtrail.jpg',
    file: 'nissan-xtrail-ai-ad.jpg',
    title: 'X-TRAIL e-4ORCE — เจาะผู้บริหาร',
    prompt: `Keep the Nissan X-Trail EXACTLY as the reference photo, photorealistic, same model/color/wheels/badges.
Make a premium VERTICAL mobile ad 9:16, misty mountain road scene with a confident executive mood.
Render a bold legible Thai headline at top: "ขับ 4 ล้อจริง มั่นใจทุกเส้นทาง" + English tagline: "Excitement in Every Drive."
+ a small Nissan-red rounded CTA button: "สัมผัสตัวจริงวันนี้". Nissan red & black accents, clean, sharp readable text.`,
  },
  {
    id: 'almera',
    img: '/images/nissan/final-almera-ad.jpg',
    file: 'nissan-almera-ai-ad.jpg',
    title: 'NEW ALMERA Turbo — เจาะสายประหยัด',
    prompt: `The first reference image is the base photo: a Nissan Almera sedan with a Thai family at a scenic morning viewpoint. Keep this photo, the car, the people, and the scenery EXACTLY unchanged. The second reference image shows the exact Nissan advertising text layout style to copy. Add advertising text and graphic elements onto the first image in EXACTLY the same graphic style, typography and layout system as the second reference: (1) Top-left: red square Nissan logo block with white NISSAN circular emblem. (2) Upper area over the sky: big bold italic Thai headline in three stacked lines exactly like the second reference typography — first line 'เติม 30 ลิตร' in red bold Thai font, second line 'วิ่งทางไกล 800 โล' in black bold Thai font, third line smaller black bold text 'จากรีวิวเจ้าของจริง' with a short red underline swoosh beneath it. (3) Bottom center above the button: white bold logo text 'NEW ALMERA' with small 'TURBO' badge below, then small white Thai text 'ออปชั่นเต็มคัน ในราคาที่เอื้อมถึง' (4) Bottom center: glossy red pill-shaped button with white Thai text 'นัดทดลองขับ' with subtle highlight, same style as the second reference. Render all Thai text accurately and crisply, professional Thai advertising typography, high contrast, premium automotive ad finish. 9:16 vertical.`,
  },
  {
    id: 'navara',
    img: '/images/nissan/final-navara-ad.jpg',
    file: 'nissan-navara-ai-ad.jpg',
    title: 'NAVARA PRO-4X — เจาะเจ้าของธุรกิจสายลุย',
    prompt: `The first reference image is the base photo: a Nissan Navara PRO-4X pickup with a Thai man on a mountain dirt road at golden hour. Keep this photo, the truck, the man, and the scenery EXACTLY unchanged. The second reference image shows the exact Nissan advertising text layout style to copy. Add advertising text and graphic elements onto the first image in EXACTLY the same graphic style, typography and layout system as the second reference: (1) Top-left: red square Nissan logo block with white NISSAN circular emblem and small white text 'Innovation that excites' below it. (2) Upper area over the sky: big bold italic Thai headline in two stacked lines — first line 'ขับสบายเหมือนเก๋ง' in white bold Thai font, second line 'ลุยได้แบบกระบะ' in white bold Thai font on an angled red banner ribbon, exactly like the red angled banner in the second reference. (3) Below the headline: smaller white italic English tagline 'Tough in Every Way.' (4) Bottom-left corner: white bold logo text 'NAVARA' with 'PRO-4X' badge styling below it. (5) Bottom-right corner: glossy red pill-shaped button with white Thai text 'นัดทดลองขับ' with subtle highlight, same style as the second reference. Render all Thai text accurately and crisply, professional Thai advertising typography, high contrast, premium automotive ad finish. 9:16 vertical.`,
  },
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="px-4 py-16 md:py-24">
    <div class="mx-auto max-w-2xl">
      <div class="text-center">
        <img src="/logos/nissan-2020.svg" alt="Nissan" class="mx-auto h-16 w-auto md:h-20" />
        <p class="mt-6 text-xs uppercase tracking-[0.25em] text-base-content/50">Welcome</p>
        <h1 class="mt-2 font-display text-3xl font-bold leading-snug text-base-content md:text-4xl">
          ยินดีต้อนรับผู้เข้าร่วมงาน<br />Nissan Sale Manager<br class="md:hidden" /> Conference 2026 🤝
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-base-content/80">
          ขอบคุณที่ทักมาครับ — นี่คือของขวัญจากผม<br class="hidden md:block" />
          <strong class="text-secondary">AI Image Prompt Generator</strong> เครื่องมือเขียน prompt ทำภาพระดับเอเจนซี
        </p>
      </div>

      <div class="mt-10 rounded-2xl border border-base-content/10 bg-base-200 p-6 text-center">
        <p class="text-sm text-base-content/70">กดปุ่มเดียว แล้วเอาไปวางใน ChatGPT / Claude / Gemini ได้เลย</p>
        <button
          id="copy-prompt"
          type="button"
          class="btn btn-secondary btn-lg mt-4 w-full font-bold text-white shadow-lg md:w-auto md:px-10"
        >
          📋 คัดลอก Prompt ทั้งหมด
        </button>
        <p id="copy-done" class="mt-3 hidden text-sm font-bold text-success">
          คัดลอกแล้ว ✓ ไปวางใน AI ได้เลยครับ
        </p>
      </div>

      <div class="mt-10">
        <h2 class="font-display text-xl font-bold text-base-content">วิธีใช้ 3 ขั้น</h2>
        <ol class="mt-4 space-y-3">
          <li class="flex gap-4 rounded-xl border border-base-content/10 bg-base-100 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">1</span>
            <p class="text-base-content/85">กดปุ่ม <strong>"คัดลอก Prompt ทั้งหมด"</strong> ด้านบน</p>
          </li>
          <li class="flex gap-4 rounded-xl border border-base-content/10 bg-base-100 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">2</span>
            <p class="text-base-content/85">
              เปิด <strong>ChatGPT / Claude / Gemini</strong> แล้ววางทั้งหมด
              (หรือสร้างเป็น Project / Gem / Custom GPT ไว้ใช้ยาวๆ)
            </p>
          </li>
          <li class="flex gap-4 rounded-xl border border-base-content/10 bg-base-100 p-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">3</span>
            <p class="text-base-content/85">
              พิมพ์ว่า <strong>"เริ่ม"</strong> — ตัวช่วยจะถามทีละข้อ
              แล้วเขียน prompt ภาพระดับเอเจนซีให้คุณเอาไปเจนเอง
            </p>
          </li>
        </ol>
      </div>

      <div class="mt-10">
        <h2 class="font-display text-xl font-bold text-base-content">ตัว Prompt เต็มๆ (เผื่ออยากอ่านก่อน)</h2>
        <pre
          id="prompt-view"
          class="mt-4 max-h-96 overflow-auto whitespace-pre-wrap rounded-xl border border-base-content/10 bg-base-100 p-4 text-xs leading-relaxed text-base-content/80">{promptRaw}</pre>
      </div>

      <div class="mt-14 rounded-2xl border border-primary/25 bg-primary/5 p-6 text-center">
        <p class="text-xs uppercase tracking-[0.25em] text-base-content/50">Speaker Slides</p>
        <h2 class="mt-2 font-display text-2xl font-bold text-base-content">สไลด์จากเวทีวันนี้ 🎤</h2>
        <p class="mt-3 text-sm leading-relaxed text-base-content/75">
          สไลด์ที่ผมใช้พูดในงาน Nissan Sale Manager Conference 2026 ฉบับเต็ม —
          ดาวน์โหลดเก็บไว้ทบทวน หรือส่งต่อให้ทีมได้เลยครับ
        </p>
        <a
          href="/downloads/nissan-sale-manager-conference-2026-slides.pdf"
          download="Nissan-Sale-Manager-Conference-2026-Slides.pdf"
          class="btn btn-primary btn-lg mt-5 w-full font-bold shadow-lg md:w-auto md:px-10"
        >
          ⬇️ ดาวน์โหลดสไลด์ (PDF · 16MB)
        </a>
        <p class="mt-3 text-xs text-base-content/50">เปิดในแอป LINE ได้เลย หรือกดแชร์เข้าอีเมล/แชทของคุณ</p>
      </div>

      <div class="mt-14">
        <h2 class="font-display text-2xl font-bold text-base-content">ตัวอย่างผลงานจริง 🚗</h2>
        <p class="mt-3 leading-relaxed text-base-content/80">
          โฆษณา 5 ชิ้นนี้เจนด้วย AI จริงๆ — ทุกภาพใช้เทคนิค
          <strong class="text-secondary">image-to-image</strong> คือแนบ "รูปรถจริง" เป็น reference
          แล้วสั่งให้ AI คงตัวรถไว้เป๊ะ (ไม่เสกรถใหม่ รุ่น/สี/ล้อไม่เพี้ยน)
          พร้อม prompt ของจริงที่ใช้เจน — กดคัดลอกไปลองกับรถของคุณได้เลยครับ
        </p>

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            EXAMPLES.map((ex) => (
              <div class="overflow-hidden rounded-2xl border border-base-content/10 bg-base-100">
                <img
                  src={ex.img}
                  alt={`ตัวอย่างโฆษณา AI — ${ex.title}`}
                  loading="lazy"
                  class="w-full"
                />
                <div class="p-4">
                  <p class="font-display text-base font-bold text-base-content">{ex.title}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <button
                      type="button"
                      class="btn btn-secondary btn-sm js-copy-example font-bold text-white"
                      data-target={`prompt-src-${ex.id}`}
                    >
                      📋 คัดลอก Prompt
                    </button>
                    <a href={ex.img} download={ex.file} class="btn btn-outline btn-sm">
                      ⬇️ ดาวน์โหลดรูป
                    </a>
                  </div>
                  <details class="mt-3">
                    <summary class="cursor-pointer text-xs font-bold text-secondary">
                      ดู Prompt ที่ใช้จริง
                    </summary>
                    <pre class="mt-2 max-h-60 overflow-auto whitespace-pre-wrap rounded-lg bg-base-200 p-3 text-[11px] leading-relaxed text-base-content/75">{ex.prompt}</pre>
                  </details>
                  <textarea
                    id={`prompt-src-${ex.id}`}
                    readonly
                    aria-hidden="true"
                    tabindex="-1"
                    style="position:fixed;left:-9999px;top:0;opacity:0;">{ex.prompt}</textarea>
                </div>
              </div>
            ))
          }
        </div>

        <p class="mt-4 text-xs leading-relaxed text-base-content/50">
          💡 เทคนิคนี้ต้องแนบรูปจริงเป็น reference คู่กับ prompt (ใน ChatGPT / Gemini อัปโหลดรูปก่อนแล้วค่อยวาง prompt)
          — ตัวเลข/ข้อความบนภาพต้องตรวจก่อนใช้ยิงโฆษณาจริงเสมอครับ
        </p>
      </div>

      <div class="mt-12 rounded-2xl border border-secondary/30 bg-secondary/5 p-6 text-center">
        <p class="font-display text-lg font-bold text-base-content">อยากให้ AI ช่วยทั้งระบบงานขาย ไม่ใช่แค่ทำภาพ?</p>
        <p class="mt-2 text-sm leading-relaxed text-base-content/75">
          ผมช่วยธุรกิจ B2B ไทยวางระบบขาย + AI ที่ใช้ได้จริง — ทักมาคุยกันได้ครับ
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            class="btn gap-2 border-none font-bold text-white hover:opacity-90"
            style="background: #06C755;"
          >
            <img src="/line-logo.png" alt="" class="h-5 w-5 shrink-0" aria-hidden="true" />
            ทักใน LINE OA
          </a>
          <a href="/" class="btn btn-outline">ดูว่าผมทำอะไร →</a>
        </div>
        <p class="mt-4 text-xs text-base-content/50">
          ปัน ณัฐพัชร์ · @pun_nattapatch · B2B Sales & Agentic AI Transformation
        </p>
      </div>
    </div>
  </section>

  <textarea
    id="prompt-source"
    readonly
    aria-hidden="true"
    tabindex="-1"
    style="position:fixed;left:-9999px;top:0;opacity:0;">{promptRaw}</textarea>

  <script is:inline>
    (function () {
      async function copyFrom(src) {
        const text = src.value;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (e) {}
        try {
          if (/ipad|iphone/i.test(navigator.userAgent)) {
            src.contentEditable = 'true';
            const range = document.createRange();
            range.selectNodeContents(src);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            src.setSelectionRange(0, text.length);
            src.contentEditable = 'false';
          } else {
            src.focus();
            src.select();
            src.setSelectionRange(0, text.length);
          }
          if (document.execCommand('copy')) return true;
        } catch (e) {}
        return false;
      }

      const btn = document.getElementById('copy-prompt');
      const done = document.getElementById('copy-done');
      const src = document.getElementById('prompt-source');
      if (btn && src) {
        const ORIG = btn.textContent;
        btn.addEventListener('click', async function () {
          if (await copyFrom(src)) {
            if (done) done.classList.remove('hidden');
            btn.textContent = '✓ คัดลอกแล้ว';
            setTimeout(function () {
              btn.textContent = ORIG;
              if (done) done.classList.add('hidden');
            }, 3000);
          } else {
            alert('คัดลอกอัตโนมัติไม่สำเร็จ — กดค้างที่กล่อง Prompt ด้านล่าง แล้วเลือก Copy ได้ครับ');
          }
        });
      }

      document.querySelectorAll('.js-copy-example').forEach(function (b) {
        const ORIG = b.textContent;
        b.addEventListener('click', async function () {
          const ta = document.getElementById(b.getAttribute('data-target'));
          if (!ta) return;
          if (await copyFrom(ta)) {
            b.textContent = '✓ คัดลอกแล้ว';
            setTimeout(function () {
              b.textContent = ORIG;
            }, 2500);
          } else {
            alert('คัดลอกอัตโนมัติไม่สำเร็จ — กด "ดู Prompt ที่ใช้จริง" แล้วกดค้างเลือก Copy ได้ครับ');
          }
        });
      });
    })();
  </script>
</BaseLayout>
