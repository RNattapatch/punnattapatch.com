---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const title = 'บริการ — ปัน ณัฐพัชร์ | AI Agent สำหรับทีมขาย หลังบ้าน เทคนิค การตลาด';
const description = 'เลือกตามทีมของคุณ — ทีมขาย หลังบ้าน เทคนิค การตลาด · หรือเอาโจทย์มาให้ผมจับมือทำจนระบบขึ้นจริง · ออกไปมีระบบที่รันได้ ไม่ใช่สไลด์';
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'ServiceList', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'บริการ', url: `${SITE.url}/services` },
    ],
  }}
>
  <!-- ===== HERO (human-first) ===== -->
  <section class="px-margin-page py-14 md:py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-[1.1fr_0.9fr]">
      <div>
        <h1 class="font-display text-5xl font-bold leading-[1.05] text-coral md:text-6xl">Service <span class="font-normal text-navy/25">|</span> <span class="text-navy">บริการของผม</span></h1>
        <p class="mt-5 font-display text-3xl font-semibold leading-[1.15] text-navy md:text-4xl">
          ให้ AI ทำงานแทนทีม<br />จน<span class="hand-underline">เจ้าของถอดตัวออกได้</span>
        </p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-warm-ink/80">
          ผมช่วยได้ 3 ทาง — <strong class="text-navy">สอนทีมใช้ AI เป็น</strong> (Training) ·
          <strong class="text-navy">เอาโจทย์มาให้ผมจับมือทำจนระบบขึ้นจริง</strong> (Consult) ·
          หรือเป็น <strong class="text-navy">คู่คิด AI ส่วนตัวให้ผู้บริหาร</strong> (CEO)
        </p>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-warm-ink/70">
          AI เก่งเหมือนน้องฝึกงานที่รู้ทุกอย่างบนโลก แต่ไม่รู้จักบริษัทคุณ — ผมเข้าไปทำให้มันรู้จัก
        </p>
        <div class="mt-6 inline-flex items-start gap-2 rounded-xl border border-coral/30 bg-coral/[0.06] px-4 py-3">
          <i data-lucide="package-check" class="mt-0.5 size-5 shrink-0 text-coral" aria-hidden="true"></i>
          <p class="text-sm font-medium text-navy">หลังจบงาน ทีมคุณได้<span class="font-semibold">ระบบ AI Agent ที่ใช้ได้จริง</span>กลับไปใช้เลย ไม่ใช่ได้แค่สไลด์สอนกับความรู้</p>
        </div>
        <!-- quick-jump box: 3 บริการ → scroll ไปหมวดนั้น -->
        <nav class="mt-7 rounded-2xl border border-[#c9c2b2] bg-surface/70 p-4" aria-label="ไปยังบริการ">
          <p class="mb-2.5 text-xs font-semibold uppercase tracking-wide text-muted">บริการของผม — กดเพื่อไปดูเลย</p>
          <div class="grid gap-2 sm:grid-cols-3">
            <a href="#doors" class="group flex items-center justify-between gap-2 rounded-xl border border-[#c9c2b2] bg-ivory px-3.5 py-2.5 text-sm font-medium text-navy transition hover:border-coral hover:text-coral">
              <span>Training <span class="text-muted transition group-hover:text-coral/70">· ปั้นทีม</span></span>
              <i data-lucide="arrow-down" class="size-4 shrink-0 text-coral" aria-hidden="true"></i>
            </a>
            <a href="#consult" class="group flex items-center justify-between gap-2 rounded-xl border border-[#c9c2b2] bg-ivory px-3.5 py-2.5 text-sm font-medium text-navy transition hover:border-coral hover:text-coral">
              <span>Consult <span class="text-muted transition group-hover:text-coral/70">· คู่คิด</span></span>
              <i data-lucide="arrow-down" class="size-4 shrink-0 text-coral" aria-hidden="true"></i>
            </a>
            <a href="#ceo" class="group flex items-center justify-between gap-2 rounded-xl border border-[#c9c2b2] bg-ivory px-3.5 py-2.5 text-sm font-medium text-navy transition hover:border-coral hover:text-coral">
              <span>CEO Consult</span>
              <i data-lucide="arrow-down" class="size-4 shrink-0 text-coral" aria-hidden="true"></i>
            </a>
          </div>
          <a href="#start" class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-coral px-6 py-3.5 font-medium text-white shadow-sm transition hover:opacity-90">
            <i data-lucide="messages-square" class="size-5" aria-hidden="true"></i> ยังไม่แน่ใจว่าทางไหนใช่? คุยกับผมก่อน
          </a>
        </nav>
      </div>

      <!-- รูปคุณปันจริง -->
      <figure class="relative">
        <span class="tape" aria-hidden="true"></span>
        <img src="/services/ceo/ceo3.jpg" alt="ปัน ณัฐพัชร์ — ที่ปรึกษา AI Agent สำหรับเจ้าของธุรกิจ SME" width="933" height="1400" loading="eager" decoding="async" class="aspect-[4/5] w-full rounded-2xl border border-[#c9c2b2] object-cover object-top paper-shadow" />
      </figure>
    </div>
  </section>

  <!-- ===== TRUST BAR ===== -->
  <section class="border-y border-[#c9c2b2] bg-surface px-margin-page py-8" aria-label="ประสบการณ์ของปัน">
    <div class="mx-auto grid max-w-6xl gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-1">
        <span class="font-display text-2xl font-semibold text-coral">ยอดขายแตะ 100 ล้าน</span>
        <span class="text-sm leading-snug text-warm-ink/70">ทำธุรกิจจริง ไม่ได้สอนจากสไลด์อย่างเดียว</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-display text-2xl font-semibold text-coral">งานขาย 5 ปี</span>
        <span class="text-sm leading-snug text-warm-ink/70">เข้าใจทั้งเจ้าของ เซลล์ และดีลที่หล่นกลางทาง</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-display text-2xl font-semibold text-coral">สัมภาษณ์เซลล์ 1,000+ คน</span>
        <span class="text-sm leading-snug text-warm-ink/70">เห็น pattern ว่าทีมขายพังตรงไหนซ้ำๆ</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-display text-2xl font-semibold text-coral">ใช้ AI Agent ทุกวัน</span>
        <span class="text-sm leading-snug text-warm-ink/70">ระบบที่ทำให้ลูกค้า ผมใช้เองก่อนเสมอ</span>
      </div>
    </div>
  </section>

  <!-- ===== PAIN CHECKLIST ===== -->
  <section class="px-margin-page py-14 md:py-20" aria-label="ปัญหาที่เจ้าของเจอ">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-coral">ปัญหาที่เจ้าของ SME เจอทุกวัน</p>
      <h2 class="mt-3 max-w-3xl font-display text-3xl font-semibold leading-snug text-navy md:text-4xl">ถ้าคุณกำลังเป็นแบบนี้อยู่ ธุรกิจอาจไม่ได้ขาดคน <span class="hand-underline">แต่ขาดระบบที่ทำงานแทนงานซ้ำๆ</span></h2>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">ตอบแชทเองทุกดึก</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">LINE เด้ง IG เด้ง Facebook เด้ง ลูกค้าถามเรื่องเดิมซ้ำๆ แต่สุดท้ายคนที่ต้องตอบคือเจ้าของ</p>
        </article>
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">ดีลหล่นเพราะ follow-up ไม่ทัน</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">วันนี้จดใน Excel พรุ่งนี้เตือนใน LINE อีกวันลืมไปแล้ว ดีลไม่ได้หายเพราะลูกค้าไม่สนใจ แต่หายเพราะไม่มีระบบตามต่อ</p>
        </article>
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">เซลล์เสียเวลา 2-4 ชม./วัน กับเอกสาร</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">เซลล์ควรได้คุยกับลูกค้าเพิ่ม แต่กลับต้องสรุปแชท ทำใบเสนอราคา อัปเดตไฟล์ ส่งรายงาน</p>
        </article>
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">เซลล์ลาออก ความรู้ก็หายไปด้วย</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">วิธีคุยกับลูกค้า เหตุผลที่ลูกค้าซื้อ objection ที่เจอบ่อย ข้อมูลพวกนี้อยู่ในหัวคนเก่งไม่กี่คน</p>
        </article>
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">เปิดวันหยุดไม่ได้</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">พนักงานรอคำตอบ ลูกค้ารอราคา เซลล์รออนุมัติ สุดท้ายธุรกิจเดินได้ก็ต่อเมื่อเจ้าของว่างตอบ</p>
        </article>
        <article class="editorial-card flex flex-col gap-2 p-6">
          <i data-lucide="circle-alert" class="size-6 text-coral" aria-hidden="true"></i>
          <h3 class="font-display text-lg font-semibold text-navy">ลงทุน AI ไปแล้ว แต่ตอบไม่ได้ว่าคุ้มไหม</h3>
          <p class="text-sm leading-relaxed text-warm-ink/70">ทีมบอกว่า "ใช้อยู่ครับพี่" แต่ไม่มีตัวเลขว่าเวลาลดลงกี่ชั่วโมง ดีลตามทันขึ้นไหม</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== THE SHIFT ===== -->
  <section class="border-y border-[#c9c2b2] bg-sand px-margin-page py-14 md:py-20" aria-label="หลักคิดมาก่อนเครื่องมือ">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-coral">หลักคิดมาก่อนเครื่องมือ</p>
      <h2 class="mt-3 font-display text-3xl font-semibold leading-snug text-navy md:text-4xl">ใครๆ ก็ใช้ AI ได้ แต่ถ้า AI ไม่รู้จักบริษัทคุณ <span class="hand-underline">มันก็เป็นแค่น้องฝึกงานที่ตอบเก่ง</span></h2>
      <div class="mt-5 space-y-4 text-base leading-relaxed text-warm-ink/80">
        <p>ทุกวันนี้ใครๆ ก็พิมพ์คำสั่งให้ AI ช่วยเขียน ช่วยสรุป ช่วยคิดได้ครับ เครื่องมือใหม่ออกแทบทุกเดือน</p>
        <p>แต่คำถามที่สำคัญกว่า "ใช้ตัวไหนดี" คือ "เราจะทำให้ AI เข้าใจธุรกิจเราได้ยังไง" เพราะ AI เหมือนน้องฝึกงานที่รู้ทุกอย่างบนโลก แต่ไม่รู้จักบริษัทคุณ</p>
        <p>ผมเลยไม่เริ่มจากเครื่องมือก่อน ผมเริ่มจากหลักคิดมาก่อนเครื่องมือเสมอ</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="editorial-card flex flex-col gap-1 p-5">
          <span class="font-display text-lg font-semibold text-coral">หลักคิด</span>
          <span class="text-sm leading-relaxed text-warm-ink/75">AI ควรช่วยงานไหน และงานไหนไม่ควรให้ AI ทำ</span>
        </div>
        <div class="editorial-card flex flex-col gap-1 p-5">
          <span class="font-display text-lg font-semibold text-coral">Context</span>
          <span class="text-sm leading-relaxed text-warm-ink/75">ให้ AI รู้จักสินค้า ลูกค้า วิธีขาย และกติกาของบริษัท</span>
        </div>
        <div class="editorial-card flex flex-col gap-1 p-5">
          <span class="font-display text-lg font-semibold text-coral">Data</span>
          <span class="text-sm leading-relaxed text-warm-ink/75">จัดข้อมูลให้ใช้ได้จริง ไม่ใช่กองอยู่ในแชท ไฟล์ และหัวคน</span>
        </div>
        <div class="editorial-card flex flex-col gap-1 p-5">
          <span class="font-display text-lg font-semibold text-coral">การวางระบบ</span>
          <span class="text-sm leading-relaxed text-warm-ink/75">ทำให้ AI ทำงานซ้ำได้เอง ไม่ต้องรอคนเปิดมาใช้ทุกครั้ง</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== POD STRIP ===== -->
  <section class="border-y border-[#c9c2b2] bg-sand px-margin-page py-6">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center text-sm md:text-base">
      <span class="inline-flex items-center gap-2 font-medium text-navy"><i data-lucide="hammer" class="size-4 text-coral" aria-hidden="true"></i> ออกไปมีระบบจริง</span>
      <span class="hidden text-muted md:inline">·</span>
      <span class="inline-flex items-center gap-2 font-medium text-navy"><i data-lucide="home" class="size-4 text-coral" aria-hidden="true"></i> ข้อมูลไหลเข้าบ้านเดียว</span>
      <span class="hidden text-muted md:inline">·</span>
      <span class="inline-flex items-center gap-2 font-medium text-navy"><i data-lucide="handshake" class="size-4 text-coral" aria-hidden="true"></i> จับมือทำทุกคน on-site</span>
    </div>
  </section>

  <!-- ===== DOOR 1: Training ===== -->
  <section id="doors" class="scroll-mt-20 px-margin-page py-14 md:py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-4xl font-bold leading-tight text-navy md:text-5xl">ทางที่ 1 : <span class="text-coral">Training</span> อบรมทีมให้ใช้ AI Agent เป็น</h2>
      <p class="mt-3 font-display text-2xl font-semibold text-navy/75">เลือกทีมที่เจ็บที่สุดก่อน</p>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-warm-ink/80"><strong class="text-navy">ผมเข้าไปอบรมที่บริษัทคุณ 1 วันต่อสายงาน</strong> แล้วพาทีมลงมือทำ AI Agent ตัวแรกกับงานจริงของตัวเองในวันนั้น</p>

      <!-- ปูพื้น -->
      <div class="mt-8 flex flex-col gap-4 rounded-2xl bg-navy px-7 py-6 text-ivory md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="font-display text-2xl font-semibold text-coral-soft">Basic AI Foundation For Business</h3>
          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wide text-ivory/60">ปูพื้นฐาน AI ให้องค์กร</p>
          <p class="mt-1.5 font-display text-xl font-semibold text-ivory">เห็นทั้งบริษัทในวันเดียว</p>
          <p class="mt-1 text-sm text-ivory/75">สำหรับเจ้าของ + ทุกทีม ที่ยังไม่เคยวาง AI อย่างเป็นระบบ</p>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-3 md:items-end">
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl font-semibold text-coral-soft tabular-nums">฿29,900</span>
            <span class="text-sm text-ivory/50 line-through tabular-nums">฿39,900</span>
          </div>
          <div class="flex gap-2">
            <a href="#start" class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-coral px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90"><i data-lucide="calendar-check" class="size-4" aria-hidden="true"></i> จองบริการ</a>
            <button type="button" data-line-service="Basic AI Foundation For Business (ปูพื้นฐาน AI)" class="line-btn inline-flex items-center justify-center gap-1.5 rounded-xl border border-ivory/40 px-4 py-2.5 text-sm font-medium text-ivory transition hover:bg-ivory hover:text-navy"><i data-lucide="message-circle" class="size-4" aria-hidden="true"></i> ทัก LINE</button>
          </div>
        </div>
      </div>

      <!-- 4 tracks -->
      <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-2">
        <article class="editorial-card flex flex-col p-6 transition hover:-translate-y-0.5 hover:paper-shadow">
          <div class="flex items-center gap-2 text-coral"><i data-lucide="trending-up" class="size-5" aria-hidden="true"></i><span class="text-xs font-semibold uppercase tracking-wide">ทีมขาย</span></div>
          <h3 class="mt-3 font-display text-2xl font-semibold leading-snug text-coral">Advance AI Agent For Sale Team</h3>
          <p class="mt-1 text-xs text-muted">จับมือสร้าง AI Agent สำหรับฝ่ายขาย</p>
          <p class="mt-2 font-display text-xl font-semibold leading-snug text-navy">ดีลไม่หล่นจากมือ เซลล์มีเวลาไปหาลูกค้าใหม่</p>
          <p class="mt-3 text-sm font-medium text-warm-ink/80">ออกไปมี:</p>
          <ul class="mt-1 space-y-1.5 text-sm text-warm-ink/70">
            <li class="flex gap-2"><i data-lucide="check" class="mt-0.5 size-4 shrink-0 text-coral" aria-hidden="true"></i> ระบบ follow-up อัตโนมัติ + ตัวช่วยออกใบเสนอราคา</li>
            <li class="flex gap-2"><i data-lucide="check" class="mt-0.5 size-4 shrink-0 text-coral" aria-hidden="true"></i> AI ซ้อมเจรจา + prompt library งานขาย</li>
          </ul>
          <div class="mt-5 flex items-baseline gap-2 border-t border-[#e7e0d2] pt-4">
            <span class="font-display text-2xl font-semibold text-coral tabular-nums">฿39,900</span>
            <span class="text-sm text-muted line-through tabular-nums">฿49,900</span>
          </div>
          <div class="mt-4 flex gap-2">
            <a href="#start" class="flex-1 inline-flex items-center justify-center gap-1.5 rounded-xl bg-coral px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90"><i data-lucide="calendar-check" class="size-4" aria-hidden="true"></i> จองบริการ</a>
            <button type="button" data-line-service="Advance AI Agent For Sale Team (ทีมขาย)" class="line-btn inline-flex items-center justify-center gap-1.5 rounded-xl border border-navy/25 px-4 py-2.5 text-sm font-medium text-navy transition hover:bg-navy hover:text-ivory"><i data-lucide="message-circle" class="size-4" aria-hidden="true"></i> ทัก LINE</button>
