---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { fmtPrice, CATALOG } from '../data/pricing.mjs';

const title = 'คอร์สสำหรับทีมขาย และบริการวางระบบฝ่ายขาย';
const description = 'รวมคอร์สอบรมทีมขายที่เปิดสอนตอนนี้ และบริการวางระบบฝ่ายขาย — เอาเรื่องยอดขาย ระบบ และงานของคนในทีมขึ้นก่อน แล้วใช้ AI เข้ามาช่วยให้ทำงานเร็วขึ้น';
const lineUrl = 'https://line.me/R/ti/p/@011xgvap';
// Design: port จาก output/web-app/mockup-course-catalog-2026-08-28.html (Codex · คุณปันเคาะ 2026-08-28)
// เพิ่มจาก mockup: ราคาจาก SSOT บนทุกการ์ด (มติ "เปิดหัวเคลียร์ + ใส่ราคา") + Services grid (master §14) + proof gallery
// การ์ดบริการอ่านจาก SSOT ตรงๆ — ชื่อ ราคา ระยะเวลา headline แก้ที่ pricing.mjs ที่เดียว
const serviceOffers = ['sales-team-structure', 'daruma-starter', 'ai-agent-ceo'].map((key) => ({ key, ...CATALOG[key] }));
const trustLogos = [
  { src: '/services/nissan.png', alt: 'Nissan' },
  { src: '/services/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/services/gpx.jpg', alt: 'GPX' },
  { src: '/services/lambretta.png', alt: 'Lambretta' },
  { src: '/services/zontes.png', alt: 'Zontes' },
  { src: '/services/futureskill.png', alt: 'FutureSkill' },
];
const proofGallery = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
const faqs = [
  { q: 'ต้องมีพื้นฐาน AI ไหม', a: 'เรียนได้ครับ เริ่มจากงานขายหรือรายงานที่ทีมทำอยู่แล้ว ผู้เรียนไม่ต้องเขียนโค้ด แต่ควรใช้คอมพิวเตอร์และไฟล์งานพื้นฐานได้' },
  { q: 'ต้องใช้ ChatGPT, Claude หรือ Gemini ตัวไหน', a: 'ใช้เครื่องมือที่องค์กรมีอยู่ก่อนครับ ผมเช็กบัญชีและข้อจำกัดก่อนวันสอน แล้วปรับแบบฝึกหัดให้ทีมไม่ต้องซื้อทุกแพลตฟอร์มพร้อมกัน' },
  { q: 'ควรส่งใครมาเรียน และรับกี่คน', a: 'เหมาะกับทีมขาย หัวหน้าทีม และคนหลังบ้านที่รับส่งข้อมูลระหว่างกัน ขนาดที่ทำ Workshop ได้ทั่วถึงคือ 5–20 คนต่อรุ่น' },
  { q: 'ต้องเตรียมอะไรสำหรับวันอบรม', a: 'ผู้เรียนเตรียม Notebook และบัญชี AI ที่ใช้อยู่ บริษัทเตรียมตัวอย่างสินค้า ขั้นตอนขาย ข้อความ Follow-up หรือ Report ที่อยากแก้ โดยลบข้อมูลลูกค้าที่เป็นความลับก่อนนำเข้าห้อง' },
  { q: 'อบรมแล้วจะได้ระบบ Automation ที่พร้อมใช้ทันทีไหม', a: 'ในคลาสทีมจะได้ Workflow, Template และ Prototype ที่ทำกับโจทย์จริง ส่วนระบบที่เชื่อมฐานข้อมูล สิทธิ์ผู้ใช้ หรือทำงานอัตโนมัติระยะยาว เป็นงานวางระบบแยก — ดูหมวด "บริการวางระบบฝ่ายขาย" ด้านบน' },
  { q: 'จัดอบรมที่บริษัทหรือออนไลน์', a: 'คอร์สในหน้านี้ออกแบบเป็น In-house ที่บริษัทเป็นหลัก เพราะต้องใช้ตัวอย่างงานของทีมจริง สถานที่ รูปแบบ และวันอบรมจะยืนยันพร้อม Scope ก่อนออกใบเสนอราคา' },
  { q: 'ขอใบเสนอราคาและจองวันอย่างไร', a: 'ทัก LINE พร้อมบอกประเภทธุรกิจ จำนวนผู้เรียน และผลลัพธ์ที่อยากได้ ผมช่วยเลือกคอร์สให้ฟรี เมื่อ Scope และวันตรงกันจะส่งใบเสนอราคาและใบแจ้งหนี้ โดยชำระ 100% ก่อนเริ่มงาน' },
];
const lineCtaClass = 'inline-flex items-center gap-2 rounded-sm font-display text-sm font-bold text-[#06c755] underline decoration-[#06c755]/30 decoration-2 underline-offset-4 transition-colors hover:text-[#05a548] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#06c755] focus-visible:ring-offset-4 focus-visible:ring-offset-surface';
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'Person', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [{ name: 'หน้าแรก', url: SITE.url }, { name: 'บริการ', url: `${SITE.url}/services` }],
  }}
>
  <!-- ===== Hero ===== -->
  <section class="relative overflow-hidden border-b border-sand-deep bg-surface">
    <div aria-hidden="true" class="absolute -right-24 -top-28 hidden h-[390px] w-[180px] rotate-[31deg] rounded-[90px] border-[28px] border-navy/5 lg:block">
      <div class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-navy/10"></div>
    </div>
    <div class="mx-auto max-w-[1180px] px-5 pb-16 pt-16 sm:px-8 sm:pb-20 sm:pt-20 lg:px-10 lg:pb-24 lg:pt-24">
      <div class="max-w-4xl">
        <p class="mb-5 font-display text-xs font-bold uppercase tracking-[0.24em] text-coral">All courses · Training</p>
        <h1 class="font-display text-[2.35rem] font-bold leading-[1.13] tracking-[-0.035em] text-navy sm:text-5xl lg:text-[3.75rem]">
          คอร์สสำหรับทีมขาย<br class="hidden sm:block" />
          <span class="relative inline-block text-coral">
            ที่เปิดสอนตอนนี้
            <svg aria-hidden="true" class="absolute -bottom-2 left-0 h-3 w-full" viewBox="0 0 420 18" preserveAspectRatio="none">
              <path d="M4 12C93 3 177 16 258 8C323 2 369 8 416 5" fill="none" stroke="#DD4155" stroke-linecap="round" stroke-width="5" />
            </svg>
          </span>
        </h1>
        <p class="mt-8 max-w-2xl text-base leading-8 text-[#625C53] sm:text-lg">
          เลือกจากงานที่อยากให้ทีมทำได้จริง ไม่ต้องเริ่มจากชื่อเครื่องมือ ทุกคอร์สเอาเรื่องยอดขาย ระบบ และงานของคนในทีมขึ้นก่อน แล้วใช้ AI เข้ามาช่วยให้ทำงานเร็วขึ้น
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Core training (2 คอร์สหลัก) ===== -->
  <section class="mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
    <div class="mb-8 flex items-end justify-between gap-6 border-b border-navy/15 pb-5 sm:mb-10">
      <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-coral">Core training</p>
        <h2 class="font-display text-2xl font-bold tracking-[-0.025em] text-navy sm:text-3xl">คอร์สหลักสำหรับทุกธุรกิจ</h2>
      </div>
      <span class="hidden font-display text-sm font-semibold text-muted sm:block">02 คอร์ส</span>
    </div>

    <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
      <article id="inhouse-a" class="group scroll-mt-6 overflow-hidden rounded-[1.6rem] border border-sand-deep bg-surface shadow-[0_18px_40px_-28px_rgba(7,43,78,.35)] transition-transform duration-300 hover:-translate-y-1">
        <figure class="relative aspect-[16/9] overflow-hidden bg-navy">
          <img src="/lp/inhouse/hero-pointing.jpg" alt="ปันกำลังสอนทีมงานในคลาสจริง โดยผู้เรียนลงมือทำบนคอมพิวเตอร์ของตัวเอง" width="1280" height="720" loading="eager" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/75 via-transparent to-transparent"></div>
          <div class="absolute left-5 top-5 rounded-full border border-white/35 bg-navy/85 px-4 py-2 text-xs font-semibold text-white backdrop-blur-sm">In-house · 1 วัน · ทีมขาย 5–20 คน</div>
          <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 text-white">
            <span class="text-xs font-medium tracking-wide">SALES × AI</span>
            <span class="text-xs text-white/75">สำหรับ B2B และ B2C</span>
          </div>
        </figure>
        <div class="flex flex-col p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-coral">เพิ่มยอดขาย + ลดงานซ้ำ</p>
          <h3 class="mt-1 font-display text-[1.65rem] font-bold leading-[1.28] tracking-[-0.025em] text-navy">คอร์สเพิ่มยอดขายด้วย AI สำหรับทีมขาย</h3>
          <p class="mt-2 leading-7 text-[#625C53]">ให้เซลล์ใช้ AI ช่วยเตรียมงาน คุยกับลูกค้า และตามดีลได้ดีขึ้น โดยยังใช้ความสัมพันธ์และวิจารณญาณของคนเป็นตัวปิดการขาย</p>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-[#4F4A43]">
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>เตรียมข้อมูลลูกค้าและประเด็นคุยก่อนเข้าพบ</span></li>
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>ร่างข้อความ Follow-up และรับมือข้อโต้แย้งแต่ละดีล</span></li>
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>วาง Funnel และวิธีใช้ AI ในงานขายที่ทีมทำอยู่จริง</span></li>
          </ul>
          <div class="mt-6 flex items-end justify-between gap-4 border-t border-sand-deep pt-5">
            <div>
              <p class="text-xs text-muted">ราคาเดียวทั้งทีม ไม่เกิน 20 คน</p>
              <p class="font-display text-3xl font-bold tabular-nums text-coral">{fmtPrice('inhouse-a')}</p>
            </div>
            <a data-line-cta href={lineUrl} class={lineCtaClass} target="_blank" rel="noopener">
              ทัก LINE ขอรายละเอียดคอร์ส <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      <article id="sales-report" class="group scroll-mt-6 overflow-hidden rounded-[1.6rem] border border-sand-deep bg-surface shadow-[0_18px_40px_-28px_rgba(7,43,78,.35)] transition-transform duration-300 hover:-translate-y-1">
        <figure class="relative aspect-[16/9] overflow-hidden bg-navy-deep">
          <img src="/proof/02-command-charts.jpg" alt="หน้าจอ Dashboard สำหรับติดตามข้อมูลและการทำงานของทีมขาย" width="1280" height="720" loading="eager" class="h-full w-full object-cover object-center opacity-90 transition-transform duration-500 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/90 via-navy/20 to-transparent"></div>
          <div class="absolute left-5 top-5 rounded-full border border-white/35 bg-navy/85 px-4 py-2 text-xs font-semibold text-white backdrop-blur-sm">In-house · 1 วัน · หัวหน้าทีมขาย + Back Office</div>
          <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 text-white">
            <span class="text-xs font-medium tracking-wide">SALES OPERATION</span>
            <span class="text-xs text-white/75">Report · Dashboard · AI</span>
          </div>
        </figure>
        <div class="flex flex-col p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-coral">เห็นงานไว + ตามงานตรงจุด</p>
          <h3 class="mt-1 font-display text-[1.65rem] font-bold leading-[1.28] tracking-[-0.025em] text-navy">คอร์สอบรม Report ทีมขาย + Dashboard + AI</h3>
          <p class="mt-2 leading-7 text-[#625C53]">ลดเวลาบี้รายงานและรวม Excel ให้หัวหน้าเห็นว่างานอยู่ขั้นไหน ดีลไหนต้องตาม และตัวเลขไหนกำลังหลุดก่อนถึงวันสรุปยอด</p>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-[#4F4A43]">
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>จัดข้อมูลรายวันให้ทีมกรอกง่ายและใช้ต่อได้จริง</span></li>
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>เปลี่ยน Report ให้เป็น Dashboard ที่หัวหน้าเปิดดูได้</span></li>
            <li class="flex gap-3"><span class="mt-0.5 font-bold text-coral">✓</span><span>ใช้ AI ช่วยสรุปประเด็นและชี้งานที่ต้อง Follow-up</span></li>
          </ul>
          <div class="mt-6 flex items-end justify-between gap-4 border-t border-sand-deep pt-5">
            <div>
              <p class="text-xs text-muted">ราคาเดียวทั้งทีม ไม่เกิน 20 คน</p>
              <p class="font-display text-3xl font-bold tabular-nums text-coral">{fmtPrice('ai-workshop-advance')}</p>
            </div>
            <a data-line-cta href={lineUrl} class={lineCtaClass} target="_blank" rel="noopener">
              ทัก LINE ขอรายละเอียดคอร์ส <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ===== Industry Edition — คอร์ส 2 วัน (Dealer) ===== -->
  <section class="border-y border-sand-deep bg-sand">
    <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
      <div class="mb-8 flex items-end justify-between gap-6 border-b border-navy/15 pb-5 sm:mb-10">
        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-coral">Industry Edition · คอร์ส 2 วัน</p>
          <h2 class="font-display text-2xl font-bold tracking-[-0.025em] text-navy sm:text-3xl">เนื้อหาเดิม ปรับ Journey ให้ตรงธุรกิจ</h2>
        </div>
        <span class="hidden font-display text-sm font-semibold text-muted sm:block">Dealer Edition</span>
      </div>

      <article id="trust-content" class="group grid scroll-mt-6 overflow-hidden rounded-[1.75rem] border border-navy/15 bg-surface shadow-[0_24px_70px_-42px_rgba(7,43,78,.45)] lg:grid-cols-[0.9fr_1.1fr]">
        <figure class="relative min-h-[300px] overflow-hidden bg-navy sm:min-h-[390px] lg:min-h-[520px]">
          <img src="/testimonial/2026-07/onsite-nissan-pun.jpg" alt="ปัน ณัฐพัชร์ บนเวที Nissan Sales Manager Seminar 2026" class="absolute inset-0 h-full w-full object-cover object-[50%_32%] transition-transform duration-500 group-hover:scale-[1.025]" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/95 via-navy/15 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between gap-4 text-white sm:bottom-8 sm:left-8 sm:right-8">
            <div>
              <p class="mb-1 text-xs font-bold uppercase tracking-[0.18em] text-[#FF8594]">Automotive proof</p>
              <p class="text-sm font-semibold">จากประสบการณ์สอนและทำงานกับธุรกิจยานยนต์จริง</p>
            </div>
          </div>
        </figure>

        <div class="flex flex-col p-6 sm:p-10 lg:p-12">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-full bg-coral/10 px-4 py-2 text-xs font-bold text-coral">In-house · 2 วัน · ที่โชว์รูม</span>
            <span class="rounded-full bg-navy/10 px-4 py-2 text-xs font-semibold text-navy">ทีมขาย 5–20 คน</span>
          </div>
          <p class="mt-7 text-xs font-bold uppercase tracking-[0.18em] text-coral">Online → Showroom → Booking</p>
          <h3 class="mt-2 font-display text-[2rem] font-bold leading-[1.2] tracking-[-0.035em] text-navy sm:text-[2.55rem]">คอร์สเพิ่มยอดขายรถจากออนไลน์ด้วย Content + Ads + AI</h3>
          <p class="mt-5 text-lg font-semibold leading-8 text-navy">ช่วยทีมขายเปลี่ยนคนดูออนไลน์ให้เป็นนัดหมาย ทดลองขับ และยอดจอง</p>
          <ul class="mt-6 space-y-3 text-sm leading-6 text-[#4F4A43] sm:text-base">
