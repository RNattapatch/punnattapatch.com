---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FaqWork from '../components/FaqWork.astro';
import { SITE, SERVICES } from '../data/site';

const title = 'บริการ — AI Transformation สำหรับ SME + CEO Advisory + AI Trust Content';
const description =
  'Basic Foundation AI for Business ฿29,900 · Advance AI & Business Automation ฿39,900 · Package A ฿54,900 (แนะนำ) · Consult ฿25,000/วัน · AI Consultant for CEO ฿35,000/วัน · AI Trust Content Cycle System ฿49,900. จับมือทำจริง ส่งระบบที่รันได้ ไม่ใช่สไลด์';

const svcBySlug = (slug: string) => SERVICES.find((s) => s.slug === slug)!;
const baht = (n: number) => '฿' + n.toLocaleString('en-US');

// ===== ยุบเหลือ 3 ทาง: Training / Consult / ทั้งคู่ (2026-06-23) =====
// ลูกค้าเลือก "เป้าหมาย" ไม่ใช่ "level" — ผมคัด level ให้หลัง intake
// line art แทน emoji (DESIGN.md) · CEO แยกเป็น section เด่น
const paths = [
  {
    key: 'training',
    art: '/lineart/advance-workshop.png',
    name: 'Training — ปั้นทีมให้ใช้ AI เป็น',
    tagline: 'อยากให้ทีมใช้ AI เป็น ทำระบบเองได้',
    forWho: 'องค์กรที่อยากให้พนักงานลงมือใช้ AI กับงานจริง',
    levels: [svcBySlug('ai-workshop'), svcBySlug('ai-workshop-advance')],
    note: 'ผมดูให้ว่าทีมคุณควรเริ่มที่ระดับไหนก่อน',
    featured: false,
    ribbon: '',
  },
  {
    key: 'consult',
    art: '/lineart/ceo-advisory.png',
    name: 'Consult — คู่คิด วางให้',
    tagline: 'ไม่มีเวลาเรียนเอง อยากมีคนวางโครง ตัดสินใจด้วย',
    forWho: 'เจ้าของที่อยากได้คนเข้าใจ AI แทน แล้วแปลงเป็นผลลัพธ์',
    levels: [svcBySlug('consult'), svcBySlug('consult-package')],
    note: 'ผมดูให้ว่าคุณควรเริ่มแบบไหนก่อน',
    featured: false,
    ribbon: '',
  },
  {
    key: 'both',
    art: '/lineart/business-os.png',
    name: 'ทั้งคู่ — วางระบบ + สอนทีม',
    tagline: 'อยากได้ทั้งระบบที่รันได้ และทีมทำต่อเองเป็น',
    forWho: 'อยากให้ผมลงไปวางระบบกับทีมจริง พร้อมปั้นให้ทำต่อเอง',
    levels: [svcBySlug('package-a')],
    note: 'Package A · Advance + Consult 2 วัน · คุ้มสุดในพอร์ต',
    featured: true,
    ribbon: 'แนะนำ',
  },
];

// AI Consultant for CEO — บริการเด่น (แยกชูเดี่ยว ตาม Pun)
const ceo = svcBySlug('ceo-advisory');
// เฉพาะทาง (แยกจาก 3 ทางหลัก)
const special = svcBySlug('trust-content-tiktok-workshop');

// ===== Social proof — testimonial gallery (authority + trust) =====
const testimonials = [
  { src: '/testimonial/web/class-selfie.jpg', alt: 'ทีมพนักงานร่วม Workshop AI Agent กับปัน — ภาพหมู่หลังอบรม' },
  { src: '/testimonial/web/chat-highway.jpg', alt: 'รีวิวจากลูกค้า — อาจารย์ปันสอนถูกใจทีมงานมาก ใช้ AI ได้ทั้งบริษัท' },
  { src: '/testimonial/web/fb-learning-org.jpg', alt: 'โพสต์รีวิวการอบรม AI ในองค์กร — บรรยากาศ Workshop จริง' },
  { src: '/testimonial/web/seminar-room.jpg', alt: 'บรรยากาศห้องสัมมนา AI Agent — ผู้เข้าร่วมเต็มห้อง' },
  { src: '/testimonial/web/pun-consulting.jpg', alt: 'ปันให้คำปรึกษาและสอนการใช้ AI Agent กับทีมลูกค้า' },
  { src: '/testimonial/web/client-gift.jpg', alt: 'ลูกค้านำของขวัญมาขอบคุณปันหลังใช้ระบบ AI ได้จริง' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'ServiceList', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'บริการ', url: `${SITE.url}/services` },
    ],
  }}
>
  <!-- ===== HEADER ===== -->
  <section class="px-margin-page py-16 md:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">บริการ</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-navy md:text-5xl">
        บริการ AI Transformation สำหรับธุรกิจคุณ
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-warm-ink/75">
        จับมือวางระบบ AI ให้ทีมใช้ได้จริง — ปูพื้นทั้งทีมจากศูนย์ ไปจนถึงคู่คิดส่วนตัวระดับผู้บริหาร
      </p>
    </div>
  </section>

  <!-- ===== 3 ทางหลัก: Training / Consult / ทั้งคู่ (ยุบ 2026-06-23) ===== -->
  <section class="px-margin-page pb-12">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-serif text-2xl font-semibold text-navy md:text-3xl">เลือกทางที่ใช่ — แล้วผมคัด level ให้</h2>
      <p class="mt-2 max-w-2xl text-warm-ink/70">
        ไม่ต้องเลือกแพ็กเกจเองให้ปวดหัว — บอกแค่ว่าอยากได้แบบไหน เล่าเรื่องธุรกิจของคุณให้ผมฟัง แล้วผมจะดูให้ว่าควรเริ่มที่ระดับไหน
      </p>

      <div class="mt-8 grid items-start gap-6 md:grid-cols-3">
        {paths.map((p) => (
          <div
            id={p.key}
            class:list={[
              'relative flex h-full flex-col rounded-2xl bg-surface p-7 transition hover:-translate-y-0.5 hover:shadow-[3px_5px_0_rgba(30,27,22,0.06)]',
              p.featured ? 'border-2 border-coral md:-mt-2 md:mb-2 paper-shadow' : 'border border-[#c9c2b2]',
            ]}
          >
            {p.ribbon && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-coral px-4 py-1 text-xs font-semibold text-white shadow-sm">
                ⭐ {p.ribbon}
              </span>
            )}
            <img src={p.art} alt="" aria-hidden="true" loading="lazy" decoding="async" class="mx-auto mb-3 h-28 w-auto" />
            <h3 class="font-serif text-xl font-semibold text-navy">{p.name}</h3>
            <p class="mt-2 font-serif text-base font-medium leading-snug text-navy">{p.tagline}</p>
            <p class="mt-2 text-sm leading-relaxed text-warm-ink/65">เหมาะกับ: {p.forWho}</p>

            <div class="mt-5 space-y-2 border-t border-[#e7e0d2] pt-4">
              {p.levels.map((lv) => {
                const lvTitle = lv.slug === 'consult' ? 'AI Consult บริการที่ปรึกษาสำหรับองค์กร' : lv.title;
                const lvPrice = lv.slug === 'consult' ? '฿25,000/วัน'
                  : lv.slug === 'consult-package' ? 'รายเดือน — ติดต่อผมเพื่อประเมินก่อน'
                  : baht(lv.priceThb);
                return (
                  <div class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="text-warm-ink/85">{lvTitle}</span>
                    <span class="shrink-0 font-medium text-coral">{lvPrice}</span>
                  </div>
                );
              })}
            </div>

            <p class="mt-4 flex flex-1 items-start gap-2 text-sm text-warm-ink/75">
              <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={16} /></span>
              <span>{p.note}</span>
            </p>

            <a
              href={`/booking?path=${p.key}`}
              class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-coral px-6 py-3.5 font-medium text-white transition hover:opacity-90"
            >
              จองคิวรับบริการ →
            </a>
          </div>
        ))}
      </div>

      <p class="mt-5 text-center text-xs text-muted">
        ทุก package ชำระ 100% ก่อนเริ่มบริการ · อบรมหรือปรึกษาที่บริษัทของลูกค้า (On-site)
      </p>
    </div>
  </section>

  <!-- ===== AI Consultant for CEO — บริการเด่น (navy band · ชูเดี่ยว) ===== -->
  <section id="ceo-advisory" class="scroll-mt-24 px-margin-page pb-14">
    <div class="mx-auto max-w-6xl">
      <div class="overflow-hidden rounded-2xl bg-navy px-7 py-10 text-ivory paper-shadow md:px-12 md:py-12">
        <div class="grid items-center gap-8 md:grid-cols-[1.35fr_1fr]">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-coral-soft">สำหรับผู้บริหารโดยเฉพาะ</p>
            <h2 class="mt-3 font-serif text-3xl font-semibold leading-snug md:text-4xl">{ceo.title}</h2>
            <p class="mt-1 text-sm text-ivory/70">{ceo.subtitle}</p>
            <p class="mt-4 max-w-xl font-serif text-lg leading-snug text-ivory/90">{ceo.hook}</p>
            <ul class="mt-5 space-y-2 text-sm text-ivory/80">
              {ceo.outcome.map((o) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 shrink-0 text-coral-soft"><Icon name="check-circle" size={16} /></span>
                  <span>{o}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap items-center gap-5">
              <span class="font-serif text-2xl font-semibold text-coral-soft">{ceo.priceLabel}</span>
              <a href="/booking?path=ceo-advisory" class="inline-flex items-center rounded-xl bg-coral px-6 py-3 font-medium text-white transition hover:opacity-90">
                จองคิวรับบริการ →
              </a>
            </div>
          </div>
          <img src="/lineart/advance-hands.png" alt="มือคนกับมือ AI สัมผัสกัน — คู่คิด AI ของผู้บริหาร" loading="lazy" decoding="async" class="hidden w-full rounded-xl md:block" />
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ — คำถามที่พบบ่อยเกี่ยวกับการทำงานกับผม (ใต้ CEO) ===== -->
  <FaqWork />

  <!-- ===== เฉพาะทาง — AI Trust Content + ตัวช่วยเลือก ===== -->
  <section class="bg-sand px-margin-page py-14 md:py-16">
    <div class="mx-auto max-w-5xl">
      <h2 class="font-serif text-2xl font-semibold text-navy md:text-3xl">บริการเฉพาะทาง</h2>
      <p class="mt-2 text-warm-ink/70">สำหรับเป้าหมายเฉพาะ — ไม่ใช่เส้นหลัก แต่เป็นระบบที่ทำให้ลูกค้าทักมาเอง</p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <!-- AI Trust Content Cycle System -->
        <div id="trust-content" class="scroll-mt-24 flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7">
          <span class="inline-flex w-fit items-center rounded-full border border-navy/20 bg-ivory px-3 py-1 text-xs font-semibold text-navy">
            {special.subtitle}
          </span>
          <img src="/lineart/tiktok-funnel.png" alt="ทีมถ่ายคอนเทนต์โดยมี AI เป็นผู้ช่วยในกองถ่าย" loading="lazy" decoding="async" class="mx-auto mt-4 h-40 w-auto" />
          <h3 class="mt-2 font-serif text-2xl font-semibold leading-snug text-navy">{special.title}</h3>
          <p class="mt-3 font-serif text-base font-medium leading-snug text-navy">{special.hook}</p>
          <ul class="mt-4 flex-1 space-y-2 text-sm text-warm-ink/75">
            {special.outcome.map((o) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={16} /></span>
                <span>{o}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 flex items-baseline gap-2">
            <span class="font-serif text-2xl font-semibold text-coral">{baht(special.priceThb)}</span>
            <span class="text-sm text-muted line-through">{baht(59900)}</span>
          </div>
          <a href="/booking?path=trust-content" class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-coral px-6 py-3.5 font-medium text-white transition hover:opacity-90">
            จองคิวรับบริการ →
          </a>
        </div>

        <!-- ตัวช่วยเลือก (ยังไม่แน่ใจ → intake) -->
        <div class="flex flex-col justify-center rounded-2xl border border-dashed border-[#c9c2b2] bg-surface/60 p-7">
          <h3 class="font-serif text-xl font-semibold text-navy">ยังไม่แน่ใจว่าทางไหนใช่?</h3>
          <p class="mt-3 text-sm leading-relaxed text-warm-ink/70">
            เล่าธุรกิจให้ผมฟังสั้นๆ ผมอ่านเองแล้วบอกตรงๆ ว่าควรเริ่มจาก Training, Consult หรือทั้งคู่ — และระดับไหนที่คุ้มกับคุณที่สุด
          </p>
          <a href="/intake-form" class="mt-5 inline-flex w-fit items-center rounded-xl border border-coral px-6 py-3 font-medium text-coral transition hover:bg-coral hover:text-white">
            ให้ผมช่วยดูให้ →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PAYMENT TERMS ===== -->
  <section class="border-y border-base-content/10 bg-base-200/30 px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-2xl font-bold tracking-tight">เงื่อนไขร่วมกันทุกแพ็กเกจ</h2>
      <dl class="mt-8 space-y-5">
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">ชำระเงิน</dt>
          <dd class="text-base-content/80">100% upfront ไม่มีข้อยกเว้น ทั้งสองฝ่าย commit เต็มที่ตั้งแต่วันแรก</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">สัญญา</dt>
          <dd class="text-base-content/80">ไม่มี lock-in ยาว จบงานจบสัญญา ใช้ระบบที่ส่งมอบต่อเองได้</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">เทคโนโลยีที่ใช้</dt>
          <dd class="text-base-content/80">Claude Code + AI Automation Platform + Google Apps Script / Sheets — ไม่มี vendor lock-in</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">การส่งมอบงาน</dt>
          <dd class="text-base-content/80">ทีมของลูกค้าดูแลระบบต่อเองได้ — มีคู่มือและการอบรมให้</dd>
        </div>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">ค่าเดินทาง (on-site ต่างจังหวัด)</dt>
          <dd class="text-base-content/80">คำนวณแยกตามจริง แจ้งก่อนรับงาน</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===== ROI COMPARISON — Public vs In-house ===== -->
  <section class="border-b border-base-content/10 px-4 py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">ทำไมต้องเรียนกับผม</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
        ทำไมผมไม่จัดคอร์สเปิดทั่วไป
      </h2>
      <p class="mt-3 max-w-2xl text-base-content/75">
        ลูกค้าของผมต้องได้มากกว่าที่จ่ายมาเสมอ ไม่ใช่แค่ได้ฟังบรรยาย
      </p>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-base-content/15">
        <table class="w-full text-sm md:text-base">
          <thead>
            <tr class="border-b border-base-content/15">
              <th class="px-4 py-4 text-left font-medium text-base-content/65 md:px-6"></th>
              <th class="px-4 py-4 text-center font-semibold text-base-content/75 md:px-6">
                คอร์สทั่วไป
              </th>
              <th class="bg-secondary/10 px-4 py-4 text-center font-bold text-secondary md:px-6">
                เรียนกับผม (In-house)
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-content/10">
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">รูปแบบ</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">พูดเร็ว ข้ามเร็ว ตามไม่ทันก็ช่างมัน</td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">ไม่ปล่อยกลับบ้านถ้ายังไม่เข้าใจ</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">Workshop</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">ดูสไลด์แล้วจบ</td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">จับมือทำทุกขั้นตอน</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">กลับไปแล้ว</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">ทำเองไม่ได้</td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">พนักงานใช้งานได้จริงทันที</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">ค่า Software</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">จ่ายรายเดือนไปเรื่อยๆ</td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">เขียน App ใช้เองได้เลย</td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">ทีมงาน</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">ท่องสเปคไปขอส่วนลด</td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">คุยกับลูกค้าได้ลึก เข้าใจ pain จริงๆ</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-2xl border border-secondary/30 bg-secondary/[0.06] p-8 text-center">
        <p class="font-display text-xl font-bold leading-tight md:text-2xl">
          จบ Workshop แล้ว ทีมคุณต้องเอาไปใช้งานได้จริง
        </p>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-base-content/75">
          ผมไม่ได้มาสอนแค่ให้ฟังแล้วจบ ทุกคนที่เข้า Workshop ต้องลงมือทำจริงในห้อง
          กลับไปวันรุ่งขึ้นเปิดเครื่องมือที่สร้างไว้ใช้งานได้เลย ไม่ต้องรอใคร
        </p>
      </div>
    </div>
  </section>

  <!-- ===== SOCIAL PROOF — Testimonials ===== -->
  <section class="bg-sand px-margin-page py-14 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">เสียงจากลูกค้า</p>
      <h2 class="mt-3 font-serif text-2xl font-semibold leading-tight text-navy md:text-3xl">
        ทีมที่ผมเข้าไปวางระบบให้ — ใช้งานได้จริง
      </h2>
      <p class="mt-2 max-w-2xl text-warm-ink/70">
        รีวิวและบรรยากาศจริงจากองค์กรที่ผมจับมือทำ — ไม่ใช่สไลด์ แต่เป็นผลลัพธ์ที่ทีมรันต่อเองได้
      </p>

      <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3">
        {testimonials.map((t) => (
          <figure class="overflow-hidden rounded-2xl border border-[#c9c2b2] bg-surface p-2 paper-shadow transition hover:-translate-y-0.5">
            <img
              src={t.src}
              alt={t.alt}
              class="aspect-square w-full rounded-xl object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="px-4 py-20 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl bg-primary px-6 py-12 text-primary-content md:px-12">
      <h2 class="font-display text-2xl font-bold leading-tight md:text-3xl">
        ไม่แน่ใจว่าเริ่มจากแพ็กเกจไหน?
      </h2>
      <p class="mt-4 max-w-2xl text-primary-content/80">
        ตอบแบบประเมิน 3 นาที เล่าข้อมูลธุรกิจของคุณ ผมตอบกลับภายใน 2 วันทำการว่าเคสคุณตรงกับแพ็กเกจไหนที่สุด
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a
          href="/intake-form"
          class="btn btn-lg bg-secondary text-secondary-content shadow-lg shadow-secondary/30 hover:bg-secondary/90"
        >
          ประเมินความพร้อมกับผม — ผมดูให้ว่าเริ่มจากไหน
        </a>
        <a
          href={SITE.social.line}
          rel="noopener"
          target="_blank"
          class="btn btn-lg btn-outline text-primary-content hover:bg-primary-content hover:text-primary"
        >
          ทักมาคุยใน LINE OA
        </a>
      </div>
      <div class="mt-4 inline-flex items-start gap-2 rounded-lg bg-black/25 px-3 py-2 text-xs text-primary-content max-w-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 flex-shrink-0 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>ผมคุยเอง ไม่ได้ใช้ AI ตอบครับ :)</span>
      </div>
    </div>
  </section>
</BaseLayout>
