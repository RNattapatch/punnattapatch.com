---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { fmtPrice, CATALOG } from '../data/pricing.mjs';

const title = 'คอร์สอบรมทีมขาย และบริการวางระบบฝ่ายขาย';
const description = 'คอร์สเพิ่มยอดขายสำหรับทีมขาย และบริการวางระบบฝ่ายขาย — โครงทีม KPI ค่าคอม Dashboard และ Report อัตโนมัติ โดยใช้ AI ลดงานที่ทีมไม่ควรเสียเวลาทำเอง';
// การ์ดอ่านจาก SSOT ตรงๆ (src/data/pricing.mjs) — ชื่อ ราคา ระยะเวลา headline แก้ที่เดียว
// IA ตาม master strategy §14: Training grid แยกจาก Services grid ห้ามปนกัน
const serviceOffers = ['sales-team-structure', 'daruma-starter', 'ai-agent-ceo'].map((key) => ({ key, ...CATALOG[key] }));
const proofGallery = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'Person', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [{ name: 'หน้าแรก', url: SITE.url }, { name: 'บริการ', url: `${SITE.url}/services` }],
  }}
>
  <section class="border-b border-[#c9c2b2] bg-ivory px-6 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">วางระบบและพัฒนาทีมขายสำหรับ SME</p>
      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight text-navy md:text-6xl">ทีมขายคุณเนี่ย ยังพึ่งคนเก่งอยู่คนเดียวรึเปล่าครับ</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-warm-ink/75">ผมช่วยเจ้าของธุรกิจวางระบบเพิ่มยอดขายและคุมทีมขายครับ ตั้งแต่การหาลูกค้า การติดตาม ไปจนถึงการบริหารผลงาน โดยใช้ AI และ Data ลดงานที่ทีมไม่ควรเสียเวลาทำเอง — เลือกได้สองทาง: อบรมให้ทีมทำเป็น หรือให้ผมเข้าไปวางระบบให้ใช้งานจริง</p>
      <a href="/booking" class="btn mt-8 border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยฟรีกับผม</a>
    </div>
  </section>

  <!-- ===== Section 1: คอร์สอบรมสำหรับทีมขาย (Training grid — ห้ามปนกับ Services grid) ===== -->
  <section class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Training · สอนให้ทีมทำเป็น</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-snug text-navy md:text-5xl">คอร์สอบรมสำหรับทีมขาย</h2>
        <p class="mt-4 leading-relaxed text-warm-ink/75">ทุกคอร์สจัด In-house ที่บริษัทคุณ ราคาเดียวทั้งทีมไม่เกิน 20 คน — เรียนจากข้อมูล ลูกค้า และวิธีขายจริงของบริษัท ไม่ใช่เคสกลางๆ ในสไลด์</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <article id="inhouse-a" class="flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">In-house · 1 วัน</p>
          <h3 class="mt-3 font-display text-2xl font-bold text-navy md:text-3xl">คอร์สเพิ่มยอดขายด้วย AI สำหรับทีมขาย</h3>
          <p class="mt-1 text-sm text-warm-ink/60">Sales × AI Agent</p>
          <p class="mt-3 text-lg font-semibold text-navy">เพิ่มยอด · ตามลูกค้าไม่หลุด · ลดงานเอกสารทีมขาย</p>
          <p class="mt-5 font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('inhouse-a')}</p>
          <p class="mt-5 leading-relaxed text-warm-ink/75">ช่วยทีมสร้างโอกาสขาย ติดตามลูกค้า และเปลี่ยน Lead ให้เป็นยอดขายครับ — AI เข้ามาช่วยลดเวลาผลิตสื่อ ค้นข้อมูล และเขียนข้อความติดตาม ทีมได้ลงมือทำกับเคสจริงของบริษัทในห้อง</p>
          <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
            <li><strong class="text-navy">เหมาะกับ:</strong> เจ้าของ หัวหน้า และเซลล์ที่อยากเริ่มพร้อมกัน</li>
            <li><strong class="text-navy">ได้กลับไป:</strong> Follow-up sequence ตาม Stage + AI ผู้ช่วยงานขายที่ผูกกับงานของทีม + แผนใช้จริง 14 วัน</li>
            <li><strong class="text-navy">รูปแบบ:</strong> 1 วัน · ที่บริษัทคุณ · ไม่เกิน 20 คน</li>
          </ul>
          <a href="/booking?path=inhouse-a" class="btn mt-8 w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">จองคิวคุยฟรี</a>
        </article>

        <article id="sales-report" class="flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">In-house · 1 วัน</p>
          <h3 class="mt-3 font-display text-2xl font-bold text-navy md:text-3xl">คอร์สอบรม Report ทีมขาย + Dashboard + AI</h3>
          <p class="mt-1 text-sm text-warm-ink/60">Sales Report & Dashboard × AI</p>
          <p class="mt-3 text-lg font-semibold text-navy">ทีมรายงานภาษาเดียวกัน — ผู้จัดการเห็นดีลค้างและงานที่ต้องตาม</p>
          <p class="mt-5 font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('ai-workshop-advance')}</p>
          <p class="mt-5 leading-relaxed text-warm-ink/75">ผู้จัดการที่ต้องไล่ถามยอดทีละคนทุกเย็นจะได้เลิกทำครับ — เราล็อก Sales stage กับข้อมูลที่ทุกคนต้องกรอกให้เป็นชุดเดียวกัน วางโครง Daily report แล้วให้ AI ช่วยรวมและสรุปให้อ่านจบในหน้าเดียว</p>
          <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
            <li><strong class="text-navy">เหมาะกับ:</strong> Owner · Sales Manager · Sales Admin และ Back Office ที่รวมรายงานด้วยมือ</li>
            <li><strong class="text-navy">ได้กลับไป:</strong> Sales stage dictionary + Daily report template + Follow-up template + Dashboard wireframe</li>
            <li><strong class="text-navy">รูปแบบ:</strong> 1 วัน · ที่บริษัทคุณ · ไม่เกิน 20 คน</li>
          </ul>
          <a href="/booking?path=sales-report" class="btn mt-8 w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">จองคิวคุยฟรี</a>
        </article>

        <article id="trust-content" class="relative flex flex-col rounded-2xl border-2 border-coral bg-surface p-7 md:p-9">
          <span class="absolute -top-3 left-6 rounded-full bg-coral px-3 py-1 text-xs font-bold text-white">2 วันเต็ม</span>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">In-house · 2 วัน + ดูแลต่อ 30 วัน</p>
          <h3 class="mt-3 font-display text-2xl font-bold text-navy md:text-3xl">คอร์สเพิ่มยอดขายจากออนไลน์ด้วย Content + Ads + AI</h3>
          <p class="mt-1 text-sm text-warm-ink/60">Online-to-Sales × Content + Ads + AI</p>
          <p class="mt-3 text-lg font-semibold text-navy">ช่วยทีมขายเปลี่ยนคนดูออนไลน์ให้เป็นแชต นัดหมาย และยอดขาย</p>
          <div class="mt-5 flex items-end gap-3"><p class="font-display text-xl tabular-nums text-warm-ink/50 line-through">{fmtPrice('tiktok-workshop-regular')}</p><p class="font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('tiktok-workshop')}</p></div>
          <p class="mt-5 leading-relaxed text-warm-ink/75">วันแรกสร้างลูกค้าจากออนไลน์ครับ — Content, ภาพและคลิปจากสินค้าจริง, Ads test วันที่สองเปลี่ยน Lead เป็นยอดขาย — คัดกรอง แชต ติดตาม ส่งต่อทีมขาย พร้อมระบบ Tracking และแผนคอนเทนต์ 14 วัน</p>
          <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
            <li><strong class="text-navy">เหมาะกับ:</strong> บริษัทที่ทำ Content/Ads หรือรับ Lead ออนไลน์อยู่แล้ว แต่ยอดไม่ตามมา</li>
            <li><strong class="text-navy">ได้กลับไป:</strong> Funnel map + Campaign kit + Chat script + Tracking sheet + Content plan 14 วัน</li>
            <li><strong class="text-navy">รูปแบบ:</strong> 2 วัน · ที่บริษัทคุณ · ไม่เกิน 20 คน · ดูแลต่อ 30 วัน</li>
          </ul>
          <a href="/booking?path=trust-content" class="btn mt-8 w-full border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยฟรี</a>
        </article>
      </div>

      <!-- Vertical edition strip — การ์ด edition ชี้ LP เฉพาะวงการ (BHSV: core เดียว vertical เปลี่ยนแค่ภาษาหน้าร้าน) -->
      <div class="mt-6 rounded-2xl border border-[#c9c2b2] bg-sand px-6 py-5 md:flex md:items-center md:justify-between md:gap-6">
        <p class="leading-relaxed text-warm-ink/80"><strong class="text-navy">ทำธุรกิจ Dealer รถใหม่?</strong> คอร์ส 2 วันตัวนี้มีรุ่นเจาะวงการ — คอร์สเพิ่มยอดขายรถจากออนไลน์ด้วย Content + Ads + AI ตัวอย่างและแบบฝึกหัดเป็นงานโชว์รูมทั้งหมด ราคาเดียวกัน</p>
        <a href="/ads/dealer-online-sales" class="btn mt-4 shrink-0 border-navy bg-transparent text-navy hover:bg-navy hover:text-white md:mt-0">ดูรายละเอียด Dealer Edition</a>
      </div>
    </div>
  </section>

  <section class="border-t border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">หลักฐานจากงานจริง</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-snug text-navy md:text-5xl">รีวิวและบรรยากาศจากงานที่เกิดขึ้นจริง</h2>
        <p class="mt-4 leading-relaxed text-warm-ink/75">ก่อนเลือกวันให้ทีม ผมอยากให้เห็นทั้งรูปกิจกรรมและแชทที่ลูกค้าส่งมาหลังจบงานครับ</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {proofGallery.map((proof, index) => (
          <figure class:list={[
            'rounded-2xl border border-[#c9c2b2] bg-surface p-2 shadow-[3px_5px_0_rgba(30,27,22,0.07)]',
            index % 2 === 0 ? 'rotate-[0.4deg]' : '-rotate-[0.4deg]',
          ]}>
            <img src={proof.src} alt={proof.alt} width={proof.width} height={proof.height} loading="lazy" decoding="async" class="aspect-square w-full rounded-xl object-cover" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Section 2: บริการวางระบบฝ่ายขาย (Services grid — การ์ดอ่านจาก SSOT) ===== -->
  <section class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Consulting · ผมเข้าไปวางระบบให้ใช้งานจริง</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-navy md:text-4xl">บริการวางระบบฝ่ายขาย</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-warm-ink/75">อบรมช่วยให้ทีมทำเป็นครับ แต่บางเรื่องต้องมีคนเข้าไปวางระบบกับข้อมูลจริงถึงหน้างาน — สามตัวนี้คืองานที่ผมลงมือทำกับทีมคุณเอง ส่งมอบเป็นระบบที่ใช้ต่อได้ทุกวัน</p>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {serviceOffers.map((offer) => (
          <article id={offer.key} class="flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:p-9">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">{offer.duration}</p>
            <h3 class="mt-3 font-display text-2xl font-bold text-navy md:text-3xl">{offer.name}</h3>
            {offer.nameEn && <p class="mt-1 text-sm text-warm-ink/60">{offer.nameEn}</p>}
            <p class="mt-3 text-lg font-semibold text-navy">{offer.headline}</p>
            <p class="mt-5 font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice(offer.key)}</p>
            <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
              <li><strong class="text-navy">เหมาะกับ:</strong> {offer.audience}</li>
              <li><strong class="text-navy">รูปแบบ:</strong> In-house ที่บริษัทคุณ · ผมลงไปทำกับทีมเอง</li>
            </ul>
            <a href={`/booking?path=${offer.key}`} class="btn mt-8 w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">จองคิวคุยฟรี</a>
          </article>
        ))}
      </div>

      <!-- Recurring — ไม่โชว์ราคา (เสนอหลังงานแรกผ่าน proposal เท่านั้น) -->
      <div class="mt-6 rounded-2xl border border-dashed border-[#c9c2b2] px-6 py-5">
        <p class="leading-relaxed text-warm-ink/75"><strong class="text-navy">หลังระบบเดินแล้ว</strong> — มีบริการดูแลระบบและที่ปรึกษาบริหารทีมขายรายเดือน (Review pipeline + โค้ชผู้จัดการ + ดูแลระบบ) เสนอเป็น proposal หลังงานแรกครับ ไม่ขายแยกหน้าเว็บ</p>
      </div>
    </div>
  </section>
</BaseLayout>
