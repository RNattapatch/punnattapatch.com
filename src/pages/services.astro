---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SERVICES } from '../data/site';

const title = 'บริการ — AI Transformation สำหรับ SME + CEO Advisory + AI Trust Content';
const description =
  'AI Transformation สำหรับ SME: Basic AI Workshop ฿29,800 · Advance ฿35,800 · Bundle Day1+2 ฿48,900 · ที่ปรึกษา AI ส่วนตัวสำหรับผู้บริหาร (CEO Advisory) · AI-Powered Trust Content. จับมือทำจริง ส่งระบบที่รันได้ ไม่ใช่สไลด์';

const svcBySlug = (slug: string) => SERVICES.find((s) => s.slug === slug)!;

const aiDay = svcBySlug('ai-workshop');
const tiktokWorkshop = svcBySlug('trust-content-tiktok-workshop');
// Sales packages (Sale Training Bundle / Sales System Sprint) removed from web showcase
// per refocus 2026-06-07 — still sold 1-on-1 via catalog · sales = credibility not product.

const priceShort = (label: string) => label.replace(/\s*\/.*$/, '');

type AiPkg = {
  svc: (typeof SERVICES)[number];
  durationLabel: string;
  persona: string;
  tier: 'entry' | 'advanced';
  bullets: string[];
};

const aiPackages: AiPkg[] = [
  {
    svc: aiDay,
    durationLabel: '1 Day · Day 1',
    tier: 'entry',
    persona: '👋 ไม่รู้จะเริ่มยังไง — เรียนตัวนี้ก่อน',
    bullets: [
      'สร้าง AI Agent ตัวแรกของทีม ใช้งานได้จริงตั้งแต่ในห้อง',
      'วางระบบงานอัตโนมัติ + ชุดคำสั่ง AI ที่ทดสอบแล้ว 30 ชุด',
      'หัวหน้าทีมดูแลระบบต่อเองได้หลังส่งมอบ',
      'ตอบคำถามผ่าน LINE ต่อเนื่อง 30 วัน',
      'ซื้อคู่ Day 1+2: ฿48,900 (ประหยัด ฿16,700)',
    ],
  },
  {
    svc: svcBySlug('ai-workshop-advance'),
    durationLabel: '1 Day · Day 2',
    tier: 'advanced',
    persona: '⚡ อยากเก่งขึ้น เทพขึ้น — มาทางนี้เลย',
    bullets: [
      'ต้องผ่าน Basic Workshop (Day 1) มาก่อน',
      'AI หลายตัวทำงานร่วมกัน · เชื่อม LINE OA + CRM เข้าด้วยกัน',
      'รายงานสรุปยอดส่งให้อัตโนมัติทุกเช้า',
      'มีคู่มือดูแลระบบ · หัวหน้าทีมขยายต่อเองได้',
      'ซื้อคู่ Day 1+2: ฿48,900 (ประหยัด ฿16,700)',
    ],
  },
];

// TYPE C — AI Consultant for CEO (web price ฿35,000/วัน ONLY · retainer ฿50K/เดือน = backstage, NOT on web)
// Copy from agent/sale-team/service-detail.md TYPE C (scope verbatim).
const ceoAdvisory = {
  name: 'AI Consultant for CEO',
  th: 'ที่ปรึกษา AI ส่วนตัวสำหรับผู้บริหาร',
  price: '฿35,000 / วัน',
  hook: 'ผู้บริหารอยากใช้ AI ให้ถูกทาง แต่ไม่มีเวลานั่งเรียนเอง',
  bullets: [
    'คู่คิด AI ส่วนตัวของผู้บริหาร — รับโจทย์ธุรกิจ แล้วแปลงเป็นแนวทาง AI ที่ทำได้จริง',
    'ช่วยตัดสินใจว่าควรสร้างเอง ซื้อ หรือรอ · เลือกงานที่คุ้มที่สุดมาทำก่อน',
    'วางแผน AI ของทั้งองค์กร + กรองความเสี่ยงเรื่องการวางระบบและความปลอดภัยข้อมูล',
    'จับมือคิดไปด้วยกัน ไม่ใช่รับจ้างลงมือทำแทน',
  ],
};

// AI layer chips for the rescoped Trust Content service (P6 → AI-Powered Trust Content)
const trustChips = [
  'AI ช่วยหาแกนเนื้อหาจากธุรกิจ',
  'AI ช่วยร่างสคริปต์และฮุก',
  'แปลง 1 คลิปเป็นหลายแบบ',
  'ระบบคอนเทนต์ที่ไหลเอง',
  '3 คลิปถ่ายจริง + ตามผลให้',
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'ServiceList', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'บริการ', url: `${SITE.url}/services` },
    ],
  }}
>
  <!-- ===== HEADER ===== -->
  <section class="px-margin-page py-16 md:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-coral">บริการ</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-navy md:text-5xl">
        บริการ AI Transformation สำหรับธุรกิจคุณ
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-warm-ink/75">
        จับมือวางระบบ AI ให้ทีมใช้ได้จริง — จากอบรมทั้งทีม ไปจนถึงคู่คิดส่วนตัวระดับผู้บริหาร
        ทุก package ชำระ 100% upfront · ส่งระบบที่รันได้จริง ไม่ใช่สไลด์
      </p>
    </div>
  </section>

  <!-- ===== AI TRANSFORMATION — Basic / Advance ===== -->
  <section class="px-margin-page pb-12">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-serif text-2xl font-semibold text-navy md:text-3xl">คอร์สอบรม AI Transformation</h2>
      <p class="mt-2 text-warm-ink/70">เริ่มที่ Day 1 สร้าง AI Agent ตัวแรก แล้วต่อ Day 2 ให้ระบบทั้งบริษัทวิ่งด้วย AI</p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {aiPackages.map((p) => (
          <div
            id={p.svc.slug}
            class:list={[
              'scroll-mt-24 flex flex-col rounded-2xl bg-surface p-7 transition hover:-translate-y-0.5 hover:shadow-[3px_5px_0_rgba(30,27,22,0.06)]',
              p.tier === 'advanced' ? 'border-2 border-coral/50' : 'border border-[#c9c2b2]',
            ]}
          >
            <p class="text-xs font-semibold text-coral">{p.persona}</p>
            <span class="mt-3 text-xs uppercase tracking-widest text-muted">{p.durationLabel}</span>
            <div class="mt-1 flex items-baseline justify-between gap-3">
              <h3 class="font-serif text-xl font-semibold text-navy">{p.svc.title}</h3>
              <div class="font-serif text-2xl font-semibold text-coral">{priceShort(p.svc.priceLabel)}</div>
            </div>
            <p class="mt-3 text-sm text-warm-ink/70">"{p.svc.hook}"</p>
            <ul class="mt-4 flex-1 space-y-2 text-sm text-warm-ink/75">
              {p.bullets.map((b) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={16} /></span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/booking?package=${p.svc.slug}`}
              class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-coral px-6 py-3.5 font-medium text-white transition hover:opacity-90"
            >
              {p.tier === 'advanced' ? 'Level Up' : 'เริ่มเลย'} · {priceShort(p.svc.priceLabel)} →
            </a>
            <a
              href={p.tier === 'advanced' ? '/ai-workshop-advance' : `/services/${p.svc.slug}`}
              class="mt-2 block text-center text-xs font-medium text-navy/70 transition hover:text-coral"
            >
              ดูรายละเอียดเพิ่มเติม →
            </a>
          </div>
        ))}
      </div>

      <p class="mt-5 text-center text-xs text-muted">
        Basic ฿29,800 · Advance ฿35,800 · Bundle Day1+2 ฿48,900 (ประหยัด ฿16,700)
      </p>
    </div>
  </section>

  <!-- ===== CEO ADVISORY + AI TRUST CONTENT ===== -->
  <section class="px-margin-page pb-16 md:pb-20">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-2">
      <!-- AI Consultant for CEO (TYPE C · web price ฿35,000/วัน only) -->
      <div id="ceo-advisory" class="scroll-mt-24 flex flex-col rounded-2xl border-2 border-coral/40 bg-surface p-7 paper-shadow">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center gap-2 rounded-full bg-navy px-3 py-1 text-xs font-semibold text-ivory">
            <span class="h-1.5 w-1.5 rounded-full bg-coral" aria-hidden="true"></span> ใหม่ · 1-on-1
          </span>
          <span class="text-coral" aria-hidden="true"><Icon name="user-circle" size={32} /></span>
        </div>
        <h3 class="mt-4 font-serif text-2xl font-semibold leading-snug text-navy">{ceoAdvisory.th}</h3>
        <div class="mt-1 font-serif text-2xl font-semibold text-coral">{ceoAdvisory.price}</div>
        <p class="mt-3 text-sm text-warm-ink/70">"{ceoAdvisory.hook}"</p>
        <ul class="mt-4 flex-1 space-y-2 text-sm text-warm-ink/75">
          {ceoAdvisory.bullets.map((b) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 shrink-0 text-coral"><Icon name="check-circle" size={16} /></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <a
          href="/booking"
          class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-coral px-6 py-3.5 font-medium text-white transition hover:opacity-90"
        >
          คุยกับผม · {ceoAdvisory.price} →
        </a>
      </div>

      <!-- AI-Powered Trust Content (rescoped from TikTok workshop · P6) -->
      <div id="trust-content" class="scroll-mt-24 flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7">
        <div class="flex items-center justify-between gap-3">
          <span class="inline-flex items-center rounded-full border border-navy/20 bg-ivory px-3 py-1 text-xs font-semibold text-navy">
            พิเศษ · 1 วัน In-house
          </span>
          <span class="text-coral" aria-hidden="true"><Icon name="paper-airplane" size={30} /></span>
        </div>
        <h3 class="mt-4 font-serif text-2xl font-semibold leading-snug text-navy">AI-Powered Trust Content</h3>
        <p class="mt-3 text-sm text-warm-ink/70">
          ใช้ AI ช่วยผลิตคอนเทนต์สร้างความน่าเชื่อถือสำหรับธุรกิจ B2B ที่ปิดการขายได้ — ถ่ายครั้งเดียว
          AI ช่วยคิดแกนเนื้อหาและสคริปต์ แล้วแตกเป็นหลายชิ้น เป็นระบบคอนเทนต์ที่ไหลเองโดยไม่ต้องจ้างทีม
        </p>
        <div class="mt-4 flex flex-1 flex-wrap content-start gap-2">
          {trustChips.map((chip) => (
            <span class="inline-flex items-center rounded-full border border-[#c9c2b2] bg-ivory px-3 py-1 text-xs text-warm-ink/75">{chip}</span>
          ))}
        </div>
        {/* TODO(price · Pun confirm): catalog P6 = ฿39,900 (list ฿50,000) · site.ts trust-content = ฿44,900 (list ฿52,800) · เดิม button = ฿39,900 — 3 ตัวเลขไม่ตรงกัน ยังไม่แก้ตัวเลข รอ Pun ยืนยัน */}
        <p class="mt-5 text-sm text-warm-ink/60">ราคา In-house — สอบถาม/นัดคุยเพื่อรับใบเสนอราคา</p>
        <a
          href={`/booking?package=${tiktokWorkshop.slug}`}
          class="mt-3 inline-flex w-full items-center justify-center rounded-xl border border-navy/30 bg-transparent px-6 py-3.5 font-medium text-navy transition hover:border-coral hover:text-coral"
        >
          สอบถามรายละเอียด →
        </a>
      </div>
    </div>
  </section>

  <!-- ===== PAYMENT TERMS ===== -->
  <section class="border-y border-base-content/10 bg-base-200/30 px-4 py-16 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-2xl font-bold tracking-tight">เงื่อนไขร่วมกันทุกแพ็กเกจ</h2>
      <dl class="mt-8 space-y-5">
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">ชำระเงิน</dt>
          <dd class="text-base-content/80">100% upfront ไม่มีข้อยกเว้น ทั้งสองฝ่าย commit เต็มที่ตั้งแต่วันแรก</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">สัญญา</dt>
          <dd class="text-base-content/80">ไม่มี lock-in ยาว จบงานจบสัญญา ใช้ระบบที่ส่งมอบต่อเองได้</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">เทคโนโลยีที่ใช้</dt>
          <dd class="text-base-content/80">Claude Code + AI Automation Platform + Google Apps Script / Sheets — ไม่มี vendor lock-in</dd>
        </div>
        <div class="flex flex-col gap-1 border-b border-base-content/10 pb-4 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">การส่งมอบงาน</dt>
          <dd class="text-base-content/80">ทีมของลูกค้าดูแลระบบต่อเองได้ — มีคู่มือและการอบรมให้</dd>
        </div>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <dt class="font-semibold">ค่าเดินทาง (on-site ต่างจังหวัด)</dt>
          <dd class="text-base-content/80">คำนวณแยกตามจริง แจ้งก่อนรับงาน</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ===== ROI COMPARISON — Public vs In-house ===== -->
  <section class="border-b border-base-content/10 px-4 py-20 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <p class="text-xs font-bold uppercase tracking-widest text-secondary">ทำไมต้องเรียนกับผม</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
        ทำไมผมไม่จัดคอร์สเปิดทั่วไป
      </h2>
      <p class="mt-3 max-w-2xl text-base-content/75">
        ลูกค้าของผมต้องได้มากกว่าที่จ่ายมาเสมอ ไม่ใช่แค่ได้ฟังบรรยาย
      </p>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-base-content/15">
        <table class="w-full text-sm md:text-base">
          <thead>
            <tr class="border-b border-base-content/15">
              <th class="px-4 py-4 text-left font-medium text-base-content/65 md:px-6"></th>
              <th class="px-4 py-4 text-center font-semibold text-base-content/75 md:px-6">
                คอร์สทั่วไป
              </th>
              <th
                class="bg-secondary/10 px-4 py-4 text-center font-bold text-secondary md:px-6"
              >
                เรียนกับผม (In-house)
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-base-content/10">
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">รูปแบบ</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">
                พูดเร็ว ข้ามเร็ว ตามไม่ทันก็ช่างมัน
              </td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">
                ไม่ปล่อยกลับบ้านถ้ายังไม่เข้าใจ
              </td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">Workshop</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">
                ดูสไลด์แล้วจบ
              </td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">
                จับมือทำทุกขั้นตอน
              </td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">กลับไปแล้ว</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">
                ทำเองไม่ได้
              </td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">
                พนักงานใช้งานได้จริงทันที
              </td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">ค่า Software</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">
                จ่ายรายเดือนไปเรื่อยๆ
              </td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">
                เขียน App ใช้เองได้เลย
              </td>
            </tr>
            <tr>
              <td class="px-4 py-4 font-medium md:px-6">ทีมงาน</td>
              <td class="px-4 py-4 text-center text-base-content/75 md:px-6">
                ท่องสเปคไปขอส่วนลด
              </td>
              <td class="bg-secondary/[0.04] px-4 py-4 text-center text-base-content md:px-6">
                คุยกับลูกค้าได้ลึก เข้าใจ pain จริงๆ
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div
        class="mt-8 rounded-2xl border border-secondary/30 bg-secondary/[0.06] p-8 text-center"
      >
        <p class="font-display text-xl font-bold leading-tight md:text-2xl">
          จบ Workshop แล้ว ทีมคุณต้องเอาไปใช้งานได้จริง
        </p>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-base-content/75">
          ผมไม่ได้มาสอนแค่ให้ฟังแล้วจบ ทุกคนที่เข้า Workshop ต้องลงมือทำจริงในห้อง
          กลับไปวันรุ่งขึ้นเปิดเครื่องมือที่สร้างไว้ใช้งานได้เลย ไม่ต้องรอใคร
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="px-4 py-20 lg:px-8">
    <div class="mx-auto max-w-4xl rounded-3xl bg-primary px-6 py-12 text-primary-content md:px-12">
      <h2 class="font-display text-2xl font-bold leading-tight md:text-3xl">
        ไม่แน่ใจว่าเริ่มจากแพ็กเกจไหน?
      </h2>
      <p class="mt-4 max-w-2xl text-primary-content/80">
        ตอบแบบประเมิน 3 นาที เล่าข้อมูลธุรกิจของคุณ ผมตอบกลับภายใน 2 วันทำการว่าเคสคุณตรงกับแพ็กเกจไหนที่สุด
      </p>
      <div class="mt-7 flex flex-wrap gap-4">
        <a
          href="/intake-form"
          class="btn btn-lg bg-secondary text-secondary-content shadow-lg shadow-secondary/30 hover:bg-secondary/90"
        >
          นัดคุยกับผม — เช็คว่าองค์กรคุณพร้อมแค่ไหน
        </a>
        <a
          href={SITE.social.line}
          rel="noopener"
          target="_blank"
          class="btn btn-lg btn-outline text-primary-content hover:bg-primary-content hover:text-primary"
        >
          ทักมาคุยใน LINE OA
        </a>
      </div>
      <div class="mt-4 inline-flex items-start gap-2 rounded-lg bg-black/25 px-3 py-2 text-xs text-primary-content max-w-md">
