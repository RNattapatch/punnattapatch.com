  <script>
    // Lucide icons
    lucide.createIcons();

    // LINE copy-message modal
    (function () {
      const modal = document.getElementById('line-modal');
      if (!modal) {
        console.log('Creating LINE modal...');
        const dialog = document.createElement('dialog');
        dialog.id = 'line-modal';
        dialog.className = 'w-[92%] max-w-md rounded-2xl border border-[#c9c2b2] bg-surface p-0 text-warm-ink shadow-xl backdrop:bg-black/40';
        dialog.innerHTML = `
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-display text-lg font-semibold text-navy">ทักไปคุยใน LINE OA</h3>
              <button type="button" id="line-modal-close" aria-label="ปิด" class="shrink-0 text-muted transition hover:text-navy"><i data-lucide="x" class="size-5" aria-hidden="true"></i></button>
            </div>
            <p class="mt-2 text-sm text-warm-ink/70">คัดลอกข้อความนี้ไปวางใน LINE ได้เลย</p>
            <p id="line-msg" class="mt-3 rounded-xl border border-[#c9c2b2] bg-ivory p-3 text-sm leading-relaxed text-warm-ink"></p>
            <div class="mt-4 flex flex-col gap-2 sm:flex-row">
              <button type="button" id="line-copy" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl border border-coral px-4 py-2.5 text-sm font-medium text-coral transition hover:bg-coral hover:text-white"><i data-lucide="copy" class="size-4" aria-hidden="true"></i> <span id="line-copy-label">คัดลอกข้อความ</span></button>
              <a href="https://line.me/R/ti/p/@punnattapatch" target="_blank" rel="noopener" id="line-open" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90" style="background:#06C755"><i data-lucide="message-circle" class="size-4" aria-hidden="true"></i> เปิด LINE OA</a>
            </div>
          </div>
        `;
        document.body.appendChild(dialog);
      }

      const msgEl = document.getElementById('line-msg');
      const copyBtn = document.getElementById('line-copy');
      const copyLabel = document.getElementById('line-copy-label');
      let currentMsg = '';
      const build = (svc) => 'สนใจบริการ ' + svc + ' ครับ อยากสอบถามรายละเอียดเพิ่มเติมครับ 🙏';

      document.querySelectorAll('.line-btn').forEach((b) => {
        b.addEventListener('click', () => {
          currentMsg = build(b.getAttribute('data-line-service') || 'ของคุณปัน');
          msgEl.textContent = currentMsg;
          copyLabel.textContent = 'คัดลอกข้อความ';
          const m = document.getElementById('line-modal');
          if (typeof m.showModal === 'function') m.showModal(); else m.setAttribute('open', '');
        });
      });
      document.getElementById('line-modal-close')?.addEventListener('click', () => document.getElementById('line-modal').close());
      copyBtn?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(currentMsg); copyLabel.textContent = 'คัดลอกแล้ว ✓'; }
        catch { copyLabel.textContent = 'คัดลอกไม่ได้ — เลือกข้อความเอง'; }
      });
    })();
  </script>
