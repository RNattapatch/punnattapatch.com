    <div id="services-final-cta" class="scroll-mt-20 bg-ivory">
      <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10">
        <LineDecisionCTA
          location="services_final_cta"
          headline="ยังไม่แน่ใจว่าควรเริ่มจากคลาสหรือวางระบบ?"
          copy="เล่าอาการที่เกิดในทีม จำนวนคน และผลลัพธ์ที่อยากได้ทาง LINE ผมช่วยแยกให้ว่าเรื่องนี้ควรเริ่มจากคลาสสอนทีม หรือให้ผมเข้าไปวางระบบให้"
          lineLabel="ให้ผมช่วยเลือกทาง LINE"
          desktopQr={LINE_QR_IMAGE}
        />
      </div>
