---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarumaMark from '../components/DarumaMark.astro';
import { SITE } from '../data/site';
import { fmtPrice } from '../data/pricing.mjs';

const title = 'บริการปั้นทีมขาย × AI Agent';
const description = 'เริ่มจากงานขายจริงของทีมคุณ แล้วค่อยใช้ AI Agent ลดงานซ้ำและทำให้ทีมเดินต่อได้เอง';
const darumaPhases = ['ดูข้อมูลจริงของทีม', 'จัดแนวเจ้าของและหัวหน้า', 'ฝึกทีม', 'ติดตั้งระบบจริง 1 ระบบ', 'ประคองใช้จริง 30 วัน', 'วัดผลก่อน-หลัง'];
const proofGallery = [
  { src: '/testimonial/2026-05/review-01.jpg', alt: 'รีวิวลูกค้า — ทีมงานร่วม Workshop AI กับอาจารย์ปั้น', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-02.jpg', alt: 'รีวิวลูกค้า — แชทขอบคุณหลังเวิร์กช็อป "ชีวิตเปลี่ยนใน 24 ชม."', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-03.jpg', alt: 'รีวิวลูกค้า — บรรยากาศห้องอบรม AI เต็มห้อง', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-04.jpg', alt: 'รีวิวลูกค้า — แชทผู้เข้าอบรมหลังจบคลาส', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-05.jpg', alt: 'รีวิวลูกค้า — แชท "อาจารย์ปั้นสอนถูกใจทีมงาน Ai ทั้งบริษัท"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-06.jpg', alt: 'รีวิวลูกค้า — ทีมงานถ่ายภาพร่วมกันที่ออฟฟิศ', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-07.jpg', alt: 'รีวิวลูกค้า — ทีมงานสังสรรค์หลังเวิร์กช็อป', width: 1000, height: 1000 },
  { src: '/testimonial/2026-05/review-08.jpg', alt: 'รีวิวลูกค้า — โพสต์รีวิว "องค์กรที่เรียนรู้เร็วที่สุด"', width: 1000, height: 1000 },
  { src: '/testimonial/2026-07/review-09.jpg', alt: 'รีวิวลูกค้า — แชทลูกศิษย์เล่าว่านอนน้อยเพราะติดใช้ AI ทำเว็บจ้างหลายแสนจบในคืนเดียว', width: 1410, height: 1410 },
  { src: '/testimonial/2026-07/review-10.jpg', alt: 'รีวิวลูกค้า — โพสต์แนะนำต่อว่า "ใครสนใจเรียน AI แนะนำน้องปันครับ เก่งมากๆ"', width: 736, height: 736 },
  { src: '/testimonial/2026-07/review-11.jpg', alt: 'รีวิวลูกค้า — แชทลูกค้าต่อยอดโปรเจกต์เลขา AI "สนุกดีครับ"', width: 914, height: 914 },
  { src: '/testimonial/2026-07/review-12.jpg', alt: 'รีวิวลูกค้า — งาน Nissan Sales Manager Seminar 2026 "One Team Energy Goal"', width: 1000, height: 1000 },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={{
    types: ['WebPage', 'Person', 'BreadcrumbList'],
    title,
    description,
    breadcrumbs: [{ name: 'หน้าแรก', url: SITE.url }, { name: 'บริการ', url: `${SITE.url}/services` }],
  }}
>
  <section class="border-b border-[#c9c2b2] bg-ivory px-6 py-16 md:py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Sales × AI Agent</p>
      <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight text-navy md:text-6xl">ทีมขายคุณเนี่ย ยังพึ่งคนเก่งอยู่คนเดียวรึเปล่าครับ</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-warm-ink/75">ผมเริ่มจากงานขายจริงของบริษัทคุณก่อนครับ แล้วค่อยใช้ AI Agent ลดงานซ้ำ คืนเวลาให้เซลล์อยู่หน้าลูกค้า และทำให้คนในทีมใช้ต่อได้จริง</p>
      <a href="/booking" class="btn mt-8 border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยฟรีกับผม</a>
    </div>
  </section>

  <section class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">เริ่มให้ทีมใช้เป็น</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-snug text-navy md:text-5xl">เลือกวันให้ตรงกับจุดที่ทีมคุณติด</h2>
        <p class="mt-4 leading-relaxed text-warm-ink/75">ใครๆ ก็ลองใช้ AI ได้ครับ แต่ถ้าไม่ได้เริ่มจากข้อมูล ลูกค้า และวิธีขายของบริษัทคุณ ของที่สร้างก็จะจบอยู่ในห้องอบรม</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <article id="inhouse-a" class="flex flex-col rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">In-house A · 1 วัน</p>
          <h3 class="mt-3 font-display text-3xl font-bold text-navy">Sales × AI Agent</h3>
          <p class="mt-3 text-lg font-semibold text-navy">ให้ทั้งทีมเริ่มใช้ AI กับงานขายจริงของตัวเอง</p>
          <p class="mt-5 font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('inhouse-a')}</p>
          <p class="mt-5 leading-relaxed text-warm-ink/75">เริ่มจากเช็กระบบขาย 6 ด้านของบริษัทคุณ แล้วเขียน Context Pack จากข้อมูลจริง ก่อนสร้าง AI ผู้ช่วยงานขาย 1 use case ไปใช้ต่อวันจันทร์</p>
          <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
            <li><strong class="text-navy">เหมาะกับ:</strong> เจ้าของ หัวหน้า และเซลล์ที่อยากเริ่มพร้อมกัน</li>
            <li><strong class="text-navy">ได้กลับไป:</strong> AI ผู้ช่วยงานขาย 1 ตัวที่ผูกกับงานของทีม</li>
            <li><strong class="text-navy">รูปแบบ:</strong> 1 วัน · ที่บริษัทคุณ · ไม่เกิน 20 คน</li>
          </ul>
          <a href="/booking?path=inhouse-a" class="btn mt-8 w-full border-navy bg-transparent text-navy hover:bg-navy hover:text-white">จองคิวคุยฟรี</a>
        </article>

        <article id="inhouse-b" class="relative flex flex-col rounded-2xl border-2 border-coral bg-surface p-7 md:p-9">
          <span class="absolute -top-3 left-6 rounded-full bg-coral px-3 py-1 text-xs font-bold text-white">ทีมขายทั้งทีม</span>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">In-house B · 2 วัน</p>
          <h3 class="mt-3 font-display text-3xl font-bold text-navy">Daruma Sales Office Bootcamp</h3>
          <p class="mt-3 text-lg font-semibold text-navy">วางระบบขายก่อน แล้วให้ทุกคนมี AI ผู้ช่วยของตัวเอง</p>
          <div class="mt-5 flex items-end gap-3"><p class="font-display text-xl tabular-nums text-warm-ink/50 line-through">{fmtPrice('inhouse-b-list')}</p><p class="font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('inhouse-b')}</p></div>
          <p class="mt-5 leading-relaxed text-warm-ink/75">วันแรกทำให้ทีมเห็นระบบเดียวกันครับ วันที่สองค่อยสร้าง AI Sales Office จากเคสจริงของบริษัทคุณ ทุกคนจะได้ผู้ช่วยที่เอาไปใช้กับงานตัวเองต่อได้</p>
          <ul class="mt-6 space-y-3 text-sm leading-relaxed text-warm-ink/80">
            <li><strong class="text-navy">เหมาะกับ:</strong> บริษัทที่อยากยกทีมขายพร้อมกันทั้งแผง</li>
            <li><strong class="text-navy">ได้กลับไป:</strong> AI ผู้ช่วยรายคน + ข้อตกลงใช้จริง 14 วัน</li>
            <li><strong class="text-navy">รูปแบบ:</strong> 2 วันติด · ที่บริษัทคุณ · สูงสุด 20 คน</li>
          </ul>
          <a href="/booking?path=inhouse-b" class="btn mt-8 w-full border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยฟรี</a>
        </article>
      </div>
    </div>
  </section>

  <section class="border-t border-[#c9c2b2] bg-sand px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">หลักฐานจากงานจริง</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-snug text-navy md:text-5xl">รีวิวและบรรยากาศจากงานที่เกิดขึ้นจริง</h2>
        <p class="mt-4 leading-relaxed text-warm-ink/75">ก่อนเลือกวันให้ทีม ผมอยากให้เห็นทั้งรูปกิจกรรมและแชทที่ลูกค้าส่งมาหลังจบงานครับ</p>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {proofGallery.map((proof, index) => (
          <figure class:list={[
            'rounded-2xl border border-[#c9c2b2] bg-surface p-2 shadow-[3px_5px_0_rgba(30,27,22,0.07)]',
            index % 2 === 0 ? 'rotate-[0.4deg]' : '-rotate-[0.4deg]',
          ]}>
            <img src={proof.src} alt={proof.alt} width={proof.width} height={proof.height} loading="lazy" decoding="async" class="aspect-square w-full rounded-xl object-cover" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="daruma-transformation" class="border-y border-[#c9c2b2] bg-[#00162f] px-6 py-16 text-[#f4f1ea] md:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[auto_1fr]">
      <DarumaMark class="size-20" />
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#ff9aa8]">Flagship · 45 วัน</p>
        <h2 class="mt-3 font-display text-3xl font-bold leading-snug md:text-5xl">Daruma Sales Transformation</h2>
        <p class="mt-2 text-xl text-[#b9c9da]">โปรแกรมพลิกทีมขาย × AI Agent ใน 45 วัน</p>
        <p class="mt-5 max-w-3xl leading-relaxed text-[#d7e2ee]">เหมาะกับเจ้าของที่อยากแก้ทั้งระบบครับ ไม่ได้แค่จัดวันอบรมแล้วแยกย้าย ผมลงไปดูข้อมูล จัดแนวหัวหน้า ฝึกทีม ติดตั้งของจริง และตามให้ทีมใช้ต่อ</p>
        <p class="mt-6 font-display text-5xl font-bold tabular-nums text-[#ff9aa8]">{fmtPrice('daruma-transformation')}</p>
        <ol class="mt-8 grid gap-x-6 gap-y-3 text-sm text-[#e8eef5] sm:grid-cols-2">
          {darumaPhases.map((phase, index) => <li><span class="mr-2 font-bold text-[#ff9aa8]">{index + 1}</span>{phase}</li>)}
        </ol>
        <a href="/booking?path=daruma-transformation" class="btn mt-8 border-0 bg-coral text-white hover:bg-[#c43245]">จองคิวคุยฟรีกับผม</a>
      </div>
    </div>
  </section>

  <section id="trust-content" class="px-6 py-16 md:py-24">
    <div class="mx-auto max-w-6xl rounded-2xl border border-[#c9c2b2] bg-surface p-7 md:flex md:items-center md:justify-between md:gap-10 md:p-10">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan">Trust Content · 2 วัน</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-navy">AI Trust Content Cycle</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-warm-ink/75">อยากให้ลูกค้าเชื่อใจจนทักเข้าทีมขายเองใช่มั้ยครับ เราวางวงจรคอนเทนต์ที่ AI ช่วยหมุนให้ต่อเนื่อง แต่เสียงและประสบการณ์ยังเป็นของคุณ</p>
      </div>
      <div class="mt-6 shrink-0 md:mt-0 md:text-right">
        <p class="font-display text-4xl font-bold tabular-nums text-coral">{fmtPrice('tiktok-workshop')}</p>
        <a href="/booking?path=trust-content" class="btn mt-4 border-navy bg-transparent text-navy hover:bg-navy hover:text-white">จองคิวคุยฟรี</a>
      </div>
    </div>
  </section>
</BaseLayout>
