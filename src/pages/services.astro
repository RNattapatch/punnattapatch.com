---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import OfferCard from '../components/services/OfferCard.astro';
import OfferChooser from '../components/services/OfferChooser.astro';
import AdvanceProgramStrip from '../components/services/AdvanceProgramStrip.astro';
import LineDecisionCTA from '../components/services/LineDecisionCTA.astro';
import { SITE } from '../data/site';
import { CATALOG, fmtPrice } from '../data/pricing.mjs';
import { SERVICE_OFFERS, type OfferCode } from '../data/service-offers';
import { LINE_QR_IMAGE, OFFER_ASSET_BY_CODE } from '../data/service-offer-assets';

const title = 'คลาสสำหรับทีมขาย และบริการวางระบบฝ่ายขาย | ปัน ณัฐพัชร์';
const description = 'คลาสสอนทีมขาย และบริการวางระบบฝ่ายขายแบบรายวัน ค่าตัวต่อวันเท่ากัน เลือกวางระบบปั้นทีมขายหรือ AI Office ฝ่ายขายได้วันละ 2 เรื่อง ให้ทีมเริ่มใช้กับงานจริง';
const canonical = `${SITE.url}/services`;
// C1 day rate (ปันเคาะ 2026-10-08): ครบรอบ 2 วัน = 2 × ค่าตัวรายวัน · คำนวณจาก catalog เสมอ
const C1_DAY = fmtPrice('daily-sales-consulting');
const C1_FULL_ROUND = `฿${(CATALOG['daily-sales-consulting'].amount * 2).toLocaleString('en-US')}`;

const offerByCode = Object.fromEntries(SERVICE_OFFERS.map((offer) => [offer.code, offer]));
const getOffer = (code: OfferCode) => {
  const offer = offerByCode[code];
  if (!offer) throw new Error(`Missing service offer: ${code}`);
  return offer;
};
const priceFor = (code: OfferCode) => {
  const pricingKey = getOffer(code).pricingKey;
  return pricingKey ? fmtPrice(pricingKey) : undefined;
};
const catalogOffers = (['T2', 'T1', 'T3', 'T4', 'C1', 'A1'] as const).map(getOffer);

const trustLogos = [
  { src: '/services/nissan.png', alt: 'Nissan' },
  { src: '/services/futureskill.png', alt: 'FutureSkill' },
  { src: '/services/ramkhamhaeng.png', alt: 'มหาวิทยาลัยรามคำแหง' },
  { src: '/services/tni.png', alt: 'สถาบันเทคโนโลยีไทย-ญี่ปุ่น (TNI)' },
  { src: '/services/royal-enfield.jpg', alt: 'Royal Enfield' },
  { src: '/services/gpx.jpg', alt: 'GPX' },
  { src: '/services/lambretta.png', alt: 'Lambretta' },
  { src: '/services/zontes.png', alt: 'Zontes' },
];

const faqs = [
  {
    q: 'ทีมต้องมีพื้นฐาน AI ก่อนเข้าอบรมไหม',
    a: 'ไม่จำเป็นครับ เราเริ่มจากงานขายหรือรายงานที่ทีมทำอยู่แล้ว ผู้เรียนไม่ต้องเขียนโค้ด แต่ควรใช้คอมพิวเตอร์และไฟล์งานพื้นฐานได้ ส่วน AI จะถูกใช้เป็นตัวช่วยในจุดที่เหมาะกับงานจริง',
  },
  {
    q: 'คลาส T1, T2 และ T3 ต่างกันอย่างไร',
    a: 'T1 เน้นจิตวิทยาการตัดสินใจ คำถาม การต่อรอง และซ้อมดีลกับ AI Sales Coach, T2 เน้นเส้นทางจาก Content และ Ads ไปสู่ Lead นัดหมายและยอดขาย, ส่วน T3 เน้น Report, Dashboard และข้อมูลที่ช่วยให้หัวหน้าเห็นดีลค้าง เลือกจากงานที่ทีมต้องทำให้ดีขึ้นก่อนครับ',
  },
  {
    q: 'สอนทีม กับให้ผมวางระบบให้ ต่างกันอย่างไร',
    a: 'สอนทีมคือทีมคุณเรียนใน Workshop แล้วกลับไปทำเอง ส่วน C1 คือผมเข้าไปวางระบบกับทีม วันละไม่เกิน 2 เรื่อง ค่าตัวต่อวันเท่ากัน ถ้าอยากให้ทดสอบกับงานจริงและดูแลต่อ ให้เลือกแบบครบรอบ 2 วัน',
  },
  {
    q: 'ควรมีใครเข้าร่วม และรับผู้เรียนกี่คน',
    a: 'เหมาะกับทีมขาย หัวหน้าทีม และคนหลังบ้านที่ส่งต่อข้อมูลระหว่างกัน รุ่น In-house ที่ทำ Workshop ได้ทั่วถึงมักอยู่ที่ 5–20 คน หากมากกว่านี้ผมจะช่วยออกแบบรูปแบบการเรียนให้เหมาะกับผลลัพธ์ที่ต้องการ',
  },
  {
    q: 'ต้องเตรียมอะไรให้พร้อมก่อนวันทำงาน',
    a: 'เตรียม Notebook บัญชีเครื่องมือที่องค์กรอนุญาต และตัวอย่างงานจริง เช่น สินค้า ขั้นตอนขาย ข้อความ Follow-up หรือ Report ที่อยากแก้ โดยลบข้อมูลลูกค้าที่เป็นความลับก่อนนำมาใช้',
  },
  {
    q: 'อบรมแล้วจะได้ Automation ที่พร้อมใช้ทันทีหรือไม่',
    a: 'ในคลาสทีมจะได้ Workflow, Template หรือ Prototype ตามขอบเขตคลาส ถ้าอยากให้ผมเข้าไปวางระบบให้ทีมใช้กับงานจริง เลือกบริการวางระบบฝ่ายขายแบบรายวัน ส่วนระบบที่ต้องเชื่อมหลายฐานข้อมูลและมี SLA ระยะยาว ผมประเมินเป็นขอบเขตแยก',
  },
  {
    q: 'ถ้าข้อมูลอยู่หลายระบบ สามารถเชื่อมทั้งหมดได้ไหม',
    a: 'ทำได้เมื่อระบบต้นทางมีวิธีเชื่อมต่อและองค์กรอนุญาต แต่ต้องประเมินทีละระบบ ทั้งคุณภาพข้อมูล สิทธิ์เข้าถึง API และเจ้าของข้อมูล งานหลายระบบจึงต้องสรุป Scope ก่อน ไม่รวมทุกอย่างไว้ในหนึ่งวันโดยอัตโนมัติ',
  },
  {
    q: 'ขอ Outline หรือใบเสนอราคาได้อย่างไร',
    a: 'ทัก LINE พร้อมบอกประเภทธุรกิจ จำนวนผู้เรียน ปัญหาที่อยากแก้ และช่วงวันที่สะดวก ผมจะช่วยเทียบโจทย์กับคลาสหรือบริการ แล้วส่ง Outline และใบเสนอราคาตาม Scope ที่ตกลงกัน',
  },
  {
    q: 'จองวันอบรมหรือวัน Consulting อย่างไร',
    a: 'หลังยืนยัน Scope และวันที่ว่าง ผมจะออกเอกสารให้ตรวจสอบ การจองสมบูรณ์เมื่อดำเนินการตามเงื่อนไขในใบเสนอราคาเรียบร้อย จึงควรเผื่อเวลาสำหรับเตรียมข้อมูลและผู้เข้าร่วมก่อนวันจริง',
  },
  {
    q: 'ยังไม่แน่ใจว่าควรเลือก T1, T2, T3 หรือ C1 ทำอย่างไร',
    a: 'เริ่มจากเล่าอาการที่เกิดในทีมทาง LINE ได้เลยครับ ผมจะช่วยแยกว่าเป็นช่องว่างด้านทักษะ การออกแบบวิธีทำงาน หรือการสร้างระบบ แล้วแนะนำทางเลือกที่เล็กพอจะเริ่มและตรงกับผลลัพธ์ที่สุด',
  },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={`${SITE.url}${OFFER_ASSET_BY_CODE.T2.src}`}
  schema={{
    types: ['WebPage', 'ItemList', 'FAQPage', 'BreadcrumbList'],
    title,
    description,
    url: canonical,
    catalog: catalogOffers,
    faq: faqs.map((faq) => ({ question: faq.q, answer: faq.a })),
    breadcrumbs: [
      { name: 'หน้าแรก', url: SITE.url },
      { name: 'คลาสและบริการ', url: `${SITE.url}/services` },
    ],
  }}
>
  <div class="min-w-0 overflow-x-clip bg-ivory">
    <section id="services-hero" class="relative overflow-hidden border-b border-sand-deep bg-surface">
      <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[42%] bg-[radial-gradient(circle_at_center,rgba(221,65,85,.13),transparent_66%)] lg:block"></div>
      <div class="relative mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">SALES TRAINING · CONSULTING · IMPLEMENTATION</p>
        <h1 class="mt-4 max-w-4xl font-display text-[2.45rem] font-bold leading-[1.16] tracking-[-0.04em] text-navy sm:text-5xl lg:text-[3.55rem]">
          คลาสและบริการสำหรับทีมขาย ที่อยากเพิ่มยอดและทำงานเป็นระบบ
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-[#625C53]">
          เลือกจากงานที่อยากให้ทีมทำได้จริง ไม่ต้องเริ่มจากชื่อเครื่องมือ ผมช่วยได้ตั้งแต่พัฒนาทักษะเซลล์ วาง Funnel ไปจนถึงสร้าง Report และ Dashboard ให้ใช้งานจริง
        </p>
        <div class="mt-8 max-w-3xl rounded-2xl border border-navy/15 bg-sand/70 p-4 sm:flex sm:items-center sm:justify-between sm:gap-5">
          <p class="font-display font-bold leading-7 text-navy">ฝึกทีมให้ทำเป็น หรือให้ผมเข้าไปวางระบบให้</p>
          <div class="mt-3 flex flex-col gap-2 sm:mt-0 sm:flex-row sm:flex-wrap">
            <a href="#core-training" class="inline-flex min-h-12 items-center justify-center rounded-full border border-navy px-4 text-sm font-bold text-navy transition-colors hover:bg-navy hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy">ดูคลาสสำหรับทีมขาย</a>
            <a href="#system-services" class="inline-flex min-h-12 items-center justify-center rounded-full border border-navy px-4 text-sm font-bold text-navy transition-colors hover:bg-navy hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy">ดูบริการวางระบบฝ่ายขาย</a>
          </div>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#public-online-courses" class="inline-flex min-h-12 items-center justify-center rounded-full border border-coral bg-coral px-6 font-bold text-white transition-colors hover:border-navy hover:bg-navy focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral">
            ดูคลาสและบริการ ↓
          </a>
          <a
            href={SITE.social.line}
            target="_blank"
            rel="noopener"
            data-contact-cta
            data-cta-location="services_hero"
            data-product-code="none"
            data-cta-label="ให้ผมช่วยเลือกทาง LINE"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#06C755] bg-[#06C755] px-6 font-bold text-white transition-colors hover:border-[#05A548] hover:bg-[#05A548] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#06C755]"
          >
            ให้ผมช่วยเลือกทาง LINE
          </a>
        </div>
      </div>
    </section>

    <section id="services-proof-strip" aria-labelledby="proof-strip-heading" class="border-b border-sand-deep bg-sand">
      <div class="mx-auto max-w-[1180px] px-5 py-8 sm:px-8 lg:px-10">
        <h2 id="proof-strip-heading" class="text-center text-sm font-semibold text-navy">องค์กรที่เคยเชิญไปสอน อบรม และทำงานกับทีม</h2>
        <div class="mx-auto mt-5 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4">
          {trustLogos.map((logo) => (
            <div class="flex h-24 min-w-0 items-center justify-center rounded-xl border border-navy/10 bg-surface p-3 sm:h-28">
              <img src={logo.src} alt={logo.alt} width="160" height="96" loading="lazy" decoding="async" class="h-full w-full object-contain" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="public-online-courses" class="scroll-mt-20 border-b border-sand-deep bg-surface">
      <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Online Class</p>
          <h2 class="mt-2 font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-navy sm:text-4xl">คลาสสำหรับบุคคลทั่วไป</h2>
          <p class="mt-4 leading-7 text-[#625C53]">เรียนออนไลน์ย้อนหลังตามเวลาของคุณ</p>
        </div>

        <div class="mt-10 grid min-w-0 max-w-2xl gap-6">
          <article data-public-course="FUTURESKILL" class="flex min-w-0 flex-col overflow-hidden rounded-[1.5rem] border border-sand-deep bg-ivory shadow-[0_18px_40px_-28px_rgba(7,43,78,.35)]">
            <figure class="flex aspect-video items-center justify-center overflow-hidden bg-[#f3efff] p-10 sm:p-14">
              <img src="/services/futureskill.png" alt="FutureSkill" width="640" height="640" loading="lazy" decoding="async" class="size-full object-contain" />
            </figure>
            <div class="flex flex-1 flex-col p-5 sm:p-7">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-navy px-3 py-1.5 text-xs font-bold text-white">Online Class</span>
                <span class="rounded-full border border-navy/15 bg-surface px-3 py-1.5 text-xs font-bold text-navy">เรียนย้อนหลัง</span>
              </div>
              <p class="mt-5 text-xs font-bold uppercase tracking-[0.16em] text-coral">เรียนออนไลน์ตามเวลาของคุณ</p>
              <h3 class="mt-2 font-display text-2xl font-bold leading-snug tracking-[-0.02em] text-navy">ตั้ง Worker บน Cloud ด้วย AI Agent</h3>
              <p class="mt-3 leading-7 text-[#625C53]">เรียนวิธีเตรียมและตั้ง Worker บน Cloud เพื่อให้ AI Agent รันนอกเครื่อง ผ่านบทเรียนวิดีโอบน FutureSkill</p>
              <div class="mt-auto pt-6">
                <p class="text-sm leading-6 text-[#625C53]">ดูราคา เนื้อหาล่าสุด และเงื่อนไขการเรียนได้โดยตรงบน FutureSkill</p>
                <a href="https://futureskill.co/course/detail/6030" target="_blank" rel="noopener" class="mt-5 inline-flex min-h-12 items-center justify-center rounded-full border border-navy bg-navy px-5 font-bold text-white transition-colors hover:border-coral hover:bg-coral focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy">ดูคลาสบน FutureSkill<span aria-hidden="true" class="ml-2">↗</span></a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="training-catalog" class="relative scroll-mt-20">
      <span id="core-training" class="absolute left-0 top-0 scroll-mt-24" aria-hidden="true"></span>
      <div class="mx-auto max-w-[1180px] px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-coral">Training catalog</p>
          <h2 class="mt-2 font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-navy sm:text-4xl">คลาสสำหรับทีมขายที่เปิดสอนตอนนี้</h2>
          <p class="mt-4 leading-7 text-[#625C53]">เลือกจากสิ่งที่ทีมต้องทำให้ดีขึ้น ตั้งแต่เข้าใจเหตุผลซื้อ เปลี่ยน Lead เป็นยอดขาย ทำ Report ที่หัวหน้าใช้ตัดสินใจ ไปจนถึงทดลอง AI Workflow ก่อนลงทุนทำระบบจริง</p>
        </div>

        <div class="mt-10">
          <div class="relative">
            <span id="trust-content" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <OfferCard offer={getOffer('T2')} image={OFFER_ASSET_BY_CODE.T2} featured priceLabel={priceFor('T2')} eagerImage />
          </div>
          <p data-take-home-for="T2" class="mt-3 rounded-2xl border border-navy/10 bg-surface px-5 py-3 text-sm leading-6 text-[#625C53]"><strong class="text-navy">สิ่งที่ทีมจะได้กลับไป:</strong> Funnel map + Campaign kit + Chat script + Tracking sheet</p>
          <aside data-proof-for="T2" class="mt-4 rounded-2xl border border-coral/20 bg-coral/[0.055] px-5 py-4 text-sm leading-6 text-[#625C53]">
            <strong class="text-navy">ภาพรถคือ Dealer proof จากงานยานยนต์จริง</strong> แต่เครื่องยนต์ของคลาสคือการพา Content และ Ads ไปสู่ Lead นัดหมาย และยอดขาย จึงใช้ได้กับ Clinic, Hotel, B2B และธุรกิจอื่นที่รับ Lead เช่นกัน
          </aside>
        </div>

        <div class="mt-6 grid min-w-0 gap-6 lg:grid-cols-2">
          <div class="relative min-w-0">
            <span id="inhouse-a" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <span id="inhouse-b" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <OfferCard offer={getOffer('T1')} image={OFFER_ASSET_BY_CODE.T1} priceLabel={priceFor('T1')} />
            <p data-take-home-for="T1" class="mt-3 rounded-2xl border border-navy/10 bg-surface px-5 py-3 text-sm leading-6 text-[#625C53]"><strong class="text-navy">สิ่งที่ทีมจะได้กลับไป:</strong> Customer Decision Map + Negotiation Playbook + AI Sales Coach + Role-play Scorecard</p>
          </div>
          <div class="relative min-w-0">
            <span id="sales-report" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <span id="back-office" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <OfferCard offer={getOffer('T3')} image={OFFER_ASSET_BY_CODE.T3} priceLabel={priceFor('T3')} />
            <p data-take-home-for="T3" class="mt-3 rounded-2xl border border-navy/10 bg-surface px-5 py-3 text-sm leading-6 text-[#625C53]"><strong class="text-navy">สิ่งที่ทีมจะได้กลับไป:</strong> Stage dictionary + Daily report template + Manager intervention rule + Dashboard wireframe</p>
          </div>
        </div>

        <div class="mt-6 min-w-0">
          <div class="relative min-w-0">
            <span id="ai-workflow-pilot" class="absolute -top-24 scroll-mt-24" aria-hidden="true"></span>
            <OfferCard offer={getOffer('T4')} image={OFFER_ASSET_BY_CODE.T4} priceLabel={priceFor('T4')} />
            <p data-take-home-for="T4" class="mt-3 rounded-2xl border border-navy/10 bg-surface px-5 py-3 text-sm leading-6 text-[#625C53]"><strong class="text-navy">สิ่งที่ทีมจะได้กลับไป:</strong> Workflow Map + Safe Sandbox + Human–AI Responsibility Brief + Decision Memo</p>
          </div>
        </div>
      </div>
