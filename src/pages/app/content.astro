    function openStudio(variantId: string) {
      const v = variants.find((x) => x.variant_id === variantId);
      const idea = ideas.find((i) => i.content_id === v?.content_id);
      if (!v || !idea) return;
      studioVariantId = variantId;
      $('wr-studio-title').textContent = `${v.variant_id} · ${idea.title}`;
      $('wr-studio-path').textContent = v.markdown_path ?? '';
      // ร่างจาก DB ต่อ variant — เปิดจากมือถือ/เครื่องไหนก็เจอร่างเดิม · ร่างใหม่เริ่มจากโครง Part 13
      ($('wr-studio-body') as HTMLTextAreaElement).value = v.script_draft ?? SCRIPT_TEMPLATE;
      showAiResult(v.ai_result, v.ai_result_at);
      $('wr-studio-ai-status').textContent = '';
      ($('wr-studio') as HTMLDialogElement).showModal();
    }

    function showAiResult(text: string | null, at: string | null) {
      const pane = $('wr-studio-ai-pane');
      if (!text) { pane.classList.add('hidden'); return; }
      pane.classList.remove('hidden');
      ($('wr-studio-ai-body') as HTMLTextAreaElement).value = text;
      $('wr-studio-ai-at').textContent = at ? new Date(at).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' }) : '';
    }

    async function saveDraft(silent = false): Promise<boolean> {
      if (!studioVariantId) return false;
      const script = ($('wr-studio-body') as HTMLTextAreaElement).value;
      try {
        await updateVariant(studioVariantId, { script_draft: script });
        const v = variants.find((x) => x.variant_id === studioVariantId);
        if (v) v.script_draft = script;
        if (!silent) toast('บันทึกร่างแล้ว 💾');
        return true;
      } catch (e) { oops(e); return false; }
    }

    async function runImprove() {
      const vid = studioVariantId;
      if (!vid) return;
      const script = ($('wr-studio-body') as HTMLTextAreaElement).value.trim();
      if (!script) { toast('พิมพ์ script ก่อนครับ', 'error'); return; }
      const btn = $('wr-studio-ai') as HTMLButtonElement;
      const status = $('wr-studio-ai-status');
      btn.disabled = true;
      btn.classList.add('loading');
      status.textContent = 'ส่งเข้าคิว Mac mini…';
      try {
        if (!(await saveDraft(true))) return; // ร่างต้องถึง DB ก่อน — กันหายถ้าปิดหน้าระหว่างรอ
        const jobId = await enqueueJob('ai_improve', { variant_id: vid, script });
        const job = await waitJob(jobId, {
          timeoutMs: 9 * 60_000,
          onTick: (s) => { status.textContent = `กำลังเกลา… ${s} วิ (Codex อ่าน framework + voice ก่อน ปกติ 2-5 นาที)`; },
        });
        const improved = String((job.result as { improved?: string })?.improved ?? '');
        showAiResult(improved, new Date().toISOString());
        const v = variants.find((x) => x.variant_id === vid);
        if (v) { v.ai_result = improved; v.ai_result_at = new Date().toISOString(); }
        status.textContent = '';
        toast('AI เกลาเสร็จแล้ว ✨');
      } catch (e) {
        status.textContent = '';
        oops(e);
      } finally {
        btn.disabled = false;
        btn.classList.remove('loading');
      }
    }
    function studioFile(): { name: string; md: string } | null {
      const v = variants.find((x) => x.variant_id === studioVariantId);
      const idea = ideas.find((i) => i.content_id === v?.content_id);
      if (!v || !idea) return null;
      const body = ($('wr-studio-body') as HTMLTextAreaElement).value;
      return { name: (v.markdown_path ?? `${v.variant_id}.md`).split('/').pop()!, md: buildVariantMarkdown(idea, v, body) };
    }

    // ---------- events ----------
    function wire() {
      $('wr-date').textContent = new Date().toLocaleDateString('th-TH', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

      // View toggle
      $('wr-view-board').addEventListener('click', () => setView('board'));
      $('wr-view-list').addEventListener('click', () => setView('list'));
      $('wr-view-queue').addEventListener('click', () => setView('queue'));
      $('wr-view-campaign').addEventListener('click', () => { openCampaign(null); setView('campaign'); });
      $('wr-view-line').addEventListener('click', () => setView('line'));
      $('wr-queue-refresh').addEventListener('click', () => void loadQueue().then(() => toast('รีเฟรชคิวแล้ว')).catch(oops));
      $('wr-queue-filter').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button[data-qf]') as HTMLButtonElement | null;
        if (!b) return;
        queueFilter = b.dataset.qf as typeof queueFilter;
        $('wr-queue-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('btn-active', x === b));
        renderQueue();
      });
      $('wr-queue').addEventListener('click', (e) => void (async () => {
        const el = e.target as HTMLElement;
        const openV = el.closest('[data-open-variant]') as HTMLElement | null;
        if (openV) { const v = variants.find((x) => x.variant_id === openV.dataset.openVariant); if (v) { openDrawer(v.content_id); openStudio(v.variant_id); } return; }
        const retry = el.closest('[data-retry]') as HTMLElement | null;
        const del = el.closest('[data-delete-job]') as HTMLElement | null;
        try {
          if (retry) { await retryWrJob(retry.dataset.retry!); toast('ส่งกลับเข้าคิวแล้ว'); }
          else if (del) { if (!confirm('ลบงานนี้ออกจากคิว?')) return; await deleteWrJob(del.dataset.deleteJob!); toast('ลบแล้ว'); }
          else return;
          await loadQueue();
        } catch (err) { oops(err); }
      })());
      document.addEventListener('visibilitychange', syncQueuePolling);

      // Quick capture
      $('wr-quick-save').addEventListener('click', () => void saveIdea(false, 'quick'));
      $('wr-quick-idea').addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); void saveIdea(false, 'quick'); } });
      $('wr-board-search').addEventListener('input', (e) => { boardSearch = (e.target as HTMLInputElement).value.trim(); renderStats(); renderBoard(); });

      // Format filter chips (เลือกได้หลายอัน · "ทั้งหมด" = ล้าง) + sort
      $('wr-fmt-filter').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button[data-fmt]') as HTMLButtonElement | null;
        if (!b) return;
        const code = b.dataset.fmt as FormatCode | '';
        if (!code) fmtFilter.clear();
        else if (fmtFilter.has(code)) fmtFilter.delete(code);
        else fmtFilter.add(code);
        if (fmtFilter.size === Object.keys(FORMAT_CODES).length) fmtFilter.clear();   // เลือกครบทุกอัน = ทั้งหมด
        saveBoardPrefs(); renderStats(); renderBoard();
      });
      $('wr-board-sort').addEventListener('change', (e) => {
        boardSort = (e.target as HTMLSelectElement).value as BoardSort;
        saveBoardPrefs(); renderBoard();
      });

      // Full capture (list view)
      $('wr-idea-save').addEventListener('click', () => void saveIdea(false, 'list'));
      $('wr-search').addEventListener('input', (e) => { search = (e.target as HTMLInputElement).value; renderList(); });
      $('wr-filter').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button[data-f]') as HTMLButtonElement | null;
        if (!b) return;
        filter = b.dataset.f!;
        $('wr-filter').querySelectorAll('button').forEach((x) => x.classList.toggle('btn-active', x === b));
        renderList();
      });
      $('wr-idea-list').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button[data-id]') as HTMLButtonElement | null;
        if (!b) return;
        renderList();
        openDrawer(b.dataset.id!);
      });

      // Board interactions (click card → drawer; quick-produce)
      $('wr-board').addEventListener('click', (e) => void (async () => {
        const mv = (e.target as HTMLElement).closest('[data-action="move-up"],[data-action="move-down"]') as HTMLElement | null;
        if (mv) {
          e.stopPropagation();
          const dir = mv.dataset.action === 'move-up' ? -1 : 1;
          if (mv.dataset.moveV) nudge('variant', mv.dataset.moveV, dir);
          else if (mv.dataset.moveCid) nudge('idea', mv.dataset.moveCid, dir);
          return;
        }
        const produce = (e.target as HTMLElement).closest('[data-action="quick-produce"]') as HTMLElement | null;
        if (produce) {
          e.stopPropagation();
          const idea = ideas.find((i) => i.content_id === produce.dataset.cid);
          if (idea) { try { await createVariant(idea, 'RL'); toast('สร้าง Reel variant แล้ว'); await refresh(); openDrawer(idea.content_id); } catch (err) { oops(err); } }
          return;
        }
        const card = (e.target as HTMLElement).closest('[data-card]') as HTMLElement | null;
        if (card?.dataset.cid) openDrawer(card.dataset.cid);
      })());

      // Board drag-drop (variant cards → columns)
      //
      // id ของการ์ดเดินทางมากับ dataTransfer และถูกล้างทุกครั้งที่การลากจบ (dragend ยิงเสมอ
      // ทั้งตอนปล่อยสำเร็จ ปล่อยนอกช่อง และกด Esc). ของเดิมจำ id ไว้ในตัวแปรนอกฟังก์ชันแล้ว
      // ล้างเฉพาะตอนปล่อยลงช่องสำเร็จ — ลากค้างแล้วปล่อยนอกช่องหนึ่งครั้ง id เก่าจะค้าง แล้ว
      // การลากอะไรก็ได้ครั้งถัดไป (ข้อความในการ์ดไอเดีย ไฟล์จาก Finder) ทำให้การ์ด "ใบเก่า"
      // เด้งไปโผล่ช่องใหม่ทั้งที่ไม่ได้สั่ง = อาการการ์ดซ้ำ/การ์ดโผล่เอง
      const DRAG_MIME = 'application/x-wr-variant';
      const IDEA_MIME = 'application/x-wr-idea';     // ลากเรียงไอเดีย (เฉพาะโหมด Custom · อยู่ในช่อง Ideas เท่านั้น)
      let dragVid: string | null = null;
      let dragCid: string | null = null;
      let moving = false;
      const clearDropHint = () => {
        $('wr-board').querySelectorAll('.wr-col')
          .forEach((c) => c.classList.remove('ring-2', 'ring-[color:var(--color-brand-coral)]'));
        $('wr-board').querySelectorAll<HTMLElement>('[data-card]').forEach((c) => { c.style.boxShadow = ''; });
      };
      // การ์ดที่จะไปวาง "ก่อน" ตามตำแหน่งเมาส์ (null = ท้ายคอลัมน์)
      const cardBefore = (col: HTMLElement, y: number, skip: string | null): HTMLElement | null => {
        const cards = [...col.querySelectorAll<HTMLElement>('[data-card]')].filter((c) => (c.dataset.v ?? c.dataset.cid) !== skip);
        return cards.find((c) => { const r = c.getBoundingClientRect(); return y < r.top + r.height / 2; }) ?? null;
      };
      const showInsert = (col: HTMLElement, y: number, skip: string | null) => {
        col.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => { c.style.boxShadow = ''; });
        const before = cardBefore(col, y, skip);
        const cards = [...col.querySelectorAll<HTMLElement>('[data-card]')].filter((c) => (c.dataset.v ?? c.dataset.cid) !== skip);
        if (before) before.style.boxShadow = '0 -3px 0 0 var(--color-brand-coral)';
        else if (cards.length) cards[cards.length - 1].style.boxShadow = '0 3px 0 0 var(--color-brand-coral)';
      };

      $('wr-board').addEventListener('dragstart', (e) => {
        const card = (e.target as HTMLElement).closest('[data-card]') as HTMLElement | null;
        dragVid = card?.dataset.card === 'variant' ? card.dataset.v ?? null : null;   // ลากอย่างอื่น (เช่น ข้อความ) = ไม่ใช่การย้าย
        dragCid = card?.dataset.card === 'idea' && boardSort === 'custom' ? card.dataset.cid ?? null : null;
        const id = dragVid ?? dragCid;
        if (!card || !id) return;
        card.classList.add('opacity-40');
        const dt = (e as DragEvent).dataTransfer!;
        dt.effectAllowed = 'move';
        dt.setData(dragVid ? DRAG_MIME : IDEA_MIME, id);
        dt.setData('text/plain', id);
      });
      $('wr-board').addEventListener('dragend', () => {
        dragVid = null; dragCid = null;
        $('wr-board').querySelectorAll('[data-card]').forEach((c) => c.classList.remove('opacity-40'));
        clearDropHint();
      });
      $('wr-board').addEventListener('dragover', (e) => {
        const de = e as DragEvent;
        const col = (e.target as HTMLElement).closest('.wr-col') as HTMLElement | null;
        if (!col) return;
        const isVariant = dragVid || de.dataTransfer?.types.includes(DRAG_MIME);
        const isIdea = dragCid || de.dataTransfer?.types.includes(IDEA_MIME);
        const ok = (isVariant && col.dataset.col) || (isIdea && col.dataset.colkey === 'ideas' && boardSort === 'custom');
        if (!ok) return;                                  // ของนอกบอร์ดไม่รับ
        e.preventDefault();
        de.dataTransfer!.dropEffect = 'move';
        $('wr-board').querySelectorAll('.wr-col').forEach((c) => c.classList.toggle('ring-2', c === col));
        col.classList.add('ring-[color:var(--color-brand-coral)]');
        if (boardSort === 'custom') showInsert(col, de.clientY, dragVid ?? dragCid);
      });
      $('wr-board').addEventListener('drop', (e) => {
        const de = e as DragEvent;
        const col = (e.target as HTMLElement).closest('.wr-col') as HTMLElement | null;
        const vid = de.dataTransfer?.getData(DRAG_MIME) || dragVid;
        const cid = de.dataTransfer?.getData(IDEA_MIME) || dragCid;
        const before = col && boardSort === 'custom' ? cardBefore(col, de.clientY, vid || cid) : null;
        clearDropHint();
        dragVid = null; dragCid = null;
        if (!col) return;

        // ไอเดีย: เรียงในช่อง Ideas เท่านั้น
        if (cid && !vid) {
          if (col.dataset.colkey !== 'ideas' || boardSort !== 'custom') return;
          e.preventDefault();
          if (reordering) return;
          const full = sortIdeas(backlogIdeas(), 'custom').map((i) => i.content_id);
          void saveOrder('idea', placeIn(full, cid, before?.dataset.cid ?? null, visibleIdsIn('ideas', 'cid')));
          return;
        }

        if (!col.dataset.col || !vid) return;
        e.preventDefault();
        if (moving || reordering) return;                 // ปล่อยรัวสองที = ยิงซ้ำ
        const v = variants.find((x) => x.variant_id === vid);
        const target = col.dataset.col as VariantStatus;
        const targetKey = col.dataset.colkey!;
        if (!v) return;
        const sameCol = colOf(v.variant_status)?.key === targetKey;

        if (boardSort !== 'custom') {
          if (sameCol) { toast('อยากเรียงเอง เลือก "เรียง → ✋ Custom" ก่อนครับ'); return; }
          moving = true;
          void (async () => {
            try { await updateVariant(vid, { variant_status: target }); toast(`ย้าย ${vid.replace('CNT-', '')} → ${col.dataset.col}`); await refresh(); }
            catch (err) { oops(err); }
            finally { moving = false; }
          })();
          return;
        }

        // Custom: วางตรงตำแหน่งที่ปล่อย (ย้ายคอลัมน์ด้วยถ้าปล่อยข้ามช่อง)
        const visible = visibleIdsIn(targetKey, 'v');
        const order = placeIn(columnVariants(targetKey).map((x) => x.variant_id), vid, before?.dataset.v ?? null, visible);
        moving = true;
        void (async () => {
          try {
            if (!sameCol) {
              await updateVariant(vid, { variant_status: target });
              v.variant_status = target; v.status_changed_at = new Date().toISOString();
            }
            await saveOrder('variant', order);
            if (!sameCol) { toast(`ย้าย ${vid.replace('CNT-', '')} → ${col.dataset.col}`); await refresh(); }
          } catch (err) { oops(err); await refresh(); }
          finally { moving = false; }
        })();
      });

      // Drawer close
      $('wr-drawer-close').addEventListener('click', closeDrawer);
      $('wr-drawer-scrim').addEventListener('click', closeDrawer);
      document.addEventListener('keydown', (e) => {
        const k = e as KeyboardEvent;
        if ((k.target as HTMLElement)?.id === 'wr-title-input') {          // ในช่องแก้ชื่อ: Enter บันทึก · Esc แค่ยกเลิกแก้ ไม่ปิดแผง
          if (k.key === 'Enter') { k.preventDefault(); void saveIdeaTitle(); }
          else if (k.key === 'Escape') { k.preventDefault(); renderDetail(); }
          return;
        }
        if (k.key === 'Escape' && !$('wr-drawer').classList.contains('hidden')) closeDrawer();
      });

      // Detail — click delegation
      $('wr-detail-body').addEventListener('click', (e) => void (async () => {
        const el = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
        if (!el || el.tagName === 'SELECT' || el.tagName === 'TEXTAREA') return;
        const idea = ideas.find((i) => i.content_id === selectedId);
        if (!idea) return;
        try {
          switch (el.dataset.action) {
            case 'edit-title': { $('wr-title-wrap').outerHTML = titleEditorHtml(idea.title); const i = $('wr-title-input') as HTMLInputElement; i.focus(); i.select(); break; }
            case 'save-title': await saveIdeaTitle(); break;
            case 'cancel-title': renderDetail(); break;
            case 'copy-id': await copyText(el.dataset.v!); toast(`คัดลอก ${el.dataset.v}`); break;
            case 'create-variant': await createVariant(idea, el.dataset.code as FormatCode); toast('สร้าง variant แล้ว'); await refresh(); break;
            case 'studio': openStudio(el.dataset.v!); break;
            case 'open-line': closeDrawer(); setView('line'); showLineVariant(el.dataset.v!); break;
            case 'note-studio': { const v = variants.find((x) => x.variant_id === el.dataset.v); if (v) await openNoteStudio(v); break; }
            case 'm-left': await moveMedia(el.dataset.v!, Number(el.dataset.i), -1); break;
            case 'm-right': await moveMedia(el.dataset.v!, Number(el.dataset.i), 1); break;
            case 'm-del': {
              const m = mediaByVariant.get(el.dataset.v!)?.[Number(el.dataset.i)];
              if (!m || !confirm('เอารูปนี้ออกจากชุด? (ไฟล์ยังเก็บไว้ กู้คืนได้)')) break;
              await archiveMedia(m.asset_id);
              const rest = (mediaByVariant.get(el.dataset.v!) ?? []).filter((x) => x.asset_id !== m.asset_id);
              await reorderMedia(rest.map((x) => x.asset_id));
              toast('เอารูปออกแล้ว'); await loadMediaFor([el.dataset.v!]); break;
            }
            case 'snap': {
              snapPubId = el.dataset.pub!;
              $('wr-snap-sub').textContent = el.dataset.label ?? '';
              $('wr-snap-fields').querySelectorAll('input').forEach((i) => { (i as HTMLInputElement).value = ''; });
              ($('wr-snap') as HTMLDialogElement).showModal();
              break;
            }
            case 'add-pub': {
              const vId = el.dataset.v!;
              const platform = (document.querySelector(`select[data-role="pub-platform"][data-v="${CSS.escape(vId)}"]`) as HTMLSelectElement).value;
              const url = (document.querySelector(`input[data-role="pub-url"][data-v="${CSS.escape(vId)}"]`) as HTMLInputElement).value.trim();
              await addPublication(vId, platform, url, new Date().toISOString());
              if (idea.idea_status !== 'published' && idea.idea_status !== 'repurpose_candidate') {
                await updateIdea(idea.content_id, { idea_status: 'published' });
              }
              toast(`บันทึกการลง ${platform} แล้ว`);
              await refresh();
              break;
            }
          }
        } catch (err) { oops(err); }
      })());

      $('wr-detail-body').addEventListener('change', (e) => void (async () => {
        const el = e.target as HTMLElement;
        const upFor = (el as HTMLInputElement).dataset?.upload;
        if (upFor) {
          const input = el as HTMLInputElement;
          const v = variants.find((x) => x.variant_id === upFor);
          const files = [...(input.files ?? [])];
          if (!v || !files.length) return;
          try {
            toast(`กำลังอัป ${files.length} รูป…`);
            const n = await uploadMedia(v, files, (mediaByVariant.get(upFor) ?? []).length);
            toast(`อัปแล้ว ${n} รูป`);
            await loadMediaFor([upFor]);
          } catch (err) { oops(err); } finally { input.value = ''; }
          return;
        }
        const action = el.dataset.action;
        const idea = ideas.find((i) => i.content_id === selectedId);
        if (!action || !idea) return;
        try {
          if (action === 'v-status') await updateVariant(el.dataset.v!, { variant_status: (el as HTMLSelectElement).value as VariantStatus });
          else if (action === 'decision') await setDecision(el.dataset.pub!, ((el as HTMLSelectElement).value || null) as DecisionLabel | null);
          else if (action === 'i-status') await updateIdea(idea.content_id, { idea_status: (el as HTMLSelectElement).value as IdeaStatus });
          else if (action === 'i-acid') await updateIdea(idea.content_id, { acid_test: (el as HTMLSelectElement).value as Idea['acid_test'] });
          else if (action === 'i-pillar') await updateIdea(idea.content_id, { pillar_bucket: ((el as HTMLSelectElement).value || null) as Idea['pillar_bucket'] });
          else if (action === 'i-pillar14') await updateIdea(idea.content_id, { pillar_v14: ((el as HTMLSelectElement).value || null) as Idea['pillar_v14'] });
          else if (action === 'i-funnel') await updateIdea(idea.content_id, { funnel_stage: ((el as HTMLSelectElement).value || null) as Idea['funnel_stage'] });
          else if (action === 'angle') await updateIdea(idea.content_id, { canonical_angle: (el as HTMLTextAreaElement).value.trim() || null });
          else return;
          toast('อัปเดตแล้ว');
          await refresh();
        } catch (err) { oops(err); }
      })());

      // Studio buttons
      $('wr-studio-copy-body').addEventListener('click', () => { void copyText(($('wr-studio-body') as HTMLTextAreaElement).value).then(() => toast('คัดลอกเนื้อหาแล้ว')); });
      $('wr-studio-copy').addEventListener('click', () => { const f = studioFile(); if (f) void copyText(f.md).then(() => toast('คัดลอกทั้งไฟล์แล้ว')); });
      $('wr-studio-dl').addEventListener('click', () => { const f = studioFile(); if (f) { downloadText(f.name, f.md); toast(`ดาวน์โหลด ${f.name}`); } });
      $('wr-studio-save-draft').addEventListener('click', () => void saveDraft());
      $('wr-studio-template').addEventListener('click', () => {
        const body = $('wr-studio-body') as HTMLTextAreaElement;
        if (body.value.trim() && body.value !== SCRIPT_TEMPLATE && !confirm('ทับเนื้อหาในช่องร่างด้วยโครงเปล่า?')) return;
        body.value = SCRIPT_TEMPLATE;
        toast('วางโครง Hook→Setup→Body→Rehook→Payoff→CTA แล้ว 📐');
      });
      $('wr-studio-ai').addEventListener('click', () => void runImprove());
      $('wr-studio-ai-copy').addEventListener('click', () => { void copyText(($('wr-studio-ai-body') as HTMLTextAreaElement).value).then(() => toast('คัดลอกผล AI แล้ว')); });
      $('wr-studio-ai-use').addEventListener('click', () => {
        const improved = ($('wr-studio-ai-body') as HTMLTextAreaElement).value;
        if (!improved) return;
        ($('wr-studio-body') as HTMLTextAreaElement).value = improved;
        toast('วางผล AI ในช่องร่างแล้ว — กด 💾 ถ้าจะเก็บทับร่างเดิม');
      });

      // Snapshot save
      $('wr-snap-save').addEventListener('click', () => void (async () => {
        if (!snapPubId) return;
        const metrics: Record<string, unknown> = {};
        $('wr-snap-fields').querySelectorAll('input').forEach((i) => {
          const input = i as HTMLInputElement;
          if (input.value !== '') metrics[input.dataset.m!] = input.dataset.m === 'notes' ? input.value : Number(input.value);
        });
        try {
          await addSnapshot(snapPubId, metrics);
          ($('wr-snap') as HTMLDialogElement).close();
          toast('บันทึก snapshot แล้ว');
          await refresh();
        } catch (err) { oops(err); }
      })());
    }

    // ---------- boot ----------
    let booted = false;
    async function boot() {
      if (booted) return;
      booted = true;
      wire();
      initNoteStudio({ toast, onRendered: async () => { await refresh(); } });
      initCampaigns({
        api: { listCampaigns, listCampaignItems, updateCampaignItem, addCampaignItems, deleteCampaignItem, createCampaign, updateIdea, updateCampaign, listMedia },
        data: () => ({ ideas, variants, pubs }),
        openDrawer: (cid) => openDrawer(cid),
        toast,
      });
      initLineView({
        api: { listLineRounds, lineRoundImages, lineImageDownloadUrl, updateLineRound },
        data: () => ({ ideas, variants }),
        openDrawer: (cid) => { setView('board'); openDrawer(cid); },
        toast,
      });
      const camp = location.hash.match(/^#campaign=(.+)$/);
      if (camp || location.hash === '#campaigns') openCampaign(camp ? decodeURIComponent(camp[1]) : null);
      const line = location.hash.match(/^#line(?:=(.+))?$/);
      if (line?.[1]) openLineRound(decodeURIComponent(line[1]));
      setView(location.hash === '#queue' ? 'queue' : camp || location.hash === '#campaigns' ? 'campaign' : line ? 'line' : 'board');
      try { await refresh(); } catch (e) { oops(e); }
      if (view === 'line') void loadLineRounds().catch(oops);   // การ์ดได้ชื่อไอเดียหลังโหลดบอร์ดเสร็จ
      void loadQueue().catch(() => {});   // badge ⏳ บนปุ่มมุมมอง — รู้ตั้งแต่เปิดหน้าว่ามีงาน AI กำลังวิ่ง
    }
    document.addEventListener('war-room:authed', () => void boot());
    void (async () => { if (await getSupabaseSession()) void boot(); })();
  </script>
</DashboardLayout>
