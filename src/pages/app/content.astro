---
// Content Center (เดิม Marketing War Room · เปลี่ยนชื่อ+route 2026-09-02 — id/ตัวแปร wr-* คงเดิม)
// Phase 1 "War Room Lite" (Kanban revision)
// Spec: claude-code repo → output/docs/marketing-war-room-content-planning-system-v2-2026-07-10.md
// State truth = Supabase (RLS is_owner) · Content truth = repo .md (Save = copy/download)
// UI: Kanban pipeline board (default) + List capture view + slide-in detail drawer.
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import NoteStudioDialog from '../../components/war-room/NoteStudioDialog.astro';
import CampaignView from '../../components/war-room/CampaignView.astro';
import LineView from '../../components/war-room/LineView.astro';
import WarRoomGate from '../../components/war-room/WarRoomGate.astro';
import AppNav from '../../components/app/AppNav.astro';
---
<DashboardLayout title="Content Center — Pun">
  <script is:inline async src="https://accounts.google.com/gsi/client"></script>
  <WarRoomGate title="Content Center" />

  <div id="war-room-app" class="hidden min-h-dvh bg-base-100">
    <AppNav app="content" />

    <div class="mx-auto flex max-w-7xl 3xl:max-w-none flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 pt-3">
      <p id="wr-date" class="text-sm opacity-60"></p>
      <!-- 5 มุมมองแล้ว (2026-10-18 เพิ่ม 📣 LINE) — มือถือแคบให้เลื่อนในแถบ ไม่ดันหน้าล้น -->
      <div role="tablist" aria-label="มุมมอง" class="join max-w-full overflow-x-auto rounded-full border border-base-300 p-0.5 [&>button]:shrink-0">
        <button id="wr-view-board" role="tab" aria-selected="true" class="join-item btn btn-sm rounded-full border-0 text-white tap-44" style="background-color:var(--color-brand-navy);">🗂 Board</button>
        <button id="wr-view-list" role="tab" aria-selected="false" class="join-item btn btn-sm rounded-full border-0 btn-ghost tap-44">📋 List</button>
        <button id="wr-view-queue" role="tab" aria-selected="false" class="join-item btn btn-sm rounded-full border-0 btn-ghost tap-44">⏳ คิว <span id="wr-queue-badge" class="badge badge-warning badge-sm ml-1 hidden">0</span></button>
        <button id="wr-view-campaign" role="tab" aria-selected="false" class="join-item btn btn-sm rounded-full border-0 btn-ghost tap-44">🎯 แคมเปญ</button>
        <button id="wr-view-line" role="tab" aria-selected="false" class="join-item btn btn-sm rounded-full border-0 btn-ghost tap-44">📣 LINE</button>
      </div>
    </div>

    <div class="mx-auto max-w-7xl 3xl:max-w-none px-4 py-4 space-y-4">
      <!-- Pipeline stat pills -->
      <section aria-label="สถานะการผลิต" class="-mx-4 overflow-x-auto px-4">
        <div id="wr-stats" class="flex min-w-max gap-2 sm:grid sm:min-w-0 sm:grid-cols-4"></div>
        <p id="wr-stats-scope" class="mt-1.5 hidden text-xs opacity-60" role="status"></p>
      </section>
      <div id="wr-stale" class="hidden rounded-2xl px-4 py-2.5 text-sm text-white" style="background-color:var(--color-brand-navy);" role="status"></div>

      <CampaignView />
      <LineView />

      <!-- ============ BOARD VIEW ============ -->
      <section id="wr-board-view" aria-label="Kanban pipeline">
        <!-- Quick capture + search bar -->
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <div class="flex flex-1 min-w-[240px] items-center gap-2 rounded-full border border-base-300 bg-base-200 pl-3 pr-1 focus-within:border-[color:var(--color-brand-coral)] transition-colors">
            <span aria-hidden="true" class="opacity-50">💡</span>
            <input id="wr-quick-idea" class="input input-ghost flex-1 border-0 px-1 focus:outline-none" placeholder="โยนไอเดียเร็ว ๆ แล้วกด Enter…" aria-label="เพิ่มไอเดียเร็ว" autocomplete="off" />
            <button id="wr-quick-save" class="btn btn-sm rounded-full text-white tap-44" style="background-color:var(--color-brand-coral);">เพิ่ม</button>
          </div>
          <label class="flex items-center gap-2 rounded-full border border-base-300 bg-base-200 px-3">
            <span aria-hidden="true" class="opacity-50">🔍</span>
            <input id="wr-board-search" class="input input-ghost w-40 border-0 px-0 focus:outline-none" placeholder="ค้นหา…" aria-label="ค้นหาในบอร์ด" autocomplete="off" />
          </label>
        </div>
        <div id="wr-quick-similar" class="mb-3 hidden rounded-xl border p-3 text-sm" style="border-color:var(--color-brand-coral);"></div>

        <!-- Format filter (tag) + sort (2026-10-15) -->
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <div id="wr-fmt-filter" role="group" aria-label="กรองตามฟอร์แมต" class="flex flex-wrap gap-1.5"></div>
          <label class="ml-auto flex items-center gap-2 text-sm">
            <span class="opacity-60">เรียง</span>
            <select id="wr-board-sort" class="select select-bordered select-sm rounded-full" aria-label="เรียงการ์ด">
              <option value="stale">ค้างนานสุดก่อน</option>
              <option value="newest">วันที่ ใหม่ → เก่า</option>
              <option value="oldest">วันที่ เก่า → ใหม่</option>
              <option value="id_asc">หมายเลข ID น้อย → มาก</option>
              <option value="id_desc">หมายเลข ID มาก → น้อย</option>
              <option value="custom">✋ Custom (ลากเรียงเอง)</option>
            </select>
          </label>
        </div>
        <p id="wr-custom-hint" class="mb-3 hidden text-xs opacity-60">✋ ลากการ์ดขึ้น-ลงในคอลัมน์ได้เลย หรือกด ↑ ↓ บนการ์ด · ลำดับบันทึกใน database เห็นตรงกันทั้ง MacBook และมือถือ</p>

        <!-- Columns -->
        <div id="wr-board" class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-3"></div>
      </section>

      <!-- ============ QUEUE VIEW (2026-09-08) — งาน AI ที่ Mac mini กำลังทำ: ✨ เกลาบท (Script Studio) · ✍️ version ผม (Intel Warroom) ============ -->
      <section id="wr-queue-view" class="hidden space-y-3" aria-label="คิวงาน AI">
        <div id="wr-queue-health" class="rounded-2xl border border-base-300 bg-base-200/60 px-4 py-3 text-sm" role="status" aria-live="polite">กำลังโหลดคิว…</div>
        <div class="flex flex-wrap items-center gap-2">
          <div id="wr-queue-filter" class="flex flex-wrap gap-1">
            <button class="btn btn-xs tap-44 btn-active" data-qf="all">ทั้งหมด</button>
            <button class="btn btn-xs tap-44" data-qf="ai_improve">✨ เกลาบท</button>
            <button class="btn btn-xs tap-44" data-qf="rewrite_reel">✍️ version ผม</button>
            <button class="btn btn-xs tap-44" data-qf="other">อื่นๆ (News Desk)</button>
          </div>
          <button id="wr-queue-refresh" class="btn btn-ghost btn-xs tap-44 ml-auto" aria-label="รีเฟรชคิว">⟳ รีเฟรช</button>
        </div>
        <div class="overflow-x-auto rounded-2xl border border-base-300">
          <table class="table table-sm">
            <thead><tr><th>งาน</th><th>การ์ด / ธง</th><th>สถานะ</th><th>ส่งเมื่อ</th><th></th></tr></thead>
            <tbody id="wr-queue"></tbody>
          </table>
        </div>
        <p class="text-xs opacity-60">worker บน Mac mini หยิบทีละงานทุก 12 วินาที · Codex ใช้ 2-10 นาทีต่องาน · ปิดหน้านี้ได้ งานไม่หยุด · งานที่วิ่งเกิน 20 นาที = ผิดปกติ ให้พิมพ์ใน Telegram ว่า <code>scout: status</code> หรือสั่ง <code>launchctl kickstart -k gui/$(id -u)/com.pun.wrjobs-worker</code> บนมินิ · งานรูป/คลิปของ Funnel Lab (🎞) วิ่งที่ worker แยก <code>com.pun.funnel-media-worker</code></p>
      </section>

      <!-- ============ LIST VIEW ============ -->
      <section id="wr-list-view" class="hidden grid gap-4 lg:grid-cols-[2fr_3fr] lg:items-start" aria-label="รายการไอเดีย">
        <div class="space-y-4">
          <!-- Idea Inbox (full capture form) -->
          <section class="card border border-base-300 bg-base-200">
            <div class="card-body p-4 gap-3">
              <div class="flex items-center justify-between">
                <h2 class="font-display font-bold">💡 Idea Inbox</h2>
                <span id="wr-untriaged" class="badge badge-sm" style="background-color:var(--color-brand-navy);color:white;"></span>
              </div>
              <label class="form-control">
                <textarea id="wr-idea-title" class="textarea textarea-bordered min-h-20 text-base" placeholder="โยนไอเดียตรงนี้ — 1 ประโยคก็พอ" aria-label="ไอเดียใหม่"></textarea>
              </label>
              <input id="wr-idea-angle" class="input input-bordered input-sm" placeholder="canonical angle (มุมหลัก — ใส่ทีหลังได้)" aria-label="Canonical angle" autocomplete="off" />
              <div class="grid grid-cols-2 gap-2">
                <select id="wr-idea-pillar" class="select select-bordered select-sm" aria-label="Pillar bucket">
                  <option value="">pillar (mix)</option>
                  <option value="ai_in_business">AI ในธุรกิจจริง 40%</option>
                  <option value="sales_team">ทีมขาย/บริหาร 30%</option>
                  <option value="intersection">จุดตัด AI×ขาย 20%</option>
                  <option value="persona">ตัวตน 10%</option>
                </select>
                <select id="wr-idea-funnel" class="select select-bordered select-sm" aria-label="Funnel stage">
                  <option value="">funnel</option>
                  <option value="top">top</option>
                  <option value="middle">middle</option>
                  <option value="bottom">bottom</option>
                </select>
              </div>
              <div id="wr-similar" class="hidden rounded-xl border p-3 text-sm" style="border-color:var(--color-brand-coral);"></div>
              <button id="wr-idea-save" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-coral);">💾 Save idea</button>
            </div>
          </section>

          <!-- Ideas list -->
          <section class="card border border-base-300 bg-base-200">
            <div class="card-body p-4 gap-3">
              <div class="flex items-center justify-between gap-2">
                <h2 class="font-display font-bold">📚 Ideas</h2>
                <input id="wr-search" class="input input-bordered input-sm w-36" placeholder="ค้นหา..." aria-label="ค้นหา idea" autocomplete="off" />
              </div>
              <div id="wr-filter" class="flex flex-wrap gap-1 text-xs">
                <button class="btn btn-xs btn-active" data-f="all">ทั้งหมด</button>
                <button class="btn btn-xs" data-f="captured">ยังไม่ triage</button>
                <button class="btn btn-xs" data-f="active">กำลังผลิต</button>
                <button class="btn btn-xs" data-f="published">ลงแล้ว</button>
                <button class="btn btn-xs" data-f="archived">archive</button>
              </div>
              <ul id="wr-idea-list" class="menu w-full gap-1 p-0"></ul>
            </div>
          </section>
        </div>
        <p class="hidden lg:block py-10 text-center text-sm opacity-40">เลือก idea เพื่อดูรายละเอียด (เปิดแผงด้านขวา)</p>
      </section>
    </div>

    <!-- ============ DETAIL DRAWER (slide-in right) ============ -->
    <div id="wr-drawer" class="fixed inset-0 z-40 hidden" role="dialog" aria-modal="true" aria-label="รายละเอียดคอนเทนต์">
      <div id="wr-drawer-scrim" class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200"></div>
      <aside id="wr-drawer-panel" class="absolute right-0 top-0 flex h-full w-full max-w-md translate-x-full flex-col bg-base-100 shadow-2xl transition-transform duration-200 will-change-transform">
        <div class="flex items-center justify-between border-b border-base-300 px-4 py-2.5">
          <span class="font-display text-sm font-bold opacity-70">รายละเอียด</span>
          <button id="wr-drawer-close" class="btn btn-sm btn-circle btn-ghost tap-44" aria-label="ปิดแผง">✕</button>
        </div>
        <div id="wr-detail-body" class="flex-1 overflow-y-auto p-4"></div>
      </aside>
    </div>

    <!-- Script Studio dialog -->
    <dialog id="wr-studio" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box max-w-3xl">
        <h3 class="font-display font-bold" id="wr-studio-title">Script Studio</h3>
        <p class="text-xs opacity-60 mt-1" id="wr-studio-path"></p>
        <textarea id="wr-studio-body" class="textarea textarea-bordered mt-3 w-full min-h-72 font-mono text-sm" placeholder="# Hook (0-2 วิ)&#10;# Setup (2-10 วิ)&#10;# Body + ↻ Rehook&#10;# Payoff&#10;# CTA&#10;# 🔤 Hook Text · # 📝 Caption" aria-label="Script markdown body"></textarea>
        <details class="mt-2 rounded-lg bg-base-200 px-3 py-2 text-xs leading-relaxed">
          <summary class="cursor-pointer font-semibold opacity-70">✅ Checklist ก่อนอัด (reel-hook-formulas Part 13.4)</summary>
          <ul class="mt-1 list-disc space-y-0.5 pl-4 opacity-80">
            <li><b>Setup</b> สัญญาว่าจะได้เห็นอะไร — ห้าม "เล่าให้ฟัง" (ใช้ "พาไปดู") · ห้ามอวดสถานะตัวเอง</li>
            <li><b>Body</b> เลือก 1 สไตล์จาก 8 และตอบได้ว่า "คนดูจะ<b>เห็น</b>อะไร" · Body ≠ Payoff</li>
            <li><b>↻ Rehook</b> ทุกจุดเปลี่ยนข้อ · ~1 ครั้ง/15-20 วิ · คลิป &gt;45 วิ ≥2 จุด · ห้าม "ไม่ใช่ X แต่ Y"</li>
            <li>Rehook เปิดประเด็นอะไร <b>Payoff ต้องตอบประเด็นนั้น</b></li>
            <li><b>🔤 Hook Text</b> กฎ 5x5 teaser ไม่ซ้ำเสียงพูด · คลิปลิสต์ต้องมี <b>🔢 Step N/M</b> เลขตรงที่พูด</li>
          </ul>
        </details>
        <p class="mt-2 text-xs opacity-60">💡 ร่างเก็บใน database (💾) · ไฟล์ .md จริงใน repo = content truth เหมือนเดิม — Download แล้ววางตาม path ข้างบน</p>

        <!-- AI improve (2026-08-13): งานวิ่งผ่าน wr_jobs → Codex CLI บน Mac mini · ร่างเดิมไม่โดนทับ -->
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <button id="wr-studio-ai" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-navy);">✨ ให้ AI เกลา</button>
          <button id="wr-studio-save-draft" class="btn btn-sm btn-ghost tap-44">💾 บันทึกร่าง</button>
          <button id="wr-studio-template" class="btn btn-sm btn-ghost tap-44">📐 วางโครง</button>
          <span id="wr-studio-ai-status" class="text-xs opacity-70" role="status" aria-live="polite"></span>
        </div>
        <section id="wr-studio-ai-pane" class="mt-3 hidden">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h4 class="font-display text-sm font-bold">🤖 ผลจาก AI <span id="wr-studio-ai-at" class="text-xs font-normal opacity-50"></span></h4>
            <div class="flex gap-1">
              <button id="wr-studio-ai-copy" class="btn btn-xs tap-44">คัดลอกผล</button>
              <button id="wr-studio-ai-use" class="btn btn-xs tap-44">⬆️ ใช้แทนร่าง</button>
            </div>
          </div>
          <textarea id="wr-studio-ai-body" readonly class="textarea textarea-bordered mt-2 w-full min-h-72 bg-base-200 font-mono text-sm" aria-label="ผล script จาก AI"></textarea>
          <p class="mt-1 text-xs opacity-60">เกลาตาม reel-hook-formulas + เสียงปัน + กฎ ai-language-check — ร่างของปันยังอยู่ช่องบนเสมอ</p>
        </section>

        <div class="modal-action flex-wrap gap-2">
          <button id="wr-studio-copy-body" class="btn btn-sm tap-44">คัดลอกเนื้อหา</button>
          <button id="wr-studio-copy" class="btn btn-sm tap-44">คัดลอกทั้งไฟล์ (.md)</button>
          <button id="wr-studio-dl" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-coral);">⬇️ Download .md</button>
          <form method="dialog"><button class="btn btn-sm btn-ghost tap-44">ปิด</button></form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิด">close</button></form>
    </dialog>

    <NoteStudioDialog />

    <!-- Analytics snapshot dialog -->
    <dialog id="wr-snap" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box">
        <h3 class="font-display font-bold">📊 Analytics snapshot</h3>
        <p class="text-xs opacity-60 mt-1" id="wr-snap-sub"></p>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3" id="wr-snap-fields">
          <label class="form-control"><span class="label-text text-xs">views</span><input data-m="views" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">reach</span><input data-m="reach" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">likes</span><input data-m="likes" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">comments</span><input data-m="comments" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">shares</span><input data-m="shares" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">saves</span><input data-m="saves" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">keyword comments</span><input data-m="keyword_comments" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">DM</span><input data-m="dm_count" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">LINE adds</span><input data-m="line_adds" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control"><span class="label-text text-xs">leads</span><input data-m="leads_created" type="number" min="0" class="input input-bordered input-sm" /></label>
          <label class="form-control col-span-2"><span class="label-text text-xs">notes</span><input data-m="notes" type="text" class="input input-bordered input-sm" /></label>
        </div>
        <div class="modal-action">
          <button id="wr-snap-save" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-coral);">บันทึก</button>
          <form method="dialog"><button class="btn btn-sm btn-ghost tap-44">ยกเลิก</button></form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิด">close</button></form>
    </dialog>

    <!-- Toast -->
    <div class="toast toast-end z-50">
      <div id="wr-toast" class="alert hidden text-sm shadow-lg"></div>
    </div>
  </div>

  <script>
    import {
      FORMAT_CODES, PLATFORMS,
      listIdeas, listVariants, listPublications, snapshotPubIds, findSimilar,
      createIdea, updateIdea, createVariant, updateVariant, reorderVariants, reorderIdeas, addPublication,
      setDecision, addSnapshot, buildVariantMarkdown, downloadText, copyText,
      enqueueJob, waitJob, listWrJobs, retryWrJob, deleteWrJob,
      listMedia, uploadMedia, reorderMedia, archiveMedia, type MediaAsset,
      listLineRounds, lineRoundImages, lineImageDownloadUrl, updateLineRound,
      listCampaigns, listCampaignItems, updateCampaignItem, addCampaignItems, deleteCampaignItem, createCampaign, updateCampaign,
      PILLAR_V14_LABEL, type PillarV14,
      type Idea, type Variant, type Publication, type FormatCode,
      type IdeaStatus, type VariantStatus, type DecisionLabel, type WrJob,
    } from '../../scripts/war-room/data';
    import { listItemTitles } from '../../scripts/newsroom/data';
    import { supabase, getSupabaseSession } from '../../scripts/dashboard/supabase';
    import { initNoteStudio, openNoteStudio } from '../../scripts/war-room/note-studio';
    import { initCampaigns, loadCampaigns, openCampaign } from '../../scripts/war-room/campaigns';
    import { initLineView, loadLineRounds, openLineRound, showLineVariant } from '../../scripts/war-room/line-library';

    // ---------- state ----------
    let ideas: Idea[] = [];
    let variants: Variant[] = [];
    let pubs: Publication[] = [];
    let snapIds = new Set<string>();
    let selectedId: string | null = null;
    let filter = 'all';
    let search = '';
    let boardSearch = '';
    // Board sort + format filter (2026-10-15) — จำค่าที่เลือกไว้ในเครื่อง (สะดวกเฉยๆ ไม่ใช่ข้อมูลสำคัญ)
    type BoardSort = 'stale' | 'newest' | 'oldest' | 'id_asc' | 'id_desc' | 'custom';
    const BOARD_SORTS: BoardSort[] = ['stale', 'newest', 'oldest', 'id_asc', 'id_desc', 'custom'];
    const PREFS_KEY = 'wr-board-prefs';
    let boardSort: BoardSort = 'stale';
    let fmtFilter = new Set<FormatCode>();
    try {
      const saved = JSON.parse(localStorage.getItem(PREFS_KEY) ?? '{}');
      if (BOARD_SORTS.includes(saved.sort)) boardSort = saved.sort;
      if (Array.isArray(saved.fmt)) fmtFilter = new Set(saved.fmt.filter((c: string) => c in FORMAT_CODES));
    } catch { /* private window / blocked storage → ค่าเริ่มต้น */ }
    const saveBoardPrefs = () => {
      try { localStorage.setItem(PREFS_KEY, JSON.stringify({ sort: boardSort, fmt: [...fmtFilter] })); } catch { /* ignore */ }
    };
    let view: 'board' | 'list' | 'queue' | 'campaign' | 'line' = 'board';
    // คิวงาน AI (wr_jobs) — badge นับงานที่รอ/กำลังทำ · ตารางเต็มเมื่อเปิดมุมมองคิว
    let wrJobs: WrJob[] = [];
    let itemTitles = new Map<string, { title: string | null; source_url: string | null }>();
    let queueFilter: 'all' | 'ai_improve' | 'rewrite_reel' | 'other' = 'all';
    let queueTimer = 0;
    let pendingIdea: { title: string; angle: string; source: 'list' | 'quick' } | null = null;
    let studioVariantId: string | null = null;
    let snapPubId: string | null = null;

    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const VARIANT_STATUSES: VariantStatus[] = ['draft','ai_improved','ready_to_record','recorded','editing','edited','scheduled','posted','analyzed','repurposed'];
    const IDEA_STATUSES: IdeaStatus[] = ['captured','triaged','selected','active','published','repurpose_candidate','archived'];
    const DECISIONS: DecisionLabel[] = ['kill','iterate','repurpose','boost','pillar','sales_asset'];
    const daysAgo = (iso: string) => Math.floor((Date.now() - new Date(iso).getTime()) / 864e5);

    // Kanban columns: pipeline stages. `statuses` = which variant_status land here;
    // `primary` = the status a card is set to when dragged into this column.
    type Col = { key: string; label: string; icon: string; statuses: VariantStatus[]; primary: VariantStatus };
    const COLUMNS: Col[] = [
      { key: 'ready',    label: 'Ready to record', icon: '🎤', statuses: ['draft','ai_improved','ready_to_record'], primary: 'ready_to_record' },
      { key: 'recorded', label: 'ถ่ายแล้ว/กำลังตัด', icon: '✂️', statuses: ['recorded','editing'],                   primary: 'recorded' },
      { key: 'edited',   label: 'ตัดแล้ว/ตั้งเวลา',   icon: '📤', statuses: ['edited','scheduled'],                   primary: 'edited' },
      { key: 'posted',   label: 'ลงแล้ว',            icon: '🚀', statuses: ['posted'],                              primary: 'posted' },
      { key: 'analyzed', label: 'วิเคราะห์แล้ว',      icon: '📊', statuses: ['analyzed','repurposed'],               primary: 'analyzed' },
    ];
    const colOf = (s: VariantStatus) => COLUMNS.find((c) => c.statuses.includes(s));

    function toast(msg: string, kind: 'success' | 'error' = 'success') {
      const el = $('wr-toast');
      el.className = `alert text-sm shadow-lg ${kind === 'error' ? 'alert-error' : 'alert-success'}`;
      el.textContent = msg;
      window.clearTimeout((window as any).__wrToast);
      (window as any).__wrToast = window.setTimeout(() => el.classList.add('hidden'), 2200);
    }
    const oops = (e: unknown) => toast((e as Error).message || 'ผิดพลาด ลองใหม่', 'error');

    // ---------- data refresh ----------
    async function refresh() {
      [ideas, variants, pubs, snapIds] = await Promise.all([listIdeas(), listVariants(), listPublications(), snapshotPubIds()]);
      renderStats(); renderBoard(); renderList(); if (selectedId) renderDetail();
      if (view === 'campaign') void loadCampaigns().catch(oops);
    }

    // ---------- stat pills ----------
    // กล่องตัวเลข + แถบเตือนค้าง นับตามตัวกรองฟอร์แมต + คำค้นเดียวกับบอร์ด (variant_id ลงท้ายด้วยรหัสฟอร์แมต)
    const inFmt = (variantId: string) => !fmtFilter.size || fmtFilter.has(variantId.slice(-2) as FormatCode);
    const inScope = (v: Variant | undefined) => !!v && inFmt(v.variant_id) && matchesSearch(v);
    function bucket(status: VariantStatus[]) { return variants.filter((v) => status.includes(v.variant_status) && inScope(v)); }
    function analyticsDue(): Publication[] {
      const cutoff = Date.now() - 48 * 3600e3;
      return pubs.filter((p) => p.status === 'posted' && p.published_at
        && (boardSearch ? inScope(variants.find((v) => v.variant_id === p.variant_id)) : inFmt(p.variant_id))
        && new Date(p.published_at).getTime() < cutoff && !snapIds.has(p.publication_id));
    }
    function statPill(icon: string, n: number, label: string, sub: string, hot: boolean) {
      return `<article class="min-w-[150px] flex-1 rounded-2xl border ${hot && n > 0 ? 'border-2' : 'border-base-300'} bg-base-200 p-3" ${hot && n > 0 ? 'style="border-color:var(--color-brand-coral);"' : ''}>
        <div class="flex items-center justify-between">
          <span aria-hidden="true">${icon}</span>
          <span class="font-display text-2xl font-bold tabular-nums">${n}</span>
        </div>
        <p class="mt-1 text-sm font-semibold">${label}</p>
        <p class="text-xs opacity-60">${sub}</p>
      </article>`;
    }
    function renderStats() {
      const ready = bucket(['ready_to_record']);
      const recorded = bucket(['recorded', 'editing']);
      const edited = bucket(['edited', 'scheduled']);
      const due = analyticsDue();
      const oldest = (vs: Variant[]) => vs.length ? `เก่าสุด ${Math.max(...vs.map((v) => daysAgo(v.status_changed_at)))} วัน` : '—';
      $('wr-stats').innerHTML =
        statPill('🎤', ready.length, 'Ready to record', oldest(ready), false) +
        statPill('✂️', recorded.length, 'ถ่ายแล้วยังไม่ตัด', oldest(recorded), true) +
        statPill('📤', edited.length, 'ตัดแล้วยังไม่ลง', oldest(edited), true) +
        statPill('📊', due.length, 'Analytics due', 'ลงแล้วเกิน 48 ชม.', false);
      const scopeEl = $('wr-stats-scope');
      const scope = [
        ...(fmtFilter.size ? [[...fmtFilter].map((c) => FORMAT_CODES[c].label).join(' · ')] : []),
        ...(boardSearch ? [`ที่ค้นว่า "${boardSearch}"`] : []),
      ];
      const reset = [...(fmtFilter.size ? ['กด "ทั้งหมด"'] : []), ...(boardSearch ? ['ล้างช่องค้นหา'] : [])].join(' และ ');
      scopeEl.classList.toggle('hidden', !scope.length);
      scopeEl.textContent = scope.length ? `นับเฉพาะ ${scope.join(' ')} — ${reset} เพื่อดูยอดรวม` : '';

      const stale = [...recorded, ...edited].filter((v) => daysAgo(v.status_changed_at) >= 3)
        .sort((a, b) => daysAgo(b.status_changed_at) - daysAgo(a.status_changed_at))[0];
      const staleEl = $('wr-stale');
      if (stale) {
        staleEl.classList.remove('hidden');
        staleEl.innerHTML = `⚠️ <strong>${esc(stale.variant_id)}</strong> ค้างสถานะ ${esc(stale.variant_status)} มา ${daysAgo(stale.status_changed_at)} วันแล้ว`;
      } else staleEl.classList.add('hidden');

      const untriaged = ideas.filter((i) => i.idea_status === 'captured').length;
      $('wr-untriaged').textContent = untriaged ? `${untriaged} ยังไม่ triage` : 'inbox ว่าง 🎉';
    }

    // ---------- Kanban board ----------
    const titleOf = (cid: string) => ideas.find((i) => i.content_id === cid)?.title ?? cid;
    const fmtOf = (v: Variant) => v.variant_id.slice(-2) as FormatCode;
    function matchesSearch(v: Variant): boolean {
      if (!boardSearch) return true;
      const q = boardSearch.toLowerCase();
      // ค้นเนื้อบท/ข้อความด้วย (2026-10-18) — จำได้แค่ประโยคในแคปชัน/บทพูดก็หาเจอ
      return `${v.content_id} ${v.variant_id} ${v.working_title ?? ''} ${titleOf(v.content_id)} ${v.ai_result ?? ''} ${v.script_draft ?? ''}`.toLowerCase().includes(q);
    }
    const matchesBoard = (v: Variant) => matchesSearch(v) && (!fmtFilter.size || fmtFilter.has(fmtOf(v)));
    function matchesBoardIdea(i: Idea): boolean {
      if (!boardSearch) return true;
      const q = boardSearch.toLowerCase();
      return `${i.content_id} ${i.title} ${i.canonical_angle ?? ''}`.toLowerCase().includes(q);
    }
    const fmtMeta = (vid: string) => {
      const code = vid.slice(-2) as FormatCode;
      return FORMAT_CODES[code] ?? { label: code };
    };
    // ไอเดียเดียวมีได้หลาย variant (Reel/Carousel/Article) และการ์ดทุกใบใช้ "ชื่อไอเดีย"
    // เป็นหัวเรื่อง — ถ้าไม่ย้อมสีแยกฟอร์แมต การ์ดพี่น้องจะดูเหมือนการ์ดซ้ำ
    const FMT_COLOR: Record<string, string> = {
      RL: 'var(--color-brand-navy)', CR: 'var(--color-brand-coral)',
      AR: '#4b5563', LN: '#0f766e',
    };
    const siblingsOf = (v: Variant) =>
      variants.filter((x) => x.content_id === v.content_id && x.variant_id !== v.variant_id);

    // ---------- sort ----------
    const ts = (iso: string) => new Date(iso).getTime();
    // rank ว่าง (ยังไม่เคยลาก) ไปท้ายคอลัมน์ แล้วเรียงใหม่ → เก่า
    const rankCmp = (a: { board_rank?: number | null }, b: { board_rank?: number | null }) =>
      a.board_rank == null ? (b.board_rank == null ? 0 : 1) : b.board_rank == null ? -1 : a.board_rank - b.board_rank;
    function sortVariants(vs: Variant[], key: BoardSort = boardSort): Variant[] {
      switch (key) {
        case 'newest':  return vs.sort((a, b) => ts(b.created_at) - ts(a.created_at));
        case 'oldest':  return vs.sort((a, b) => ts(a.created_at) - ts(b.created_at));
        case 'id_asc':  return vs.sort((a, b) => a.variant_id.localeCompare(b.variant_id));
        case 'id_desc': return vs.sort((a, b) => b.variant_id.localeCompare(a.variant_id));
        case 'custom':  return vs.sort((a, b) => rankCmp(a, b) || ts(b.created_at) - ts(a.created_at));
        default:        return vs.sort((a, b) => ts(a.status_changed_at) - ts(b.status_changed_at));   // ค้างนานสุดก่อน
      }
    }
    function sortIdeas(is: Idea[], key: BoardSort = boardSort): Idea[] {
      switch (key) {
        case 'oldest':  return is.sort((a, b) => ts(a.created_at) - ts(b.created_at));
        case 'id_asc':  return is.sort((a, b) => a.content_id.localeCompare(b.content_id));
        case 'id_desc': return is.sort((a, b) => b.content_id.localeCompare(a.content_id));
        case 'custom':  return is.sort((a, b) => rankCmp(a, b) || ts(b.created_at) - ts(a.created_at));
        default:        return is.sort((a, b) => ts(b.created_at) - ts(a.created_at));   // ไอเดียไม่มีสถานะค้าง → ใหม่สุดก่อน
      }
    }
    // ทั้งคอลัมน์ (ไม่สนตัวกรอง/ค้นหา) ตามลำดับ Custom — ใช้ตอนบันทึกลำดับ การ์ดที่ถูกซ่อนจะได้ไม่เสียที่
    const columnVariants = (key: string) => {
      const c = COLUMNS.find((x) => x.key === key);
      return c ? sortVariants(variants.filter((v) => c.statuses.includes(v.variant_status)), 'custom') : [];
    };
    const backlogIdeas = () => {
      const withVariant = new Set(variants.map((v) => v.content_id));
      return ideas.filter((i) => !withVariant.has(i.content_id) && !['archived', 'published', 'repurpose_candidate'].includes(i.idea_status));
    };
    const moveBtns = (attr: string, id: string) => boardSort !== 'custom' ? '' :
      `<span class="flex gap-0.5">
        <button data-action="move-up" ${attr}="${esc(id)}" class="btn btn-ghost btn-xs h-6 min-h-6 px-1.5 pointer-coarse:h-10 pointer-coarse:min-h-10 pointer-coarse:px-3" aria-label="เลื่อนการ์ดขึ้น">↑</button>
        <button data-action="move-down" ${attr}="${esc(id)}" class="btn btn-ghost btn-xs h-6 min-h-6 px-1.5 pointer-coarse:h-10 pointer-coarse:min-h-10 pointer-coarse:px-3" aria-label="เลื่อนการ์ดลง">↓</button>
      </span>`;

    function variantCard(v: Variant): string {
      const meta: any = fmtMeta(v.variant_id);
      const age = daysAgo(v.status_changed_at);
      const stale = age >= 3;
      const idea = ideas.find((i) => i.content_id === v.content_id);
      const vPubs = pubs.filter((p) => p.variant_id === v.variant_id);
      const sibs = siblingsOf(v);
      const sibHint = sibs.length
        ? `<p class="mt-1 truncate text-[10px] opacity-55" title="${esc(sibs.map((s) => `${(fmtMeta(s.variant_id) as any).label ?? ''} → ${colOf(s.variant_status)?.label ?? s.variant_status}`).join(' · '))}">⧉ ไอเดียนี้มีอีก ${sibs.length} ฟอร์แมต: ${esc(sibs.map((s) => (fmtMeta(s.variant_id) as any).label ?? '').join(' · '))}</p>`
        : '';
      return `<article draggable="true" data-card="variant" data-v="${esc(v.variant_id)}" data-cid="${esc(v.content_id)}"
        class="wr-card group cursor-grab rounded-xl border border-base-300 bg-base-100 p-2.5 shadow-sm transition hover:border-[color:var(--color-brand-coral)] hover:shadow-md active:cursor-grabbing">
        <div class="flex items-center justify-between gap-2">
          <span class="badge badge-xs font-semibold" style="background-color:${FMT_COLOR[v.variant_id.slice(-2)] ?? 'var(--color-brand-navy)'};color:white;">${esc(meta.label ?? '')}</span>
          <span class="font-mono text-[10px] opacity-50">${esc(v.variant_id.replace('CNT-', ''))}</span>
        </div>
        <p class="mt-1.5 line-clamp-2 text-sm font-medium leading-snug">${esc(idea?.title ?? v.working_title ?? v.variant_id)}</p>
        <div class="mt-1.5 flex items-center justify-between gap-2">
          <span class="text-[11px] ${stale ? 'font-semibold text-error' : 'opacity-50'}">${stale ? `⏳ ค้าง ${age} วัน` : (age ? `${age} วัน` : 'วันนี้')}</span>
          ${vPubs.length ? `<span class="text-[11px] opacity-60">${vPubs.map((p) => esc(p.platform)).slice(0, 3).join(' · ')}</span>` : ''}
          ${moveBtns('data-move-v', v.variant_id)}
        </div>
        ${sibHint}
      </article>`;
    }

    function ideaCard(i: Idea): string {
      const acid = i.acid_test === 'passed' ? '✅' : i.acid_test === 'failed' ? '🔴' : '🧪';
      return `<article data-card="idea" data-cid="${esc(i.content_id)}" ${boardSort === 'custom' ? 'draggable="true"' : ''}
        class="wr-card cursor-pointer rounded-xl border border-dashed border-base-300 bg-base-100 p-2.5 shadow-sm transition hover:border-[color:var(--color-brand-coral)] hover:shadow-md">
        <div class="flex items-center justify-between gap-2">
          <span class="text-xs" aria-hidden="true" title="acid test">${acid}</span>
          <span class="flex items-center gap-1">${moveBtns('data-move-cid', i.content_id)}<span class="font-mono text-[10px] opacity-50">${esc(i.content_id.replace('CNT-', ''))}</span></span>
        </div>
        <p class="mt-1 line-clamp-2 text-sm font-medium leading-snug">${esc(i.title)}</p>
        <button data-action="quick-produce" data-cid="${esc(i.content_id)}" class="btn btn-xs mt-2 w-full tap-44">+ เริ่มผลิต</button>
      </article>`;
    }

    function column(key: string, icon: string, label: string, count: number, cardsHtml: string, dropStatus?: string): string {
      return `<section data-col="${dropStatus ?? ''}" data-colkey="${key}" class="wr-col flex w-[78vw] max-w-[300px] shrink-0 snap-start flex-col rounded-2xl border border-base-300 bg-base-200/60 sm:w-72 3xl:w-0 3xl:min-w-72 3xl:max-w-none 3xl:grow">
        <header class="flex items-center justify-between gap-2 px-3 py-2.5">
          <span class="flex items-center gap-1.5 font-display text-sm font-bold"><span aria-hidden="true">${icon}</span> ${label}</span>
          <span class="badge badge-sm tabular-nums">${count}</span>
        </header>
        <div class="wr-drop flex-1 space-y-2 overflow-y-auto px-2 pb-3" style="min-height:80px;max-height:min(60vh,640px);">
          ${cardsHtml || `<p class="px-1 py-6 text-center text-xs opacity-40">— ว่าง —</p>`}
        </div>
      </section>`;
    }

    function renderFmtFilter() {
      const searched = variants.filter(matchesSearch);
      const chip = (code: FormatCode | '', label: string, n: number, on: boolean) => {
        const color = code ? FMT_COLOR[code] ?? 'var(--color-brand-navy)' : 'var(--color-brand-navy)';
        return `<button type="button" data-fmt="${code}" aria-pressed="${on}"
          class="btn btn-sm h-9 min-h-9 pointer-coarse:h-11 pointer-coarse:min-h-11 gap-1.5 rounded-full border px-3 font-medium ${on ? 'text-white' : 'border-base-300 bg-base-100'}"
          style="${on ? `background-color:${color};border-color:${color};` : ''}">
          ${code ? `<span aria-hidden="true" class="h-2 w-2 rounded-full" style="background-color:${on ? 'white' : color};"></span>` : ''}${esc(label)}
          <span class="tabular-nums ${on ? 'opacity-80' : 'opacity-50'}">${n}</span>
        </button>`;
      };
      $('wr-fmt-filter').innerHTML = chip('', 'ทั้งหมด', searched.length, fmtFilter.size === 0) +
        (Object.keys(FORMAT_CODES) as FormatCode[])
          .map((code) => chip(code, FORMAT_CODES[code].label, searched.filter((v) => fmtOf(v) === code).length, fmtFilter.has(code)))
          .join('');
      ($('wr-board-sort') as HTMLSelectElement).value = boardSort;
      $('wr-custom-hint').classList.toggle('hidden', boardSort !== 'custom');
    }

    function renderBoard() {
      renderFmtFilter();
      // Ideas backlog = ideas with no variant yet, not archived/published.
      // ไอเดียยังไม่มีฟอร์แมต → ตอนกรองฟอร์แมตซ่อนทั้งช่อง (มือถือจะได้ไม่เสียจอทั้งช่องให้ช่องว่าง)
      const backlog = sortIdeas(backlogIdeas().filter(matchesBoardIdea));

      const cols = COLUMNS.map((c) => {
        const vs = sortVariants(variants.filter((v) => c.statuses.includes(v.variant_status)).filter(matchesBoard));
        return column(c.key, c.icon, c.label, vs.length, vs.map(variantCard).join(''), c.primary);
      }).join('');

      $('wr-board').innerHTML =
        (fmtFilter.size ? '' : column('ideas', '💡', 'Ideas', backlog.length, backlog.map(ideaCard).join(''))) + cols;
    }

    // ---------- custom order ----------
    // ย้ายการ์ด `id` ไปไว้ก่อน `beforeId` (null = ท้ายสุดของที่มองเห็น) แล้วบันทึกทั้งคอลัมน์
    // visibleIds = ลำดับที่มองเห็นอยู่ (หลังกรอง) — ใช้หาตำแหน่งในลิสต์เต็มที่รวมการ์ดที่ถูกซ่อน
    function placeIn(full: string[], id: string, beforeId: string | null, visibleIds: string[]): string[] {
      const rest = full.filter((x) => x !== id);
      let at = beforeId ? rest.indexOf(beforeId) : -1;
      if (at < 0) {
        const lastVisible = [...visibleIds].reverse().find((x) => x !== id && rest.includes(x));
        at = lastVisible ? rest.indexOf(lastVisible) + 1 : rest.length;
      }
      rest.splice(at, 0, id);
      return rest;
    }
    let reordering = false;
    async function saveOrder(kind: 'variant' | 'idea', ids: string[]) {
      // อัปเดตในเครื่องก่อนให้การ์ดขยับทันที แล้วค่อยยิง database
      const rank = new Map(ids.map((x, n) => [x, n + 1]));
      if (kind === 'variant') variants.forEach((v) => { if (rank.has(v.variant_id)) v.board_rank = rank.get(v.variant_id); });
      else ideas.forEach((i) => { if (rank.has(i.content_id)) i.board_rank = rank.get(i.content_id); });
      renderBoard();
      reordering = true;
      try { await (kind === 'variant' ? reorderVariants(ids) : reorderIdeas(ids)); }
      catch (err) { oops(err); await refresh(); }
      finally { reordering = false; }
    }
    function visibleIdsIn(colKey: string, attr: 'v' | 'cid'): string[] {
      const col = $('wr-board').querySelector(`.wr-col[data-colkey="${colKey}"]`);
      return col ? [...col.querySelectorAll<HTMLElement>('[data-card]')].map((el) => el.dataset[attr]!) : [];
    }
    function nudge(kind: 'variant' | 'idea', id: string, dir: -1 | 1) {
      if (reordering) return;
      const colKey = kind === 'idea' ? 'ideas' : colOf(variants.find((v) => v.variant_id === id)!.variant_status)!.key;
      const vis = visibleIdsIn(colKey, kind === 'idea' ? 'cid' : 'v');
      const n = vis.indexOf(id);
      const to = n + dir;
      if (n < 0 || to < 0 || to >= vis.length) return;
      const full = kind === 'idea' ? sortIdeas(backlogIdeas(), 'custom').map((i) => i.content_id) : columnVariants(colKey).map((v) => v.variant_id);
      // ขึ้น = ไปก่อนใบที่อยู่เหนือ · ลง = ไปก่อนใบที่ถัดจากใบล่าง (หรือท้ายสุด)
      const beforeId = dir < 0 ? vis[to] : vis[to + 1] ?? null;
      void saveOrder(kind, placeIn(full, id, beforeId, vis));
    }

    // ---------- Ideas list (List view) ----------
    const STATUS_BADGE: Record<string, string> = {
      captured: 'badge-neutral', triaged: 'badge-info', selected: 'badge-primary',
      active: 'badge-warning', published: 'badge-success', repurpose_candidate: 'badge-secondary', archived: 'badge-ghost',
    };
    function renderList() {
      const q = search.trim().toLowerCase();
      const rows = ideas.filter((i) => {
        if (filter === 'all') { /* keep */ }
        else if (filter === 'active' && !['selected', 'active'].includes(i.idea_status)) return false;
        else if (filter === 'published' && !['published', 'repurpose_candidate'].includes(i.idea_status)) return false;
        else if ((filter === 'captured' || filter === 'archived') && i.idea_status !== filter) return false;
        if (q && !`${i.content_id} ${i.title} ${i.canonical_angle ?? ''} ${i.topic_cluster ?? ''}`.toLowerCase().includes(q)) return false;
        return true;
      });
      $('wr-idea-list').innerHTML = rows.length
        ? rows.map((i) => `<li><button data-id="${esc(i.content_id)}" class="flex w-full flex-col items-start gap-0.5 rounded-xl px-3 py-2 text-left ${i.content_id === selectedId ? 'bg-base-300' : ''}">
            <span class="flex w-full items-center justify-between gap-2">
              <span class="font-mono text-[11px] opacity-60">${esc(i.content_id)}</span>
              <span class="badge badge-xs ${STATUS_BADGE[i.idea_status] ?? ''}">${esc(i.idea_status)}</span>
            </span>
            <span class="text-sm font-medium leading-snug">${esc(i.title)}</span>
          </button></li>`).join('')
        : '<li class="px-3 py-6 text-center text-sm opacity-50">ไม่พบ idea</li>';
    }

    // ---------- Detail (drawer) ----------
    function renderDetail() {
      const body = $('wr-detail-body');
      const idea = ideas.find((i) => i.content_id === selectedId);
      if (!idea) {
        body.innerHTML = '<p class="py-10 text-center text-sm opacity-50">เลือก idea จากบอร์ด หรือโยน idea ใหม่</p>';
        return;
      }
      const vs = variants.filter((v) => v.content_id === idea.content_id);
      const opt = (v: string, cur: string | null, label?: string) =>
        `<option value="${esc(v)}" ${v === cur ? 'selected' : ''}>${esc(label ?? v)}</option>`;

      const variantCards = (Object.keys(FORMAT_CODES) as FormatCode[]).map((code) => {
        const meta = FORMAT_CODES[code];
        const v = vs.find((x) => x.variant_id.endsWith(`-${code}`));
        if (!v) {
          return `<article class="rounded-xl border border-dashed border-base-300 p-3">
            <p class="font-display text-sm font-semibold opacity-60">${code} · ${esc(meta.label)}</p>
            <button data-action="create-variant" data-code="${code}" class="btn btn-xs mt-2 tap-44">+ สร้าง</button>
          </article>`;
        }
        const vPubs = pubs.filter((p) => p.variant_id === v.variant_id);
        const pubRows = vPubs.map((p) => `
          <div class="flex flex-wrap items-center gap-1 rounded-lg bg-base-100 px-2 py-1 text-xs">
            <span class="font-semibold">${esc(p.platform)}</span>
            ${p.post_url ? `<a class="link max-w-32 truncate" href="${esc(p.post_url)}" target="_blank" rel="noopener">link</a>` : ''}
            <span class="opacity-50">${p.published_at ? esc(new Date(p.published_at).toLocaleDateString('th-TH')) : ''}</span>
            <select data-action="decision" data-pub="${esc(p.publication_id)}" class="select select-ghost select-xs" aria-label="decision label">
              ${opt('', p.decision_label, 'decision?')}${DECISIONS.map((d) => opt(d, p.decision_label)).join('')}
            </select>
            <button data-action="snap" data-pub="${esc(p.publication_id)}" data-label="${esc(v.variant_id)} · ${esc(p.platform)}" class="btn btn-ghost btn-xs">📊${snapIds.has(p.publication_id) ? '✓' : ''}</button>
          </div>`).join('');
        const platOpts = PLATFORMS.filter((pl) => !vPubs.some((p) => p.platform === pl))
          .map((pl) => `<option value="${pl}">${pl}</option>`).join('');
        return `<article class="rounded-xl border border-base-300 bg-base-100 p-3 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <p class="font-display text-sm font-semibold">${code} · ${esc(meta.label)}</p>
            <button data-action="copy-id" data-v="${esc(v.variant_id)}" class="btn btn-ghost btn-xs" aria-label="copy variant id">📋 ID</button>
          </div>
          <select data-action="v-status" data-v="${esc(v.variant_id)}" class="select select-bordered select-xs w-full" aria-label="variant status">
            ${VARIANT_STATUSES.map((s) => opt(s, v.variant_status)).join('')}
          </select>
          <p class="break-all font-mono text-[10px] opacity-50">${esc(v.markdown_path ?? '')}</p>
          <button data-action="studio" data-v="${esc(v.variant_id)}" class="btn btn-xs w-full tap-44">📝 Script Studio</button>
          ${v.format === 'carousel' || v.format === 'article' ? `<div class="rounded-lg bg-base-200/70 p-2">
            <div class="flex items-center justify-between gap-1">
              <span class="text-xs font-semibold">🖼 รูป <span data-media-count="${esc(v.variant_id)}" class="font-normal opacity-60"></span></span>
              <label class="btn btn-ghost btn-xs tap-44">อัปรูป<input type="file" accept="image/*" multiple class="sr-only" data-upload="${esc(v.variant_id)}" aria-label="อัปโหลดรูปให้ ${esc(v.variant_id)}" /></label>
            </div>
            <ol data-media-for="${esc(v.variant_id)}" class="mt-1 grid grid-cols-4 gap-1" aria-label="ลำดับรูป ใบแรก = ปก"><li class="col-span-4 text-xs opacity-50">กำลังโหลด…</li></ol>
            <button data-action="note-studio" data-v="${esc(v.variant_id)}" class="btn btn-xs mt-2 w-full text-white tap-44" style="background-color:var(--color-brand-navy);">🎨 Note Studio — ทำ/แก้รูป</button>
          </div>` : v.format === 'line_broadcast' ? `<div class="rounded-lg bg-base-200/70 p-2">
            <span class="text-xs font-semibold">📣 รูปทุกรอบ <span data-media-count="${esc(v.variant_id)}" class="font-normal opacity-60"></span></span>
            <ol data-media-for="${esc(v.variant_id)}" class="mt-1 grid grid-cols-4 gap-1" aria-label="รูป broadcast ทุกรอบ"><li class="col-span-4 text-xs opacity-50">กำลังโหลด…</li></ol>
            <button data-action="open-line" data-v="${esc(v.variant_id)}" class="btn btn-xs mt-2 w-full text-white tap-44" style="background-color:var(--color-brand-navy);">📣 เปิดในแท็บ LINE (ข้อความ + ส่งแล้ว)</button>
          </div>` : ''}
          ${pubRows}
          ${platOpts ? `<div class="flex gap-1">
            <select data-role="pub-platform" data-v="${esc(v.variant_id)}" class="select select-bordered select-xs flex-1" aria-label="platform">${platOpts}</select>
            <input data-role="pub-url" data-v="${esc(v.variant_id)}" class="input input-bordered input-xs flex-1" placeholder="post URL" aria-label="post url" />
            <button data-action="add-pub" data-v="${esc(v.variant_id)}" class="btn btn-xs tap-44">ลงแล้ว</button>
          </div>` : ''}
        </article>`;
      }).join('');

      body.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs opacity-60">${esc(idea.content_id)}</span>
              <button data-action="copy-id" data-v="${esc(idea.content_id)}" class="btn btn-ghost btn-xs" aria-label="copy content id">📋</button>
            </div>
            <div id="wr-title-wrap" class="flex items-start gap-2">
              <h2 class="min-w-0 flex-1 font-display text-lg font-bold leading-snug">${esc(idea.title)}</h2>
              <button data-action="edit-title" class="btn btn-ghost btn-xs tap-44 shrink-0" aria-label="แก้ชื่อหัวข้อ" title="แก้ชื่อหัวข้อ">✏️</button>
            </div>
          </div>
        </div>
        <label class="form-control mt-2">
          <span class="label-text text-xs opacity-60">canonical angle</span>
          <textarea data-action="angle" class="textarea textarea-bordered textarea-sm" rows="2" aria-label="canonical angle">${esc(idea.canonical_angle ?? '')}</textarea>
        </label>
        <div class="mt-2 grid grid-cols-2 gap-2 md:grid-cols-4">
          <select data-action="i-status" class="select select-bordered select-xs" aria-label="idea status">${IDEA_STATUSES.map((s) => opt(s, idea.idea_status)).join('')}</select>
          <select data-action="i-acid" class="select select-bordered select-xs" aria-label="acid test">
            ${opt('pending', idea.acid_test, 'acid: pending')}${opt('passed', idea.acid_test, 'acid: passed ✅')}${opt('failed', idea.acid_test, 'acid: failed 🔴')}
          </select>
          <select data-action="i-pillar" class="select select-bordered select-xs" aria-label="pillar">
            ${opt('', idea.pillar_bucket, 'pillar?')}${opt('ai_in_business', idea.pillar_bucket)}${opt('sales_team', idea.pillar_bucket)}${opt('intersection', idea.pillar_bucket)}${opt('persona', idea.pillar_bucket)}
          </select>
          <select data-action="i-funnel" class="select select-bordered select-xs" aria-label="funnel">
            ${opt('', idea.funnel_stage, 'funnel?')}${opt('top', idea.funnel_stage)}${opt('middle', idea.funnel_stage)}${opt('bottom', idea.funnel_stage)}
          </select>
          <select data-action="i-pillar14" class="select select-bordered select-xs col-span-2 md:col-span-4" aria-label="หมวดตามธง v1.4">
            ${opt('', idea.pillar_v14 ?? null, 'หมวด (ธง v1.4)?')}${(Object.keys(PILLAR_V14_LABEL) as PillarV14[]).map((k) => opt(k, idea.pillar_v14 ?? null, `หมวด: ${PILLAR_V14_LABEL[k]}`)).join('')}
          </select>
        </div>
        ${idea.acid_test !== 'passed' ? `<p class="mt-2 rounded-lg bg-warning/20 px-3 py-2 text-xs">🧪 Triage Gate: ถามก่อนถ่าย — "ตัดหน้า/ชื่อปันออก คนดูยังได้ของกลับบ้านไหม?" ผ่านแล้วตั้ง acid: passed ก่อนเข้า weekly plan</p>` : ''}
        <h3 class="mt-4 font-display text-sm font-bold">Variants <span class="font-normal opacity-50">(format เท่านั้น — platform บันทึกตอนลงจริง)</span></h3>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">${variantCards}</div>`;
      void loadMediaFor(vs.filter((v) => v.format === 'carousel' || v.format === 'article' || v.format === 'line_broadcast').map((v) => v.variant_id));
    }

    // ---------- รูปของ post/carousel (2026-10-02) ----------
    let mediaByVariant = new Map<string, MediaAsset[]>();
    async function loadMediaFor(ids: string[]) {
      if (!ids.length) return;
      let rows: MediaAsset[] = [];
      try { rows = await listMedia(ids); } catch (e) { oops(e); return; }
      for (const id of ids) {
        const list = rows.filter((r) => r.variant_id === id);
        mediaByVariant.set(id, list);
        const box = document.querySelector(`[data-media-for="${CSS.escape(id)}"]`);
        const cnt = document.querySelector(`[data-media-count="${CSS.escape(id)}"]`);
        if (cnt) cnt.textContent = list.length ? `(${list.length})` : '';
        if (!box) continue;
        box.innerHTML = list.length ? list.map((m, i) => `<li class="relative">
            <a href="${esc(m.url ?? '#')}" target="_blank" rel="noopener"><img src="${esc(m.url ?? '')}" alt="รูปที่ ${i + 1}" loading="lazy" class="aspect-[4/5] w-full rounded object-cover ${i === 0 ? 'ring-2 ring-[var(--color-brand-coral)]' : ''}" /></a>
            ${m.drive_file_id ? `<a href="https://drive.google.com/file/d/${esc(m.drive_file_id)}/view" target="_blank" rel="noopener" class="absolute right-0.5 top-0.5 rounded bg-base-100/90 px-1.5 py-0.5 text-[11px] font-semibold shadow" aria-label="เปิดต้นฉบับรูป ${i + 1} ใน Google Drive">Drive</a>` : ''}
            <span class="mt-0.5 flex justify-between">
              <button data-action="m-left" data-v="${esc(id)}" data-i="${i}" class="btn btn-ghost btn-xs px-1" aria-label="เลื่อนรูป ${i + 1} ไปก่อน" ${i === 0 ? 'disabled' : ''}>◀</button>
              <button data-action="m-del" data-v="${esc(id)}" data-i="${i}" class="btn btn-ghost btn-xs px-1" aria-label="เอารูป ${i + 1} ออก">✕</button>
              <button data-action="m-right" data-v="${esc(id)}" data-i="${i}" class="btn btn-ghost btn-xs px-1" aria-label="เลื่อนรูป ${i + 1} ไปหลัง" ${i === list.length - 1 ? 'disabled' : ''}>▶</button>
            </span></li>`).join('')
          : '<li class="col-span-4 text-xs opacity-50">ยังไม่มีรูป — อัปเอง หรือทำใน Note Studio</li>';
      }
    }
    async function moveMedia(id: string, i: number, d: number) {
      const list = [...(mediaByVariant.get(id) ?? [])];
      if (!list[i + d]) return;
      [list[i], list[i + d]] = [list[i + d], list[i]];
      await reorderMedia(list.map((m) => m.asset_id));
      await loadMediaFor([id]);
    }

    // ---------- แก้ชื่อไอเดียในที่ (2026-09-08 · ✏️ → input · Enter บันทึก · Esc ยกเลิก) ----------
    function titleEditorHtml(title: string) {
      return `<div id="wr-title-wrap" class="flex flex-col gap-2">
        <input id="wr-title-input" class="input input-bordered input-sm w-full font-display font-bold" value="${esc(title)}" maxlength="200" aria-label="ชื่อหัวข้อไอเดีย" />
        <div class="flex gap-1">
          <button data-action="save-title" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-coral);">บันทึก</button>
          <button data-action="cancel-title" class="btn btn-sm btn-ghost tap-44">ยกเลิก</button></div></div>`;
    }
    async function saveIdeaTitle() {
      const idea = ideas.find((i) => i.content_id === selectedId);
      const input = $('wr-title-input') as HTMLInputElement | null;
      if (!idea || !input) return;
      const title = input.value.trim();
      if (!title) return toast('หัวข้อว่างไม่ได้ครับ', 'error');
      if (title === idea.title) { renderDetail(); return; }
      input.disabled = true;
      try {
        await updateIdea(idea.content_id, { title });
        idea.title = title;                       // การ์ดบนบอร์ดโชว์ idea.title → อัปเดตทันทีไม่ต้องรอ refresh
        for (const v of variants) if (v.content_id === idea.content_id) v.working_title = title;
        renderBoard(); renderList(); renderDetail();
        toast('บันทึกหัวข้อแล้ว');
      } catch (err) { input.disabled = false; oops(err); }
    }

    // ---------- drawer open/close ----------
    function openDrawer(cid: string) {
      selectedId = cid;
      renderDetail();
      const d = $('wr-drawer'), scrim = $('wr-drawer-scrim'), panel = $('wr-drawer-panel');
      d.classList.remove('hidden');
      requestAnimationFrame(() => { scrim.classList.remove('opacity-0'); panel.classList.remove('translate-x-full'); });
    }
    function closeDrawer() {
      const d = $('wr-drawer'), scrim = $('wr-drawer-scrim'), panel = $('wr-drawer-panel');
      scrim.classList.add('opacity-0'); panel.classList.add('translate-x-full');
      window.setTimeout(() => d.classList.add('hidden'), 200);
    }

    // ---------- view toggle ----------
    function setView(v: 'board' | 'list' | 'queue' | 'campaign' | 'line') {
      view = v;
      $('wr-board-view').classList.toggle('hidden', v !== 'board');
      $('wr-list-view').classList.toggle('hidden', v !== 'list');
      $('wr-queue-view').classList.toggle('hidden', v !== 'queue');
      $('wr-campaign-view').classList.toggle('hidden', v !== 'campaign');
      $('wr-line-view').classList.toggle('hidden', v !== 'line');
      // แถบสถิติ/แบนเนอร์ค้างเป็นของมุมผลิต — ในหน้าแคมเปญ/LINE ซ่อนให้โล่ง
      $('wr-stats').parentElement!.classList.toggle('hidden', v === 'campaign' || v === 'line');
      if (v === 'campaign') void loadCampaigns().catch(oops);
      else if (location.hash.startsWith('#campaign')) history.replaceState(null, '', location.pathname);
      if (v === 'line') { if (!location.hash.startsWith('#line')) history.replaceState(null, '', '#line'); void loadLineRounds().catch(oops); }
      else if (location.hash.startsWith('#line')) history.replaceState(null, '', location.pathname);
      for (const [id, key] of [['wr-view-board', 'board'], ['wr-view-list', 'list'], ['wr-view-queue', 'queue'], ['wr-view-campaign', 'campaign'], ['wr-view-line', 'line']] as const) {
        const el = $(id), on = v === key;
        el.setAttribute('aria-selected', String(on));
        el.classList.toggle('btn-ghost', !on);
        el.classList.toggle('text-white', on);
        el.style.backgroundColor = on ? 'var(--color-brand-navy)' : '';
      }
      if (v === 'queue') void loadQueue().catch(oops);
      syncQueuePolling();
    }

    // ---------- คิวงาน AI (wr_jobs · 2026-09-08) ----------
    // คุณปันขอ: "อยากดูว่าการ์ดไหนกำลังให้ AI improve อยู่ / งานที่มาจากกดเกลาเป็น version ผมใน Warroom กำลังทำอยู่ ไม่มีปัญหาใช่ไหม"
    const JOB_TONE: Record<string, string> = { queued: 'badge-warning', running: 'badge-primary', done: 'badge-success', error: 'badge-error' };
    const JOB_LABEL: Record<string, string> = {
      ai_improve: '✨ เกลาบท (Script Studio)', rewrite_reel: '✍️ version ผม (Intel Warroom)',
      rewrite_copy: '✍️ เขียนข่าวใหม่ (News Desk)', render_text_card: '🖼 การ์ดตัวอักษร', render_card: '🎨 การ์ดซีน AI', publish: '🚀 โพสต์',
      growth_eval: '🧭 ประเมินข้อความ (Funnel Lab)', funnel_media_eval: '🎞 ประเมินรูป/คลิป (Funnel Lab)',
    };
    const STALL_MS = 20 * 60_000;
    const mmss = (ms: number) => `${Math.floor(ms / 60_000)}:${String(Math.floor((ms % 60_000) / 1000)).padStart(2, '0')}`;
    const fmtWhen = (iso: string) => new Date(iso).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' });
    const jobIsMine = (j: WrJob) => j.job_type === 'ai_improve' || j.job_type === 'rewrite_reel';

    async function loadQueue() {
      wrJobs = await listWrJobs(60);
      const pending = wrJobs.filter((j) => j.status === 'queued' || j.status === 'running');
      const b = $('wr-queue-badge');
      b.textContent = String(pending.length);
      b.classList.toggle('hidden', pending.length === 0);
      // ชื่อการ์ด Intel ของงาน rewrite_reel — ดึงเฉพาะที่ยังไม่รู้
      const need = wrJobs.map((j) => (j.payload as { item_id?: string })?.item_id).filter((id): id is string => !!id && !itemTitles.has(id));
      if (need.length) { try { for (const [id, v] of await listItemTitles(need)) itemTitles.set(id, v); } catch { /* ชื่อไม่มา ยังโชว์ id ได้ */ } }
      if (view === 'queue') renderQueue();
    }

    function jobSubject(j: WrJob): { text: string; sub: string; href: string | null; variantId: string | null } {
      const p = (j.payload ?? {}) as Record<string, unknown>;
      if (j.job_type === 'ai_improve') {
        const vid = String(p.variant_id ?? '');
        const v = variants.find((x) => x.variant_id === vid);
        const idea = ideas.find((i) => i.content_id === v?.content_id);
        return { text: idea?.title ?? v?.working_title ?? vid ?? '—', sub: vid, href: null, variantId: vid || null };
      }
      if (j.job_type === 'rewrite_reel') {
        const id = String(p.item_id ?? '');
        const it = itemTitles.get(id);
        return { text: String(p.theme ?? '—'), sub: it?.title ? `จากการ์ด: ${it.title}` : (id ? `การ์ด ${id.slice(0, 8)}…` : ''), href: id ? `/app/intel?item=${encodeURIComponent(id)}` : null, variantId: null };
      }
      if (j.job_type === 'growth_eval' || j.job_type === 'funnel_media_eval') {
        const c = (p.creative ?? {}) as { name?: string; channel?: string };
        const pk = (p.pack ?? {}) as { name?: string };
        return { text: String(c.name ?? 'Touchpoint'), sub: [pk.name, c.channel].filter(Boolean).join(' · '), href: '/app/funnel-lab', variantId: null };
      }
      const cid = String(p.candidate_id ?? '');
      return { text: cid ? `ข่าว ${cid.slice(0, 8)}…` : '—', sub: '', href: '/app/news-desk', variantId: null };
    }

    function renderQueue() {
      const now = Date.now();
      const rows = wrJobs.filter((j) => queueFilter === 'all' ? true : queueFilter === 'other' ? !jobIsMine(j) : j.job_type === queueFilter);
      const running = wrJobs.filter((j) => j.status === 'running');
      const queued = wrJobs.filter((j) => j.status === 'queued');
      const stalled = running.filter((j) => j.started_at && now - new Date(j.started_at).getTime() > STALL_MS);
      // worker ตาย = มีงานรอเกิน 1 นาทีแต่ไม่มีอะไร running (worker หยิบทุก 12 วิ)
      const oldestQueued = queued.length ? Math.min(...queued.map((j) => new Date(j.created_at).getTime())) : 0;
      const workerSilent = queued.length > 0 && running.length === 0 && now - oldestQueued > 60_000;
      const lastDone = wrJobs.filter((j) => j.status === 'done' && j.finished_at).sort((a, b) => String(b.finished_at).localeCompare(String(a.finished_at)))[0];
      const health = $('wr-queue-health');
      if (stalled.length || workerSilent) {
        health.className = 'rounded-2xl border border-error/50 bg-error/10 px-4 py-3 text-sm';
        health.innerHTML = stalled.length
          ? `⚠️ <b>งานวิ่งนานผิดปกติ ${stalled.length} งาน</b> (เกิน 20 นาที) — Codex/worker บนมินิอาจค้าง · ลองรอถึง 25 นาทีแล้วกด "ลองใหม่" หรือสั่ง kickstart worker${stalled.some((j) => j.job_type === 'funnel_media_eval') ? ' (งาน 🎞 Funnel Lab → <code>com.pun.funnel-media-worker</code>)' : ''}`
          : `⚠️ <b>มีงานรอคิว ${queued.length} งาน แต่ worker ยังไม่หยิบ</b> เกิน 1 นาที — worker บนมินิอาจไม่ทำงาน · พิมพ์ใน Telegram: <code>scout: status</code>`;
      } else {
        health.className = 'rounded-2xl border border-base-300 bg-base-200/60 px-4 py-3 text-sm';
        health.innerHTML = running.length
          ? `🟢 <b>กำลังทำ ${running.length} งาน</b>${queued.length ? ` · รอคิว ${queued.length}` : ''} — ${running.map((j) => `${JOB_LABEL[j.job_type] ?? j.job_type} ${j.started_at ? mmss(now - new Date(j.started_at).getTime()) : ''} นาที`).join(' · ')}`
          : queued.length ? `🟡 <b>รอคิว ${queued.length} งาน</b> — worker หยิบภายใน 12 วินาที`
          : `✅ <b>คิวว่าง</b> ไม่มีงานค้าง${lastDone?.finished_at ? ` · งานล่าสุดเสร็จ ${fmtWhen(lastDone.finished_at)}` : ''}`;
      }
      $('wr-queue').innerHTML = rows.length ? rows.map((j) => {
        const s = jobSubject(j);
        const started = j.started_at ? new Date(j.started_at).getTime() : 0;
        const stateNote = j.status === 'running' && started ? `<span class="ml-1 text-xs tabular-nums ${now - started > STALL_MS ? 'text-error font-semibold' : 'opacity-60'}">${mmss(now - started)} นาที${now - started > STALL_MS ? ' ⚠️' : ''}</span>`
          : j.status === 'queued' ? `<span class="ml-1 text-xs opacity-60">อันดับ ${queued.findIndex((q) => q.id === j.id) + 1}</span>`
          : j.status === 'done' && j.finished_at && started ? `<span class="ml-1 text-xs opacity-60">ใช้ ${mmss(new Date(j.finished_at).getTime() - started)} นาที</span>` : '';
        const open = j.status === 'done'
          ? (s.variantId ? `<button class="btn btn-outline btn-xs tap-44" data-open-variant="${esc(s.variantId)}">เปิด Studio</button>` : s.href ? `<a class="btn btn-outline btn-xs tap-44" href="${esc(s.href)}">เปิดการ์ด</a>` : '')
          : '';
        return `<tr class="align-top">
          <td class="whitespace-nowrap text-sm">${esc(JOB_LABEL[j.job_type] ?? j.job_type)}</td>
          <td><div class="max-w-72 truncate text-sm font-medium" title="${esc(s.text)}">${esc(s.text)}</div>${s.sub ? `<div class="max-w-72 truncate text-xs opacity-60">${esc(s.sub)}</div>` : ''}${j.error ? `<p class="mt-1 whitespace-pre-wrap text-xs text-error">${esc(j.error.slice(0, 240))}</p>` : ''}</td>
          <td class="whitespace-nowrap"><span class="badge badge-sm ${JOB_TONE[j.status] ?? 'badge-ghost'}">${esc({ queued: 'รอคิว', running: 'กำลังทำ', done: 'เสร็จ', error: 'พัง' }[j.status] ?? j.status)}</span>${stateNote}</td>
          <td class="whitespace-nowrap text-xs opacity-60">${esc(fmtWhen(j.created_at))}</td>
          <td class="whitespace-nowrap">${open}${j.status === 'error' ? `<button class="btn btn-outline btn-xs tap-44" data-retry="${esc(j.id)}">ลองใหม่</button>` : ''}<button class="btn btn-ghost btn-xs text-error tap-44" data-delete-job="${esc(j.id)}" aria-label="ลบงานนี้ออกจากคิว">ลบ</button></td></tr>`;
      }).join('') : '<tr><td colspan="5" class="py-6 text-center opacity-60">ไม่มีงานในหมวดนี้</td></tr>';
    }

    // badge นับทุก 30 วิเสมอ (เห็นจากบอร์ดว่ามีอะไรกำลังทำ) · เปิดมุมมองคิว = ถี่ขึ้นเป็น 10 วิ · หน้าจอไม่เห็น = หยุด
    function syncQueuePolling() {
      if (queueTimer) { window.clearInterval(queueTimer); queueTimer = 0; }
      if (document.visibilityState !== 'visible') return;
      queueTimer = window.setInterval(() => void loadQueue().catch(() => {}), view === 'queue' ? 10_000 : 30_000);
    }

    // ---------- Idea capture (shared by list + quick) ----------
    async function saveIdea(confirmed: boolean, source: 'list' | 'quick') {
      const titleEl = source === 'quick' ? $('wr-quick-idea') as HTMLInputElement : $('wr-idea-title') as HTMLTextAreaElement;
      const title = titleEl.value.trim();
      if (!title) { toast('พิมพ์ไอเดียก่อน', 'error'); return; }
      const angle = source === 'list' ? ($('wr-idea-angle') as HTMLInputElement).value.trim() : '';
      const simBox = source === 'quick' ? $('wr-quick-similar') : $('wr-similar');
      try {
        if (!confirmed) {
          const hits = (await findSimilar(`${title} ${angle}`)).filter((h) => h.sim >= 0.22);
          if (hits.length) {
            pendingIdea = { title, angle, source };
            simBox.classList.remove('hidden');
            simBox.innerHTML = `<p class="font-semibold" style="color:var(--color-brand-coral);">⚠️ คล้ายกับ idea เดิม:</p>
              ${hits.map((h) => `<p class="mt-1"><span class="font-mono text-xs opacity-60">${esc(h.content_id)}</span> ${esc(h.title)} <span class="opacity-50">(${Math.round(h.sim * 100)}%)</span></p>`).join('')}
              <div class="mt-2 flex gap-2">
                <button data-sim="force" class="btn btn-xs tap-44">บันทึกเป็น idea ใหม่</button>
                <button data-sim="cancel" class="btn btn-xs btn-ghost tap-44">ยกเลิก</button>
              </div>`;
            simBox.querySelector('[data-sim="force"]')!.addEventListener('click', () => void saveIdea(true, source));
            simBox.querySelector('[data-sim="cancel"]')!.addEventListener('click', () => { pendingIdea = null; simBox.classList.add('hidden'); });
            return;
          }
        }
        const idea = await createIdea({
          title,
          canonical_angle: angle || null,
          pillar_bucket: source === 'list' ? ((($('wr-idea-pillar') as HTMLSelectElement).value || null) as Idea['pillar_bucket']) : null,
          funnel_stage: source === 'list' ? ((($('wr-idea-funnel') as HTMLSelectElement).value || null) as Idea['funnel_stage']) : null,
        });
        pendingIdea = null;
        simBox.classList.add('hidden');
        titleEl.value = '';
        if (source === 'list') ($('wr-idea-angle') as HTMLInputElement).value = '';
        toast(`บันทึกแล้ว → ${idea.content_id}`);
        await refresh();
      } catch (e) { oops(e); }
    }

    // ---------- Script Studio ----------
    // โครงบทตาม reel-hook-formulas.md Part 13 (Clip Architecture · Setup + ↻Rehook · 2026-08-09)
