      sync(); area.addEventListener('input', sync);
      body.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      $('#chat-context-form').addEventListener('submit', async (event) => {
        event.preventDefault(); const save = $<HTMLButtonElement>('#chat-context-save'); save.disabled = true;
        try {
          await saveContext(row.id, { heading: $<HTMLInputElement>('#chat-context-heading').value.trim(), body: area.value, display_order: Number($<HTMLInputElement>('#chat-context-order').value) || row.display_order, enabled: $<HTMLInputElement>('#chat-context-enabled').checked, note: $<HTMLInputElement>('#chat-context-note').value.trim() || null });
          dialog.close(); toast('บันทึกแล้ว — กดส่งให้บอทใช้ที่แท็บ Publish'); await reload();
        } catch (error) { oops(error); } finally { save.disabled = false; }
      });
      dialog.showModal();
    }

