            <label class="text-xs">ลำดับ<input id="chat-offer-order" type="number" class="input input-sm input-bordered mt-1 w-full"></label>
          </div>
          <label class="flex items-center gap-2 text-xs"><input id="chat-offer-enabled" type="checkbox" class="checkbox checkbox-sm"> เปิดใช้ (ปิด = บอทไม่หยิบสคริปต์ชุดนี้)</label>
          <div id="chat-offer-errors" class="text-sm text-error" role="alert"></div>
          <div class="modal-action"><button type="button" class="btn btn-ghost btn-sm tap-44" data-close>ยกเลิก</button><button type="submit" id="chat-offer-save" class="btn btn-primary btn-sm tap-44">บันทึก</button></div>
        </form>`;
      if (row) {
        $<HTMLInputElement>('#chat-offer-code').value = row.code;
        $<HTMLSelectElement>('#chat-offer-key').value = row.pricing_key;
        $<HTMLInputElement>('#chat-offer-liner').value = row.one_liner || '';
