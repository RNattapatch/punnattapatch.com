        </form>`;
      $<HTMLInputElement>('#chat-context-heading').value = row.heading;
      const area = $<HTMLTextAreaElement>('#chat-context-body'); area.value = row.body;
      $<HTMLInputElement>('#chat-context-order').value = String(row.display_order);
      $<HTMLInputElement>('#chat-context-note').value = row.note || '';
