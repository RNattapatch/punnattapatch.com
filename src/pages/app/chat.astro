              <label class="text-xs">ตัวเลข ณ วันที่<input id="chat-asset-asof" type="date" class="input input-sm input-bordered mt-1 w-full"></label>
            </div>
          </fieldset>
          <label class="block text-xs">โน้ต<input id="chat-asset-note" class="input input-sm input-bordered mt-1 w-full"></label>
