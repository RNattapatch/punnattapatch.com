      body.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      $('#chat-offer-form').addEventListener('submit', async (event) => {
        event.preventDefault(); const save = $<HTMLButtonElement>('#chat-offer-save'); save.disabled = true;
        const patch = {
          pricing_key: $<HTMLSelectElement>('#chat-offer-key').value,
          one_liner: $<HTMLInputElement>('#chat-offer-liner').value.trim(),
          fit: $<HTMLTextAreaElement>('#chat-offer-fit').value.trim() || null,
