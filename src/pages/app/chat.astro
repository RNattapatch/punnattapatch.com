      $('#chat-view-context').innerHTML = `
        <div class="alert border border-base-300 bg-base-200 text-sm"><span>นี่คือของที่บอทถืออยู่ตอนคุยกับลูกค้า · ปิดหัวข้อไหนบอทจะไม่เห็นหัวข้อนั้นเลย · กติกาบุคลิกบอทกับตัวอย่างโทนอยู่ในโค้ด ไม่ได้แก้จากหน้านี้</span></div>
        ${files.map((file) => {
          const rows = (state.context || []).filter((row: ContextRow) => row.file === file).sort((a: ContextRow, b: ContextRow) => a.display_order - b.display_order);
          const chars = rows.filter((row: ContextRow) => row.enabled).reduce((sum: number, row: ContextRow) => sum + row.body.length, 0);
          return `<section class="rounded-2xl border border-base-300 bg-base-200 p-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div><h2 class="font-display font-bold">${esc(file)}</h2><p class="text-xs opacity-70">${rows.length} หัวข้อ · ที่เปิดอยู่รวม ${chars.toLocaleString('en-US')} ตัวอักษร</p></div>
              <button class="btn btn-sm tap-44" data-add-context="${esc(file)}">+ เพิ่มหัวข้อ</button>
            </div>
            <div class="mt-3 space-y-2">${rows.map((row: ContextRow) => `
              <article class="rounded-xl border border-base-300 bg-base-100 p-3 ${row.enabled ? '' : 'opacity-60'}">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-bold">${esc(row.heading.replace(/^#+\s*/, ''))} ${row.enabled ? '' : '<span class="badge badge-ghost">ปิดอยู่</span>'}</h3>
                  <span class="flex shrink-0 gap-1"><button class="btn btn-xs tap-44" data-edit-context="${esc(row.id)}">แก้</button><button class="btn btn-xs btn-ghost tap-44" data-del-context="${esc(row.id)}" aria-label="ลบหัวข้อ ${esc(row.heading)}">ลบ</button></span>
                </div>
                <p class="mt-1 text-xs opacity-60">${row.body.length.toLocaleString('en-US')} ตัวอักษร${row.note ? ` · ${esc(row.note)}` : ''}</p>
              </article>`).join('')}</div>
          </section>`;
        }).join('')}`;
    }

    function renderAll() { renderSummary(); renderOffers(); syncFilters(); renderSnippets(); void renderAssets(); renderFaq(); renderKeywords(); renderContext(); renderPublish(); bindPublishActions(); bindCrudActions(); bindAssetActions(); }
    function setView(view: View, focus = false) {
      state.view = view;
      document.querySelectorAll<HTMLButtonElement>('.chat-tab').forEach((button) => { const active = button.dataset.view === view; button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1; if (active && focus) button.focus(); });
      (['offers','snippets','assets','faq','keywords','context','publish'] as View[]).forEach((name) => $(`#chat-view-${name}`).classList.toggle('hidden', name !== view));
      history.replaceState(null, '', view === 'offers' ? location.pathname + location.search : `#${view}`);
    }
    async function reload() {
      const [data, catalogResponse] = await Promise.all([loadAll(), fetch('/catalog.json', { cache: 'no-store' })]);
      if (!catalogResponse.ok) throw new Error(`โหลดราคาสดไม่ได้ (${catalogResponse.status}) — รีเฟรชแล้วลองใหม่`);
      Object.assign(state, data); state.catalog = await catalogResponse.json() as CatalogLike; renderAll();
    }
    function bind() {
      $('#chat-refresh').addEventListener('click', async (event) => { const button = event.currentTarget as HTMLButtonElement; button.disabled = true; try { await reload(); toast('รีเฟรชแล้ว'); } catch (error) { oops(error); } finally { button.disabled = false; } });
      ['#chat-filter-offer','#chat-filter-slot','#chat-filter-channel'].forEach((selector) => $(selector).addEventListener('change', () => { state.offerFilter = $<HTMLSelectElement>('#chat-filter-offer').value; state.slotFilter = $<HTMLSelectElement>('#chat-filter-slot').value; state.channelFilter = $<HTMLSelectElement>('#chat-filter-channel').value; renderSnippets(); }));
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('.chat-tab')];
      tabs.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view as View)));
      $('#chat-tabs').addEventListener('keydown', (event) => { if (!['ArrowLeft','ArrowRight'].includes(event.key)) return; event.preventDefault(); const index = tabs.findIndex((item) => item.dataset.view === state.view); const offset = event.key === 'ArrowRight' ? 1 : -1; const next = tabs[(index + offset + tabs.length) % tabs.length]; setView(next.dataset.view as View, true); });
    }
    let booted = false;
    async function boot() {
      if (booted) return; booted = true; bind();
      try { await reload(); const hash = location.hash.slice(1) as View; if (['snippets','keywords','publish'].includes(hash)) setView(hash); } catch (error) { oops(error); }
    }
    document.addEventListener('chat:authed', () => void boot());
    void (async () => { if (await getSupabaseSession()) void boot(); })();
  </script>
</DashboardLayout>
