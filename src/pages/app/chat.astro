    function bindAssetActions() {
      $('#chat-asset-filter-offer')?.addEventListener('change', (event) => { state.assetOffer = (event.target as HTMLSelectElement).value; void renderAssets(); });
      $('#chat-asset-filter-kind')?.addEventListener('change', (event) => { state.assetKind = (event.target as HTMLSelectElement).value; void renderAssets(); });
      document.querySelectorAll<HTMLButtonElement>('[data-add-asset]').forEach((b) => b.addEventListener('click', () => openAsset(null)));
      document.querySelectorAll<HTMLButtonElement>('[data-edit-asset]').forEach((b) => b.addEventListener('click', () => openAsset(b.dataset.editAsset!)));
      document.querySelectorAll<HTMLButtonElement>('[data-del-asset]').forEach((b) => b.addEventListener('click', async () => {
        const row = (state.assets || []).find((item: AssetRow) => item.id === b.dataset.delAsset);
        if (!row || !confirm(`ลบ "${row.title}" ออกจากทะเบียน?\n\nภาพตัวอย่างถูกลบด้วย แต่ไฟล์ต้นฉบับที่อื่นไม่ถูกแตะ`)) return;
        b.disabled = true;
        try { await deleteAsset(row.id, row.thumb_path); toast('ลบแล้ว'); await reload(); } catch (error) { oops(error); b.disabled = false; }
      }));
      document.querySelectorAll<HTMLButtonElement>('[data-goto-assets]').forEach((b) => b.addEventListener('click', () => { state.assetOffer = b.dataset.gotoAssets!; state.assetKind = 'all'; setView('assets'); void renderAssets(); bindAssetActions(); }));
    }

    function bindCrudActions() {
      document.querySelectorAll<HTMLButtonElement>('[data-edit-context]').forEach((b) => b.addEventListener('click', () => openContext(b.dataset.editContext!)));
      document.querySelectorAll<HTMLButtonElement>('[data-edit-offer]').forEach((b) => b.addEventListener('click', () => openOffer(b.dataset.editOffer!)));
      document.querySelectorAll<HTMLButtonElement>('[data-add-offer]').forEach((b) => b.addEventListener('click', () => openOffer(null)));

      document.querySelectorAll<HTMLButtonElement>('[data-add-context]').forEach((b) => b.addEventListener('click', async () => {
        const file = b.dataset.addContext!;
        const heading = prompt(`หัวข้อใหม่ใน ${file} (ขึ้นต้นด้วย ##)`, '## ');
        if (!heading?.trim()) return;
        b.disabled = true;
        const last = (state.context || []).filter((row: ContextRow) => row.file === file).reduce((max: number, row: ContextRow) => Math.max(max, row.display_order), 0);
        try { await createContext({ file, heading: heading.trim(), body: '', display_order: last + 10 }); toast('เพิ่มหัวข้อแล้ว'); await reload(); }
        catch (error) { oops(error); b.disabled = false; }
      }));

      document.querySelectorAll<HTMLButtonElement>('[data-del-context]').forEach((b) => b.addEventListener('click', async () => {
        const row = (state.context || []).find((item: ContextRow) => item.id === b.dataset.delContext);
        if (!row || !confirm(`ลบหัวข้อ "${row.heading.replace(/^#+\s*/, '')}" ออกจาก ${row.file}?\n\nบอทจะไม่เห็นข้อมูลส่วนนี้อีก`)) return;
        b.disabled = true;
        try { await deleteContext(row.id); toast('ลบแล้ว'); await reload(); } catch (error) { oops(error); b.disabled = false; }
      }));

      document.querySelectorAll<HTMLButtonElement>('[data-del-snippet]').forEach((b) => b.addEventListener('click', async () => {
        const row = state.snippets.find((item: SnippetRow) => item.id === b.dataset.delSnippet);
        if (!row || !confirm(`ลบข้อความ ${row.offer_code} · ${row.slot}${row.faq_q ? ` (${row.faq_q})` : ''}?`)) return;
        b.disabled = true;
        try { await deleteSnippet(row.id); toast('ลบแล้ว'); await reload(); } catch (error) { oops(error); b.disabled = false; }
      }));

      document.querySelectorAll<HTMLButtonElement>('[data-add-faq]').forEach((b) => b.addEventListener('click', async () => {
        const offer = b.dataset.addFaq!;
        const question = prompt(`คำถามใหม่ของ ${offer}`);
        if (!question?.trim()) return;
        b.disabled = true;
        const last = state.snippets.filter((row: SnippetRow) => row.offer_code === offer && row.slot === 'faq').reduce((max: number, row: SnippetRow) => Math.max(max, row.display_order ?? 0), 0);
        try { await createSnippet({ offer_code: offer, slot: 'faq', channel: 'any', body: 'ค่ะ', faq_q: question.trim(), display_order: last + 10 }); toast('เพิ่มคำถามแล้ว — กดแก้เพื่อใส่คำตอบ'); await reload(); }
        catch (error) { oops(error); b.disabled = false; }
      }));

      document.querySelectorAll<HTMLButtonElement>('[data-add-snippet]').forEach((b) => b.addEventListener('click', async () => {
        const offer = b.dataset.addSnippet!;
        const slot = prompt(`ช่วงข้อความใหม่ของ ${offer} (b1–b6 หรือ payment)`, 'b3');
        if (!slot?.trim()) return;
        b.disabled = true;
        try { await createSnippet({ offer_code: offer, slot: slot.trim(), channel: 'any', body: 'ค่ะ' }); toast('เพิ่มข้อความแล้ว — กดแก้เพื่อใส่เนื้อหา'); await reload(); }
        catch (error) { oops(error); b.disabled = false; }
      }));

      document.querySelectorAll<HTMLButtonElement>('[data-del-offer]').forEach((b) => b.addEventListener('click', async () => {
        const code = b.dataset.delOffer!;
        const count = state.snippets.filter((row: SnippetRow) => row.offer_code === code).length;
        if (!confirm(`ลบ ${code} ออกจาก Chat Center?\n\nข้อความ ${count} ก้อนของสินค้านี้จะถูกลบตามไปด้วย\nราคาใน catalog ไม่ถูกแตะ`)) return;
        b.disabled = true;
        try { await deleteOffer(code); toast('ลบแล้ว'); await reload(); } catch (error) { oops(error); b.disabled = false; }
      }));
    }

