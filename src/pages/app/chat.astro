            <label class="text-xs">ผูกกับราคาใน catalog<select id="chat-offer-key" class="select select-sm select-bordered mt-1 w-full">${keys.map((key: string) => `<option>${esc(key)}</option>`).join('')}</select></label>
          </div>
          <label class="block text-xs">ประโยคเดียวว่าคืออะไร<input id="chat-offer-liner" class="input input-sm input-bordered mt-1 w-full" required></label>
