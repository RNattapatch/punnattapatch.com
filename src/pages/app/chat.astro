        </form>`;
      if (row) {
        $<HTMLInputElement>('#chat-asset-title').value = row.title;
        $<HTMLSelectElement>('#chat-asset-kind').value = row.kind;
        $<HTMLSelectElement>('#chat-asset-offer').value = row.offer_code || '';
        $<HTMLInputElement>('#chat-asset-platform').value = row.platform || '';
        $<HTMLSelectElement>('#chat-asset-status').value = row.status;
        $<HTMLInputElement>('#chat-asset-url').value = row.url || '';
        $<HTMLInputElement>('#chat-asset-source').value = row.source_path || '';
        $<HTMLInputElement>('#chat-asset-note').value = row.note || '';
        if (m.views != null) $<HTMLInputElement>('#chat-asset-views').value = String(m.views);
        if (m.ctr != null) $<HTMLInputElement>('#chat-asset-ctr').value = String(m.ctr);
        if (m.leads != null) $<HTMLInputElement>('#chat-asset-leads').value = String(m.leads);
        if (m.as_of) $<HTMLInputElement>('#chat-asset-asof').value = m.as_of;
      }
      body.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      $('#chat-asset-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const save = $<HTMLButtonElement>('#chat-asset-save'); save.disabled = true;
        const errors = $('#chat-asset-errors'); errors.textContent = '';
        try {
          const file = $<HTMLInputElement>('#chat-asset-file').files?.[0];
          let thumb = row?.thumb_path ?? null; let width = row?.width ?? null; let height = row?.height ?? null; let ratio = row?.ratio ?? null;
          if (file) {
            $('#chat-asset-filenote').textContent = 'กำลังย่อและอัปภาพ…';
            const shrunk = await shrink(file);
            thumb = await uploadThumb(shrunk.blob, file.name.replace(/\.[^.]+$/, '.webp'));
            width = shrunk.width; height = shrunk.height; ratio = ratioOf(shrunk.width, shrunk.height);
          }
          const views = $<HTMLInputElement>('#chat-asset-views').value;
          const ctr = $<HTMLInputElement>('#chat-asset-ctr').value;
          const leads = $<HTMLInputElement>('#chat-asset-leads').value;
          const asOf = $<HTMLInputElement>('#chat-asset-asof').value;
          const metrics: Record<string, unknown> = {};
          if (views) metrics.views = Number(views);
          if (ctr) metrics.ctr = Number(ctr);
          if (leads) metrics.leads = Number(leads);
          if (asOf) metrics.as_of = asOf;
          if (Object.keys(metrics).length && !asOf) { errors.textContent = 'กรอกตัวเลขผลงานแล้วต้องระบุวันที่ด้วย — ตัวเลขที่ไม่รู้ว่าของวันไหนใช้ตัดสินใจไม่ได้'; save.disabled = false; return; }
          const patch = {
            title: $<HTMLInputElement>('#chat-asset-title').value.trim(),
            kind: $<HTMLSelectElement>('#chat-asset-kind').value,
            offer_code: $<HTMLSelectElement>('#chat-asset-offer').value || null,
            platform: $<HTMLInputElement>('#chat-asset-platform').value.trim() || null,
            status: $<HTMLSelectElement>('#chat-asset-status').value,
            url: $<HTMLInputElement>('#chat-asset-url').value.trim() || null,
            source_path: $<HTMLInputElement>('#chat-asset-source').value.trim() || null,
            note: $<HTMLInputElement>('#chat-asset-note').value.trim() || null,
            thumb_path: thumb, width, height, ratio, metrics,
          };
          if (row) await saveAsset(row.id, patch); else await createAsset(patch as never);
          dialog.close(); toast(row ? 'บันทึกแล้ว' : 'เพิ่มชิ้นงานแล้ว'); await reload();
        } catch (error) { oops(error); errors.textContent = (error as Error).message; } finally { save.disabled = false; }
      });
      dialog.showModal();
    }

