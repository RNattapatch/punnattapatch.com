---
// Chat Center — SSOT for bot reply copy and CTA keywords.
// Structure intentionally mirrors docs.astro: shared layout, gate, nav, runtime-rendered views, and full reload after writes.
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WarRoomGate from '../../components/war-room/WarRoomGate.astro';
import AppNav from '../../components/app/AppNav.astro';
---
<DashboardLayout title="Chat Center — Pun">
  <script is:inline async src="https://accounts.google.com/gsi/client"></script>
  <WarRoomGate appId="chat-app" title="Chat Center" icon="💬" event="chat:authed" />

  <style is:global>
    /* Runtime cards and rows are rendered through innerHTML, so these selectors must remain global. */
    #chat-app {
      --chat-ink: var(--color-brand-navy);
      --chat-alert: var(--color-brand-coral);
      --chat-line: color-mix(in srgb, var(--color-brand-navy) 14%, transparent);
      --chat-wash: color-mix(in srgb, var(--color-brand-navy) 5%, transparent);
    }
    .chat-tab[aria-selected="true"] { background: var(--chat-ink); color: var(--color-base-100); }
    .chat-panel-grid { display: grid; gap: .75rem; }
    .chat-offer { border-left: 4px solid var(--chat-ink); }
    .chat-offer[open] { background: var(--chat-wash); }
    .chat-offer summary { cursor: pointer; list-style: none; }
    .chat-offer summary::-webkit-details-marker { display: none; }
    .chat-source { border: 1px dashed var(--chat-line); background: var(--color-base-100); }
    .chat-preview { border: 1px solid var(--chat-line); background: var(--chat-wash); }
    .chat-copy { white-space: pre-wrap; overflow-wrap: anywhere; }
    .chat-warning { border-left: 4px solid var(--chat-alert); }
    .chat-hash { overflow-wrap: anywhere; font-size: .75rem; font-variant-numeric: tabular-nums; }
    .chat-drift { color: var(--chat-alert); }
    .chat-ok { color: var(--chat-ink); }
    @media (min-width: 768px) { .chat-compare { grid-template-columns: 1fr 1fr; } }
  </style>

  <div id="chat-app" class="hidden min-h-dvh bg-base-100">
    <AppNav app="chat">
      <button id="chat-refresh" class="btn btn-ghost btn-sm tap-44" aria-label="รีเฟรช Chat Center" title="รีเฟรช">⟳</button>
    </AppNav>

    <main class="mx-auto max-w-7xl space-y-4 px-4 py-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="font-display text-xl font-bold">💬 Chat Center</h1>
          <p class="text-xs opacity-60">ข้อความตอบลูกค้า · CTA keyword · สถานะของที่บอทใช้อยู่</p>
        </div>
        <div id="chat-tabs" class="flex max-w-full gap-1 overflow-x-auto" role="tablist" aria-label="ส่วนของ Chat Center">
          <button id="chat-tab-offers" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="true" aria-controls="chat-view-offers" data-view="offers">Offers</button>
          <button id="chat-tab-snippets" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-snippets" data-view="snippets">Snippets</button>
          <button id="chat-tab-assets" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-assets" data-view="assets">Assets</button>
          <button id="chat-tab-faq" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-faq" data-view="faq">FAQ</button>
          <button id="chat-tab-keywords" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-keywords" data-view="keywords">Keywords</button>
          <button id="chat-tab-context" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-context" data-view="context">Context บอท</button>
          <button id="chat-tab-publish" class="chat-tab btn btn-sm tap-44" role="tab" aria-selected="false" aria-controls="chat-view-publish" data-view="publish">Publish</button>
        </div>
      </div>

      <section id="chat-summary" class="rounded-2xl border border-base-300 bg-base-200 px-4 py-3 text-sm" aria-label="สรุป Chat Center" aria-live="polite"></section>
      <section id="chat-view-offers" role="tabpanel" aria-labelledby="chat-tab-offers"></section>
      <section id="chat-view-snippets" class="hidden space-y-3" role="tabpanel" aria-labelledby="chat-tab-snippets">
        <div class="grid gap-2 rounded-2xl border border-base-300 bg-base-200 p-3 sm:grid-cols-3">
          <label class="text-xs">สินค้า<select id="chat-filter-offer" class="select select-sm select-bordered mt-1 w-full" aria-label="กรองข้อความตามสินค้า"></select></label>
          <label class="text-xs">ช่วงข้อความ<select id="chat-filter-slot" class="select select-sm select-bordered mt-1 w-full" aria-label="กรองข้อความตามช่วง"></select></label>
          <label class="text-xs">ช่องทาง<select id="chat-filter-channel" class="select select-sm select-bordered mt-1 w-full" aria-label="กรองข้อความตามช่องทาง"></select></label>
        </div>
        <div id="chat-snippets"></div>
      </section>
      <section id="chat-view-assets" class="hidden space-y-3" role="tabpanel" aria-labelledby="chat-tab-assets"></section>
      <section id="chat-view-faq" class="hidden space-y-3" role="tabpanel" aria-labelledby="chat-tab-faq"></section>
      <section id="chat-view-keywords" class="hidden" role="tabpanel" aria-labelledby="chat-tab-keywords"></section>
      <section id="chat-view-context" class="hidden space-y-3" role="tabpanel" aria-labelledby="chat-tab-context"></section>
      <section id="chat-view-publish" class="hidden space-y-3" role="tabpanel" aria-labelledby="chat-tab-publish"></section>
    </main>

    <dialog id="chat-snippet-dialog" class="modal">
      <div id="chat-snippet-dialog-body" class="modal-box max-w-4xl"></div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิดหน้าต่างแก้ข้อความ">ปิด</button></form>
    </dialog>
    <dialog id="chat-keyword-dialog" class="modal">
      <div id="chat-keyword-dialog-body" class="modal-box max-w-3xl"></div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิดหน้าต่างแก้ keyword">ปิด</button></form>
    </dialog>
    <dialog id="chat-asset-dialog" class="modal">
      <div id="chat-asset-dialog-body" class="modal-box max-w-3xl"></div>
      <form method="dialog" class="modal-backdrop"><button class="tap-44" aria-label="ปิดหน้าต่างชิ้นงาน">ปิด</button></form>
    </dialog>
    <dialog id="chat-offer-dialog" class="modal">
      <div id="chat-offer-dialog-body" class="modal-box max-w-3xl"></div>
      <form method="dialog" class="modal-backdrop"><button class="tap-44" aria-label="ปิดหน้าต่างแก้สินค้า">ปิด</button></form>
    </dialog>
    <dialog id="chat-context-dialog" class="modal">
      <div id="chat-context-dialog-body" class="modal-box max-w-4xl"></div>
      <form method="dialog" class="modal-backdrop"><button class="tap-44" aria-label="ปิดหน้าต่างแก้ context">ปิด</button></form>
    </dialog>
    <div class="toast toast-end z-50"><div id="chat-toast" class="alert hidden text-sm shadow-lg" role="status" aria-live="polite"></div></div>
  </div>

  <script>
    import { loadAll, saveSnippet, saveKeyword, type OfferRow, type SnippetRow, type KeywordRow, type PublishRow, type PublishVersionRow, type DeclaredRef , requestPublish, rollbackTo, type KeywordStatRow, type ContextRow, saveContext, createContext, deleteContext, createOffer, saveOffer, deleteOffer, createSnippet, deleteSnippet, type AssetRow, loadAssets, createAsset, saveAsset, deleteAsset, uploadThumb, signThumb } from '../../scripts/chat/data';
    import { renderTokens, validateSnippet, keywordConflicts, type CatalogLike } from '../../scripts/chat/logic';
    import { getSupabaseSession } from '../../scripts/dashboard/supabase';

    const $ = <T extends HTMLElement = HTMLElement>(selector: string) => document.querySelector(selector) as T;
    const esc = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string);
    const fmtDate = (value?: string | null) => value ? new Intl.DateTimeFormat('th-TH', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : 'ยังไม่เคยส่ง';
    const shortHash = (value?: string | null) => value ? value.slice(0, 12) : '—';
    const safeHref = (value?: string | null) => value && (/^https?:\/\//i.test(value) || value.startsWith('/')) ? value : null;
    let toastTimer: number | undefined;
    function toast(message: string, kind: 'success' | 'error' = 'success') {
      const element = $('#chat-toast');
      element.className = `alert text-sm shadow-lg ${kind === 'error' ? 'alert-error' : 'alert-success'}`;
      element.textContent = message; element.classList.remove('hidden');
      window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => element.classList.add('hidden'), 3200);
    }
    const oops = (error: unknown) => toast((error as Error)?.message || 'ทำรายการไม่สำเร็จ — ลองใหม่อีกครั้ง', 'error');

    type View = 'offers' | 'snippets' | 'assets' | 'faq' | 'keywords' | 'context' | 'publish';
    const state: any = {
      assetOffer: 'all', assetKind: 'all',
      offers: [] as OfferRow[], snippets: [] as SnippetRow[], keywords: [] as KeywordRow[],
      publish: [] as PublishRow[], versions: [] as PublishVersionRow[], catalog: { packages: [] } as CatalogLike,
      view: 'offers' as View, offerFilter: 'all', slotFilter: 'all', channelFilter: 'all',
    };
    const offerByCode = () => new Map(state.offers.map((offer) => [offer.code, offer]));
    const catalogByKey = () => new Map(state.catalog.packages.map((item) => [item.key, item]));
    const declared = (keyword: KeywordRow) => Array.isArray(keyword.declared_in) ? keyword.declared_in : [];
    const preview = (body: string) => { try { return renderTokens(body, state.catalog); } catch (error) { return `⚠️ ${(error as Error).message}`; } };
    const botWrittenAt = () => state.publish.find((row) => row.file === 'oa-service-scripts.json')?.bot_written_at;
    const copyIsDirty = (updatedAt: string) => !botWrittenAt() || new Date(updatedAt) > new Date(botWrittenAt()!);

    function renderSummary() {
      const dirty = state.offers.filter((offer) => copyIsDirty(offer.updated_at)).length;
      $('#chat-summary').innerHTML = `<b>${state.offers.length}</b> สินค้า · <b>${state.snippets.length}</b> ข้อความ · <b>${state.keywords.length}</b> keyword · <span class="${dirty ? 'chat-drift' : ''}"><b>${dirty}</b> สินค้ามีการแก้หลังส่งถึงบอทครั้งล่าสุด</span>`;
    }

    function renderOffers() {
      const prices = catalogByKey();
      $('#chat-view-offers').innerHTML = `<div class="mb-3 flex justify-end"><button class="btn btn-primary btn-sm tap-44" data-add-offer>+ เพิ่มสินค้า/บริการ</button></div><div class="chat-panel-grid">${state.offers.map((offer) => {
        const item = prices.get(offer.pricing_key); const snippets = state.snippets.filter((row) => row.offer_code === offer.code);
        const keywords = state.keywords.filter((row) => row.offer_code === offer.code);
        const declaredCount = keywords.reduce((sum, row) => sum + declared(row).length, 0);
        return `<details class="chat-offer rounded-2xl border border-base-300 bg-base-200 p-4">
          <summary class="flex flex-wrap items-start justify-between gap-3" aria-label="เปิดรายละเอียด ${esc(offer.code)}">
            <span><span class="font-display text-lg font-bold">${esc(offer.code)} · ${esc(item?.name || offer.pricing_key)}</span>${offer.enabled ? '' : ' <span class="badge badge-ghost">ปิดอยู่</span>'}<br><span class="text-sm opacity-70">${esc(offer.one_liner)}</span></span>
            <span class="text-right"><span class="font-display text-lg font-bold">${item ? Number(item.amount_thb).toLocaleString('th-TH') : 'ไม่พบราคา'}</span><br><span class="badge ${item?.bot_may_quote ? 'badge-success' : 'badge-warning'}">${item?.bot_may_quote ? 'บอทบอกราคาได้' : 'บอทห้ามบอกราคา'}</span>${copyIsDirty(offer.updated_at) ? '<br><span class="badge badge-warning mt-1">ยังไม่ได้ส่งให้บอท</span>' : ''}</span>
          </summary>
          <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_2fr]">
            <div class="space-y-2 text-sm"><p><b>เหมาะกับ:</b> ${esc(offer.fit || 'ยังไม่ได้ระบุ')}</p><p><b>ยังไม่เหมาะ:</b> ${esc(offer.not_fit || 'ยังไม่ได้ระบุ')}</p><p><b>ขั้นถัดไป:</b> ${esc(offer.next_step || 'ยังไม่ได้ระบุ')}</p><p><b>Keyword:</b> ${keywords.length ? keywords.map((row) => `<span class="badge badge-outline mr-1">${esc(row.keyword)}</span>`).join('') : 'ยังไม่มี'}</p><p><b>รายการประกาศที่ผูกอยู่:</b> ${declaredCount}</p><div class="flex flex-wrap gap-2">${safeHref(offer.lp_url) ? `<a class="btn btn-sm tap-44" href="${esc(safeHref(offer.lp_url))}" target="_blank" rel="noreferrer">เปิด LP</a>` : ''}${safeHref(offer.outline_url) ? `<a class="btn btn-sm tap-44" href="${esc(safeHref(offer.outline_url))}" target="_blank" rel="noreferrer">เปิด Outline</a>` : ''}</div></div>
            <div class="space-y-2">${snippets.map((row) => `<div class="rounded-xl border border-base-300 bg-base-100 p-3"><div class="mb-1 flex justify-between gap-2 text-xs"><b>${esc(row.slot)} · ${esc(row.channel)}</b><span>${row.char_count} ตัวอักษร</span></div><p class="chat-copy text-sm">${esc(preview(row.body))}</p></div>`).join('')}</div>
          </div>
          ${(() => {
            const mine = (state.assets || []).filter((row: AssetRow) => row.offer_code === offer.code);
            if (!mine.length) return '<p class="mt-3 border-t border-base-300 pt-3 text-xs opacity-60">ยังไม่มีชิ้นงาน (รูปแอด · reel · LP) ผูกกับสินค้านี้</p>';
            return `<div class="mt-3 border-t border-base-300 pt-3">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs opacity-70">ชิ้นงาน ${mine.length} ชิ้น</span>
                <button class="btn btn-xs tap-44" data-goto-assets="${esc(offer.code)}">ดูทั้งหมด</button>
              </div>
              <div class="mt-2 flex gap-2">${mine.slice(0, 3).map((row: AssetRow) => row.thumb_path
                ? `<img data-thumb="${esc(row.thumb_path)}" alt="${esc(row.title)}" class="h-14 w-24 rounded-lg border border-base-300 object-cover" loading="lazy">`
                : `<span class="flex h-14 w-24 items-center justify-center rounded-lg border border-base-300 text-[10px] opacity-50">${esc(row.kind)}</span>`).join('')}</div>
            </div>`;
          })()}
          <div class="mt-3 flex flex-wrap gap-2 border-t border-base-300 pt-3">
            <button class="btn btn-sm tap-44" data-edit-offer="${esc(offer.code)}">แก้รายละเอียด</button>
            <button class="btn btn-sm tap-44" data-add-snippet="${esc(offer.code)}">+ เพิ่มข้อความ</button>
            <button class="btn btn-ghost btn-sm tap-44" data-del-offer="${esc(offer.code)}" aria-label="ลบสินค้า ${esc(offer.code)}">ลบสินค้านี้</button>
          </div></details>`;
      }).join('')}</div>`;
    }

    function syncFilters() {
      const options = (values: string[]) => `<option value="all">ทั้งหมด</option>${[...new Set(values)].sort().map((value) => `<option value="${esc(value)}">${esc(value)}</option>`).join('')}`;
      const offer = $<HTMLSelectElement>('#chat-filter-offer'), slot = $<HTMLSelectElement>('#chat-filter-slot'), channel = $<HTMLSelectElement>('#chat-filter-channel');
      offer.innerHTML = options(state.offers.map((row) => row.code)); slot.innerHTML = options(state.snippets.map((row) => row.slot)); channel.innerHTML = options(state.snippets.map((row) => row.channel));
      offer.value = state.offerFilter; slot.value = state.slotFilter; channel.value = state.channelFilter;
    }

    function renderSnippets() {
      const rows = state.snippets.filter((row) => (state.offerFilter === 'all' || row.offer_code === state.offerFilter) && (state.slotFilter === 'all' || row.slot === state.slotFilter) && (state.channelFilter === 'all' || row.channel === state.channelFilter));
      $('#chat-snippets').innerHTML = `<div class="overflow-x-auto rounded-2xl border border-base-300 bg-base-200"><table class="table table-sm min-w-[720px]"><thead><tr><th>สินค้า / ช่วง</th><th>ช่องทาง</th><th>Preview ที่ใช้คัดลอก</th><th>ความยาว</th><th></th></tr></thead><tbody>${rows.map((row) => `<tr><td><b>${esc(row.offer_code)}</b><br><span class="text-xs opacity-60">${esc(row.slot)}${row.faq_q ? ` · ${esc(row.faq_q)}` : ''}</span>${copyIsDirty(row.updated_at) ? '<br><span class="badge badge-warning mt-1">ยังไม่ได้ส่งให้บอท</span>' : ''}</td><td>${esc(row.channel)}</td><td class="max-w-xl"><p class="chat-copy line-clamp-3 text-sm">${esc(preview(row.body))}</p></td><td>${row.char_count}/1,900</td><td><div class="flex gap-1"><button class="btn btn-sm tap-44" data-copy="${esc(row.id)}" aria-label="คัดลอกข้อความ ${esc(row.offer_code)} ${esc(row.slot)}">คัดลอก</button><button class="btn btn-sm tap-44" data-edit-snippet="${esc(row.id)}" aria-label="แก้ข้อความ ${esc(row.offer_code)} ${esc(row.slot)}">แก้</button><button class="btn btn-ghost btn-sm tap-44" data-del-snippet="${esc(row.id)}" aria-label="ลบข้อความ ${esc(row.offer_code)} ${esc(row.slot)}">ลบ</button></div></td></tr>`).join('')}</tbody></table></div>`;
      bindSnippetActions();
    }

    function bindSnippetActions() {
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
        const row = state.snippets.find((item) => item.id === button.dataset.copy); if (!row) return;
        try { await navigator.clipboard.writeText(renderTokens(row.body, state.catalog)); toast('คัดลอกข้อความที่ใส่ราคาจริงแล้ว'); } catch (error) { oops(error); }
      }));
      document.querySelectorAll<HTMLButtonElement>('[data-edit-snippet]').forEach((button) => button.addEventListener('click', () => openSnippet(button.dataset.editSnippet!)));
    }

    function openSnippet(id: string) {
      const row = state.snippets.find((item) => item.id === id); if (!row) return;
      const dialog = $<HTMLDialogElement>('#chat-snippet-dialog'); const body = $('#chat-snippet-dialog-body');
      body.innerHTML = `<h2 class="font-display text-lg font-bold">แก้ข้อความ ${esc(row.offer_code)} · ${esc(row.slot)}</h2><form id="chat-snippet-form" class="mt-3 space-y-3">
        <div class="grid gap-2 sm:grid-cols-3"><label class="text-xs">ช่องทาง<select id="chat-snippet-channel" class="select select-sm select-bordered mt-1 w-full"><option>any</option><option>line</option><option>messenger</option><option>manual</option></select></label><label class="text-xs">สถานะ<select id="chat-snippet-status" class="select select-sm select-bordered mt-1 w-full"><option>draft</option><option>live</option></select></label><label class="text-xs">คำถาม FAQ<input id="chat-snippet-faq" class="input input-sm input-bordered mt-1 w-full" value="${esc(row.faq_q || '')}" /></label></div>
        <div class="chat-compare grid gap-3"><label class="text-xs">ต้นฉบับ (เก็บ token)<textarea id="chat-snippet-body" class="textarea textarea-bordered mt-1 min-h-56 w-full text-sm" required>${esc(row.body)}</textarea><span id="chat-snippet-count" class="mt-1 block opacity-60"></span></label><div class="text-xs">Preview ที่ลูกค้าเห็น<div id="chat-snippet-preview" class="chat-preview chat-copy mt-1 min-h-56 rounded-xl p-3 text-sm"></div></div></div>
        <div id="chat-snippet-errors" class="text-sm text-error" role="alert"></div><div class="modal-action"><button type="button" class="btn btn-ghost btn-sm tap-44" data-close>ยกเลิก</button><button type="button" class="btn btn-sm tap-44" data-copy-preview>คัดลอก Preview</button><button id="chat-snippet-save" class="btn btn-sm text-white tap-44" style="background-color:var(--color-brand-navy);">บันทึก</button></div></form>`;
      $<HTMLSelectElement>('#chat-snippet-channel').value = row.channel; $<HTMLSelectElement>('#chat-snippet-status').value = row.status;
      const source = $<HTMLTextAreaElement>('#chat-snippet-body');
      const sync = () => { $('#chat-snippet-count').textContent = `${source.value.length}/1,900 ตัวอักษร`; $('#chat-snippet-preview').textContent = preview(source.value); };
      sync(); source.addEventListener('input', sync); body.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
      body.querySelector('[data-copy-preview]')?.addEventListener('click', async () => { try { await navigator.clipboard.writeText(renderTokens(source.value, state.catalog)); toast('คัดลอก Preview แล้ว'); } catch (error) { oops(error); } });
      $('#chat-snippet-form').addEventListener('submit', async (event) => {
        event.preventDefault(); const save = $<HTMLButtonElement>('#chat-snippet-save'); save.disabled = true;
        const candidate = { ...row, body: source.value, channel: $<HTMLSelectElement>('#chat-snippet-channel').value, status: $<HTMLSelectElement>('#chat-snippet-status').value, faq_q: $<HTMLInputElement>('#chat-snippet-faq').value.trim() || null };
        const validation = validateSnippet(candidate, state.catalog); $('#chat-snippet-errors').textContent = validation.issues.map((issue) => issue.message).join(' · ');
        if (!validation.valid) { save.disabled = false; return; }
        try { await saveSnippet(row.id, candidate); dialog.close(); toast('บันทึกข้อความแล้ว'); await reload(); } catch (error) { oops(error); } finally { save.disabled = false; }
      });
      dialog.showModal(); source.focus();
    }

    function keywordWarnings(row: KeywordRow): string[] {
      const warnings: string[] = [];
      if (keywordConflicts(state.keywords).some((item) => item.leftId === row.id || item.rightId === row.id)) warnings.push('คำนี้ชนหรือซ้อนกับ keyword อื่น');
      const age = (Date.now() - new Date(row.updated_at).getTime()) / 86400000;
      if (declared(row).length && age >= 14 && !Number(row.hits_30d || 0)) warnings.push('ประกาศมาอย่างน้อย 14 วันแต่ยังไม่มี hit');
      if (!row.enabled && declared(row).length) warnings.push('ปิด keyword อยู่ แต่ยังมีรายการประกาศที่ผูกไว้');
      return warnings;
    }

    function statBadge(id: string) {
      const stat = (state.stats || []).find((item: KeywordStatRow) => item.id === id);
