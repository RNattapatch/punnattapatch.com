---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WarRoomGate from '../../components/war-room/WarRoomGate.astro';
import AppNav from '../../components/app/AppNav.astro';
---
<DashboardLayout title="AI Office | Pun">
  <script is:inline async src="https://accounts.google.com/gsi/client"></script>
  <WarRoomGate appId="office-app" title="AI Office" icon="🏢" event="office:authed" />

  <style is:global>
    #office-app {
      --of-accent: #0f766e;
      --of-wash: #ecf8f5;
      --of-border: color-mix(in srgb, currentColor 11%, transparent);
    }
    [data-theme="pundark"] #office-app { --of-wash: color-mix(in srgb, #14b8a6 18%, transparent); }
    .of-shell { height: calc(100dvh - 4rem); min-height: 0; overflow: hidden; }
    .of-pane { min-width: 0; min-height: 0; background: var(--color-base-100); }
    .of-scroll { min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; }
    .of-room[aria-current="true"], .of-chat[aria-current="true"] { background: var(--of-wash); border-color: var(--of-accent); }
    .of-room, .of-chat, .of-action { min-height: 44px; border: 1px solid transparent; border-radius: .85rem; }
    .of-bubble { max-width: min(42rem, 88%); border: 1px solid var(--of-border); border-radius: 1rem; padding: .7rem .8rem; overflow-wrap: anywhere; }
    .of-bubble-owner { margin-left: auto; background: var(--of-accent); border-color: var(--of-accent); color: white; }
    .of-copy { white-space: pre-wrap; overflow-wrap: anywhere; }
    .of-separator { display: flex; align-items: center; gap: .65rem; color: color-mix(in srgb, currentColor 58%, transparent); font-size: .75rem; }
    .of-separator::before, .of-separator::after { content: ''; height: 1px; flex: 1; background: var(--of-border); }
    .of-context::-webkit-progress-value { background: var(--of-meter, #64748b); }
    .of-context::-moz-progress-bar { background: var(--of-meter, #64748b); }
    .of-compose { padding-bottom: max(.75rem, env(safe-area-inset-bottom)); }
    .of-message-stack > * + * { margin-top: .22rem; }
    .of-file { border: 1px solid var(--of-border); border-radius: .7rem; padding: .55rem; }
    .of-status-sheet { width: min(48rem, calc(100vw - 1.5rem)); max-width: none; }
    .tap-44 { min-width: 44px; min-height: 44px; }
    .menu button, .menu summary { min-height: 44px; }
    button:focus-visible, a:focus-visible, textarea:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--color-brand-coral); outline-offset: 2px; }
    @media (min-width: 1024px) {
      .of-grid { display: grid; grid-template-columns: minmax(14rem, .78fr) minmax(18rem, 1fr) minmax(24rem, 1.45fr); }
      .of-pane + .of-pane { border-left: 1px solid var(--of-border); }
    }
    @media (max-width: 1023px) {
      .of-grid { display: block; }
      .of-pane { display: none; height: 100%; }
      #office-app[data-mobile-stage="rooms"] #of-rooms-pane,
      #office-app[data-mobile-stage="room"] #of-room-pane,
      #office-app[data-mobile-stage="chat"] #of-chat-pane { display: flex; }
    }
    @media (prefers-reduced-motion: reduce) {
      #office-app *, #office-app *::before, #office-app *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
    }
    /* iOS Safari ซูมทั้งหน้าเมื่อแตะช่องที่ตัวอักษรต่ำกว่า 16px · iPhone คือจอหลักของหน้านี้ */
    #office-app textarea, #office-app input, #office-app select { font-size: max(16px, 1rem); }
  </style>

  <div id="office-app" data-mobile-stage="rooms" class="hidden min-h-dvh bg-base-200/50">
    <AppNav app="office">
      <span id="of-nav-health" class="badge badge-ghost my-auto hidden sm:inline-flex" role="status">…</span>
      <button id="of-office-status" class="btn btn-ghost btn-sm my-auto min-h-11" type="button">สถานะออฟฟิศ</button>
      <button id="of-refresh" class="btn btn-ghost btn-sm tap-44 my-auto" type="button" aria-label="รีเฟรช" title="รีเฟรช">⟳</button>
    </AppNav>

    <main class="of-shell mx-auto w-full max-w-[100rem] p-0 md:p-3">
      <div class="of-grid h-full overflow-hidden border-base-300 bg-base-100 md:rounded-2xl md:border md:shadow-sm">
        <aside id="of-rooms-pane" class="of-pane flex h-full flex-col" aria-label="รายการห้อง">
          <header class="border-b border-base-300 p-3">
            <p class="text-xs font-semibold uppercase tracking-[.16em] opacity-55">AI Office</p>
            <h1 class="font-display text-2xl font-bold">ห้องทำงาน</h1>
            <div id="of-waiting" class="mt-3 rounded-xl bg-warning/15 p-3 text-sm font-semibold" role="status"></div>
          </header>
          <nav id="of-room-list" class="of-scroll flex-1 space-y-4 p-2" aria-label="ห้องทั้งหมด"></nav>
        </aside>

        <section id="of-room-pane" class="of-pane flex h-full flex-col" aria-labelledby="of-room-title">
          <header class="flex min-h-16 items-center gap-2 border-b border-base-300 px-3 py-2">
            <button class="of-back-rooms btn btn-ghost btn-sm tap-44 lg:hidden" type="button" aria-label="กลับไปรายการห้อง">‹</button>
            <div class="min-w-0 flex-1">
              <h2 id="of-room-title" class="truncate font-display text-lg font-bold">เลือกห้อง</h2>
              <p id="of-room-subtitle" class="truncate text-xs opacity-55"></p>
            </div>
            <button id="of-new-chat" class="btn btn-primary btn-sm min-h-11" type="button">+ แชทใหม่</button>
          </header>
          <div class="of-scroll flex-1 p-3">
            <section aria-labelledby="of-chats-title">
              <h3 id="of-chats-title" class="mb-2 text-xs font-semibold uppercase tracking-[.12em] opacity-55">แชท</h3>
              <div id="of-chat-list" class="space-y-1"></div>
            </section>
            <section id="of-review-section" class="mt-5 hidden" aria-labelledby="of-review-title">
              <h3 id="of-review-title" class="mb-2 text-xs font-semibold uppercase tracking-[.12em] opacity-55">งานรอคุณปัน</h3>
              <div id="of-review-list" class="space-y-2"></div>
            </section>
            <section id="of-alert-section" class="mt-5 hidden" aria-labelledby="of-alert-title">
              <h3 id="of-alert-title" class="mb-2 text-xs font-semibold uppercase tracking-[.12em] opacity-55">เหตุทั้งหมด</h3>
              <div id="of-alert-list" class="space-y-2"></div>
            </section>
            <section class="mt-5" aria-labelledby="of-feed-title">
              <h3 id="of-feed-title" class="mb-2 text-xs font-semibold uppercase tracking-[.12em] opacity-55">ฟีดของห้อง</h3>
              <div id="of-room-feed" class="space-y-2"></div>
            </section>
          </div>
          <form id="of-incident-form" class="of-compose hidden border-t border-base-300 bg-base-100 p-3">
            <label for="of-incident-input" class="mb-1 block text-xs font-semibold">แจ้งเหตุให้ฝ่ายเทค</label>
            <div class="flex items-end gap-2">
              <textarea id="of-incident-input" class="textarea textarea-bordered min-h-11 flex-1 resize-none" rows="1" maxlength="2000" enterkeyhint="send" placeholder="เกิดอะไรขึ้น"></textarea>
              <button class="btn btn-error min-h-11" type="submit">แจ้งเหตุ</button>
            </div>
            <p id="of-incident-error" class="mt-1 hidden text-sm text-error" role="alert"></p>
          </form>
        </section>

        <section id="of-chat-pane" class="of-pane flex h-full flex-col" aria-labelledby="of-chat-title">
          <header class="border-b border-base-300 px-3 py-2">
            <div class="flex min-h-11 items-center gap-2">
              <button class="of-back-room btn btn-ghost btn-sm tap-44 lg:hidden" type="button" aria-label="กลับไปที่ห้อง">‹</button>
              <div class="min-w-0 flex-1">
                <h2 id="of-chat-title" class="truncate font-display text-lg font-bold">เลือกแชท</h2>
                <div class="mt-0.5 flex flex-wrap items-center gap-2"><span id="of-chat-status" class="badge badge-sm badge-ghost">ยังไม่เลือก</span><span id="of-readonly" class="hidden text-xs text-warning">แชทนี้อ่านได้อย่างเดียว</span></div>
              </div>
              <details id="of-chat-menu" class="dropdown dropdown-end hidden">
                <summary class="btn btn-ghost btn-sm tap-44 list-none" aria-label="เมนูแชท">⋯</summary>
                <ul class="menu dropdown-content z-30 mt-2 w-72 rounded-box border border-base-300 bg-base-100 p-2 shadow-xl">
                  <li><button type="button" data-chat-action="reset_context">เริ่มบริบทใหม่</button></li>
                  <li><button type="button" data-chat-action="handoff">สรุปส่งต่อแชทใหม่</button></li>
                  <li><button type="button" data-chat-action="handoff_other">ส่งต่อไปห้องอื่น</button></li>
                  <li><details><summary>แจ้งเตือน Telegram</summary><ul><li><button type="button" data-notify="final">เฉพาะจบและรอคุณปัน</button></li><li><button type="button" data-notify="all">ทุกขั้น</button></li><li><button type="button" data-notify="off">ปิด</button></li></ul></details></li>
                  <li><button type="button" data-chat-action="close" class="text-warning">ปิดแชท</button></li>
                  <li><button type="button" data-chat-action="archive" class="text-error">เก็บแชท</button></li>
                </ul>
              </details>
            </div>
            <div id="of-context-wrap" class="mt-2 hidden">
              <div class="mb-1 flex justify-between gap-3 text-xs"><span>บริบทของหัวหน้า</span><span id="of-context-label"></span></div>
              <progress id="of-context" class="of-context progress h-1.5 w-full" max="100" value="0" aria-label="การใช้บริบทของหัวหน้า"></progress>
              <p id="of-context-warning" class="mt-1 hidden text-xs font-semibold text-error">แนะนำสรุปส่งต่อแชทใหม่</p>
            </div>
          </header>
          <div id="of-message-list" class="of-scroll flex-1 space-y-3 p-3" aria-live="polite"></div>
          <form id="of-compose" class="of-compose border-t border-base-300 bg-base-100 p-3">
            <label id="of-compose-label" for="of-compose-input" class="mb-1 block text-xs font-semibold">เริ่มแชทใหม่</label>
            <div class="flex items-end gap-2">
              <textarea id="of-compose-input" class="textarea textarea-bordered min-h-11 flex-1 resize-none" rows="1" maxlength="4000" enterkeyhint="send" placeholder="พิมพ์หาหัวหน้าฝ่าย"></textarea>
              <button id="of-compose-send" class="btn btn-primary min-h-11" type="submit">ส่ง</button>
            </div>
            <p id="of-compose-error" class="mt-1 hidden text-sm text-error" role="alert"></p>
          </form>
        </section>
      </div>
    </main>

    <dialog id="of-status-dialog" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box of-status-sheet max-h-[90dvh]">
        <form method="dialog"><button class="btn btn-circle btn-ghost btn-sm absolute right-3 top-3" aria-label="ปิด">✕</button></form>
        <h2 class="font-display text-2xl font-bold">สถานะออฟฟิศ</h2>
        <div id="of-status-content" class="mt-4 space-y-5"></div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>ปิด</button></form>
    </dialog>

    <dialog id="of-confirm-dialog" class="modal">
      <form id="of-confirm-form" method="dialog" class="modal-box">
        <h2 id="of-confirm-title" class="font-display text-xl font-bold">ยืนยัน</h2>
        <p id="of-confirm-copy" class="mt-2 text-sm opacity-70"></p>
        <label id="of-confirm-room-wrap" class="mt-4 hidden text-sm font-semibold">ห้องปลายทาง<select id="of-confirm-room" class="select select-bordered mt-1 min-h-11 w-full"></select></label>
        <label id="of-confirm-note-wrap" class="mt-4 hidden text-sm font-semibold">จุดที่อยากให้แก้<textarea id="of-confirm-note" class="textarea textarea-bordered mt-1 w-full" rows="3" maxlength="4000"></textarea></label>
        <p id="of-confirm-error" class="mt-2 hidden text-sm text-error" role="alert"></p>
        <div class="modal-action"><button value="cancel" class="btn min-h-11" type="button" id="of-confirm-cancel">ยังไม่ทำ</button><button value="confirm" class="btn btn-primary min-h-11" type="submit" id="of-confirm-submit">ยืนยัน</button></div>
      </form>
    </dialog>

    <div class="toast toast-end z-50"><div id="of-toast" class="alert alert-error hidden max-w-sm text-sm shadow-lg" role="alert"></div></div>
  </div>

  <script src="../../scripts/office/app.ts"></script>
</DashboardLayout>
