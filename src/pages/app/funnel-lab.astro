---
// Funnel Lab (เดิม Growth Lab / Growth Journey Lab · เปลี่ยนชื่อ+route 2026-10-12 · /growth-lab redirect มาที่นี่)
// ทดสอบข้อความ/ข้อเสนอ/touchpoint กับ persona จำลองก่อนยิงจริง แล้วคาดการณ์ Customer Journey
// (2026-10-11 · Codex สร้างเป็นแอปเดี่ยว → Claude QC แล้วแก้ก่อนย้ายเข้า app hub · 2026-10-12 UX โต๊ะทดลองจาก mock ของ Codex)
// ชื่อภายใน (id growth-lab-app · ตาราง growth_lab_* · job growth_eval · โฟลเดอร์ scripts/growth-lab) คงเดิมโดยตั้งใจ
// — เปลี่ยนแล้วข้อมูล/คิว/สำเนาในเครื่องที่มีอยู่จะหลุด ไม่ได้อะไรเพิ่ม
//
// ทำไมมีหน้านี้: ก่อนใส่งบแอด/ส่ง LINE OA/โทรหาลูกค้า อยากรู้ว่า "ข้อความนี้พาใครไปต่อได้บ้าง" แบบเร็วและถูก
// แล้วเอาผลจริงมาเทียบ (Results) เพื่อจูน Persona Pack รอบถัดไป · ใช้ได้ทั้ง B2B / B2C / B2G
//
// สิ่งที่แก้จากรุ่น Codex (QC 2026-10-11): ตัวให้คะแนน Local ไม่ดูช่องทาง/ประเภท touchpoint/stage/B2B-B2C-B2G เลย
// (Meta Ad = SMS = Sales call คะแนนเท่ากันเป๊ะ · แอด B2C ดีๆ โดน KILL) · เวลาประเมินเป็นปี 1970 · ผลเก่า 1 ตัว
// ล้าง workspace ทิ้งทั้งก้อน · ปุ่ม Codex พังบน codex-cli 0.147 · รายละเอียด: tests/growth-lab/engine-context.test.mjs
//
// ข้อมูล: workspace ทั้งก้อนอยู่ Supabase growth_lab_workspaces (แถว 'default' · RLS is_owner) + สำเนาใน localStorage
//   → เปิดจาก MacBook/iPhone เห็นชุดเดียวกัน · ออฟไลน์ก็ทำงานต่อได้ แล้วซิงก์ทีหลัง
// Codex: ปุ่ม "ประเมินด้วย Codex (มินิ)" → wr_jobs.growth_eval → wrjobs_worker.mjs บนมินิรัน codex exec แบบปิดเครื่องมือ
//   (read-only · ไม่มี shell/browser/plugin) → ผลกลับมาที่แถว job · ระหว่างรอปิดแท็บได้ กลับมาเปิดใหม่จะรับผลต่อเอง
// Logic ทั้งหมด (pure) อยู่ src/scripts/growth-lab/*.mjs · เทสต์ tests/growth-lab/
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import WarRoomGate from '../../components/war-room/WarRoomGate.astro';
import AppNav from '../../components/app/AppNav.astro';
---
<DashboardLayout title="Funnel Lab — Pun">
  <script is:inline async src="https://accounts.google.com/gsi/client"></script>
  <WarRoomGate appId="growth-lab-app" title="Funnel Lab" icon="🧭" event="growth-lab:authed" />

  <style is:global>
    #growth-lab-app { --gl-accent: var(--color-brand-navy); --gl-accent-ink: #fff; }
    #growth-lab-app .gl-eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .55; }
    #growth-lab-app .gl-tab[aria-current="page"], #growth-lab-app .gl-tab[aria-current="page"]:hover { --btn-bg: var(--gl-accent); --btn-fg: var(--gl-accent-ink); --btn-border: var(--gl-accent); background: var(--gl-accent); color: var(--gl-accent-ink); }
    #growth-lab-app .gl-primary { --btn-bg: var(--gl-accent); --btn-fg: var(--gl-accent-ink); --btn-border: var(--gl-accent); background: var(--gl-accent); border-color: var(--gl-accent); color: var(--gl-accent-ink); }
    #growth-lab-app .gl-primary:hover { filter: brightness(1.08); }
    #growth-lab-app .gl-card-active { outline: 2px solid var(--gl-accent); outline-offset: -2px; background: var(--color-base-100); }
    #growth-lab-app .gl-scale { color: #2f7a55; }
    #growth-lab-app .gl-iterate { color: #b7791f; }
    #growth-lab-app .gl-kill { color: var(--color-brand-coral); }
    #growth-lab-app .gl-chip-scale { background: color-mix(in oklab, #2f7a55 16%, transparent); color: #2f7a55; }
    #growth-lab-app .gl-chip-iterate { background: color-mix(in oklab, #b7791f 18%, transparent); color: #9a6418; }
    #growth-lab-app .gl-chip-kill { background: color-mix(in oklab, var(--color-brand-coral) 16%, transparent); color: var(--color-brand-coral-dark); }
    #growth-lab-app .gl-chip-draft { background: var(--color-base-300); }
    #growth-lab-app .gl-seat { border: 1px solid var(--color-base-300); border-left-width: 4px; }
    #growth-lab-app .gl-seat-stop { border-left-color: #2f7a55; }
    #growth-lab-app .gl-seat-watch { border-left-color: #d69e2e; }
    #growth-lab-app .gl-seat-scroll { border-left-color: var(--color-brand-coral); }
    #growth-lab-app .gl-seat-pending { border-left-color: var(--color-base-300); }
    #growth-lab-app .gl-dot { display: inline-block; width: .55rem; height: .55rem; border-radius: 999px; }
    #growth-lab-app .gl-bar { height: .5rem; border-radius: 999px; background: var(--color-base-300); overflow: hidden; }
    #growth-lab-app .gl-bar > span { display: block; height: 100%; border-radius: inherit; background: var(--gl-accent); }
    #growth-lab-app .gl-weak > span { background: var(--color-brand-coral); }
    #growth-lab-app .gl-stage-bottleneck { outline: 2px solid var(--color-brand-coral); outline-offset: -2px; }
    #growth-lab-app .gl-stage-passed { opacity: .55; }
    #growth-lab-app .gl-rail::-webkit-scrollbar, #growth-lab-app .gl-tabs::-webkit-scrollbar { display: none; }
    #growth-lab-app .gl-rail, #growth-lab-app .gl-tabs { scrollbar-width: none; }
    #growth-lab-app input[type="file"].gl-file { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }
    #growth-lab-app label:has(> input.gl-file:focus-visible) { outline: 2px solid var(--color-brand-coral); outline-offset: 2px; }
    @media (prefers-reduced-motion: no-preference) { #growth-lab-app .gl-bar > span { transition: width 240ms ease; } }
    /* โต๊ะทดลอง: แผงหลักเรียบ · แผ่น "ข้อสรุป" ตัดกับพื้นเสมอ (ธีมสว่าง = แผ่นกรมท่า · ธีมมืด = แผ่นกระดาษ) */
    #growth-lab-app .gl-panel { border: 1px solid var(--color-base-300); background: var(--color-base-200); border-radius: 1rem; }
    #growth-lab-app .gl-step { display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.75rem; margin-right: .5rem; border: 1px solid var(--color-base-300); border-radius: .4rem; font-size: .75rem; font-weight: 700; color: var(--color-brand-coral); vertical-align: middle; }
    #growth-lab-app .gl-sheet { --sheet-bg: var(--color-brand-navy); --sheet-ink: #f4eee3; --sheet-rule: rgb(255 255 255 / .16); --sheet-track: rgb(255 255 255 / .16); --sheet-bar: #8bd3a4; --sheet-weak: #f0b07a; background: var(--sheet-bg); color: var(--sheet-ink); }
    [data-theme="pundark"] #growth-lab-app .gl-sheet { --sheet-bg: #f4eee3; --sheet-ink: #172937; --sheet-rule: #d8d0c2; --sheet-track: #ded7cb; --sheet-bar: #527462; --sheet-weak: #ac763d; }
    #growth-lab-app .gl-sheet .gl-step-sheet { border-color: var(--sheet-rule); color: inherit; }
    #growth-lab-app .gl-sheet .gl-rule { border-color: var(--sheet-rule); }
    #growth-lab-app .gl-sheet .gl-bar { background: var(--sheet-track); }
    #growth-lab-app .gl-sheet .gl-bar > span { background: var(--sheet-bar); }
    #growth-lab-app .gl-sheet .gl-weak > span { background: var(--sheet-weak); }
    #growth-lab-app .gl-sheet .gl-weak-text { color: var(--sheet-weak); }
    #growth-lab-app .gl-sheet-action { --btn-bg: var(--sheet-ink); --btn-fg: var(--sheet-bg); --btn-border: var(--sheet-ink); background: var(--sheet-ink); color: var(--sheet-bg); border-color: var(--sheet-ink); }
    #growth-lab-app .gl-sheet-quiet { --btn-bg: transparent; --btn-fg: var(--sheet-ink); --btn-border: var(--sheet-rule); background: transparent; color: var(--sheet-ink); border-color: var(--sheet-rule); }
    #growth-lab-app .gl-sheet .badge { background: transparent; color: inherit; border-color: var(--sheet-rule); }
    #growth-lab-app .gl-preview { border: 1px solid var(--color-base-300); background: var(--color-base-100); border-radius: .75rem; overflow: hidden; }
    #growth-lab-app .gl-count[aria-pressed="true"] { outline: 2px solid var(--gl-accent); outline-offset: -2px; }
    #growth-lab-app .gl-stop { color: #2f7a55; } #growth-lab-app .gl-watch { color: #b7791f; } #growth-lab-app .gl-scroll { color: var(--color-brand-coral); }
    [data-theme="pundark"] #growth-lab-app .gl-stop { color: #8bd3a4; } [data-theme="pundark"] #growth-lab-app .gl-watch { color: #ebc579; }
  </style>

  <div id="growth-lab-app" class="hidden min-h-dvh bg-base-100">
    <AppNav app="funnel-lab" />

    <!-- Lab header: ชื่อ workspace (white-label) + สถานะซิงก์ + แท็บมุมมอง -->
    <div class="border-b border-base-300 bg-base-100">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <div class="min-w-0 flex-1">
          <p class="truncate font-display text-base font-semibold leading-tight" id="brand-name">Funnel Lab</p>
          <p class="truncate text-xs opacity-60" id="brand-client">ข้อความที่ใช่ เริ่มจากเข้าใจคนรับ</p>
        </div>
        <span id="sync-status" class="badge badge-ghost badge-sm whitespace-nowrap" role="status" aria-live="polite">กำลังโหลด…</span>
        <nav class="gl-tabs -mx-4 flex w-full gap-1 overflow-x-auto px-4 sm:mx-0 sm:w-auto sm:px-0" aria-label="มุมมองของ Funnel Lab">
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="workbench" aria-current="page">โต๊ะทดลอง</button>
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="compare">เทียบข้อความ</button>
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="journey">เส้นทางซื้อ</button>
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="results">ผลจริง</button>
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="personas">กลุ่มผู้ซื้อ <span class="badge badge-sm" id="persona-count">0</span></button>
          <button class="gl-tab btn btn-sm rounded-full border-0 btn-ghost tap-44" data-view="settings" aria-label="ตั้งค่า">⚙️</button>
        </nav>
      </div>
    </div>

    <main class="mx-auto max-w-7xl px-4 py-4">
      <div id="notice" class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl px-4 py-2.5 text-sm text-white" style="background-color:var(--color-brand-navy);" role="status" aria-live="polite" hidden>
        <span id="notice-text" class="min-w-0 flex-1"></span>
        <button type="button" id="notice-action" class="btn btn-xs border-0 bg-white text-[color:var(--color-brand-navy)] tap-44" hidden></button>
      </div>

      <!-- ===================== WORKBENCH · โต๊ะทดลอง (layout จาก UX mock ของ Codex 2026-10-11) =====================
           01 ข้อความทดลอง → 02 มุมมองผู้ซื้อ → 03 ข้อสรุป · ฟอร์มละเอียดเปิดใน dialog เมื่อกด "แก้ข้อความ"
           มือถือเรียง: ข้อความ → ข้อสรุป → ผู้ซื้อ -->
      <section id="view-workbench" data-screen="workbench" aria-labelledby="workbench-title">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
          <div>
            <p class="gl-eyebrow">Test / Learn / Refine</p>
            <h1 id="workbench-title" class="font-display text-xl font-semibold sm:text-2xl">ข้อความนี้ คนซื้อจะหยุดดูไหม?</h1>
            <p class="mt-1 text-sm opacity-70">เลือกข้อความ ดูเหตุผลของคนซื้อ แล้วเปลี่ยนทีละอย่าง</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button class="btn btn-sm tap-44" data-action="new-creative">+ ข้อความใหม่</button>
            <button class="gl-primary btn btn-sm tap-44" data-action="evaluate">⚡ ประเมินข้อความนี้</button>
          </div>
        </div>

        <div class="grid items-start gap-4 lg:grid-cols-[200px_minmax(0,1fr)_300px] lg:grid-rows-[auto_1fr] xl:grid-cols-[230px_minmax(0,1fr)_320px]">
          <!-- 01 ข้อความทดลอง -->
          <aside class="gl-panel order-1 min-w-0 p-4 lg:row-span-2" aria-labelledby="rail-title">
            <div class="mb-3 flex items-center justify-between"><h2 id="rail-title" class="font-display font-semibold"><span class="gl-step">01</span>ข้อความทดลอง</h2><span class="gl-eyebrow" id="creative-count">0</span></div>
            <div id="creative-list" class="gl-rail -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0"></div>
            <button class="btn btn-sm btn-ghost mt-3 hidden w-full border border-dashed border-base-300 tap-44 lg:inline-flex" data-action="new-creative">+ เพิ่มข้อความทดลอง</button>
            <div class="mt-4 hidden border-t border-base-300 pt-3 text-xs opacity-80 lg:block">
              <p>เปลี่ยนทีละอย่างเพื่อรู้ว่าอะไรได้ผล</p>
              <button class="link link-hover mt-1 tap-44" data-view="compare">เปิดตารางเทียบข้อความ →</button>
            </div>
            <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 border-t border-base-300 pt-3 text-xs">
              <button class="link link-hover tap-44" data-action="backup-json">↓ Backup JSON</button>
              <label class="link link-hover relative flex items-center tap-44" for="json-restore">↑ Restore JSON<input id="json-restore" class="gl-file" type="file" accept="application/json,.json"></label>
            </div>
          </aside>

          <!-- ข้อความที่เลือก (สิ่งที่ผู้รับเห็น) -->
          <section class="gl-panel order-2 min-w-0 p-4 sm:p-5 lg:col-start-2" aria-labelledby="message-title">
            <div class="mb-3 flex items-start justify-between gap-3">
              <div class="min-w-0"><p class="gl-eyebrow" id="message-kicker">Selected message</p><h2 id="message-title" class="truncate font-display text-lg font-semibold">—</h2></div>
              <div class="flex shrink-0 items-center gap-2"><span class="badge badge-ghost badge-sm" id="save-state">บันทึกแล้ว</span><button class="btn btn-sm tap-44" data-action="edit-creative">✎ แก้ข้อความ</button></div>
            </div>
            <div class="mb-3 flex flex-wrap gap-2" id="message-chips"></div>
            <div id="message-preview"></div>
          </section>

          <!-- 03 ข้อสรุป -->
          <aside class="gl-sheet order-3 min-w-0 scroll-mt-20 rounded-2xl p-5 lg:col-start-3 lg:row-span-2 lg:row-start-1 lg:sticky lg:top-20" aria-labelledby="decision-title">
            <div class="mb-4 flex items-center justify-between gap-2"><h2 id="decision-title" class="font-display text-lg font-semibold"><span class="gl-step gl-step-sheet">03</span>ข้อสรุป</h2><span class="badge badge-sm shrink-0 whitespace-nowrap" id="evaluation-engine">LOCAL</span></div>
            <div id="decision-summary"></div>
            <div class="mt-4 space-y-3" id="component-bars"></div>
            <div id="hypothesis-card"></div>
            <button class="btn btn-sm gl-sheet-quiet mt-4 w-full tap-44" type="button" id="provider-button" data-action="evaluate-provider">🧠 ประเมินลึกด้วย Codex (มินิ)</button>
            <p class="mt-2 text-[11px] leading-relaxed opacity-70" id="provider-note">Codex ส่งเข้าคิว Mac mini ราว 1–4 นาที ปิดแท็บได้ กลับมาจะรับผลต่อเอง · ผู้ซื้อทั้งหมดเป็นแบบจำลอง ผลจริงจาก Ads / LINE / ทีมขายคือคำตอบสุดท้าย</p>
          </aside>

          <!-- 02 มุมมองผู้ซื้อ -->
          <section class="gl-panel order-4 min-w-0 p-4 sm:p-5 lg:col-start-2 lg:row-start-2" aria-labelledby="persona-panel-title">
            <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
              <div><h2 id="persona-panel-title" class="font-display text-lg font-semibold"><span class="gl-step">02</span>มุมมองผู้ซื้อ</h2><p class="mt-0.5 text-xs opacity-70" id="buyer-panel-label">กดแต่ละคนเพื่ออ่านเหตุผล</p></div>
            </div>
            <div class="mb-3 grid grid-cols-3 gap-2" id="decision-legend"></div>
            <div class="mb-2 flex items-center justify-between gap-2"><button class="link link-hover text-xs tap-44" data-filter="ALL" id="filter-all">ดูทั้งหมด</button><span class="text-[11px] opacity-60">คะแนน / 100</span></div>
            <div id="persona-panel" class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-5"></div>
          </section>
        </div>
      </section>

      <!-- ===================== COMPARE ===================== -->
      <section id="view-compare" data-screen="compare" aria-labelledby="compare-title" class="space-y-4" hidden>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="gl-eyebrow">Variant ranking</p><h1 id="compare-title" class="font-display text-xl font-semibold sm:text-2xl">เทียบข้อความ · เลือกตัวชนะก่อนลงงบ</h1></div>
          <button class="gl-primary btn btn-sm tap-44" data-view="workbench">กลับไปโต๊ะทดลอง</button>
        </div>
        <div id="compare-content"></div>
      </section>

      <!-- ===================== JOURNEY ===================== -->
      <section id="view-journey" data-screen="journey" aria-labelledby="journey-title" class="space-y-4" hidden>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="gl-eyebrow">Directional forecast</p><h1 id="journey-title" class="font-display text-xl font-semibold sm:text-2xl">เส้นทางซื้อหลังรับข้อความ</h1></div>
          <button class="gl-primary btn btn-sm tap-44" data-view="workbench">กลับไปปรับข้อความ</button>
        </div>
        <section id="journey-summary" class="grid gap-3 sm:grid-cols-3"></section>
        <section aria-labelledby="journey-rail-title" class="space-y-2">
          <div><p class="gl-eyebrow">Journey rail</p><h2 id="journey-rail-title" class="font-display font-semibold">โอกาสผ่านแต่ละ Stage และจุดหลุด</h2></div>
          <div id="journey-rail" class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-2"></div>
        </section>
        <section class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div class="min-w-0 space-y-2">
            <div><p class="gl-eyebrow">Persona paths</p><h2 class="font-display font-semibold">ใครติดตรงไหน</h2></div>
            <div id="journey-persona-table" class="overflow-x-auto rounded-2xl border border-base-300 bg-base-200"></div>
          </div>
          <aside class="space-y-2">
            <div><p class="gl-eyebrow">Assumptions</p><h2 class="font-display font-semibold">ความมั่นใจและข้อจำกัด</h2></div>
            <div id="journey-assumptions" class="card border border-base-300 bg-base-200"></div>
          </aside>
        </section>
      </section>

      <!-- ===================== RESULTS ===================== -->
      <section id="view-results" data-screen="results" aria-labelledby="results-title" class="space-y-4" hidden>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="gl-eyebrow">Ground truth</p><h1 id="results-title" class="font-display text-xl font-semibold sm:text-2xl">เทียบคำทำนายกับผลจริงตามช่องทาง</h1></div>
          <div class="flex flex-wrap gap-2">
            <button class="btn btn-sm tap-44" data-action="export-csv">↓ Export CSV</button>
            <label class="btn btn-sm relative tap-44" for="csv-import">↑ Import CSV<input id="csv-import" class="gl-file" type="file" accept="text/csv,.csv"></label>
          </div>
        </div>
        <div class="grid gap-4 lg:grid-cols-2">
          <section class="card border border-base-300 bg-base-200"><div class="card-body gap-3 p-4">
            <div><p class="gl-eyebrow">Actual input · <span id="actual-context">CHANNEL</span></p><h2 class="font-display font-semibold">ผลลัพธ์จริงตามช่องทาง</h2></div>
            <form id="actual-results-form" class="space-y-3" novalidate></form>
          </div></section>
          <section class="card border border-base-300 bg-base-200" aria-labelledby="metrics-title"><div class="card-body gap-3 p-4">
            <div><p class="gl-eyebrow">Calibration</p><h2 id="metrics-title" class="font-display font-semibold">Prediction ↔ Actual</h2></div>
            <div id="calibration-content"></div>
          </div></section>
        </div>
        <div class="text-sm" id="import-report" aria-live="polite"></div>
      </section>

      <!-- ===================== PERSONAS ===================== -->
      <section id="view-personas" data-screen="personas" aria-labelledby="personas-title" class="space-y-4" hidden>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="gl-eyebrow">Persona pack library</p><h1 id="personas-title" class="font-display text-xl font-semibold sm:text-2xl">กลุ่มผู้ซื้อที่ตรงกับ Business Unit</h1></div>
          <div class="flex flex-wrap gap-2">
            <button class="btn btn-sm tap-44" data-action="clone-pack">⧉ Clone pack</button>
            <button class="btn btn-sm tap-44" data-action="new-pack">+ New pack</button>
            <button class="btn btn-sm tap-44" data-action="export-pack">↓ Export pack</button>
            <label class="btn btn-sm relative tap-44" for="persona-pack-import">↑ Import pack<input id="persona-pack-import" class="gl-file" type="file" accept="application/json,.json,.persona-pack.json"></label>
          </div>
        </div>
        <div class="grid gap-4 lg:grid-cols-[240px_minmax(0,1fr)]">
          <aside class="min-w-0 space-y-2">
            <div class="flex items-center justify-between gl-eyebrow"><span>Pack library</span><span id="pack-count">0</span></div>
            <div id="pack-library" class="gl-rail -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0"></div>
          </aside>
          <section class="card min-w-0 border border-base-300 bg-base-200"><div class="card-body gap-4 p-4">
            <form id="pack-form" class="space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div><p class="gl-eyebrow">Business context</p><h2 class="font-display font-semibold">Pack strategy</h2></div>
                <button class="gl-primary btn btn-sm tap-44" type="submit">Save pack</button>
              </div>
              <p class="text-xs opacity-60" id="pack-builtin-note" hidden>นี่คือ pack ตั้งต้น — กด Clone pack ก่อนปรับให้ลูกค้า จะได้ไม่แตะต้นฉบับ</p>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Pack name</span><input class="input input-bordered input-sm w-full" name="name" required maxlength="500"></label>
                <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Business model</span><select class="select select-bordered select-sm w-full" name="businessModel"><option value="b2b">B2B</option><option value="b2c">B2C</option><option value="b2g">B2G</option></select></label>
                <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Industry</span><input class="input input-bordered input-sm w-full" name="industry" required maxlength="500"></label>
                <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Product / Service</span><input class="input input-bordered input-sm w-full" name="product" required maxlength="500"></label>
                <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">Primary outcome</span><textarea class="textarea textarea-bordered w-full text-sm" name="primaryOutcome" rows="2" required maxlength="2000"></textarea></label>
                <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">KPIs <span class="font-normal opacity-60">คั่นด้วย comma</span></span><input class="input input-bordered input-sm w-full" name="kpis" required></label>
              </div>
            </form>
            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-base-300 pt-4">
              <div><p class="gl-eyebrow">Persona builder</p><h2 class="font-display font-semibold">รายละเอียดผู้ตัดสินใจ</h2></div>
              <div class="flex flex-wrap gap-2">
                <button class="btn btn-sm tap-44" data-action="add-persona">+ Add persona</button>
                <button class="btn btn-sm btn-outline btn-error tap-44" data-action="remove-persona">Remove persona</button>
              </div>
            </div>
            <div class="grid gap-4 md:grid-cols-[200px_minmax(0,1fr)]">
              <div id="persona-editor-list" class="gl-rail -mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:max-h-[34rem] md:flex-col md:overflow-y-auto md:px-0"></div>
              <form id="persona-editor" class="space-y-3">
                <input name="id" type="hidden">
                <div class="grid gap-3 sm:grid-cols-2">
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ชื่อ</span><input class="input input-bordered input-sm w-full" name="name" required maxlength="500"></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">บทบาท</span><input class="input input-bordered input-sm w-full" name="role" required maxlength="500"></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Segment</span><input class="input input-bordered input-sm w-full" name="segment" required maxlength="500"></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Decision role</span><select class="select select-bordered select-sm w-full" name="decisionRole"><option value="buyer">Buyer</option><option value="approver">Approver</option><option value="gatekeeper">Gatekeeper</option><option value="influencer">Influencer</option><option value="user">User</option></select></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Awareness</span><input class="input input-bordered input-sm w-full" name="awareness" required maxlength="500"></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Threshold (0–100)</span><input class="input input-bordered input-sm w-full" name="threshold" type="number" inputmode="numeric" min="0" max="100" required></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Risk 1–5 <span class="font-normal opacity-60">1 = กลัวเสี่ยงมาก</span></span><input class="input input-bordered input-sm w-full" name="risk" type="number" inputmode="numeric" min="1" max="5" required></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Price sensitivity 1–5</span><input class="input input-bordered input-sm w-full" name="priceSensitivity" type="number" inputmode="numeric" min="1" max="5" required></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Evidence need 1–5</span><input class="input input-bordered input-sm w-full" name="evidenceNeed" type="number" inputmode="numeric" min="1" max="5" required></label>
                  <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Urgency 1–5</span><input class="input input-bordered input-sm w-full" name="urgency" type="number" inputmode="numeric" min="1" max="5" required></label>
                  <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">Pains <span class="font-normal opacity-60">คั่นด้วย comma</span></span><textarea class="textarea textarea-bordered w-full text-sm" name="pains" rows="2"></textarea></label>
                  <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">Desired outcomes</span><textarea class="textarea textarea-bordered w-full text-sm" name="outcomes" rows="2"></textarea></label>
                  <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">Keywords <span class="font-normal opacity-60">คำที่ถ้าเห็นในข้อความแล้วเขาหยุด</span></span><textarea class="textarea textarea-bordered w-full text-sm" name="keywords" rows="2"></textarea></label>
                  <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">Objections</span><textarea class="textarea textarea-bordered w-full text-sm" name="objections" rows="2"></textarea></label>
                  <fieldset class="grid grid-cols-2 gap-3 rounded-xl border border-base-300 p-3 sm:col-span-2 sm:grid-cols-4">
                    <legend class="px-1 text-xs font-semibold">Weights (รวมกันต้องเท่ากับ 1) · <span id="weight-total">1.00</span></legend>
                    <label class="form-control"><span class="label-text mb-1 text-xs">Hook</span><input class="input input-bordered input-sm w-full" name="weightHook" type="number" inputmode="decimal" min="0" max="1" step="0.01"></label>
                    <label class="form-control"><span class="label-text mb-1 text-xs">Offer</span><input class="input input-bordered input-sm w-full" name="weightOffer" type="number" inputmode="decimal" min="0" max="1" step="0.01"></label>
                    <label class="form-control"><span class="label-text mb-1 text-xs">Copy</span><input class="input input-bordered input-sm w-full" name="weightCopy" type="number" inputmode="decimal" min="0" max="1" step="0.01"></label>
                    <label class="form-control"><span class="label-text mb-1 text-xs">Visual</span><input class="input input-bordered input-sm w-full" name="weightVisual" type="number" inputmode="decimal" min="0" max="1" step="0.01"></label>
                  </fieldset>
                </div>
                <p class="min-h-[1.25rem] text-sm text-error" id="persona-editor-error" role="alert"></p>
                <button class="gl-primary btn btn-sm tap-44" type="submit">Save persona</button>
              </form>
            </div>
          </div></section>
        </div>
        <p class="text-sm opacity-70">แต่ละที่นั่งใช้บทบาท ความเสี่ยง หลักฐานที่ต้องการ และเกณฑ์ตัดสินใจ ไม่ใช่ demographic ลอยๆ</p>
        <div id="persona-directory" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
      </section>

      <!-- ===================== SETTINGS ===================== -->
      <section id="view-settings" data-screen="settings" aria-labelledby="settings-title" class="space-y-4" hidden>
        <div><p class="gl-eyebrow">Client-ready controls</p><h1 id="settings-title" class="font-display text-xl font-semibold sm:text-2xl">ชื่อ workspace ข้อมูล และการซิงก์</h1></div>
        <div class="grid gap-4 lg:grid-cols-2">
          <form id="settings-form" class="card border border-base-300 bg-base-200"><div class="card-body gap-3 p-4">
            <div><p class="gl-eyebrow">White-label</p><h2 class="font-display font-semibold">Workspace identity <span class="text-xs font-normal opacity-60">ใช้ตอนแชร์จอให้ลูกค้า</span></h2></div>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ชื่อแอป</span><input class="input input-bordered input-sm w-full" name="appName" required maxlength="120"></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ชื่อลูกค้า / Business Unit</span><input class="input input-bordered input-sm w-full" name="clientName" maxlength="200"></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">Accent color</span><input class="h-10 w-24 cursor-pointer rounded-lg border border-base-300 bg-base-100" name="accentColor" type="color" required></label>
            <input type="hidden" name="preferredProvider" value="local">
            <p class="min-h-[1.25rem] text-sm text-error" id="settings-error" role="alert"></p>
            <button class="gl-primary btn btn-sm self-start tap-44" type="submit">Save settings</button>
          </div></form>
          <aside id="privacy-summary" class="card border border-base-300 bg-base-200"></aside>
        </div>
      </section>
    </main>

    <dialog id="editor-dialog" class="modal" aria-labelledby="editor-dialog-title">
      <div class="modal-box max-w-3xl">
        <div class="mb-4 flex items-start justify-between gap-3">
          <div><p class="gl-eyebrow">Message editor</p><h2 id="editor-dialog-title" class="font-display text-lg font-semibold">แก้ข้อความทดลอง</h2></div>
          <button type="button" class="btn btn-sm btn-circle btn-ghost tap-44" data-action="close-editor" aria-label="ปิดฟอร์ม">✕</button>
        </div>
        <form id="creative-form" class="space-y-3" novalidate>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">กลุ่มผู้ซื้อ (Persona Pack)</span><select class="select select-bordered select-sm w-full" name="personaPackId" id="persona-pack-select"></select></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ประเภทธุรกิจ <span class="font-normal opacity-60">ตามกลุ่มผู้ซื้อ</span></span><select class="select select-bordered select-sm w-full" name="businessModel" aria-label="Business model" disabled><option value="b2b">B2B</option><option value="b2c">B2C</option><option value="b2g">B2G</option></select></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ประเภทข้อความ</span><select class="select select-bordered select-sm w-full" name="touchpointType"><option value="meta-ad">แอด (Meta Ad)</option><option value="promotion">โปรโมชัน</option><option value="line-oa">LINE OA Broadcast</option><option value="sales-outreach">ทีมขายติดต่อ</option></select></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ช่องทาง</span><select class="select select-bordered select-sm w-full" name="channel"><option value="meta">Meta Ads</option><option value="line-oa">LINE OA</option><option value="email">อีเมล</option><option value="sms">SMS</option><option value="sales-call">โทรขาย</option><option value="website">เว็บไซต์</option><option value="offline">ออฟไลน์</option></select></label>
            <label class="form-control sm:col-span-2"><span class="label-text mb-1 text-xs font-semibold">จังหวะซื้อที่ส่งข้อความนี้ <span class="font-normal opacity-60">ช่วงก่อนหน้าถือว่าผ่านแล้ว</span></span><select class="select select-bordered select-sm w-full" name="journeyStage" id="journey-stage-select"></select></label>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ชื่อข้อความ / Variant</span><input class="input input-bordered input-sm w-full" name="name" required maxlength="500"></label>
            <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ตัวแปรที่เปลี่ยนรอบนี้</span><select class="select select-bordered select-sm w-full" name="changedVariable"><option value="hook">ประโยคเปิด</option><option value="offer">ข้อเสนอ</option><option value="copy">เนื้อความ</option><option value="visual">ภาพ / วิธีส่ง</option></select></label>
          </div>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ประโยคเปิด <span class="font-normal opacity-60">สิ่งแรกที่คนรับเห็น</span> <span class="font-normal opacity-60" id="hook-budget"></span></span><textarea class="textarea textarea-bordered w-full text-sm" name="hook" rows="2" required></textarea></label>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">เนื้อความ <span class="font-normal opacity-60" id="body-budget"></span></span><textarea class="textarea textarea-bordered w-full text-sm" name="primaryText" rows="4" required></textarea></label>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">หัวข้อ / Subject</span><input class="input input-bordered input-sm w-full" name="headline" required></label>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ข้อเสนอ / โปรโมชัน</span><textarea class="textarea textarea-bordered w-full text-sm" name="offer" rows="2" required></textarea></label>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">คำชวน (CTA)</span><input class="input input-bordered input-sm w-full" name="cta" required></label>
          <label class="form-control"><span class="label-text mb-1 text-xs font-semibold">ภาพ / วิธีส่ง <span class="font-normal opacity-60">ภาพ เวลาส่ง รูปแบบ หรือสิ่งที่เห็นก่อน</span></span><textarea class="textarea textarea-bordered w-full text-sm" name="visualDirection" rows="2" required></textarea></label>
          <p class="min-h-[1.25rem] text-sm text-error" id="creative-error" role="alert"></p>
          <div class="flex flex-col gap-2 sm:flex-row">
            <button class="gl-primary btn btn-sm flex-1 tap-44" type="submit">⚡ บันทึกแล้วประเมิน</button>
            <button class="btn btn-sm flex-1 tap-44" type="button" data-action="close-editor">เสร็จ (บันทึกอัตโนมัติแล้ว)</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิดฟอร์ม">close</button></form>
    </dialog>
    <dialog id="persona-dialog" class="modal" aria-labelledby="persona-dialog-title">
      <div class="modal-box max-w-lg">
        <form method="dialog"><button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 tap-44" aria-label="ปิด">✕</button></form>
        <div id="persona-dialog-content"></div>
      </div>
      <form method="dialog" class="modal-backdrop"><button aria-label="ปิด">close</button></form>
    </dialog>
    <dialog id="confirm-remove-dialog" class="modal" aria-labelledby="confirm-remove-title">
      <div class="modal-box max-w-md">
        <p class="gl-eyebrow">ยืนยันการลบ</p>
        <h2 id="confirm-remove-title" class="font-display text-lg font-semibold">ลบ <span id="confirm-persona-name">persona นี้</span>?</h2>
        <p class="mt-2 text-sm opacity-70">การลบมีผลกับ Persona Pack นี้ และผลประเมินของ Touchpoint ที่ใช้ pack นี้จะถูกล้างเพื่อให้ประเมินใหม่</p>
        <div class="modal-action">
          <button class="btn btn-sm tap-44" data-action="cancel-remove-persona">ยกเลิก</button>
          <button class="btn btn-sm btn-error tap-44" data-action="confirm-remove-persona">ลบ persona</button>
        </div>
      </div>
    </dialog>
  </div>

  <script>
    import { boot } from '../../scripts/growth-lab/ui.mjs';
    // The gate may restore the session and fire its event before this module finishes loading
    // (all module scripts race on their imports) — so also boot if the app is already revealed.
    let booted = false;
    const start = () => { if (!booted) { booted = true; void boot(); } };
    document.addEventListener('growth-lab:authed', start, { once: true });
    if (!document.getElementById('growth-lab-app')?.classList.contains('hidden')) start();
  </script>
</DashboardLayout>
