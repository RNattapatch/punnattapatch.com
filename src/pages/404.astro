---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ไม่พบหน้านี้ (404)" description="ขออภัย ไม่พบหน้าที่คุณกำลังมองหา" noindex={true}>
  <main class="min-h-[60vh] flex items-center justify-center px-6 py-24">
    <div class="text-center max-w-md">
      <p class="font-display text-7xl font-bold text-primary">404</p>
      <h1 class="mt-4 text-2xl font-display font-semibold">ไม่พบหน้านี้ครับ</h1>
      <p class="mt-3 text-base-content/60">
        หน้าที่คุณกำลังหาอาจถูกย้าย เปลี่ยนชื่อ หรือไม่มีอยู่แล้ว
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-primary rounded-full">กลับหน้าแรก</a>
        <a href="/booking" class="btn btn-ghost rounded-full">จองคิวรับบริการ</a>
      </div>
    </div>
  </main>
</BaseLayout>
