# Cloudflare Pages security headers — applies to every route.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP note: the site ships Astro `is:inline` scripts (define:vars) and
# Tailwind/DaisyUI inline styles, so 'unsafe-inline' is required for
# script-src/style-src — removing it WILL break the site. The CSP value here
# still limits which external origins can load/connect and blocks framing.
# After deploying, verify forms + analytics still work, then tighten if desired.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://pl.punnattapatch.com https://analytics.tiktok.com https://connect.facebook.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://rnat.app.n8n.cloud https://pl.punnattapatch.com https://analytics.tiktok.com https://www.facebook.com https://accounts.google.com https://oauth2.googleapis.com https://script.google.com https://script.googleusercontent.com; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self' https://rnat.app.n8n.cloud; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
