# Cloudflare Pages security headers — applies to every route.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP note: the site ships Astro `is:inline` scripts (define:vars) and
# Tailwind/DaisyUI inline styles, so 'unsafe-inline' is required for
# script-src/style-src — removing it WILL break the site. The CSP value here
# still limits which external origins can load/connect and blocks framing.
# After deploying, verify forms + analytics still work, then tighten if desired.
#
# 2026-08-20: connect-src เพิ่ม 2 origin
#   · form-hook.punnattapatch.com = ตัวรับฟอร์มบน Mac mini (แทน n8n ที่โควตาหมด)
#   · yykocvhorgcgzaluuldn.supabase.co = fallback ชั้นสองที่โค้ดฟอร์มเรียกอยู่แล้ว
#     แต่ CSP บล็อกมาตลอด → เวลา primary ล่ม lead หายทั้งที่โค้ด fallback มีอยู่
#   คง rnat.app.n8n.cloud ไว้ก่อนเผื่อ rollback (หน้าที่ค้าง cache ยังยิงเข้า n8n อยู่)

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://pl.punnattapatch.com https://analytics.tiktok.com https://accounts.google.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://form-hook.punnattapatch.com https://yykocvhorgcgzaluuldn.supabase.co https://rnat.app.n8n.cloud https://pl.punnattapatch.com https://analytics.tiktok.com https://accounts.google.com https://oauth2.googleapis.com https://script.google.com https://script.googleusercontent.com https://www.facebook.com https://connect.facebook.net; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self' https://form-hook.punnattapatch.com https://rnat.app.n8n.cloud; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
